# iSchool Environment Variables
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════════════════════
# Core Application
# ═══════════════════════════════════════════════════════
NODE_ENV=development  # development | staging | production
LOG_LEVEL=info  # debug | info | warn | error | fatal
PORT=4321

# Session & Security
SESSION_SECRET=change-this-to-a-random-64-char-string
ENCRYPTION_KEY=change-this-to-a-random-32-char-string  # AES-256 key for encrypting sensitive fields

# Database
DATABASE_PATH=./ischool.db

# ═══════════════════════════════════════════════════════
# Cloudinary (Image/Video Storage)
# ═══════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════
# Email (Gmail SMTP)
# ═══════════════════════════════════════════════════════
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=noreply@yourschool.com

# ═══════════════════════════════════════════════════════
# AI Provider (Z.AI / OpenAI compatible)
# ═══════════════════════════════════════════════════════
AI_API_KEY=
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_MODEL=glm-4.6

# ═══════════════════════════════════════════════════════
# Payment Gateways
# ═══════════════════════════════════════════════════════
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Paystack (Africa)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════
# SMS (Optional)
# ═══════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ═══════════════════════════════════════════════════════
# Google Translate (Multilingual)
# ═══════════════════════════════════════════════════════
GOOGLE_TRANSLATE_API_KEY=

# ═══════════════════════════════════════════════════════
# Error Tracking (Optional)
# ═══════════════════════════════════════════════════════
SENTRY_DSN=

# ═══════════════════════════════════════════════════════
# Backup (Optional)
# ═══════════════════════════════════════════════════════
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
