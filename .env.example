# iSchool Environment Variables
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════════════════════
# Core Application
# ═══════════════════════════════════════════════════════
NODE_ENV=development  # development | staging | production
LOG_LEVEL=info  # debug | info | warn | error | fatal
PORT=4321

# Public base URL (used for password reset links, email links, etc.)
PUBLIC_BASE_URL=http://localhost:4321

# Session & Security
SESSION_SECRET=change-this-to-a-random-64-char-string
ENCRYPTION_KEY=change-this-to-a-random-32-char-string  # AES-256 key for encrypting sensitive fields

# Database Provider: sqlite (default) or lightbase
DB_PROVIDER=lightbase

# SQLite Configuration (used when DB_PROVIDER=sqlite)
DATABASE_PATH=./ischool.db

# Lightbase Configuration (used when DB_PROVIDER=lightbase)
# NOTE: Do NOT commit real credentials here. Set these in your actual .env file
# or via your deployment platform's environment variables.
LIGHTBASE_API_KEY=
LIGHTBASE_PROJECT=ischool-beta
LIGHTBASE_BASE_URL=https://your-lightbase-instance.example.com
# Server-side Lightbase request timeout in ms (default 12000)
LIGHTBASE_TIMEOUT_MS=12000
# OPTIONAL Path A §B4: scoped READ-MOSTLY key for the browser public SDK
# (data-attribute injected on live-refresh pages; leave empty to keep the
# browser SDK dormant with SSR fallback). NEVER reuse the server key here.
LIGHTBASE_PUBLIC_API_KEY=

# ═══════════════════════════════════════════════════════
# Platform Admin Access
# ═══════════════════════════════════════════════════════
# Format: email:password,email:password
# Platform admins log in at /auth/login with these credentials
# and are redirected to /admin (platform admin dashboard)
PLATFORM_ADMINS=admin@ischool.com:admin123

# ═══════════════════════════════════════════════════════
# AI Provider (OpenAI-compatible)
# ═══════════════════════════════════════════════════════
# Used as fallback if no AI provider is configured in the database
# Any OpenAI-compatible API will work
AI_API_KEY=sk-d4f94a4d246c6791-a86fbc-e4001aad
AI_BASE_URL=https://dependence-subjects-mandatory-hunt.trycloudflare.com/v1
AI_MODEL=general1

# ═══════════════════════════════════════════════════════
# Cloudinary (Image/Video Storage)
# ═══════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════
# Email (Gmail SMTP)
# ═══════════════════════════════════════════════════════
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=noreply@yourschool.com

# ═══════════════════════════════════════════════════════
# Payment Gateways (Optional — manual payment recording works without these)
# ═══════════════════════════════════════════════════════
# BirrPay — PRIMARY gateway (aggregates Flutterwave/Paystack/KoraPay/PayPal
# behind one API + hosted checkout + one webhook relay at /api/webhooks/birrpay):
PAYMENTS_PROVIDER=birrpay       # birrpay (default) | paystack | stripe | bank_transfer | cash
BIRRPAY_BASE_URL=https://birrpay-beta1b.pages.dev
BIRRPAY_SECRET_KEY=             # sk_test_... / sk_live_... from your BirrPay dashboard
BIRRPAY_WEBHOOK_SECRET=         # whsec_... — verifies X-BirrPay-Signature
BIRRPAY_CURRENCY=NGN            # session currency for school invoices

# Stripe (kept for reversibility; disabled by default)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Paystack (Africa)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════
# SMS (Optional)
# ═══════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ═══════════════════════════════════════════════════════
# Google Translate (Optional — for multilingual support)
# ═══════════════════════════════════════════════════════
GOOGLE_TRANSLATE_API_KEY=

# ═══════════════════════════════════════════════════════
# Error Tracking (Optional)
# ═══════════════════════════════════════════════════════
SENTRY_DSN=
