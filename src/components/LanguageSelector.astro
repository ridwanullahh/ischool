---
import { translationService } from '../lib/i18n/translation-service.js';

const languages = translationService.getSupportedLanguages();
---

<div class="relative" id="language-selector">
  <button
    id="language-toggle"
    class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-100 transition-colors"
    aria-label="Select Language"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="text-sm font-medium hidden sm:inline" id="current-language">English</span>
  </button>

  <div id="language-dropdown" class="hidden absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-lg shadow-lg z-50 max-h-96 overflow-y-auto">
    <div class="p-2">
      <div class="px-3 py-2 text-sm font-semibold text-gray-500">Select Language</div>
      <div class="space-y-1">
        {languages.map((lang) => (
          <button
            data-lang={lang.code}
            class="lang-option w-full flex items-center justify-between px-3 py-2 rounded-md hover:bg-gray-100 transition-colors text-left"
          >
            <div class="flex flex-col">
              <span class="text-sm font-medium">{lang.nativeName}</span>
              <span class="text-xs text-gray-500">{lang.name}</span>
            </div>
            <svg class="w-4 h-4 text-primary-600 hidden check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline set:html={`(function(){
  var toggle = document.getElementById('language-toggle');
  var dropdown = document.getElementById('language-dropdown');
  var currentLangEl = document.getElementById('current-language');
  var rtlLanguages = ['ar', 'he', 'fa', 'ur'];
  var translationProgress = document.createElement('div');
  translationProgress.style.cssText = 'position:fixed;top:0;left:0;right:0;height:3px;z-index:99999;transition:width .3s ease;pointer-events:none;display:none;';
  translationProgress.id = 'translation-progress-bar';
  var translationBar = document.createElement('div');
  translationBar.style.cssText = 'height:100%;background:linear-gradient(90deg,#4f46e5,#7c3aed);transition:width .3s ease;width:0;';
  translationProgress.appendChild(translationBar);
  document.body.appendChild(translationProgress);

  // Client-side translation cache (localStorage, persists across sessions)
  var CACHE_KEY = 'ischool_translations_cache';
  var CACHE_VERSION = 'v2';
  var CACHE_MAX_AGE = 7 * 24 * 60 * 60 * 1000; // 7 days

  function getCache() {
    try {
      var raw = localStorage.getItem(CACHE_KEY + '_' + CACHE_VERSION);
      if (!raw) return {};
      var parsed = JSON.parse(raw);
      // Check if cache is too old
      if (parsed._timestamp && Date.now() - parsed._timestamp > CACHE_MAX_AGE) {
        localStorage.removeItem(CACHE_KEY + '_' + CACHE_VERSION);
        return {};
      }
      return parsed;
    } catch (e) { return {}; }
  }

  function saveCache(cache) {
    try {
      cache._timestamp = Date.now();
      localStorage.setItem(CACHE_KEY + '_' + CACHE_VERSION, JSON.stringify(cache));
    } catch (e) {
      // localStorage might be full, clear old entries
      try {
        var keys = Object.keys(cache);
        if (keys.length > 500) {
          keys.slice(0, 200).forEach(function(k) { delete cache[k]; });
          cache._timestamp = Date.now();
          localStorage.setItem(CACHE_KEY + '_' + CACHE_VERSION, JSON.stringify(cache));
        }
      } catch (e2) {}
    }
  }

  function getCachedTranslation(lang, text) {
    var cache = getCache();
    var key = lang + '::' + text;
    if (cache[key] && cache[key].timestamp && Date.now() - cache[key].timestamp < CACHE_MAX_AGE) {
      return cache[key].text;
    }
    return null;
  }

  function setCachedTranslation(lang, text, translated) {
    var cache = getCache();
    var key = lang + '::' + text;
    cache[key] = { text: translated, timestamp: Date.now() };
    saveCache(cache);
  }

  function getCurrentLang() {
    return localStorage.getItem('preferredLanguage') || 'en';
  }

  function updateUI() {
    var currentLang = getCurrentLang();
    // Use the original (untranslated) language name for the indicator
    var langNames = {
      'en': 'English', 'ar': 'العربية', 'fr': 'Français', 'es': 'Español',
      'de': 'Deutsch', 'it': 'Italiano', 'pt': 'Português', 'ru': 'Русский',
      'zh': '中文', 'ja': '日本語', 'ko': '한국어', 'hi': 'हिन्दी',
      'ur': 'اردو', 'tr': 'Türkçe', 'fa': 'فارسی', 'id': 'Bahasa Indonesia',
      'ms': 'Bahasa Melayu', 'th': 'ไทย', 'vi': 'Tiếng Việt', 'sw': 'Kiswahili',
      'ha': 'Hausa'
    };
    if (currentLangEl) currentLangEl.textContent = langNames[currentLang] || 'English';
    
    var currentOption = document.querySelector('[data-lang="' + currentLang + '"]');
    if (currentOption) {
      document.querySelectorAll('.check-icon').forEach(function(icon) { icon.classList.add('hidden'); });
      var checkIcon = currentOption.querySelector('.check-icon');
      if (checkIcon) checkIcon.classList.remove('hidden');
    }
    document.documentElement.lang = currentLang;
    document.documentElement.dir = rtlLanguages.includes(currentLang) ? 'rtl' : 'ltr';
  }

  toggle && toggle.addEventListener('click', function() {
    dropdown && dropdown.classList.toggle('hidden');
  });

  document.addEventListener('click', function(e) {
    if (!document.getElementById('language-selector') || !document.getElementById('language-selector').contains(e.target)) {
      dropdown && dropdown.classList.add('hidden');
    }
  });

  // Store original text for reverting
  var originalTexts = new WeakMap();

  function storeOriginal(node) {
    if (!originalTexts.has(node)) {
      originalTexts.set(node, node.textContent);
    }
  }

  function restoreOriginals() {
    document.querySelectorAll('[data-translated="true"]').forEach(function(el) {
      var original = originalTexts.get(el);
      if (original !== undefined) {
        el.textContent = original;
        el.removeAttribute('data-translated');
      }
    });
  }

  // Collect ALL text nodes on the page (not just 100)
  function collectTextNodes() {
    var textNodes = [];
    var walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode: function(node) {
          var text = node.textContent.trim();
          if (!text || text.length === 0 || text.length > 500) return NodeFilter.FILTER_REJECT;
          var parent = node.parentElement;
          if (!parent) return NodeFilter.FILTER_REJECT;
          var tag = parent.tagName;
          if (['SCRIPT', 'STYLE', 'CODE', 'PRE', 'SVG', 'INPUT', 'TEXTAREA', 'NOSCRIPT'].includes(tag)) return NodeFilter.FILTER_REJECT;
          // Skip already translated nodes
          if (parent.getAttribute('data-translated') === 'true') return NodeFilter.FILTER_REJECT;
          // Skip language selector (prevents indicator from being translated)
          if (parent.closest('#language-selector')) return NodeFilter.FILTER_REJECT;
          // Skip elements marked as no-translate
          if (parent.closest('[data-no-translate]')) return NodeFilter.FILTER_REJECT;
          // Skip links that are just URLs
          if (parent.tagName === 'A' && /^https?:\\/\\//.test(text)) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      }
    );
    while (walker.nextNode()) {
      textNodes.push(walker.currentNode);
    }
    return textNodes;
  }

  // Batch translate: send multiple texts in one API call
  async function batchTranslate(texts, targetLang) {
    try {
      var response = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ texts: texts, targetLang: targetLang, sourceLang: 'en', batch: true })
      });
      if (response.ok) {
        var data = await response.json();
        if (data.translations && Array.isArray(data.translations)) {
          return data.translations;
        }
      }
    } catch (e) {}
    return null;
  }

  // Translate single text with cache
  async function translateSingle(text, targetLang) {
    var cached = getCachedTranslation(targetLang, text);
    if (cached) return cached;

    try {
      var response = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text, targetLang: targetLang, sourceLang: 'en' })
      });
      if (response.ok) {
        var data = await response.json();
        if (data.translatedText) {
          setCachedTranslation(targetLang, text, data.translatedText);
          return data.translatedText;
        }
      }
    } catch (e) {}
    return text; // Return original on failure
  }

  async function translatePage(targetLang) {
    if (targetLang === 'en') {
      restoreOriginals();
      return;
    }

    var textNodes = collectTextNodes();
    if (textNodes.length === 0) return;

    // Show progress bar
    translationProgress.style.display = 'block';
    translationBar.style.width = '0%';

    var total = textNodes.length;
    var processed = 0;
    var batchSize = 20; // Process 20 texts at a time

    // Process in batches
    for (var i = 0; i < textNodes.length; i += batchSize) {
      var batch = textNodes.slice(i, i + batchSize);
      var textsToTranslate = [];
      var nodesToTranslate = [];

      // Check cache first, collect uncached
      for (var j = 0; j < batch.length; j++) {
        var node = batch[j];
        var text = node.textContent.trim();
        var cached = getCachedTranslation(targetLang, text);
        if (cached) {
          // Apply cached translation immediately
          storeOriginal(node.parentElement);
          node.textContent = cached;
          node.parentElement.setAttribute('data-translated', 'true');
          processed++;
        } else {
          textsToTranslate.push(text);
          nodesToTranslate.push(node);
        }
      }

      // Update progress
      translationBar.style.width = Math.round((processed / total) * 100) + '%';

      // Translate uncached texts
      if (textsToTranslate.length > 0) {
        // Try batch first
        var batchResult = await batchTranslate(textsToTranslate, targetLang);
        if (batchResult && batchResult.length === textsToTranslate.length) {
          for (var k = 0; k < nodesToTranslate.length; k++) {
            var translated = batchResult[k];
            storeOriginal(nodesToTranslate[k].parentElement);
            nodesToTranslate[k].textContent = translated;
            nodesToTranslate[k].parentElement.setAttribute('data-translated', 'true');
            setCachedTranslation(targetLang, textsToTranslate[k], translated);
            processed++;
          }
        } else {
          // Fall back to individual translations (parallel)
          var promises = textsToTranslate.map(function(text) {
            return translateSingle(text, targetLang);
          });
          var results = await Promise.all(promises);
          for (var m = 0; m < nodesToTranslate.length; m++) {
            storeOriginal(nodesToTranslate[m].parentElement);
            nodesToTranslate[m].textContent = results[m];
            nodesToTranslate[m].parentElement.setAttribute('data-translated', 'true');
            processed++;
          }
        }
      }

      // Update progress bar
      translationBar.style.width = Math.round((processed / total) * 100) + '%';
    }

    // Hide progress bar after completion
    setTimeout(function() {
      translationProgress.style.display = 'none';
    }, 1000);
  }

  // Language option click handler
  document.querySelectorAll('.lang-option').forEach(function(button) {
    button.addEventListener('click', function() {
      var lang = button.getAttribute('data-lang');
      if (lang) {
        localStorage.setItem('preferredLanguage', lang);
        updateUI();
        dropdown && dropdown.classList.add('hidden');
        translatePage(lang);
      }
    });
  });

  updateUI();

  // Auto-translate on page load if language is not English
  var currentLang = getCurrentLang();
  if (currentLang !== 'en') {
    // Wait for page to fully render
    window.addEventListener('load', function() {
      setTimeout(function() { translatePage(currentLang); }, 300);
    });
    // Also try immediately in case load already fired
    setTimeout(function() { translatePage(currentLang); }, 500);
  }
})();`} />
