---
import { getDb } from '../lib/db/index.js';

interface Props {
  school?: any;
  schoolId?: number;
  currentPage?: string;
}

const { school, schoolId: directSchoolId, currentPage = '/' } = Astro.props;
const schoolId = directSchoolId || school?.id;
const now = new Date().toISOString().split('T')[0];

function parsePages(val: any): string[] {
  if (Array.isArray(val)) return val;
  if (typeof val === 'string') {
    try { const p = JSON.parse(val); return Array.isArray(p) ? p : ['all']; } catch { return ['all']; }
  }
  return ['all'];
}

function parseJson(val: any, fallback: any): any {
  if (val === null || val === undefined) return fallback;
  if (typeof val === 'object') return val;
  if (typeof val === 'string') {
    if (val === '') return fallback;
    try { return JSON.parse(val); } catch { return fallback; }
  }
  return fallback;
}

let activeBanners: any[] = [];
let activePopups: any[] = [];

try {
  const drizzleDb = getDb() as any;
  // Access the raw better-sqlite3 instance (Drizzle wraps it)
  const db = drizzleDb.$client || drizzleDb.session?.client || drizzleDb;
  // Fetch banners using raw SQL (safe against column changes)
  try {
    const rows: any[] = db.prepare('SELECT * FROM banners WHERE school_id = ? AND is_active = 1').all(schoolId);
    activeBanners = rows.filter(b => {
      try {
        if (b.start_date && b.start_date > now) return false;
        if (b.end_date && b.end_date < now) return false;
        const pages = parsePages(b.display_pages || b.displayPages || b.pages);
        if (pages.includes('all')) return true;
        return pages.some((p: string) => currentPage.startsWith(p));
      } catch { return true; }
    });
  } catch {}

  // Fetch popups using raw SQL
  try {
    const rows: any[] = db.prepare('SELECT * FROM popups WHERE school_id = ? AND is_active = 1').all(schoolId);
    activePopups = rows.filter(p => {
      try {
        if (p.start_date && p.start_date > now) return false;
        if (p.end_date && p.end_date < now) return false;
        const pages = parsePages(p.display_pages || p.displayPages || p.pages);
        if (pages.includes('all')) return true;
        return pages.some((pg: string) => currentPage.startsWith(pg));
      } catch { return true; }
    });
  } catch {}
} catch {
  // DB not available — no banners/popups
}

// Normalize banner/popup field names (handle both snake_case and camelCase)
function normalizeBanner(b: any): any {
  return {
    id: b.id,
    title: b.title || '',
    subtitle: b.subtitle || b.description || '',
    imageUrl: b.image_url || b.imageUrl || '',
    linkUrl: b.link_url || b.linkUrl || '',
    linkText: b.link_text || b.linkText || 'Learn More',
    position: b.position || 'top',
    styleOverrides: parseJson(b.style_overrides || b.styleOverrides, {}),
    ctaText: b.cta_text || b.ctaText || '',
  };
}

function normalizePopup(p: any): any {
  return {
    id: p.id,
    title: p.title || '',
    content: p.content || p.body || '',
    imageUrl: p.image_url || p.imageUrl || '',
    linkUrl: p.link_url || p.linkUrl || '',
    linkText: p.link_text || p.linkText || 'Learn More',
    triggerType: p.trigger_type || p.triggerType || 'on_load',
    triggerDelay: p.trigger_delay || p.triggerDelay || 0,
    displayFrequency: p.display_frequency || p.displayFrequency || 'once_per_session',
  };
}

const banners = activeBanners.map(normalizeBanner);
const popups = activePopups.map(normalizePopup);

// Check if banners module is enabled (banners disabled by default - coming soon)
let bannersEnabled = false;
try {
  const drizzleDb2 = getDb() as any;
  const db2 = drizzleDb2.$client || drizzleDb2.session?.client || drizzleDb2;
  const bannerSetting = db2.prepare('SELECT enabled FROM module_settings WHERE school_id = ? AND module = ?').get(schoolId, 'banners') as any;
  bannersEnabled = bannerSetting ? (bannerSetting.enabled === 1 || bannerSetting.enabled === true) : false;
} catch {}

const topBanners = bannersEnabled ? banners.filter(b => b.position === 'top') : [];
const heroBanners = bannersEnabled ? banners.filter(b => b.position === 'hero') : [];
const sidebarBanners = bannersEnabled ? banners.filter(b => b.position === 'sidebar') : [];
---

{topBanners.map(b => (
  <div class="ischool-banner" data-position="top" data-banner-id={b.id} style={b.styleOverrides?.background ? `background:${b.styleOverrides.background}` : ''}>
    <div class="ischool-banner-inner">
      <div class="ischool-banner-content">
        {b.title && <span class="ischool-banner-title">{b.title}</span>}
        {b.subtitle && <span class="ischool-banner-subtitle">{b.subtitle}</span>}
      </div>
      {b.linkUrl && <a href={b.linkUrl} class="ischool-banner-link">{b.linkText}</a>}
      <button type="button" class="ischool-banner-close" data-banner-close={b.id} aria-label="Close banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
))}

{heroBanners.map(b => (
  <section class="ischool-hero-banner" data-banner-id={b.id} style={b.imageUrl ? `background-image:url(${b.imageUrl})` : ''}>
    <div class="ischool-hero-overlay">
      <button type="button" class="ischool-hero-close" data-banner-close={b.id} aria-label="Close banner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <h2 class="ischool-hero-title">{b.title}</h2>
      {b.subtitle && <p class="ischool-hero-subtitle">{b.subtitle}</p>}
      {b.linkUrl && <a href={b.linkUrl} class="ischool-hero-link">{b.linkText} &rarr;</a>}
    </div>
  </section>
))}

{sidebarBanners.length > 0 && (
  <div class="ischool-sidebar-banners fixed right-4 top-1/2 -translate-y-1/2 z-40 space-y-3 max-w-[280px]">
    {sidebarBanners.map(b => (
      <div class="ischool-sidebar-banner" data-banner-id={b.id}>
        <button type="button" class="ischool-sidebar-close" data-banner-close={b.id} aria-label="Close banner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        {b.imageUrl && <img src={b.imageUrl} alt={b.title} class="ischool-sidebar-image" />}
        <div class="ischool-sidebar-content">
          <h4 class="ischool-sidebar-title">{b.title}</h4>
          {b.subtitle && <p class="ischool-sidebar-subtitle">{b.subtitle}</p>}
          {b.linkUrl && <a href={b.linkUrl} class="ischool-sidebar-link">{b.linkText}</a>}
        </div>
      </div>
    ))}
  </div>
)}

{popups.length > 0 && (
  <div id="ischool-popup-overlay" class="ischool-popup-overlay" style="display:none" data-popup-overlay>
    <div id="ischool-popup-container" data-popup-container>
      {/* Only render the FIRST active popup — show one at a time */}
      {popups.slice(0, 1).map(p => (
        <div class="ischool-popup" data-trigger={p.triggerType} data-delay={p.triggerDelay} data-frequency={p.displayFrequency} data-id={p.id}>
          <button type="button" class="ischool-popup-close" data-popup-close={p.id} aria-label="Close popup">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          {p.imageUrl && <img src={p.imageUrl} alt={p.title} class="ischool-popup-image" />}
          <h3 class="ischool-popup-title">{p.title}</h3>
          <p class="ischool-popup-content">{p.content}</p>
          {p.linkUrl && <a href={p.linkUrl} class="ischool-popup-link">{p.linkText}</a>}
        </div>
      ))}
    </div>
  </div>
)}

<script is:inline set:html={`(function(){
  // === Banner close buttons ===
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-banner-close]');
    if (!btn) return;
    var id = btn.getAttribute('data-banner-close');
    var banner = document.querySelector('[data-banner-id="' + id + '"]');
    if (banner) {
      banner.style.transition = 'opacity .2s ease, max-height .2s ease';
      banner.style.opacity = '0';
      banner.style.maxHeight = banner.offsetHeight + 'px';
      setTimeout(function(){ banner.style.maxHeight = '0'; banner.style.padding = '0'; banner.style.margin = '0'; }, 200);
      setTimeout(function(){ banner.remove(); }, 400);
    }
    try { sessionStorage.setItem('banner_dismissed_' + id, '1'); } catch {}
  });

  // Hide banners already dismissed this session
  try {
    document.querySelectorAll('[data-banner-id]').forEach(function(el) {
      var id = el.getAttribute('data-banner-id');
      if (sessionStorage.getItem('banner_dismissed_' + id)) el.remove();
    });
  } catch {}

  // === Popup system ===
  var popups = document.querySelectorAll('.ischool-popup');
  if (!popups.length) return;
  var overlay = document.getElementById('ischool-popup-overlay');
  if (!overlay) return;

  function showPopup(el) {
    var id = el.getAttribute('data-id');
    var freq = el.getAttribute('data-frequency');
    var key = 'popup_' + id;
    var dismissKey = 'popup_dismissed_' + id;
    try {
      if (freq === 'once' && localStorage.getItem(key)) return;
      if (freq === 'once_per_session' && sessionStorage.getItem(key)) return;
      if (freq === 'once_per_day') {
        var d = localStorage.getItem(key);
        if (d && new Date(d).toDateString() === new Date().toDateString()) return;
      }
      if (sessionStorage.getItem(dismissKey)) return;
    } catch {}
    overlay.style.display = 'flex';
    el.style.display = 'block';
    // Hide other popups, show this one
    popups.forEach(function(other) {
      if (other !== el) other.style.display = 'none';
    });
    try {
      if (freq === 'once') localStorage.setItem(key, '1');
      else if (freq === 'once_per_session') sessionStorage.setItem(key, '1');
      else if (freq === 'once_per_day') localStorage.setItem(key, new Date().toISOString());
    } catch {}
  }

  popups.forEach(function(el) {
    var trigger = el.getAttribute('data-trigger');
    var delay = parseInt(el.getAttribute('data-delay')) || 0;
    if (trigger === 'on_load' || trigger === 'timed') {
      setTimeout(function(){ showPopup(el); }, delay * 1000);
    } else if (trigger === 'scroll') {
      var shown = false;
      window.addEventListener('scroll', function() {
        if (!shown && window.scrollY > document.body.scrollHeight * 0.5) { showPopup(el); shown = true; }
      });
    } else if (trigger === 'exit_intent') {
      document.addEventListener('mouseout', function(e) {
        if (e.clientY < 5) showPopup(el);
      });
    }
  });

  // Close popup handlers
  document.addEventListener('click', function(e) {
    var closeBtn = e.target.closest('[data-popup-close]');
    if (closeBtn) {
      var popup = closeBtn.closest('.ischool-popup');
      var id = popup ? popup.getAttribute('data-id') : '';
      overlay.style.display = 'none';
      try { sessionStorage.setItem('popup_dismissed_' + id, '1'); } catch {}
      return;
    }
    // Click on overlay backdrop (not on popup content) closes
    if (e.target === overlay) {
      overlay.style.display = 'none';
      try {
        var visible = document.querySelector('.ischool-popup:not([style*="display: none"])');
        var id = visible ? visible.getAttribute('data-id') : '';
        sessionStorage.setItem('popup_dismissed_' + id, '1');
      } catch {}
    }
  });

  // ESC key closes popup
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.style.display === 'flex') {
      overlay.style.display = 'none';
      try {
        var visible = document.querySelector('.ischool-popup:not([style*="display: none"])');
        var id = visible ? visible.getAttribute('data-id') : '';
        sessionStorage.setItem('popup_dismissed_' + id, '1');
      } catch {}
    }
  });
})();`} />

<style is:inline>{`
  .ischool-banner{background:var(--tp,#2563eb);color:#fff;padding:10px 0;font-size:14px;position:relative;z-index:50;overflow:hidden;transition:opacity .2s ease}
  .ischool-banner-inner{max-width:1280px;margin:0 auto;padding:0 16px;display:flex;align-items:center;justify-content:center;gap:16px;position:relative}
  .ischool-banner-content{display:flex;align-items:center;gap:8px;flex:1;justify-content:center;min-width:0}
  .ischool-banner-title{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ischool-banner-subtitle{opacity:.85;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ischool-banner-link{background:rgba(255,255,255,.2);padding:4px 12px;border-radius:999px;font-weight:500;color:#fff;text-decoration:none;font-size:13px;white-space:nowrap;flex-shrink:0}
  .ischool-banner-link:hover{background:rgba(255,255,255,.3)}
  .ischool-banner-close{background:rgba(255,255,255,.15);border:none;color:#fff;cursor:pointer;padding:4px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;width:28px;height:28px;transition:background .15s}
  .ischool-banner-close:hover{background:rgba(255,255,255,.3)}
  .ischool-banner-close svg{display:block}

  .ischool-hero-banner{position:relative;min-height:400px;background-size:cover;background-position:center;display:flex;align-items:center;background-color:var(--tp,#2563eb)}
  .ischool-hero-overlay{max-width:700px;padding:60px 40px;background:rgba(0,0,0,.45);color:#fff;border-radius:0 16px 16px 0;position:relative}
  .ischool-hero-close{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.3);border:none;color:#fff;cursor:pointer;padding:6px;border-radius:50%;display:flex;align-items:center;justify-content:center;width:36px;height:36px;transition:background .15s}
  .ischool-hero-close:hover{background:rgba(0,0,0,.5)}
  .ischool-hero-title{font-size:2.5rem;font-weight:800;line-height:1.1;margin-bottom:12px}
  .ischool-hero-subtitle{font-size:1.1rem;opacity:.9;margin-bottom:20px;line-height:1.5}
  .ischool-hero-link{display:inline-block;background:#fff;color:#111;padding:12px 28px;border-radius:999px;font-weight:600;text-decoration:none;font-size:14px}
  .ischool-hero-link:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2)}

  .ischool-sidebar-banner{background:var(--surface,#fff);border:1px solid var(--border,#e2e8f0);border-radius:16px;overflow:hidden;position:relative;box-shadow:0 8px 24px rgba(0,0,0,.08);transition:transform .2s}
  .ischool-sidebar-banner:hover{transform:translateY(-2px)}
  .ischool-sidebar-close{position:absolute;top:8px;right:8px;background:rgba(0,0,0,.3);border:none;color:#fff;cursor:pointer;padding:4px;border-radius:50%;display:flex;align-items:center;justify-content:center;width:24px;height:24px;z-index:1}
  .ischool-sidebar-close:hover{background:rgba(0,0,0,.5)}
  .ischool-sidebar-image{width:100%;height:120px;object-fit:cover}
  .ischool-sidebar-content{padding:14px}
  .ischool-sidebar-title{font-size:.875rem;font-weight:700;color:var(--text,#111);margin-bottom:4px}
  .ischool-sidebar-subtitle{font-size:.75rem;color:var(--muted,#6b7280);line-height:1.4;margin-bottom:8px}
  .ischool-sidebar-link{display:inline-block;font-size:.75rem;font-weight:600;color:var(--primary,var(--tp,#2563eb));text-decoration:none}
  .ischool-sidebar-link:hover{text-decoration:underline}

  .ischool-popup-overlay{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
  .ischool-popup{background:var(--surface,#fff);border:1px solid var(--border,#e2e8f0);border-radius:20px;max-width:480px;width:100%;padding:40px;position:relative;box-shadow:0 24px 64px rgba(0,0,0,.25);text-align:center;animation:popupIn .3s ease;max-height:90vh;overflow-y:auto}
  @keyframes popupIn{from{opacity:0;transform:scale(.9) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
  .ischool-popup-close{position:absolute;top:12px;right:12px;background:color-mix(in srgb, var(--muted,#6b7280) 15%, transparent);border:none;color:var(--muted,#6b7280);cursor:pointer;padding:6px;border-radius:50%;display:flex;align-items:center;justify-content:center;width:36px;height:36px;transition:background .15s,color .15s;z-index:1}
  .ischool-popup-close:hover{background:color-mix(in srgb, var(--muted,#6b7280) 25%, transparent);color:var(--text,#111)}
  .ischool-popup-close svg{display:block}
  .ischool-popup-image{width:100%;max-height:200px;object-fit:cover;border-radius:12px;margin-bottom:20px}
  .ischool-popup-title{font-size:1.5rem;font-weight:700;color:var(--text,#111);margin-bottom:8px}
  .ischool-popup-content{color:var(--muted,#555);line-height:1.6;margin-bottom:20px}
  .ischool-popup-link{display:inline-block;background:var(--tp,#2563eb);color:#fff;padding:12px 32px;border-radius:999px;font-weight:600;text-decoration:none;font-size:14px}
  .ischool-popup-link:hover{opacity:.9;transform:translateY(-1px)}

  @media (max-width:640px){
    .ischool-banner-inner{flex-wrap:wrap;gap:8px;padding:0 12px}
    .ischool-banner-content{justify-content:flex-start}
    .ischool-banner-close{position:absolute;top:50%;right:8px;transform:translateY(-50%)}
    .ischool-popup{padding:28px 20px}
    .ischool-popup-title{font-size:1.25rem}
    .ischool-hero-overlay{padding:40px 24px}
    .ischool-hero-title{font-size:1.75rem}
    .ischool-sidebar-banners{display:none}
  }
`}</style>