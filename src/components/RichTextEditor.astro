---
/**
 * RichTextEditor — A production-grade WYSIWYG editor with AI integration.
 * Supports: bold, italic, underline, headings, lists, links, images,
 * code blocks, blockquotes, and AI-assisted writing (improve, expand,
 * summarize, translate, generate).
 *
 * Usage:
 * <RichTextEditor name="content" value={post.content} id="content-editor" />
 */
interface Props {
  name: string;
  value?: string;
  id?: string;
  placeholder?: string;
  schoolSlug?: string;
}

const { name, value = '', id = 'rich-editor', placeholder = 'Start writing...', schoolSlug = '' } = Astro.props;
---

<div class="rich-editor-wrapper" data-editor-id={id}>
  <div class="flex flex-wrap items-center gap-1 p-2 border border-gray-200 border-b-0 rounded-t-lg bg-gray-50">
    <button type="button" data-cmd="bold" class="rte-btn" title="Bold (Ctrl+B)"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6V4zm0 8h9a4 4 0 014 4 4 4 0 01-4 4H6v-8z"/></svg></button>
    <button type="button" data-cmd="italic" class="rte-btn" title="Italic (Ctrl+I)"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 4h-9M14 20H5M15 4L9 20"/></svg></button>
    <button type="button" data-cmd="underline" class="rte-btn" title="Underline (Ctrl+U)"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4v6a6 6 0 0012 0V4M4 20h16"/></svg></button>
    <div class="w-px h-6 bg-gray-300 mx-1"></div>
    <button type="button" data-cmd="formatBlock" data-val="h2" class="rte-btn" title="Heading 2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h7M4 12h7m-7 6h7M16 6l3 3m0 0l3-3m-3 3V3"/></svg></button>
    <button type="button" data-cmd="formatBlock" data-val="h3" class="rte-btn" title="Heading 3"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h7M4 12h7m-7 6h7M16 6l3 3m0 0l3-3m-3 3V3M16 14h6"/></svg></button>
    <button type="button" data-cmd="formatBlock" data-val="p" class="rte-btn" title="Paragraph"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h12"/></svg></button>
    <div class="w-px h-6 bg-gray-300 mx-1"></div>
    <button type="button" data-cmd="insertUnorderedList" class="rte-btn" title="Bullet List"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h.01M4 12h.01M4 18h.01M8 6h12M8 12h12M8 18h12"/></svg></button>
    <button type="button" data-cmd="insertOrderedList" class="rte-btn" title="Numbered List"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 6h12M7 12h12M7 18h12M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
    <div class="w-px h-6 bg-gray-300 mx-1"></div>
    <button type="button" data-cmd="createLink" class="rte-btn" title="Insert Link"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg></button>
    <button type="button" data-cmd="formatBlock" data-val="blockquote" class="rte-btn" title="Quote"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h6v6H3zM3 13h6v6H3zM15 5h6v6h-6zM15 13h6v6h-6z"/></svg></button>
    <button type="button" data-cmd="formatBlock" data-val="pre" class="rte-btn" title="Code Block"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg></button>
    <div class="w-px h-6 bg-gray-300 mx-1"></div>
    <button type="button" data-cmd="removeFormat" class="rte-btn" title="Clear Formatting"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6a2 2 0 012 2v8"/></svg></button>

    <div class="w-px h-6 bg-gray-300 mx-1"></div>
    <div class="relative">
      <button type="button" id={id + '-ai-btn'} class="rte-btn rte-ai-btn flex items-center gap-1" title="AI Writing Assistant">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="text-xs font-medium">AI</span>
      </button>
      <div id={id + '-ai-dropdown'} class="hidden absolute top-full left-0 mt-1 w-56 bg-white border border-gray-200 rounded-lg shadow-lg z-50">
        <div class="p-1">
          <button type="button" data-ai-action="improve" class="rte-ai-option w-full text-left px-3 py-2 text-xs hover:bg-gray-100 rounded">Improve Writing</button>
          <button type="button" data-ai-action="expand" class="rte-ai-option w-full text-left px-3 py-2 text-xs hover:bg-gray-100 rounded">Expand Content</button>
          <button type="button" data-ai-action="summarize" class="rte-ai-option w-full text-left px-3 py-2 text-xs hover:bg-gray-100 rounded">Summarize</button>
          <button type="button" data-ai-action="generate" class="rte-ai-option w-full text-left px-3 py-2 text-xs hover:bg-gray-100 rounded">Generate from Prompt</button>
          <div class="border-t border-gray-100 my-1"></div>
          <button type="button" data-ai-action="grammar" class="rte-ai-option w-full text-left px-3 py-2 text-xs hover:bg-gray-100 rounded">Fix Grammar</button>
          <button type="button" data-ai-action="seo" class="rte-ai-option w-full text-left px-3 py-2 text-xs hover:bg-gray-100 rounded">SEO Optimize</button>
        </div>
      </div>
    </div>
  </div>

  <div id={id + '-editor'} class="rich-editor-content prose max-w-none min-h-[300px] p-4 border border-gray-200 rounded-b-lg focus:outline-none" contenteditable="true" data-placeholder={placeholder}></div>

  <textarea name={name} id={id + '-hidden'} class="hidden">{value}</textarea>

  <div id={id + '-ai-status'} class="hidden mt-2 p-2 rounded-lg text-xs"></div>
</div>

<style is:inline set:html={`
  .rte-btn { display: inline-flex; align-items: center; justify-content: center; padding: 6px; border-radius: 6px; color: #4b5563; transition: all .15s; min-width: 32px; min-height: 32px; }
  .rte-btn:hover { background: #e5e7eb; color: #111827; }
  .rte-btn:active { transform: scale(0.95); }
  .rte-ai-btn { background: #ede9fe; color: #7c3aed; }
  .rte-ai-btn:hover { background: #ddd6fe; }
  .rich-editor-content:empty::before { content: attr(data-placeholder); color: #9ca3af; pointer-events: none; }
  .rich-editor-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1rem 0 0.5rem; }
  .rich-editor-content h3 { font-size: 1.25rem; font-weight: 600; margin: 0.875rem 0 0.5rem; }
  .rich-editor-content p { margin: 0.5rem 0; }
  .rich-editor-content ul { list-style: disc; padding-left: 1.5rem; margin: 0.5rem 0; }
  .rich-editor-content ol { list-style: decimal; padding-left: 1.5rem; margin: 0.5rem 0; }
  .rich-editor-content blockquote { border-left: 4px solid #d1d5db; padding-left: 1rem; margin: 0.5rem 0; color: #6b7280; font-style: italic; }
  .rich-editor-content pre { background: #f3f4f6; padding: 1rem; border-radius: 8px; overflow-x: auto; margin: 0.5rem 0; }
  .rich-editor-content a { color: #4f46e5; text-decoration: underline; }
  .rte-ai-option { color: #374151; }
`} />

<script is:inline define:vars={{ editorId: id, schoolSlug }}>
  (function() {
    var wrapper = document.querySelector('[data-editor-id="' + editorId + '"]');
    if (!wrapper) return;
    var editor = document.getElementById(editorId + '-editor');
    var hidden = document.getElementById(editorId + '-hidden');
    var aiBtn = document.getElementById(editorId + '-ai-btn');
    var aiDropdown = document.getElementById(editorId + '-ai-dropdown');
    var aiStatus = document.getElementById(editorId + '-ai-status');

    // Set initial content
    editor.innerHTML = hidden.value || '';

    // Sync content to hidden textarea on input
    editor.addEventListener('input', function() { hidden.value = editor.innerHTML; });

    // Toolbar commands
    wrapper.querySelectorAll('[data-cmd]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var cmd = btn.getAttribute('data-cmd');
        var val = btn.getAttribute('data-val');
        editor.focus();
        if (cmd === 'createLink') {
          var url = prompt('Enter URL:');
          if (url) document.execCommand('createLink', false, url);
        } else if (val) {
          document.execCommand(cmd, false, val);
        } else {
          document.execCommand(cmd, false, null);
        }
        hidden.value = editor.innerHTML;
      });
    });

    // Keyboard shortcuts
    editor.addEventListener('keydown', function(e) {
      if (e.ctrlKey || e.metaKey) {
        if (e.key === 'b') { e.preventDefault(); document.execCommand('bold'); }
        else if (e.key === 'i') { e.preventDefault(); document.execCommand('italic'); }
        else if (e.key === 'u') { e.preventDefault(); document.execCommand('underline'); }
      }
      hidden.value = editor.innerHTML;
    });

    // AI dropdown toggle
    aiBtn?.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      aiDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', function(e) {
      if (!aiBtn?.contains(e.target) && !aiDropdown?.contains(e.target)) {
        aiDropdown?.classList.add('hidden');
      }
    });

    // AI actions
    wrapper.querySelectorAll('[data-ai-action]').forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        aiDropdown.classList.add('hidden');
        var action = btn.getAttribute('data-ai-action');
        var selectedText = window.getSelection().toString();
        var fullContent = editor.innerText;

        if (action === 'generate') {
          var prompt = prompt('What would you like the AI to write about?');
          if (!prompt) return;
          selectedText = prompt;
        }

        if (!selectedText && action !== 'generate' && !fullContent) {
          aiStatus.textContent = 'Please select some text or write some content first.';
          aiStatus.className = 'mt-2 p-2 rounded-lg text-xs bg-amber-50 text-amber-700';
          aiStatus.classList.remove('hidden');
          return;
        }

        aiStatus.textContent = 'AI is working...';
        aiStatus.className = 'mt-2 p-2 rounded-lg text-xs bg-blue-50 text-blue-700 flex items-center gap-2';
        aiStatus.innerHTML = '<svg class="animate-spin w-3 h-3" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> AI is processing...';
        aiStatus.classList.remove('hidden');

        try {
          var res = await fetch('/api/dashboard/ai-write', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: action,
              text: selectedText || fullContent,
              context: fullContent,
              schoolSlug: schoolSlug
            })
          });
          var data = await res.json();
          if (data.result) {
            if (action === 'generate') {
              editor.innerHTML += data.result;
            } else if (selectedText) {
              // Replace selected text
              var sel = window.getSelection();
              if (sel.rangeCount > 0) {
                var range = sel.getRangeAt(0);
                range.deleteContents();
                range.insertNode(document.createTextNode(data.result));
              }
            } else {
              // Replace all content
              editor.innerHTML = data.result;
            }
            hidden.value = editor.innerHTML;
            aiStatus.textContent = 'AI content applied successfully.';
            aiStatus.className = 'mt-2 p-2 rounded-lg text-xs bg-green-50 text-green-700';
            setTimeout(function() { aiStatus.classList.add('hidden'); }, 3000);
          } else {
            throw new Error(data.error || 'AI request failed');
          }
        } catch (err) {
          aiStatus.textContent = 'Error: ' + (err.message || 'AI request failed. Is AI configured?');
          aiStatus.className = 'mt-2 p-2 rounded-lg text-xs bg-red-50 text-red-700';
        }
      });
    });
  })();
</script>
