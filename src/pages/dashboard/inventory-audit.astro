---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { purchaseRequests, suppliers, assets, inventoryItems, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const requests = await db.select({
  id: purchaseRequests.id, items: purchaseRequests.items, totalAmount: purchaseRequests.totalAmount,
  reason: purchaseRequests.reason, status: purchaseRequests.status, approvedAt: purchaseRequests.approvedAt,
  createdAt: purchaseRequests.createdAt,
  supplierId: purchaseRequests.supplierId, supplierName: suppliers.name,
}).from(purchaseRequests)
  .leftJoin(suppliers, eq(purchaseRequests.supplierId, suppliers.id))
  .where(eq(purchaseRequests.schoolId, schoolId))
  .orderBy(desc(purchaseRequests.createdAt)).all();

const allSuppliers = await db.select().from(suppliers).where(eq(suppliers.schoolId, schoolId)).all();

const assetsCount = await db.select({ count: sql<number>`count(*)`, totalValue: sql<number>`coalesce(sum(${assets.currentValue}), 0)` })
  .from(assets).where(eq(assets.schoolId, schoolId)).all()[0];
const inventoryCount = await db.select({ count: sql<number>`count(*)`, totalQty: sql<number>`coalesce(sum(${inventoryItems.quantity}), 0)`, lowStock: sql<number>`sum(case when ${inventoryItems.quantity} <= ${inventoryItems.reorderLevel} then 1 else 0 end)` })
  .from(inventoryItems).where(eq(inventoryItems.schoolId, schoolId)).all()[0];
const conditionBreakdown = await db.select({
  condition: assets.condition, count: sql<number>`count(*)`, value: sql<number>`coalesce(sum(${assets.currentValue}), 0)`,
}).from(assets).where(eq(assets.schoolId, schoolId)).groupBy(assets.condition).all();

const conditionColors: Record<string, string> = { new: 'bg-green-100 text-green-700', good: 'bg-blue-100 text-blue-700', fair: 'bg-amber-100 text-amber-700', damaged: 'bg-orange-100 text-orange-700', decommissioned: 'bg-red-100 text-red-700' };
const statusColors: Record<string, string> = { pending: 'bg-amber-100 text-amber-700', approved: 'bg-green-100 text-green-700', rejected: 'bg-red-100 text-red-700', ordered: 'bg-blue-100 text-blue-700', received: 'bg-emerald-100 text-emerald-700', cancelled: 'bg-gray-100 text-gray-700' };
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const fmtMoney = (n: any) => n ? '₦' + n.toLocaleString() : '—';
---

<DashboardLayout title="Inventory Audit - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Inventory Audit & Procurement</h2>
        <p class="text-sm text-gray-500 mt-1">Asset condition breakdown, depreciation tracking, and purchase request workflow with approval.</p>
      </div>
      <button onclick="openReqModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Purchase Request</button>
    </div>

    {/* Asset & inventory summary */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Assets</div><div class="text-2xl font-bold">{assetsCount?.count || 0}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Asset Value</div><div class="text-2xl font-bold text-blue-600">{fmtMoney(assetsCount?.totalValue || 0)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Stock Items</div><div class="text-2xl font-bold">{inventoryCount?.count || 0}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Low Stock Alerts</div><div class="text-2xl font-bold text-amber-600">{inventoryCount?.lowStock || 0}</div></div>
    </div>

    {/* Asset condition breakdown */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Asset Condition Breakdown</h3>
      {conditionBreakdown.length === 0 ? (
        <p class="text-sm text-gray-500 text-center py-4">No assets recorded.</p>
      ) : (
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
          {conditionBreakdown.map(c => (
            <div class="border rounded-lg p-3 text-center">
              <span class={`inline-block text-[10px] font-bold uppercase px-2 py-0.5 rounded ${conditionColors[c.condition] || 'bg-gray-100'}`}>{c.condition}</span>
              <div class="text-2xl font-bold mt-2">{c.count}</div>
              <div class="text-xs text-gray-500">{fmtMoney(c.value || 0)}</div>
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Purchase requests */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Purchase Requests ({requests.length})</div>
      {requests.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No purchase requests yet.</p>
      ) : (
        <div class="divide-y divide-gray-100">
          {requests.map(r => {
            let items: any[] = [];
            try { items = typeof r.items === 'string' ? JSON.parse(r.items) : r.items; } catch {}
            return (
              <div class="p-4 hover:bg-gray-50">
                <div class="flex items-start justify-between">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                      <h3 class="font-semibold text-gray-900">Purchase Request #{r.id}</h3>
                      <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[r.status]}`}>{r.status}</span>
                    </div>
                    <p class="text-xs text-gray-500">
                      {r.supplierName && <span>Supplier: {r.supplierName} · </span>}
                      Total: <strong>{fmtMoney(r.totalAmount)}</strong> · Submitted {fmtDate(r.createdAt)}
                      {r.approvedAt && <span> · {r.status} on {fmtDate(r.approvedAt)}</span>}
                    </p>
                    {r.reason && <p class="text-sm text-gray-600 mt-1">{r.reason}</p>}
                    {Array.isArray(items) && items.length > 0 && (
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {items.map((it, i) => (
                          <span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded text-xs">
                            {it.name} × {it.quantity} {it.unitPrice ? `@ ${fmtMoney(it.unitPrice)}` : ''}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  {r.status === 'pending' && (
                    <div class="flex gap-2 shrink-0">
                      <button onclick={`approveReq(${r.id})`} class="text-xs text-green-600 font-medium">Approve</button>
                      <button onclick={`rejectReq(${r.id})`} class="text-xs text-red-600 font-medium">Reject</button>
                    </div>
                  )}
                  <button onclick={`deleteReq(${r.id})`} class="text-xs text-gray-500 font-medium ml-2">Delete</button>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <div id="reqModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New Purchase Request</h3>
      <form id="reqForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Supplier (optional)</label>
          <select name="supplierId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">—</option>
            {allSuppliers.map(s => <option value={s.id}>{s.name}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Reason / Justification</label><textarea name="reason" rows="2" placeholder="e.g. Restock for new term" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Items</label>
          <div id="itemRows" class="space-y-2"></div>
          <button type="button" onclick="addItemRow()" class="text-xs text-primary-600 font-medium mt-2">+ Add Item</button>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('reqModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Submit Request</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openReqModal = function() {
      document.getElementById('itemRows').innerHTML = '';
      addItemRow();
      document.getElementById('reqModal').classList.remove('hidden');
    };
    window.addItemRow = function() {
      var container = document.getElementById('itemRows');
      var row = document.createElement('div');
      row.className = 'flex gap-2';
      row.innerHTML = '<input type="text" name="itemName" placeholder="Item name" class="flex-1 px-2 py-1.5 border rounded text-xs" />' +
        '<input type="number" name="itemQty" placeholder="Qty" class="w-16 px-2 py-1.5 border rounded text-xs" />' +
        '<input type="number" name="itemPrice" placeholder="Unit ₦" class="w-24 px-2 py-1.5 border rounded text-xs" />' +
        '<input type="text" name="itemCat" placeholder="Category" class="w-24 px-2 py-1.5 border rounded text-xs" />' +
        '<button type="button" onclick="this.parentElement.remove()" class="text-red-500 text-xs px-2">×</button>';
      container.appendChild(row);
    };
    window.approveReq = async function(id) {
      await fetch('/api/dashboard/inventory-audit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'approve', id: id }) });
      window.location.reload();
    };
    window.rejectReq = async function(id) {
      await fetch('/api/dashboard/inventory-audit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'reject', id: id }) });
      window.location.reload();
    };
    window.deleteReq = async function(id) {
      if (!confirm('Delete this purchase request?')) return;
      await fetch('/api/dashboard/inventory-audit', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    document.getElementById('reqForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var nameNodes = this.querySelectorAll('[name="itemName"]');
      var qtyNodes = this.querySelectorAll('[name="itemQty"]');
      var priceNodes = this.querySelectorAll('[name="itemPrice"]');
      var catNodes = this.querySelectorAll('[name="itemCat"]');
      var items = [];
      for (var i = 0; i < nameNodes.length; i++) {
        if (nameNodes[i].value) items.push({ name: nameNodes[i].value, quantity: parseInt(qtyNodes[i].value) || 1, unitPrice: parseInt(priceNodes[i].value) || 0, category: catNodes[i].value || null });
      }
      if (items.length === 0) { alert('Add at least one item'); return; }
      var res = await fetch('/api/dashboard/inventory-audit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        supplierId: fd.get('supplierId') ? parseInt(fd.get('supplierId')) : null,
        reason: fd.get('reason') || null,
        items: items,
      }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
