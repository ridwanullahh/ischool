---
/**
 * Webhook Management
 *
 * School admins can register webhook endpoints, subscribe to events,
 * view delivery history, and test webhooks.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { webhooks, webhookDeliveries } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';
import { pageGuard } from '../../lib/rbac.js';
import { getAvailableEvents } from '../../lib/webhooks.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'it.modules.manage')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user);
const db = getDb();

const myWebhooks = schoolId
  ? await db.select().from(webhooks).where(eq(webhooks.schoolId, schoolId)).orderBy(desc(webhooks.createdAt)).all()
  : [];

const recentDeliveries = schoolId
  ? await db.select().from(webhookDeliveries)
    .orderBy(desc(webhookDeliveries.createdAt)).limit(20).all()
  : [];

const availableEvents = getAvailableEvents();

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
const statusColors: Record<string, string> = {
  delivered: 'bg-green-100 text-green-700',
  failed: 'bg-red-100 text-red-700',
  pending: 'bg-gray-100 text-gray-500',
  retry: 'bg-amber-100 text-amber-700',
};
---

<DashboardLayout title="Webhooks - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Webhooks</h2>
        <p class="text-sm text-gray-500 mt-1">Register webhook endpoints for event-driven automation</p>
      </div>
      <button onclick="document.getElementById('createModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Add Webhook</button>
    </div>

    {/* Webhook list */}
    {myWebhooks.length > 0 ? (
      <div class="space-y-3">
        {myWebhooks.map(w => {
          const events = (w.events as string[]) || [];
          return (
            <div class="bg-white rounded-xl border border-gray-200 p-5">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class:list={["inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold", w.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500']}>{w.active ? 'ACTIVE' : 'INACTIVE'}</span>
                    {w.secret && <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">SIGNED</span>}
                  </div>
                  <p class="text-sm font-mono text-gray-900 truncate">{w.url}</p>
                  <div class="flex items-center gap-1 mt-2 flex-wrap">
                    {events.map(e => <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-600">{e}</span>)}
                  </div>
                </div>
                <div class="flex items-center gap-1 shrink-0">
                  <button data-test-id={w.id} class="px-2 py-1 text-xs font-medium text-primary-600 border border-primary-200 rounded hover:bg-primary-50">Test</button>
                  <button data-toggle-id={w.id} data-active={String(w.active)} class="px-2 py-1 text-xs font-medium text-gray-600 border border-gray-200 rounded hover:bg-gray-50">{w.active ? 'Disable' : 'Enable'}</button>
                  <button data-delete-id={w.id} class="px-2 py-1 text-xs font-medium text-red-600 border border-red-200 rounded hover:bg-red-50">Delete</button>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        <p class="text-sm text-gray-500 mt-2">No webhooks registered yet.</p>
      </div>
    )}

    {/* Recent deliveries */}
    {recentDeliveries.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-base font-semibold text-gray-900 mb-4">Recent Deliveries</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b">
              <tr>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Event</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Status</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Response</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Attempts</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {recentDeliveries.map(d => (
                <tr class="hover:bg-gray-50">
                  <td class="py-2.5 px-3 font-mono text-xs text-gray-900">{d.event}</td>
                  <td class="py-2.5 px-3"><span class:list={["inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase", statusColors[d.status] || 'bg-gray-100 text-gray-500']}>{d.status}</span></td>
                  <td class="py-2.5 px-3 text-xs text-gray-500">{d.responseStatus || '-'}</td>
                  <td class="py-2.5 px-3 text-xs text-gray-500">{d.attempts}</td>
                  <td class="py-2.5 px-3 text-xs text-gray-400">{formatDate(d.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  {/* Create webhook modal */}
  <div id="createModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Add Webhook</h3>
        <button onclick="document.getElementById('createModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="createForm" class="space-y-4">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Endpoint URL</label><input name="url" type="url" required placeholder="https://example.com/webhook" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Events to Subscribe</label>
          <div class="space-y-1 max-h-48 overflow-y-auto border border-gray-200 rounded-lg p-2">
            {availableEvents.map(e => (
              <label class="flex items-center gap-2 p-1.5 hover:bg-gray-50 rounded cursor-pointer">
                <input type="checkbox" name="events" value={e.event} class="w-4 h-4 text-primary-600 rounded" />
                <div><p class="text-sm text-gray-900">{e.label}</p><p class="text-xs text-gray-500">{e.description}</p></div>
              </label>
            ))}
          </div>
        </div>
        <div><label class="flex items-center gap-2 text-xs font-medium text-gray-700"><input type="checkbox" name="generateSecret" checked class="w-4 h-4 text-primary-600 rounded" /> Generate secret for HMAC signature verification</label></div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create Webhook</button>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ schoolId }}>
    document.getElementById('createForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const fd = new FormData(this);
      const events = fd.getAll('events');
      const body = { schoolId, url: fd.get('url'), events, generateSecret: fd.get('generateSecret') === 'on' };
      const res = await fetch('/api/dashboard/webhooks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) window.location.reload(); else { const d = await res.json().catch(() => ({})); alert(d.error || 'Failed'); }
    });

    document.querySelectorAll('[data-test-id]').forEach(btn => {
      btn.addEventListener('click', async function() {
        const id = this.dataset.testId;
        const res = await fetch('/api/dashboard/webhooks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'test', id: parseInt(id) }) });
        if (res.ok) alert('Test event dispatched'); else alert('Failed');
      });
    });

    document.querySelectorAll('[data-toggle-id]').forEach(btn => {
      btn.addEventListener('click', async function() {
        const id = parseInt(this.dataset.toggleId);
        const active = this.dataset.active !== 'true';
        const res = await fetch('/api/dashboard/webhooks', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, active }) });
        if (res.ok) window.location.reload(); else alert('Failed');
      });
    });

    document.querySelectorAll('[data-delete-id]').forEach(btn => {
      btn.addEventListener('click', async function() {
        if (!confirm('Delete this webhook?')) return;
        const id = parseInt(this.dataset.deleteId);
        const res = await fetch('/api/dashboard/webhooks', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
        if (res.ok) window.location.reload(); else alert('Failed');
      });
    });
  </script>
</DashboardLayout>
