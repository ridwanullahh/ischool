---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { announcements, classes, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const anns = db.select().from(announcements).where(eq(announcements.schoolId, schoolId)).orderBy(desc(announcements.createdAt)).all();
const allClasses = db.select().from(classes).where(eq(classes.schoolId, schoolId)).all();
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
---

<DashboardLayout title="Announcements - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Announcements & Broadcasts</h2>
        <p class="text-sm text-gray-500 mt-1">Send targeted announcements to all, staff, teachers, parents, students, by class, or by grade. Emergency broadcasts highlight as high-priority alerts.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Announcement</button>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      {anns.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">📢</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No announcements yet</h3>
          <p class="text-sm text-gray-500">Send your first announcement to parents, students, or staff.</p>
        </div>
      ) : (
        <div class="divide-y divide-gray-100">
          {anns.map(a => (
            <div class="p-4 hover:bg-gray-50">
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    {a.isPinned && <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-700">📌 Pinned</span>}
                    <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${a.published ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'}`}>{a.published ? 'Published' : 'Draft'}</span>
                    <h3 class="font-semibold text-gray-900">{a.title}</h3>
                  </div>
                  <p class="text-sm text-gray-600 mt-1 line-clamp-2">{a.excerpt || a.content.substring(0, 200)}</p>
                  <p class="text-xs text-gray-400 mt-2">{fmtDate(a.createdAt)}</p>
                </div>
                <div class="flex gap-2 shrink-0 ml-2">
                  <button onclick={`editAnn(${a.id})`} class="text-xs text-amber-600 font-medium">Edit</button>
                  <button onclick={`deleteAnn(${a.id})`} class="text-xs text-red-600 font-medium">Delete</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>

  {/* Modal */}
  <div id="annModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="modalTitle">New Announcement</h3>
      <form id="annForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title *</label><input name="title" required placeholder="e.g. School Closed for Eid Break" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Content *</label><textarea name="content" required rows="4" placeholder="Announcement details…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Excerpt (optional)</label><input name="excerpt" placeholder="Short summary" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Target Audience *</label>
          <select name="audience" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="toggleAudienceFields(this.value)">
            <option value="all">Everyone (all users in school)</option>
            <option value="staff">All Staff</option>
            <option value="teachers">Teachers Only</option>
            <option value="parents">Parents Only</option>
            <option value="students">Students Only</option>
            <option value="class">Specific Class</option>
            <option value="grade">Specific Grade Level</option>
          </select>
        </div>
        <div id="classField" class="hidden"><label class="block text-xs font-medium text-gray-700 mb-1">Class *</label>
          <select name="classId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select class…</option>
            {allClasses.map(c => <option value={c.id}>{c.name}</option>)}
          </select>
        </div>
        <div id="gradeField" class="hidden"><label class="block text-xs font-medium text-gray-700 mb-1">Grade Level *</label><input name="gradeLevel" placeholder="e.g. Grade 5" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="isPinned" class="rounded" /> Pin to top</label>
          <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="isEmergency" class="rounded" /> Emergency (high-priority alert)</label>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" name="broadcast" checked class="rounded" />
          <label>Send in-app notifications to recipients</label>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('annModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Send</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ anns }} set:html={`(function(){
    var allAnns = anns;
    window.openModal = function() {
      var form = document.getElementById('annForm');
      form.reset(); form.id.value = '';
      document.getElementById('modalTitle').textContent = 'New Announcement';
      toggleAudienceFields('all');
      document.getElementById('annModal').classList.remove('hidden');
    };
    window.editAnn = function(id) {
      var a = allAnns.find(function(x){ return x.id === id; });
      if (!a) return;
      var form = document.getElementById('annForm');
      form.id.value = a.id;
      form.title.value = a.title;
      form.content.value = a.content;
      form.excerpt.value = a.excerpt || '';
      form.isPinned.checked = !!a.isPinned;
      toggleAudienceFields('all');
      document.getElementById('modalTitle').textContent = 'Edit Announcement';
      document.getElementById('annModal').classList.remove('hidden');
    };
    window.deleteAnn = async function(id) {
      if (!confirm('Delete this announcement?')) return;
      await fetch('/api/dashboard/comms-announcements', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.toggleAudienceFields = function(audience) {
      document.getElementById('classField').classList.toggle('hidden', audience !== 'class');
      document.getElementById('gradeField').classList.toggle('hidden', audience !== 'grade');
    };
    document.getElementById('annForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var id = fd.get('id');
      var payload = {
        title: fd.get('title'),
        content: fd.get('content'),
        excerpt: fd.get('excerpt') || null,
        audience: fd.get('audience'),
        classId: fd.get('classId') ? parseInt(fd.get('classId')) : null,
        gradeLevel: fd.get('gradeLevel') || null,
        isPinned: fd.get('isPinned') === 'on',
        isEmergency: fd.get('isEmergency') === 'on',
        broadcast: fd.get('broadcast') === 'on',
        published: true,
      };
      var method = id ? 'PUT' : 'POST';
      if (id) payload.id = parseInt(id);
      var res = await fetch('/api/dashboard/comms-announcements', { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) {
        var data = await res.json();
        if (data.recipients) alert('Announcement sent to ' + data.recipients + ' recipients!');
        window.location.reload();
      } else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
