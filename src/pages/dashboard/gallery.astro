---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { galleryItems } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';
const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();
let items: any[] = [];
if (schoolId) { try { items = await db.select().from(galleryItems).where(eq(galleryItems.schoolId, schoolId)).orderBy(desc(galleryItems.createdAt)).all() || []; } catch {} }
const success = Astro.url.searchParams.get('success');
---
<DashboardLayout title="Gallery - iSchool">
  {success && <div class="mosaic-card p-4 mb-4" style="border-color:#05B34D;background:rgba(5,179,77,0.05);"><p class="text-sm font-medium" style="color:#05B34D;">Gallery item saved successfully.</p></div>}
  <div class="mb-6"><h1 class="text-2xl font-bold mb-1" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Gallery</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Manage gallery images.</p></div>
  <ListToolbar searchPlaceholder="Search gallery..." newItemHref="/dashboard/gallery/new" newItemLabel="+ New Image" />
  <div id="list-container" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    {items.length === 0 ? (
      <div class="col-span-full mosaic-card p-12 text-center"><h3 class="text-base font-semibold mb-1" style="color:var(--mosaic-text);">No gallery items yet</h3><a href="/dashboard/gallery/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm mt-2">+ New Image</a></div>
    ) : items.map(item => (
      <div data-list-item data-title={item.title||''} data-status="published" data-date={item.createdAt||item.created_at||''} class="mosaic-card overflow-hidden group relative">
        {item.imageUrl||item.image_url ? (
          <div class="aspect-square overflow-hidden"><img src={item.imageUrl||item.image_url} alt={item.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" loading="lazy" /></div>
        ) : (
          <div class="aspect-square flex items-center justify-center" style="background:linear-gradient(135deg,rgba(5,179,77,0.08) 0%,rgba(5,179,77,0.02) 100%);"><svg class="w-10 h-10" style="color:rgba(5,179,77,0.3);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
        )}
        <div class="p-3">
          <h3 class="text-xs font-semibold line-clamp-1" style="color:var(--mosaic-text);">{item.title||'Untitled'}</h3>
          <div class="flex items-center justify-between mt-1">
            <span class="text-[10px]" style="color:var(--mosaic-text-subtle);">{item.sortOrder ?? item.sort_order ?? 0}</span>
            <a href={`/dashboard/gallery/${item.id}/edit`} class="p-1 rounded transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" title="Edit"><svg class="w-3.5 h-3.5" style="color:var(--mosaic-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
          </div>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
