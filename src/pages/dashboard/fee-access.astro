---
/**
 * Fee-Access Linkage Configuration
 *
 * School admins configure which modules to block for students with
 * overdue fees, the grace period, and threshold amount.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { feeAccessRules } from '../../lib/db/schema.js';
import { eq } from 'drizzle-orm';
import { pageGuard } from '../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'fees.manage')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user.id);
const db = getDb();

const existingRule = schoolId ? await db.select().from(feeAccessRules).where(eq(feeAccessRules.schoolId, schoolId)).get() : null;

const moduleOptions = [
  { key: 'lms', label: 'LMS (Assignments, Quizzes, Grades)' },
  { key: 'exams', label: 'Examinations' },
  { key: 'cbt', label: 'CBT / e-Exam' },
  { key: 'portal', label: 'Student Portal (all access)' },
];
const currentModules = (existingRule?.blockedModules as string[]) || [];
---

<DashboardLayout title="Fee-Access Configuration - iSchool">
  <div class="space-y-6 max-w-2xl">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Fee-Access Linkage</h2>
      <p class="text-sm text-gray-500 mt-1">Configure module access restrictions for students with overdue fees</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <form id="feeAccessForm" class="space-y-5">
        {/* Enable toggle */}
        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
          <div>
            <p class="text-sm font-medium text-gray-900">Enable Fee-Access Blocking</p>
            <p class="text-xs text-gray-500">When enabled, students with overdue fees will be blocked from selected modules</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="enabled" id="enabledToggle" class="sr-only" checked={existingRule?.enabled ?? false} />
            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:bg-primary-600 transition-colors"></div>
            <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full transition-transform peer-checked:translate-x-5"></div>
          </label>
        </div>

        {/* Grace period */}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Grace Period (days)</label>
          <input type="number" name="gracePeriodDays" min="0" value={existingRule?.gracePeriodDays ?? 0} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          <p class="text-xs text-gray-500 mt-1">Number of days after a fee is due before blocking kicks in</p>
        </div>

        {/* Threshold amount */}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Threshold Amount</label>
          <input type="number" name="thresholdAmount" min="0" value={existingRule?.thresholdAmount ?? 0} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          <p class="text-xs text-gray-500 mt-1">Only block if outstanding amount exceeds this (0 = any amount triggers)</p>
        </div>

        {/* Blocked modules */}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Modules to Block</label>
          <div class="space-y-2">
            {moduleOptions.map(m => (
              <label class="flex items-center gap-3 p-2.5 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer">
                <input type="checkbox" name="blockedModules" value={m.key} checked={currentModules.includes(m.key)} class="w-4 h-4 text-primary-600 rounded" />
                <span class="text-sm text-gray-900">{m.label}</span>
              </label>
            ))}
          </div>
        </div>

        {/* Custom message */}
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Custom Block Message (optional)</label>
          <textarea name="blockMessage" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Message shown to blocked students...">{existingRule?.blockMessage || ''}</textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Save Configuration</button>
        </div>
      </form>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div>
          <p class="text-sm font-medium text-blue-900">How it works</p>
          <p class="text-xs text-blue-700 mt-1">When a student has an unpaid invoice past the due date + grace period, and the outstanding amount meets the threshold, they will be blocked from the selected modules and see your custom message. Students can still view their fees page to see what they owe.</p>
        </div>
      </div>
    </div>
  </div>

  <div id="toast" class="fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg text-sm hidden z-50"></div>

  <script is:inline define:vars={{ schoolId }}>
    document.getElementById('feeAccessForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const fd = new FormData(this);
      const blockedModules = fd.getAll('blockedModules');
      const body = {
        schoolId,
        enabled: fd.get('enabled') === 'on',
        gracePeriodDays: parseInt(fd.get('gracePeriodDays')) || 0,
        thresholdAmount: parseInt(fd.get('thresholdAmount')) || 0,
        blockedModules,
        blockMessage: fd.get('blockMessage') || null,
      };
      const res = await fetch('/api/dashboard/fee-access', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const toast = document.getElementById('toast');
      if (res.ok) {
        toast.textContent = 'Configuration saved';
        toast.className = 'fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg text-sm z-50';
      } else {
        toast.textContent = 'Failed to save';
        toast.className = 'fixed bottom-4 right-4 bg-red-600 text-white px-4 py-2 rounded-lg shadow-lg text-sm z-50';
      }
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3000);
    });
  </script>
</DashboardLayout>
