---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { blogPosts } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();

let posts: any[] = [];
if (schoolId) {
  try {
    const result = await db.select().from(blogPosts).where(eq(blogPosts.schoolId, schoolId)).orderBy(desc(blogPosts.createdAt)).all();
    posts = Array.isArray(result) ? result : [];
  } catch (e: any) {
    console.error('[blog list] Error:', e?.message);
  }
}
const success = Astro.url.searchParams.get('success');
---

<DashboardLayout title="Blog - iSchool">
  {success && (
    <div class="mosaic-card p-4 mb-4 flex items-center gap-3" style="border-color: #05B34D; background: rgba(5,179,77,0.05);">
      <svg class="w-5 h-5" style="color: #05B34D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <p class="text-sm font-medium" style="color: #05B34D;">Blog post saved successfully.</p>
    </div>
  )}

  <div class="mb-6">
    <h1 class="text-2xl font-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">Blog Posts</h1>
    <p class="text-sm" style="color: var(--mosaic-text-muted);">Create and manage blog posts for your school website.</p>
  </div>

  <ListToolbar
    searchPlaceholder="Search blog posts..."
    filterOptions={[{value:'published',label:'Published'},{value:'draft',label:'Draft'}]}
    filterField="status"
    newItemHref="/dashboard/blog/new"
    newItemLabel="+ New Post"
  />

  <div id="list-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.length === 0 ? (
      <div class="col-span-full mosaic-card p-12 text-center">
        <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4" style="background: var(--mosaic-surface-2);">
          <svg class="w-8 h-8" style="color: var(--mosaic-text-subtle);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        </div>
        <h3 class="text-base font-semibold mb-1" style="color: var(--mosaic-text);">No blog posts yet</h3>
        <p class="text-sm mb-4" style="color: var(--mosaic-text-muted);">Create your first blog post to get started.</p>
        <a href="/dashboard/blog/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm">+ New Post</a>
      </div>
    ) : (
      posts.map(post => (
        <div data-list-item data-title={post.title || ''} data-status={post.status || 'published'} data-date={post.createdAt || post.created_at || ''} class="mosaic-card overflow-hidden group">
          {post.coverImageUrl || post.cover_image_url ? (
            <div class="h-32 overflow-hidden">
              <img src={post.coverImageUrl || post.cover_image_url} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
          ) : (
            <div class="h-32 flex items-center justify-center" style="background: linear-gradient(135deg, rgba(5,179,77,0.08) 0%, rgba(5,179,77,0.02) 100%);">
              <svg class="w-10 h-10" style="color: rgba(5,179,77,0.3);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            </div>
          )}
          <div class="p-4">
            <div class="flex items-center gap-2 mb-2">
              {post.category && <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full" style="background: rgba(5,179,77,0.1); color: #05B34D;">{post.category}</span>}
              <span class:list={["text-[10px] font-medium px-2 py-0.5 rounded-full", (post.status || 'published') === 'published' ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600"]}>{post.status || 'published'}</span>
            </div>
            <h3 class="text-sm font-bold mb-1 line-clamp-2" style="color: var(--mosaic-text);">{post.title || 'Untitled'}</h3>
            <p class="text-xs line-clamp-2 mb-3" style="color: var(--mosaic-text-muted);">{post.excerpt || 'No excerpt available.'}</p>
            <div class="flex items-center justify-between">
              <span class="text-[11px]" style="color: var(--mosaic-text-subtle);">{post.createdAt || post.created_at ? new Date(post.createdAt || post.created_at).toLocaleDateString() : ''}</span>
              <div class="flex items-center gap-1">
                <a href={`/dashboard/blog/${post.id}/edit`} class="p-1.5 rounded-lg transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" title="Edit">
                  <svg class="w-4 h-4" style="color: var(--mosaic-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))
    )}
  </div>
</DashboardLayout>
