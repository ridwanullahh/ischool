---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb, isLightbase, batchSelectAll } from '../../lib/db/index.js';
import { enrollments, students, classes } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();
let records: any[] = [];
let allStudents: any[] = [];
let allClasses: any[] = [];
let stats = { total: 0, accepted: 0, pending: 0, rejected: 0 };

// Path A §B3 browser-direct wiring: the public SDK config is injected via a
// data attribute — NO hardcoded keys. It activates only when a scoped,
// read-mostly LIGHTBASE_PUBLIC_API_KEY is provisioned (blueprint §B4);
// without it the client stays dormant and the SSR data below stands.
const lbPublicConfig = JSON.stringify({
  baseUrl: process.env.LIGHTBASE_BASE_URL || 'https://lightbase.pages.dev',
  project: process.env.LIGHTBASE_PROJECT || 'ischool-beta',
  apiKey: process.env.LIGHTBASE_PUBLIC_API_KEY || '',
});

if (schoolId) {
  try {
    // Path A §A3: three independent school-scoped selects coalesced into ONE
    // /batch call per render (previously 3 sequential GET /docs requests).
    if (isLightbase()) {
      const rawRecords = await batchSelectAll([
        { table: students, where: eq(students.schoolId, schoolId) },
        { table: classes, where: eq(classes.schoolId, schoolId) },
        { table: enrollments, where: eq(enrollments.schoolId, schoolId), orderBy: desc(enrollments.createdAt) },
      ]);
      allStudents = rawRecords[0] || [];
      allClasses = rawRecords[1] || [];
      records = rawRecords[2] || [];
    } else {
      allStudents = await db.select().from(students).where(eq(students.schoolId, schoolId)).all() || [];
      allClasses = await db.select().from(classes).where(eq(classes.schoolId, schoolId)).all() || [];
      records = await db.select().from(enrollments).where(eq(enrollments.schoolId, schoolId)).orderBy(desc(enrollments.createdAt)).all() || [];
    }
    const studentMap = new Map((allStudents||[]).map((s:any) => [s.id, s]));
    const classMap = new Map((allClasses||[]).map((c:any) => [c.id, c.name]));
    records = records.map((r:any) => {
      const student = studentMap.get(r.studentId ?? r.student_id);
      return { ...r, studentName: student ? `${student.firstName||student.first_name||''} ${student.lastName||student.last_name||''}`.trim() : 'Unknown', studentIdentifier: student?.studentId || student?.student_id || '', className: classMap.get(r.classId ?? r.class_id) || '—' };
    });
    stats = { total: records.length, accepted: records.filter(r => r.status === 'accepted').length, pending: records.filter(r => r.status === 'submitted' || r.status === 'pending').length, rejected: records.filter(r => r.status === 'rejected').length };
  } catch {}
}
---

<DashboardLayout title="Enrollments - iSchool">
  <div class="mb-6"><h1 class="text-2xl font-bold mb-1" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Enrollments</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Manage student enrollment records.</p></div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Total</p><p id="lb-stat-total" class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">{stats.total}</p></div>
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Accepted</p><p id="lb-stat-accepted" class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#05B34D;">{stats.accepted}</p></div>
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Pending</p><p id="lb-stat-pending" class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#F2B91C;">{stats.pending}</p></div>
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Rejected</p><p id="lb-stat-rejected" class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#EF4444;">{stats.rejected}</p></div>
  </div>

  <ListToolbar searchPlaceholder="Search enrollments..." filterOptions={[{value:'accepted',label:'Accepted'},{value:'submitted',label:'Submitted'},{value:'rejected',label:'Rejected'}]} filterField="status" newItemHref="/dashboard/enrollments/new" newItemLabel="+ New Enrollment" />

  <div id="list-container" class="space-y-3">
    {records.length === 0 ? (
      <div class="mosaic-card p-12 text-center"><h3 class="text-base font-semibold mb-1" style="color:var(--mosaic-text);">No enrollments yet</h3><a href="/dashboard/enrollments/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm mt-2">+ New Enrollment</a></div>
    ) : records.map(r => (
      <div data-list-item data-title={r.studentName||''} data-status={r.status||''} data-date={r.createdAt||r.created_at||''} class="mosaic-card p-4 group flex items-center gap-4">
        <div class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold text-white" style="background:linear-gradient(135deg,#05B34D 0%,#049940 100%);">{(r.studentName||'S').charAt(0)}</div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold" style="color:var(--mosaic-text);">{r.studentName}</p>
          <p class="text-xs" style="color:var(--mosaic-text-muted);">{r.studentIdentifier} · {r.className} · {r.academicYear || r.academic_year || ''}</p>
        </div>
        <span class:list={["text-[10px] font-bold uppercase px-2 py-1 rounded-full",r.status==='accepted'?"bg-green-100 text-green-700":r.status==='submitted'?"bg-amber-100 text-amber-700":"bg-red-100 text-red-700"]}>{r.status}</span>
        <a href={`/dashboard/enrollments/${r.id}/edit`} class="p-2 rounded-lg transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" title="Edit"><svg class="w-4 h-4" style="color:var(--mosaic-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
      </div>
    ))}
  </div>

  <div id="lb-public-config" class="hidden" aria-hidden="true" data-lb-config={lbPublicConfig} data-lb-school={JSON.stringify({ schoolId })}></div>
</DashboardLayout>

<script>
  // Path A §B3 heaviest-read-path wiring (enrollments): a browser-direct
  // coalesced + ETag-cached live refresh of the enrollment stats.
  // Graceful fallback: when no scoped key is injected the client is null and
  // the server-rendered stats above simply stay — nothing breaks.
  import { LightbasePublicClient } from '../../lib/lightbase/public-client.js';

  const cfgEl = document.getElementById('lb-public-config');
  const client = LightbasePublicClient.fromDataAttribute(cfgEl);

  if (client) {
    const parseRaw = (raw: string | null): { schoolId: unknown } => {
      try { return JSON.parse(raw || '{}'); } catch { return { schoolId: null }; }
    };
    const { schoolId } = parseRaw(cfgEl?.getAttribute('data-lb-school'));

    if (schoolId !== null && schoolId !== undefined) {
      const apply = (rows: any[]) => {
        const list = Array.isArray(rows) ? rows : [];
        const set = (id: string, v: number) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(v);
        };
        set('lb-stat-total', list.length);
        set('lb-stat-accepted', list.filter((r) => r?.status === 'accepted').length);
        set('lb-stat-pending', list.filter((r) => r?.status === 'submitted' || r?.status === 'pending').length);
        set('lb-stat-rejected', list.filter((r) => r?.status === 'rejected').length);
      };

      client
        .watch(
          { kind: 'query', collection: 'enrollments', filter: { field: 'school_id', op: 'eq', value: schoolId }, tag: 'enrollments-live' },
          apply,
          () => { /* silent — SSR data stands */ },
        );
    }
  }
</script>
