---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { events, eventRsvps, users, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// Events with RSVP required
const rsvpEvents = db.select().from(events).where(and(eq(events.schoolId, schoolId), eq(events.rsvpRequired, 1))).orderBy(desc(events.startDate)).all();
const allRsvps = db.select().from(eventRsvps).all();
const allUsers = db.select({ id: users.id, name: users.name, email: users.email }).from(users).all();
const userMap = new Map(allUsers.map(u => [u.id, u]));

const enrichedEvents = rsvpEvents.map(e => {
  const rsvps = allRsvps.filter(r => r.eventId === e.id);
  return {
    ...e,
    yesCount: rsvps.filter(r => r.response === 'yes').length,
    noCount: rsvps.filter(r => r.response === 'no').length,
    maybeCount: rsvps.filter(r => r.response === 'maybe').length,
    totalGuests: rsvps.filter(r => r.response === 'yes').reduce((s, r) => s + (r.numberOfGuests || 0), 0),
    totalResponses: rsvps.length,
    rsvps: rsvps.map(r => ({ ...r, user: userMap.get(r.userId) })),
  };
});

const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const responseColors: Record<string, string> = { yes: 'bg-green-100 text-green-700', no: 'bg-red-100 text-red-700', maybe: 'bg-amber-100 text-amber-700' };
---

<DashboardLayout title="RSVP Tracking - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">RSVP Tracking</h2>
      <p class="text-sm text-gray-500 mt-1">Track RSVP responses for events that require registration. View per-event breakdown of yes/no/maybe responses and guest counts.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">RSVP Events</div><div class="text-2xl font-bold">{rsvpEvents.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Yes</div><div class="text-2xl font-bold text-green-600">{enrichedEvents.reduce((s, e) => s + e.yesCount, 0)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total No</div><div class="text-2xl font-bold text-red-600">{enrichedEvents.reduce((s, e) => s + e.noCount, 0)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Guests</div><div class="text-2xl font-bold text-blue-600">{enrichedEvents.reduce((s, e) => s + e.totalGuests, 0)}</div></div>
    </div>

    <div class="space-y-4">
      {enrichedEvents.length === 0 ? (
        <div class="bg-white rounded-xl border p-12 text-center">
          <div class="text-4xl mb-3">📝</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No RSVP-required events</h3>
          <p class="text-sm text-gray-500">When you create an event with RSVP required, responses will appear here.</p>
        </div>
      ) : enrichedEvents.map(e => (
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <div class="p-4 border-b bg-gradient-to-r from-blue-50 to-indigo-50">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="font-semibold text-gray-900">{e.title}</h3>
                <p class="text-xs text-gray-500 mt-0.5">
                  📅 {fmtDate(e.startDate)}{e.startTime ? ` · ${e.startTime}` : ''}
                  {e.venue && <span> · 📍 {e.venue}</span>}
                </p>
              </div>
              <div class="flex gap-2">
                <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded">✓ {e.yesCount} Yes</span>
                <span class="text-xs px-2 py-1 bg-amber-100 text-amber-700 rounded">? {e.maybeCount} Maybe</span>
                <span class="text-xs px-2 py-1 bg-red-100 text-red-700 rounded">✗ {e.noCount} No</span>
              </div>
            </div>
            {e.totalResponses > 0 && (
              <p class="text-xs text-gray-600 mt-2">
                📊 {e.totalResponses} responses · {e.totalGuests} additional guests expected (total attendance: {e.yesCount + e.totalGuests})
              </p>
            )}
          </div>
          {e.rsvps.length > 0 && (
            <div class="divide-y divide-gray-100">
              {e.rsvps.map(r => (
                <div class="p-3 flex items-center justify-between">
                  <div>
                    <div class="text-sm font-medium text-gray-900">{r.user?.name || 'Unknown'}</div>
                    <div class="text-xs text-gray-500">{r.user?.email}</div>
                    {r.notes && <div class="text-xs text-gray-600 italic mt-1">"{r.notes}"</div>}
                  </div>
                  <div class="flex items-center gap-2">
                    {r.numberOfGuests > 0 && r.response === 'yes' && <span class="text-xs text-gray-600">+{r.numberOfGuests} guest{r.numberOfGuests !== 1 ? 's' : ''}</span>}
                    <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${responseColors[r.response]}`}>{r.response}</span>
                    <button onclick={`deleteRsvp(${r.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.deleteRsvp = async function(id) {
      if (!confirm('Delete this RSVP response?')) return;
      await fetch('/api/dashboard/rsvp', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
  })();`} />
</DashboardLayout>
