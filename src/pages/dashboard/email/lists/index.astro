---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { emailLists } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const lists = await db.select().from(emailLists).where(eq(emailLists.schoolId, schoolId)).all();
---

<DashboardLayout title="Lists - Email Marketing">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div><h2 class="text-2xl font-bold text-gray-900">Subscriber Lists</h2><p class="text-sm text-gray-500 mt-1">{lists.length} lists</p></div>
      <button onclick="document.getElementById('listModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New List</button>
    </div>

    {lists.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {lists.map(l => (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-semibold text-gray-900">{l.name}</h3>
              <span class="text-xs text-gray-500">{l.subscriberCount || 0} subs</span>
            </div>
            {l.description && <p class="text-xs text-gray-500 mb-3">{l.description}</p>}
            <div class="flex gap-2">
              <a href={`/dashboard/email/subscribers?list=${l.id}`} class="text-xs text-primary-600 font-medium">View Subscribers</a>
              <button onclick={`deleteList(${l.id})`} class="text-xs text-red-600 font-medium">Delete</button>
            </div>
          </div>
        ))}
      </div>
    ) : (<div class="bg-white rounded-xl border border-gray-200 p-12 text-center"><p class="text-lg font-semibold text-gray-900 mb-2">No lists yet</p><p class="text-sm text-gray-500 mb-4">Create lists to organize your subscribers.</p><button onclick="document.getElementById('listModal').classList.remove('hidden')" class="inline-block px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create List</button></div>)}
  </div>

  <div id="listModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New Subscriber List</h3>
      <form id="listForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">List Name *</label><input name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. Parents" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><input name="description" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2"><button type="button" onclick="document.getElementById('listModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button><button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create</button></div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    document.getElementById('listForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create_list', name: fd.get('name'), description: fd.get('description') }) });
      if (res.ok) window.location.reload();
    });
    window.deleteList = async function(id) {
      if (!confirm('Delete this list? Subscribers will not be deleted.')) return;
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_list', listId: id }) });
      if (res.ok) window.location.reload();
    };
  })();`} />
</DashboardLayout>
