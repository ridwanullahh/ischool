---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../lib/school.js';
import { getDb } from '../../../lib/db/index.js';
import { emailLists, emailSubscribers, emailCampaigns, emailCampaignStats, emailAutomations, emailTemplates } from '../../../lib/db/schema.js';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const totalSubs = await db.select({ c: sql<number>`count(*)` }).from(emailSubscribers).where(eq(emailSubscribers.schoolId, schoolId)).get()?.c || 0;
const activeSubs = await db.select({ c: sql<number>`count(*)` }).from(emailSubscribers).where(and(eq(emailSubscribers.schoolId, schoolId), eq(emailSubscribers.status, 'active'))).get()?.c || 0;
const campaigns = await db.select().from(emailCampaigns).where(eq(emailCampaigns.schoolId, schoolId)).orderBy(desc(emailCampaigns.createdAt)).limit(5).all();
const totalSent = campaigns.filter(c => c.status === 'sent').length;
const lists = await db.select().from(emailLists).where(eq(emailLists.schoolId, schoolId)).all();
const automations = await db.select().from(emailAutomations).where(eq(emailAutomations.schoolId, schoolId)).all();
const templates = await db.select().from(emailTemplates).where(eq(emailTemplates.schoolId, schoolId)).all();

import { and } from 'drizzle-orm';
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const statusColors: Record<string, string> = { draft: 'bg-gray-100 text-gray-600', sent: 'bg-green-100 text-green-700', scheduled: 'bg-blue-100 text-blue-700' };
---

<DashboardLayout title="Email Marketing - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Email Marketing</h2>
        <p class="text-sm text-gray-500 mt-1">Create campaigns, manage subscribers, and track performance.</p>
      </div>
      <a href="/dashboard/email/campaigns/new" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Campaign</a>
    </div>

    <!-- Quick Nav Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/dashboard/email/campaigns" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-primary-300 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center mb-3"><svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
        <p class="text-sm font-semibold text-gray-900">Campaigns</p>
        <p class="text-xs text-gray-500 mt-1">{campaigns.length} total, {totalSent} sent</p>
      </a>
      <a href="/dashboard/email/subscribers" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-primary-300 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center mb-3"><svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>
        <p class="text-sm font-semibold text-gray-900">Subscribers</p>
        <p class="text-xs text-gray-500 mt-1">{totalSubs} total, {activeSubs} active</p>
      </a>
      <a href="/dashboard/email/lists" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-primary-300 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center mb-3"><svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg></div>
        <p class="text-sm font-semibold text-gray-900">Lists</p>
        <p class="text-xs text-gray-500 mt-1">{lists.length} lists</p>
      </a>
      <a href="/dashboard/email/automations" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-primary-300 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center mb-3"><svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
        <p class="text-sm font-semibold text-gray-900">Automations</p>
        <p class="text-xs text-gray-500 mt-1">{automations.length} workflows</p>
      </a>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Total Subscribers</p><p class="text-2xl font-bold text-gray-900 mt-1">{totalSubs}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Active</p><p class="text-2xl font-bold text-green-600 mt-1">{activeSubs}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Campaigns Sent</p><p class="text-2xl font-bold text-blue-600 mt-1">{totalSent}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Templates</p><p class="text-2xl font-bold text-purple-600 mt-1">{templates.length}</p></div>
    </div>

    <!-- Recent Campaigns -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-gray-900">Recent Campaigns</h3>
        <a href="/dashboard/email/campaigns" class="text-xs text-primary-600 font-medium">View all</a>
      </div>
      {campaigns.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="border-b text-left text-xs text-gray-500 uppercase"><th class="pb-2 pr-4">Name</th><th class="pb-2 pr-4">Subject</th><th class="pb-2 pr-4">Status</th><th class="pb-2 pr-4">Date</th></tr></thead>
            <tbody>
              {campaigns.map(c => (
                <tr class="border-b">
                  <td class="py-3 pr-4 font-medium text-gray-900">{c.name}</td>
                  <td class="py-3 pr-4 text-gray-600 max-w-xs truncate">{c.subject || '—'}</td>
                  <td class="py-3 pr-4"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[c.status] || 'bg-gray-100 text-gray-600'}`}>{c.status}</span></td>
                  <td class="py-3 pr-4 text-xs text-gray-500">{formatDate(c.sentAt || c.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (<p class="text-sm text-gray-500 text-center py-8">No campaigns yet. <a href="/dashboard/email/campaigns/new" class="text-primary-600 font-medium">Create your first campaign</a>.</p>)}
    </div>
  </div>
</DashboardLayout>
