---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import RichTextEditor from '../../../../components/RichTextEditor.astro';
import { getUserSchoolId, getUserSchool } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { emailCampaigns, emailLists, emailTemplates } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const school = getUserSchool(user.id);
const db = getDb();

const lists = db.select().from(emailLists).where(eq(emailLists.schoolId, schoolId)).all();
const templates = db.select().from(emailTemplates).where(eq(emailTemplates.schoolId, schoolId)).all();
const editId = Astro.url.searchParams.get('edit');
let editing: any = null;
if (editId) {
  editing = db.select().from(emailCampaigns).where(eq(emailCampaigns.id, Number(editId))).get();
}
---

<DashboardLayout title={editing ? 'Edit Campaign' : 'New Campaign'}>
  <div class="space-y-6 max-w-4xl">
    <div class="flex items-center gap-3">
      <a href="/dashboard/email/campaigns" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>Back</a>
      <h2 class="text-2xl font-bold text-gray-900">{editing ? 'Edit Campaign' : 'New Campaign'}</h2>
    </div>

    <form id="campaignForm" class="space-y-5">
      <input type="hidden" name="action" value="save_campaign" />
      {editing && <input type="hidden" name="campaignId" value={editing.id} />}

      <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Campaign Name *</label><input name="name" required value={editing?.name || ''} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Send to List</label><select name="listId" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm"><option value="">All subscribers</option>{lists.map(l => <option value={l.id} selected={editing?.listId === l.id}>{l.name} ({l.subscriberCount || 0})</option>)}</select></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">From Name</label><input name="fromName" value={editing?.fromName || school?.name || ''} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">From Email</label><input name="fromEmail" type="email" value={editing?.fromEmail || ''} placeholder="noreply@school.edu" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Campaign Type</label><select name="type" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm"><option value="regular" selected={editing?.type === 'regular' || !editing}>Regular</option><option value="automated" selected={editing?.type === 'automated'}>Automated</option><option value="ab_test" selected={editing?.type === 'ab_test'}>A/B Test</option></select></div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
        <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Subject Line *</label><input name="subject" required value={editing?.subject || ''} class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" placeholder="Enter email subject..." /></div>
        <div class="flex gap-2">
          <button type="button" onclick="aiSubject()" class="px-3 py-1.5 text-xs font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-700 flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>AI Subject</button>
          <span id="subjectStatus" class="text-xs text-gray-400 self-center"></span>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-sm font-medium text-gray-700">Email Content *</label>
            <button type="button" onclick="aiContent()" class="px-3 py-1.5 text-xs font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-700 flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>AI Generate</button>
          </div>
          <RichTextEditor name="htmlContent" value={editing?.htmlContent || ''} id="email-content-editor" placeholder="Write your email content... Use {first_name} for personalization." schoolSlug={school?.slug || ''} />
        </div>
        <div id="aiStatus" class="hidden text-xs"></div>

        {templates.length > 0 && (
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Load Template</label><select id="templateSelect" onchange="loadTemplate()" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm"><option value="">Choose a template...</option>{templates.map(t => <option value={t.id}>{t.name}</option>)}</select></div>
        )}
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Schedule (optional)</label>
        <input name="scheduledAt" type="datetime-local" value={editing?.scheduledAt || ''} class="w-full max-w-xs px-3 py-2.5 border border-gray-300 rounded-lg text-sm" />
        <p class="text-xs text-gray-500 mt-1">Leave empty to save as draft. Set a date to schedule.</p>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="px-6 py-2.5 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Save Campaign</button>
        <a href="/dashboard/email/campaigns" class="px-6 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">Cancel</a>
      </div>
    </form>
  </div>

  <script is:inline set:html={`(function(){
    var form = document.getElementById('campaignForm');
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(form);
      var data = {};
      fd.forEach(function(v, k) { data[k] = v; });
      data.action = 'save_campaign';
      if (data.listId) data.listId = Number(data.listId);
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      var result = await res.json();
      if (result.success) window.location.href = '/dashboard/email/campaigns';
      else alert('Error: ' + (result.error || 'Failed'));
    });

    window.aiSubject = async function() {
      var s = document.getElementById('subjectStatus');
      s.textContent = 'Generating...';
      var name = form.querySelector('[name="name"]').value || 'school newsletter';
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'ai_subject', prompt: name }) });
      var data = await res.json();
      if (data.subject) { form.querySelector('[name="subject"]').value = data.subject; s.textContent = 'Done!'; }
      else s.textContent = 'Error';
    };

    window.aiContent = async function() {
      var status = document.getElementById('aiStatus');
      status.className = 'text-xs text-blue-600'; status.textContent = 'AI generating content...'; status.classList.remove('hidden');
      var subject = form.querySelector('[name="subject"]').value || 'school update';
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'ai_generate', prompt: subject }) });
      var data = await res.json();
      if (data.success) {
        var editor = document.getElementById('email-content-editor-editor');
        if (editor) { editor.innerHTML = data.content; document.getElementById('email-content-editor-hidden').value = data.content; }
        status.className = 'text-xs text-green-600'; status.textContent = 'AI content generated!';
      } else { status.className = 'text-xs text-red-600'; status.textContent = 'Error: ' + (data.error || 'AI not configured'); }
    };

    window.loadTemplate = async function() {
      var id = document.getElementById('templateSelect').value;
      if (!id) return;
      var res = await fetch('/api/dashboard/email?type=templates');
      var data = await res.json();
      var tpl = data.find(function(t) { return t.id == id; });
      if (tpl) {
        var editor = document.getElementById('email-content-editor-editor');
        if (editor) { editor.innerHTML = tpl.htmlContent; document.getElementById('email-content-editor-hidden').value = tpl.htmlContent; }
      }
    };
  })();`} />
</DashboardLayout>
