---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { emailCampaigns } from '../../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const campaigns = await db.select().from(emailCampaigns).where(eq(emailCampaigns.schoolId, schoolId)).orderBy(desc(emailCampaigns.createdAt)).all();
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const statusColors: Record<string, string> = { draft: 'bg-gray-100 text-gray-600', sent: 'bg-green-100 text-green-700', scheduled: 'bg-blue-100 text-blue-700', sending: 'bg-amber-100 text-amber-700' };
---

<DashboardLayout title="Campaigns - Email Marketing">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div><h2 class="text-2xl font-bold text-gray-900">Campaigns</h2><p class="text-sm text-gray-500 mt-1">Manage all your email campaigns.</p></div>
      <a href="/dashboard/email/campaigns/new" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Campaign</a>
    </div>

    {campaigns.length > 0 ? (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
            <th class="px-6 py-3">Name</th><th class="px-6 py-3">Subject</th><th class="px-6 py-3">Type</th>
            <th class="px-6 py-3">Status</th><th class="px-6 py-3">Sent Date</th><th class="px-6 py-3">Actions</th>
          </tr></thead>
          <tbody class="divide-y divide-gray-200">
            {campaigns.map(c => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">{c.name}</td>
                <td class="px-6 py-4 text-gray-600 max-w-xs truncate">{c.subject || '—'}</td>
                <td class="px-6 py-4 text-gray-600 capitalize">{c.type || 'regular'}</td>
                <td class="px-6 py-4"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[c.status] || 'bg-gray-100 text-gray-600'}`}>{c.status}</span></td>
                <td class="px-6 py-4 text-xs text-gray-500">{formatDate(c.sentAt || c.createdAt)}</td>
                <td class="px-6 py-4">
                  {c.status === 'draft' ? (
                    <div class="flex gap-2">
                      <button onclick={`sendCampaign(${c.id})`} class="text-xs text-green-600 hover:text-green-700 font-medium">Send</button>
                      <a href={`/dashboard/email/campaigns/${c.id}`} class="text-xs text-primary-600 hover:text-primary-700 font-medium">Edit</a>
                      <button onclick={`deleteCampaign(${c.id})`} class="text-xs text-red-600 hover:text-red-700 font-medium">Delete</button>
                    </div>
                  ) : (
                    <a href={`/dashboard/email/analytics?id=${c.id}`} class="text-xs text-primary-600 font-medium">View Stats</a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <p class="text-lg font-semibold text-gray-900 mb-2">No campaigns yet</p>
        <p class="text-sm text-gray-500 mb-4">Create your first email campaign to get started.</p>
        <a href="/dashboard/email/campaigns/new" class="inline-block px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create Campaign</a>
      </div>
    )}
  </div>

  <script is:inline set:html={`(function(){
    window.sendCampaign = async function(id) {
      if (!confirm('Send this campaign to all subscribers? This cannot be undone.')) return;
      var btn = event.target;
      btn.textContent = 'Sending...';
      btn.disabled = true;
      try {
        var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'send_campaign', campaignId: id }) });
        var data = await res.json();
        if (data.success) { alert('Sent: ' + data.sent + ' emails, ' + data.failed + ' failed'); window.location.reload(); }
        else alert('Error: ' + (data.error || 'Failed'));
      } catch(e) { alert('Error: ' + e.message); }
      btn.textContent = 'Send'; btn.disabled = false;
    };
    window.deleteCampaign = async function(id) {
      if (!confirm('Delete this campaign?')) return;
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_campaign', campaignId: id }) });
      if (res.ok) window.location.reload();
    };
  })();`} />
</DashboardLayout>
