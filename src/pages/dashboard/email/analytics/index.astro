---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { emailCampaigns, emailCampaignStats } from '../../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const campaignId = Astro.url.searchParams.get('id');
let campaign: any = null;
let stats: any = null;

if (campaignId) {
  campaign = db.select().from(emailCampaigns).where(eq(emailCampaigns.id, Number(campaignId))).get();
  stats = db.select().from(emailCampaignStats).where(eq(emailCampaignStats.campaignId, Number(campaignId))).get();
}

const allCampaigns = db.select().from(emailCampaigns).where(eq(emailCampaigns.schoolId, schoolId)).orderBy(desc(emailCampaigns.createdAt)).all();
const allStats = db.select().from(emailCampaignStats).all();
const totalSent = allStats.reduce((sum, s) => sum + (s.sent || 0), 0);
const totalOpens = allStats.reduce((sum, s) => sum + (s.uniqueOpens || 0), 0);
const totalClicks = allStats.reduce((sum, s) => sum + (s.uniqueClicks || 0), 0);
const openRate = totalSent > 0 ? Math.round((totalOpens / totalSent) * 100) : 0;
const clickRate = totalSent > 0 ? Math.round((totalClicks / totalSent) * 100) : 0;
---

<DashboardLayout title="Analytics - Email Marketing">
  <div class="space-y-6">
    <div><h2 class="text-2xl font-bold text-gray-900">Analytics</h2><p class="text-sm text-gray-500 mt-1">Track your email marketing performance.</p></div>

    <!-- Overall Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Total Sent</p><p class="text-2xl font-bold text-gray-900 mt-1">{totalSent}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Open Rate</p><p class="text-2xl font-bold text-green-600 mt-1">{openRate}%</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Click Rate</p><p class="text-2xl font-bold text-blue-600 mt-1">{clickRate}%</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase tracking-wider">Campaigns</p><p class="text-2xl font-bold text-purple-600 mt-1">{allCampaigns.length}</p></div>
    </div>

    {campaign && stats ? (
      <!-- Single Campaign Stats -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-base font-semibold text-gray-900 mb-4">Campaign: {campaign.name}</h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          <div class="text-center"><p class="text-2xl font-bold text-gray-900">{stats.sent || 0}</p><p class="text-xs text-gray-500">Sent</p></div>
          <div class="text-center"><p class="text-2xl font-bold text-green-600">{stats.delivered || 0}</p><p class="text-xs text-gray-500">Delivered</p></div>
          <div class="text-center"><p class="text-2xl font-bold text-blue-600">{stats.uniqueOpens || 0}</p><p class="text-xs text-gray-500">Opens</p></div>
          <div class="text-center"><p class="text-2xl font-bold text-purple-600">{stats.uniqueClicks || 0}</p><p class="text-xs text-gray-500">Clicks</p></div>
          <div class="text-center"><p class="text-2xl font-bold text-red-600">{stats.bounces || 0}</p><p class="text-xs text-gray-500">Bounces</p></div>
        </div>
      </div>
    ) : (
      <!-- Campaign Performance Table -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-base font-semibold text-gray-900 mb-4">Campaign Performance</h3>
        {allCampaigns.filter(c => c.status === 'sent').length > 0 ? (
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Campaign</th><th class="px-4 py-3">Sent</th><th class="px-4 py-3">Opens</th><th class="px-4 py-3">Clicks</th><th class="px-4 py-3">Bounces</th></tr></thead>
            <tbody class="divide-y divide-gray-200">
              {allCampaigns.filter(c => c.status === 'sent').map(c => {
                const s = allStats.find(st => st.campaignId === c.id);
                return (
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium text-gray-900">{c.name}</td>
                    <td class="px-4 py-3 text-gray-600">{s?.sent || 0}</td>
                    <td class="px-4 py-3 text-green-600">{s?.uniqueOpens || 0}</td>
                    <td class="px-4 py-3 text-blue-600">{s?.uniqueClicks || 0}</td>
                    <td class="px-4 py-3 text-red-600">{s?.bounces || 0}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ) : (<p class="text-sm text-gray-500 text-center py-8">No sent campaigns to analyze yet.</p>)}
      </div>
    )}
  </div>
</DashboardLayout>
