---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { emailAutomations } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const automations = await db.select().from(emailAutomations).where(eq(emailAutomations.schoolId, schoolId)).all();
---

<DashboardLayout title="Automations - Email Marketing">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div><h2 class="text-2xl font-bold text-gray-900">Automation Workflows</h2><p class="text-sm text-gray-500 mt-1">Set up automated email sequences.</p></div>
      <button onclick="document.getElementById('autoModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Automation</button>
    </div>

    {automations.length > 0 ? (
      <div class="space-y-3">
        {automations.map(a => (
          <div class="bg-white rounded-xl border border-gray-200 p-5 flex items-center justify-between">
            <div><h3 class="font-semibold text-gray-900">{a.name}</h3><p class="text-xs text-gray-500 mt-1">Trigger: {a.trigger || 'manual'} | Status: <span class={a.status === 'active' ? 'text-green-600' : 'text-gray-400'}>{a.status}</span></p></div>
            <div class="flex gap-2"><button class="text-xs text-primary-600 font-medium">Edit</button><button onclick={`toggleAuto(${a.id}, '${a.status}')`} class="text-xs text-amber-600 font-medium">{a.status === 'active' ? 'Pause' : 'Activate'}</button></div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <p class="text-lg font-semibold text-gray-900 mb-2">No automations yet</p>
        <p class="text-sm text-gray-500 mb-4">Create automated email workflows like welcome series, birthday emails, or fee reminders.</p>
        <button onclick="document.getElementById('autoModal').classList.remove('hidden')" class="inline-block px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create Automation</button>
      </div>
    )}

    <!-- Quick Templates -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Quick Setup Templates</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <button onclick="quickSetup('welcome')" class="text-left p-4 border rounded-lg hover:border-primary-300 hover:bg-primary-50/30 transition-colors"><p class="text-sm font-medium text-gray-900">Welcome Series</p><p class="text-xs text-gray-500 mt-1">Send a welcome email when someone subscribes</p></button>
        <button onclick="quickSetup('birthday')" class="text-left p-4 border rounded-lg hover:border-primary-300 hover:bg-primary-50/30 transition-colors"><p class="text-sm font-medium text-gray-900">Birthday Wishes</p><p class="text-xs text-gray-500 mt-1">Automatically send birthday greetings</p></button>
        <button onclick="quickSetup('fee_reminder')" class="text-left p-4 border rounded-lg hover:border-primary-300 hover:bg-primary-50/30 transition-colors"><p class="text-sm font-medium text-gray-900">Fee Payment Reminder</p><p class="text-xs text-gray-500 mt-1">Remind parents about upcoming fee due dates</p></button>
        <button onclick="quickSetup('reengage')" class="text-left p-4 border rounded-lg hover:border-primary-300 hover:bg-primary-50/30 transition-colors"><p class="text-sm font-medium text-gray-900">Re-engagement</p><p class="text-xs text-gray-500 mt-1">Win back inactive subscribers</p></button>
      </div>
    </div>
  </div>

  <div id="autoModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New Automation</h3>
      <form id="autoForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Name *</label><input name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. Welcome Series" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Trigger</label><select name="trigger" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="new_subscriber">New Subscriber</option><option value="birthday">Birthday</option><option value="fee_due">Fee Due</option><option value="manual">Manual</option></select></div>
        <div class="flex gap-3 pt-2"><button type="button" onclick="document.getElementById('autoModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button><button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create</button></div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    document.getElementById('autoForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create_automation', name: fd.get('name'), trigger: fd.get('trigger') }) });
      if (res.ok) window.location.reload();
    });
    window.toggleAuto = async function(id, status) {
      var newStatus = status === 'active' ? 'paused' : 'active';
      await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'toggle_automation', automationId: id, status: newStatus }) });
      window.location.reload();
    };
    window.quickSetup = function(type) {
      var names = { welcome: 'Welcome Series', birthday: 'Birthday Wishes', fee_reminder: 'Fee Payment Reminder', reengage: 'Re-engagement Campaign' };
      var triggers = { welcome: 'new_subscriber', birthday: 'birthday', fee_reminder: 'fee_due', reengage: 'manual' };
      document.querySelector('[name="name"]').value = names[type];
      document.querySelector('[name="trigger"]').value = triggers[type];
      document.getElementById('autoModal').classList.remove('hidden');
    };
  })();`} />
</DashboardLayout>
