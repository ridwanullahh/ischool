---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { emailSubscribers, emailLists } from '../../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const subscribers = await db.select().from(emailSubscribers).where(eq(emailSubscribers.schoolId, schoolId)).orderBy(desc(emailSubscribers.createdAt)).all();
const lists = await db.select().from(emailLists).where(eq(emailLists.schoolId, schoolId)).all();
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const statusColors: Record<string, string> = { active: 'bg-green-100 text-green-700', unsubscribed: 'bg-red-100 text-red-700', bounced: 'bg-amber-100 text-amber-700' };
const getListName = (id: number) => lists.find(l => l.id === id)?.name || 'All';
---

<DashboardLayout title="Subscribers - Email Marketing">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div><h2 class="text-2xl font-bold text-gray-900">Subscribers</h2><p class="text-sm text-gray-500 mt-1">{subscribers.length} total subscribers</p></div>
      <div class="flex gap-2">
        <button onclick="document.getElementById('importModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Import</button>
        <button onclick="document.getElementById('addModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Add Subscriber</button>
      </div>
    </div>

    {subscribers.length > 0 ? (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-6 py-3">Email</th><th class="px-6 py-3">Name</th><th class="px-6 py-3">List</th><th class="px-6 py-3">Status</th><th class="px-6 py-3">Joined</th><th class="px-6 py-3">Engagement</th></tr></thead>
          <tbody class="divide-y divide-gray-200">
            {subscribers.map(s => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">{s.email}</td>
                <td class="px-6 py-4 text-gray-600">{s.firstName || ''} {s.lastName || ''}</td>
                <td class="px-6 py-4 text-gray-600">{s.listId ? getListName(s.listId) : 'All'}</td>
                <td class="px-6 py-4"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[s.status] || 'bg-gray-100 text-gray-600'}`}>{s.status}</span></td>
                <td class="px-6 py-4 text-xs text-gray-500">{formatDate(s.subscribedAt || s.createdAt)}</td>
                <td class="px-6 py-4"><div class="flex items-center gap-2"><div class="w-16 h-1.5 bg-gray-200 rounded-full"><div class="h-full bg-primary-600 rounded-full" style={`width:${Math.min((s.engagementScore || 0), 100)}%`}></div></div><span class="text-xs text-gray-500">{s.engagementScore || 0}</span></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (<div class="bg-white rounded-xl border border-gray-200 p-12 text-center"><p class="text-lg font-semibold text-gray-900 mb-2">No subscribers yet</p><p class="text-sm text-gray-500 mb-4">Import or add subscribers to get started.</p><button onclick="document.getElementById('importModal').classList.remove('hidden')" class="inline-block px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Import Subscribers</button></div>)}
  </div>

  <!-- Add Modal -->
  <div id="addModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Add Subscriber</h3>
      <form id="addForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Email *</label><input name="email" type="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-gray-700 mb-1">First Name</label><input name="firstName" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div><div><label class="block text-xs font-medium text-gray-700 mb-1">Last Name</label><input name="lastName" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">List</label><select name="listId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="">All subscribers</option>{lists.map(l => <option value={l.id}>{l.name}</option>)}</select></div>
        <div class="flex gap-3 pt-2"><button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button><button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Add</button></div>
      </form>
    </div>
  </div>

  <!-- Import Modal -->
  <div id="importModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Import Subscribers</h3>
      <form id="importForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">List</label><select name="listId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="">All subscribers</option>{lists.map(l => <option value={l.id}>{l.name}</option>)}</select></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Emails (one per line or comma-separated)</label><textarea name="emails" rows="6" placeholder="email1@example.com&#10;email2@example.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono"></textarea></div>
        <div class="flex gap-3 pt-2"><button type="button" onclick="document.getElementById('importModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button><button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Import</button></div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    document.getElementById('addForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'add_subscriber', email: fd.get('email'), firstName: fd.get('firstName'), lastName: fd.get('lastName'), listId: fd.get('listId') ? Number(fd.get('listId')) : null }) });
      if (res.ok) window.location.reload();
    });
    document.getElementById('importForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var emails = fd.get('emails').split(/[\\n,]/).map(function(s) { return s.trim(); }).filter(Boolean);
      var subscribers = emails.map(function(e) { return { email: e }; });
      var res = await fetch('/api/dashboard/email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'add_subscribers', listId: fd.get('listId') ? Number(fd.get('listId')) : null, subscribers: subscribers }) });
      var data = await res.json();
      if (data.success) { alert('Imported ' + data.added + ' subscribers'); window.location.reload(); }
      else alert('Error: ' + (data.error || 'Failed'));
    });
  })();`} />
</DashboardLayout>
