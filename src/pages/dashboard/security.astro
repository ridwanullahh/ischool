---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { auditLogs, users, sessions, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// Recent audit logs
const recentLogs = await db.select().from(auditLogs).where(eq(auditLogs.schoolId, schoolId)).orderBy(desc(auditLogs.createdAt)).limit(50).all();

// Active sessions
const activeSessions = await db.select({ count: sql<number>`count(*)` }).from(sessions).all()[0]?.count || 0;

// Total users
const schoolUserIds = await db.select({ userId: schoolMembers.userId }).from(schoolMembers).where(eq(schoolMembers.schoolId, schoolId)).all().map(m => m.userId);
const totalUsers = schoolUserIds.length;

// Failed logins (from audit logs filtered by action containing 'login_failed')
const failedLogins = recentLogs.filter((l: any) => l.action && l.action.includes('login_failed')).length;

const fmtDate = (d: any) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
const actionColors: Record<string, string> = {
  create: 'bg-green-100 text-green-700', update: 'bg-blue-100 text-blue-700',
  delete: 'bg-red-100 text-red-700', login: 'bg-purple-100 text-purple-700',
  login_failed: 'bg-red-100 text-red-700', logout: 'bg-gray-100 text-gray-700',
};
---

<DashboardLayout title="Security - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Security & Audit</h2>
      <p class="text-sm text-gray-500 mt-1">Audit log, login activity, suspicious activity alerts, and security configuration.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Users</div><div class="text-2xl font-bold">{totalUsers}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Active Sessions</div><div class="text-2xl font-bold text-green-600">{activeSessions}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Failed Logins (recent)</div><div class="text-2xl font-bold text-red-600">{failedLogins}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Audit Logs (recent)</div><div class="text-2xl font-bold text-blue-600">{recentLogs.length}</div></div>
    </div>

    {/* Security recommendations */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">🛡️ Security Posture</h3>
      <div class="space-y-2">
        <div class="flex items-center gap-3 p-3 bg-green-50 rounded">
          <span class="text-green-600">✓</span>
          <div class="flex-1"><div class="text-sm font-medium text-gray-900">Password Hashing</div><div class="text-xs text-gray-500">Passwords stored using bcrypt with salt</div></div>
          <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-green-100 text-green-700">Active</span>
        </div>
        <div class="flex items-center gap-3 p-3 bg-green-50 rounded">
          <span class="text-green-600">✓</span>
          <div class="flex-1"><div class="text-sm font-medium text-gray-900">Session Management</div><div class="text-xs text-gray-500">HTTP-only secure cookies with expiry</div></div>
          <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-green-100 text-green-700">Active</span>
        </div>
        <div class="flex items-center gap-3 p-3 bg-amber-50 rounded">
          <span class="text-amber-600">⚠</span>
          <div class="flex-1"><div class="text-sm font-medium text-gray-900">Two-Factor Authentication (2FA)</div><div class="text-xs text-gray-500">Optional per-user — encourage admins to enable</div></div>
          <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-700">Optional</span>
        </div>
        <div class="flex items-center gap-3 p-3 bg-green-50 rounded">
          <span class="text-green-600">✓</span>
          <div class="flex-1"><div class="text-sm font-medium text-gray-900">Audit Logging</div><div class="text-xs text-gray-500">All create/update/delete actions recorded</div></div>
          <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-green-100 text-green-700">Active</span>
        </div>
        <div class="flex items-center gap-3 p-3 bg-green-50 rounded">
          <span class="text-green-600">✓</span>
          <div class="flex-1"><div class="text-sm font-medium text-gray-900">School-Level Data Isolation</div><div class="text-xs text-gray-500">Multi-tenant — every query scoped by schoolId</div></div>
          <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-green-100 text-green-700">Active</span>
        </div>
        <div class="flex items-center gap-3 p-3 bg-amber-50 rounded">
          <span class="text-amber-600">⚠</span>
          <div class="flex-1"><div class="text-sm font-medium text-gray-900">GDPR Data Export & Deletion</div><div class="text-xs text-gray-500">Data export available; right-to-be-forgotten requires admin action</div></div>
          <span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-700">Partial</span>
        </div>
      </div>
    </div>

    {/* Audit log */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b flex items-center justify-between">
        <h3 class="font-semibold text-gray-900">Audit Log (Last 50 Events)</h3>
        <input id="searchInput" type="text" placeholder="Filter logs…" class="px-3 py-1.5 border rounded text-xs" oninput="filterLogs()" />
      </div>
      {recentLogs.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No audit events recorded yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Time</th><th class="px-4 py-3">User</th>
              <th class="px-4 py-3">Action</th><th class="px-4 py-3">Entity</th>
              <th class="px-4 py-3">IP</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {recentLogs.map(l => (
                <tr class="hover:bg-gray-50 log-row" data-search={`${l.userId || ''} ${l.action || ''} ${l.entityType || ''}`.toLowerCase()}>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(l.createdAt)}</td>
                  <td class="px-4 py-3 text-gray-700">User #{l.userId || '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${actionColors[l.action] || 'bg-gray-100 text-gray-700'}`}>{l.action || '—'}</span></td>
                  <td class="px-4 py-3 text-gray-700">{l.entityType || '—'} {l.entityId ? `#${l.entityId}` : ''}</td>
                  <td class="px-4 py-3 text-gray-500 text-xs">{l.ipAddress || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.filterLogs = function() {
      var q = document.getElementById('searchInput').value.toLowerCase();
      document.querySelectorAll('.log-row').forEach(function(row) {
        row.style.display = !q || row.dataset.search.indexOf(q) >= 0 ? '' : 'none';
      });
    };
  })();`} />
</DashboardLayout>
