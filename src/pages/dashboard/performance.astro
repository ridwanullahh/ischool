---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { performanceAppraisals, staff, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allStaff = await db.select({ id: staff.id, firstName: staff.firstName, lastName: staff.lastName, staffId: staff.staffId, designation: staff.designation, department: staff.department })
  .from(staff).where(eq(staff.schoolId, schoolId)).all();

const appraisals = await db.select({
  id: performanceAppraisals.id, staffId: performanceAppraisals.staffId,
  cycle: performanceAppraisals.cycle, type: performanceAppraisals.type,
  kpis: performanceAppraisals.kpis, strengths: performanceAppraisals.strengths,
  improvements: performanceAppraisals.improvements, goals: performanceAppraisals.goals,
  overallRating: performanceAppraisals.overallRating, status: performanceAppraisals.status,
  createdAt: performanceAppraisals.createdAt,
  staffName: staff.firstName, staffLastName: staff.lastName, staffCode: staff.staffId,
  designation: staff.designation, department: staff.department,
}).from(performanceAppraisals)
  .leftJoin(staff, eq(performanceAppraisals.staffId, staff.id))
  .where(eq(performanceAppraisals.schoolId, schoolId))
  .orderBy(desc(performanceAppraisals.createdAt)).all();

const stats = {
  total: appraisals.length,
  pending: appraisals.filter(a => a.status === 'pending').length,
  completed: appraisals.filter(a => a.status === 'completed').length,
  avgRating: appraisals.length > 0
    ? (appraisals.filter(a => a.overallRating).reduce((s, a) => s + (a.overallRating || 0), 0) / appraisals.filter(a => a.overallRating).length).toFixed(1)
    : '—',
};

const typeLabels: Record<string, string> = {
  self_assessment: 'Self-Assessment', manager_assessment: 'Manager Assessment', final: 'Final Review',
};
const typeColors: Record<string, string> = {
  self_assessment: 'bg-blue-100 text-blue-700', manager_assessment: 'bg-purple-100 text-purple-700', final: 'bg-emerald-100 text-emerald-700',
};
const statusColors: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-700', submitted: 'bg-blue-100 text-blue-700',
  reviewed: 'bg-purple-100 text-purple-700', completed: 'bg-green-100 text-green-700',
};
const ratingStars = (n: number | null) => n ? '★'.repeat(n) + '☆'.repeat(5 - n) : '—';
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const defaultKpis = [
  'Teaching Quality', 'Student Engagement', 'Punctuality', 'Professional Development', 'Team Collaboration',
];
---

<DashboardLayout title="Performance Appraisals - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Performance Appraisals</h2>
        <p class="text-sm text-gray-500 mt-1">Run appraisal cycles with self-assessment, manager assessment, KPI tracking, and final review.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Appraisal</button>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total</div><div class="text-2xl font-bold">{stats.total}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Pending</div><div class="text-2xl font-bold text-amber-600">{stats.pending}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Completed</div><div class="text-2xl font-bold text-green-600">{stats.completed}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Avg Rating</div><div class="text-2xl font-bold text-amber-500">{stats.avgRating}</div></div>
    </div>

    {/* Appraisals table */}
    <div class="bg-white rounded-xl border border-gray-200">
      {appraisals.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">🎯</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No appraisals yet</h3>
          <p class="text-sm text-gray-500">Start an appraisal cycle for any staff member.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Staff</th><th class="px-4 py-3">Cycle</th>
              <th class="px-4 py-3">Type</th><th class="px-4 py-3">Rating</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Created</th>
              <th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {appraisals.map(a => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{a.staffName} {a.staffLastName}<div class="text-xs text-gray-500">{a.staffCode} · {a.designation || '—'}</div></td>
                  <td class="px-4 py-3 text-gray-700">{a.cycle}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${typeColors[a.type]}`}>{typeLabels[a.type]}</span></td>
                  <td class="px-4 py-3 text-amber-500 font-bold">{ratingStars(a.overallRating)}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[a.status]}`}>{a.status}</span></td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(a.createdAt)}</td>
                  <td class="px-4 py-3">
                    <button onclick={`viewAppraisal(${a.id})`} class="text-xs text-primary-600 font-medium">View</button>
                    <button onclick={`deleteAppraisal(${a.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* New Appraisal Modal */}
  <div id="appraisalModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New Performance Appraisal</h3>
      <form id="appraisalForm" class="space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Staff Member *</label>
            <select name="staffId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="">Select staff…</option>
              {allStaff.map(s => <option value={s.id}>{s.firstName} {s.lastName} ({s.staffId})</option>)}
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Cycle *</label><input name="cycle" required placeholder="e.g. 2025 Annual" value={`${new Date().getFullYear()} Annual`} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Type *</label>
            <select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="self_assessment">Self-Assessment</option>
              <option value="manager_assessment">Manager Assessment</option>
              <option value="final">Final Review</option>
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Overall Rating (1-5)</label>
            <select name="overallRating" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="">—</option>
              <option value="1">1 — Poor</option>
              <option value="2">2 — Below Expectations</option>
              <option value="3">3 — Meets Expectations</option>
              <option value="4">4 — Exceeds Expectations</option>
              <option value="5">5 — Outstanding</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">KPI Ratings</label>
          <p class="text-xs text-gray-500 mb-2">Rate each KPI from 1 (poor) to 5 (outstanding).</p>
          <div id="kpiRows" class="space-y-2">
            {defaultKpis.map(k => (
              <div class="flex items-center gap-2">
                <input type="hidden" name="kpiName" value={k} />
                <span class="flex-1 text-sm text-gray-700">{k}</span>
                <select name="kpiRating" class="px-2 py-1 border border-gray-300 rounded text-xs">
                  <option value="">—</option>
                  <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option>
                </select>
                <input type="text" name="kpiComment" placeholder="Comment" class="flex-1 px-2 py-1 border border-gray-300 rounded text-xs" />
              </div>
            ))}
          </div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Strengths</label><textarea name="strengths" rows="2" placeholder="What is this staff member doing well?" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Areas for Improvement</label><textarea name="improvements" rows="2" placeholder="Where can they grow?" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Goals for Next Cycle</label><textarea name="goals" rows="2" placeholder="Specific, measurable goals" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
          <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="pending">Pending</option>
            <option value="submitted">Submitted</option>
            <option value="reviewed">Reviewed</option>
            <option value="completed">Completed</option>
          </select>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('appraisalModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save Appraisal</button>
        </div>
      </form>
    </div>
  </div>

  {/* View Modal */}
  <div id="viewModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto" id="viewContent"></div>
  </div>

  <script is:inline define:vars={{ appraisals }} set:html={`(function(){
    var allAppraisals = appraisals;
    var typeLabels = { self_assessment: 'Self-Assessment', manager_assessment: 'Manager Assessment', final: 'Final Review' };

    window.openModal = function() { document.getElementById('appraisalModal').classList.remove('hidden'); };
    window.deleteAppraisal = async function(id) {
      if (!confirm('Delete this appraisal?')) return;
      await fetch('/api/dashboard/performance', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.viewAppraisal = function(id) {
      var a = allAppraisals.find(function(x){ return x.id === id; });
      if (!a) return;
      var kpis = [];
      try { kpis = JSON.parse(a.kpis || '[]'); } catch {}
      var html = '<div class="mb-4"><div style="font-size: 20px; font-weight: bold;">' + a.staffName + ' ' + (a.staffLastName || '') + '</div>' +
        '<div style="color: #666; font-size: 12px;">' + (a.designation || '—') + ' · ' + (a.department || '—') + ' · ' + a.staffCode + '</div></div>' +
        '<div class="grid grid-cols-2 gap-4 mb-6">' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Cycle</div><div style="font-weight: bold;">' + a.cycle + '</div></div>' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Type</div><div style="font-weight: bold;">' + (typeLabels[a.type] || a.type) + '</div></div>' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Overall Rating</div><div style="font-weight: bold; color: #f59e0b;">' + (a.overallRating ? '★'.repeat(a.overallRating) + '☆'.repeat(5 - a.overallRating) : '—') + '</div></div>' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Status</div><div style="font-weight: bold; text-transform: capitalize;">' + a.status + '</div></div>' +
        '</div>';
      if (kpis.length > 0) {
        html += '<h4 style="font-weight: bold; margin-bottom: 8px;">KPI Ratings</h4><table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">' +
          '<thead><tr style="background: #f3f4f6;"><th style="padding: 8px; text-align: left; border: 1px solid #e5e7eb;">KPI</th><th style="padding: 8px; border: 1px solid #e5e7eb;">Rating</th><th style="padding: 8px; text-align: left; border: 1px solid #e5e7eb;">Comment</th></tr></thead><tbody>';
        kpis.forEach(function(k) {
          html += '<tr><td style="padding: 8px; border: 1px solid #e5e7eb;">' + (k.kpi || k.name || '—') + '</td>' +
            '<td style="padding: 8px; border: 1px solid #e5e7eb; text-align: center; font-weight: bold;">' + (k.rating || '—') + '/5</td>' +
            '<td style="padding: 8px; border: 1px solid #e5e7eb;">' + (k.comment || '—') + '</td></tr>';
        });
        html += '</tbody></table>';
      }
      if (a.strengths) html += '<div style="margin-bottom: 8px;"><strong>Strengths:</strong> ' + a.strengths + '</div>';
      if (a.improvements) html += '<div style="margin-bottom: 8px;"><strong>Areas for Improvement:</strong> ' + a.improvements + '</div>';
      if (a.goals) html += '<div style="margin-bottom: 8px;"><strong>Goals:</strong> ' + a.goals + '</div>';
      html += '<div class="text-center mt-6"><button onclick="window.print()" class="px-4 py-2 bg-primary-600 text-white rounded text-sm">Print / PDF</button></div>';
      document.getElementById('viewContent').innerHTML = html;
      document.getElementById('viewModal').classList.remove('hidden');
    };

    document.getElementById('appraisalForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      // Build KPI array
      var kpiNames = this.querySelectorAll('[name="kpiName"]');
      var kpiRatings = this.querySelectorAll('[name="kpiRating"]');
      var kpiComments = this.querySelectorAll('[name="kpiComment"]');
      var kpis = [];
      for (var i = 0; i < kpiNames.length; i++) {
        var rating = kpiRatings[i].value;
        if (rating) kpis.push({ kpi: kpiNames[i].value, rating: parseInt(rating), comment: kpiComments[i].value || null });
      }
      var payload = {
        staffId: parseInt(fd.get('staffId')),
        cycle: fd.get('cycle'),
        type: fd.get('type'),
        overallRating: fd.get('overallRating') ? parseInt(fd.get('overallRating')) : null,
        kpis: kpis,
        strengths: fd.get('strengths') || null,
        improvements: fd.get('improvements') || null,
        goals: fd.get('goals') || null,
        status: fd.get('status'),
      };
      var res = await fetch('/api/dashboard/performance', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
