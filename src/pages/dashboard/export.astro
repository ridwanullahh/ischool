---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { students, staff, attendance, invoices, payments, grades, enrollments, classes, courses, schoolMembers } from '../../lib/db/schema.js';
import { eq, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// Counts for each export option
const studentCount = await db.select({ count: sql<number>`count(*)` }).from(students).where(eq(students.schoolId, schoolId)).all()[0]?.count || 0;
const staffCount = await db.select({ count: sql<number>`count(*)` }).from(staff).where(eq(staff.schoolId, schoolId)).all()[0]?.count || 0;
const attendanceCount = await db.select({ count: sql<number>`count(*)` }).from(attendance).where(eq(attendance.schoolId, schoolId)).all()[0]?.count || 0;
const invoiceCount = await db.select({ count: sql<number>`count(*)` }).from(invoices).where(eq(invoices.schoolId, schoolId)).all()[0]?.count || 0;
const paymentCount = await db.select({ count: sql<number>`count(*)` }).from(payments).where(eq(payments.schoolId, schoolId)).all()[0]?.count || 0;
const gradeCount = await db.select({ count: sql<number>`count(*)` }).from(grades).where(eq(grades.schoolId, schoolId)).all()[0]?.count || 0;
const enrollmentCount = await db.select({ count: sql<number>`count(*)` }).from(enrollments).where(eq(enrollments.schoolId, schoolId)).all()[0]?.count || 0;
const classCount = await db.select({ count: sql<number>`count(*)` }).from(classes).where(eq(classes.schoolId, schoolId)).all()[0]?.count || 0;
const courseCount = await db.select({ count: sql<number>`count(*)` }).from(courses).where(eq(courses.schoolId, schoolId)).all()[0]?.count || 0;

const exportOptions = [
  { slug: 'students', label: 'Students', icon: '👨‍🎓', count: studentCount, desc: 'All student records with personal and contact details', api: '/api/dashboard/students?action=export' },
  { slug: 'attendance', label: 'Attendance', icon: '📅', count: attendanceCount, desc: 'Daily and period-based attendance records', api: '/api/dashboard/attendance?action=export' },
  { slug: 'invoices', label: 'Invoices', icon: '💰', count: invoiceCount, desc: 'All invoices with amounts, balances, and status', api: '/api/dashboard/invoices?action=export' },
  { slug: 'library', label: 'Library Books', icon: '📚', count: 0, desc: 'Library catalog with copies and availability', api: '/api/dashboard/library?action=export' },
  { slug: 'hostels', label: 'Hostels', icon: '🛏️', count: 0, desc: 'Hostel buildings and room inventory', api: '/api/dashboard/hostel?action=export' },
];
---

<DashboardLayout title="Data Export - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Data Export Center</h2>
      <p class="text-sm text-gray-500 mt-1">Export school data to CSV format for use in Excel, Google Sheets, or external accounting/reporting tools. GDPR-compliant data portability.</p>
    </div>

    {/* Quick stats */}
    <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
      <div class="bg-white rounded-lg border p-3 text-center">
        <div class="text-2xl font-bold text-blue-600">{studentCount}</div>
        <div class="text-[10px] text-gray-500 uppercase">Students</div>
      </div>
      <div class="bg-white rounded-lg border p-3 text-center">
        <div class="text-2xl font-bold text-purple-600">{staffCount}</div>
        <div class="text-[10px] text-gray-500 uppercase">Staff</div>
      </div>
      <div class="bg-white rounded-lg border p-3 text-center">
        <div class="text-2xl font-bold text-green-600">{attendanceCount}</div>
        <div class="text-[10px] text-gray-500 uppercase">Attendance</div>
      </div>
      <div class="bg-white rounded-lg border p-3 text-center">
        <div class="text-2xl font-bold text-amber-600">{invoiceCount}</div>
        <div class="text-[10px] text-gray-500 uppercase">Invoices</div>
      </div>
      <div class="bg-white rounded-lg border p-3 text-center">
        <div class="text-2xl font-bold text-emerald-600">{paymentCount}</div>
        <div class="text-[10px] text-gray-500 uppercase">Payments</div>
      </div>
      <div class="bg-white rounded-lg border p-3 text-center">
        <div class="text-2xl font-bold text-cyan-600">{gradeCount}</div>
        <div class="text-[10px] text-gray-500 uppercase">Grades</div>
      </div>
    </div>

    {/* Export options grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {exportOptions.map(opt => (
        <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition">
          <div class="flex items-start gap-3 mb-3">
            <div class="text-3xl">{opt.icon}</div>
            <div class="flex-1">
              <h3 class="font-semibold text-gray-900">{opt.label}</h3>
              <p class="text-xs text-gray-500 mt-0.5">{opt.desc}</p>
            </div>
          </div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs text-gray-600">{opt.count.toLocaleString()} record{opt.count !== 1 ? 's' : ''}</span>
            {opt.count === 0 && <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-500">Empty</span>}
          </div>
          <a href={opt.api} class={`block text-center px-4 py-2 text-sm font-medium rounded-lg ${opt.count > 0 ? 'bg-green-600 text-white hover:bg-green-700' : 'bg-gray-100 text-gray-400 pointer-events-none'}`}>
            ⬇ Download CSV
          </a>
        </div>
      ))}
    </div>

    {/* Custom export info */}
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
      <h3 class="text-sm font-semibold text-blue-900 mb-2">📋 Need a Custom Export?</h3>
      <p class="text-sm text-blue-800 mb-3">Use the <a href="/dashboard/report-builder" class="underline font-medium">Report Builder</a> to:</p>
      <ul class="text-sm text-blue-800 space-y-1 ml-4 list-disc">
        <li>Select specific fields to include</li>
        <li>Choose data type (students, staff, attendance, invoices, payments, grades)</li>
        <li>Save report configurations for reuse</li>
        <li>Preview results before downloading</li>
      </ul>
    </div>

    {/* Format reference */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Supported Export Formats</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="border rounded-lg p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl">📄</span>
            <h4 class="font-medium text-gray-900">CSV</h4>
            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-green-100 text-green-700">Available</span>
          </div>
          <p class="text-xs text-gray-600">Comma-separated values. Opens in Excel, Google Sheets, Numbers. Universal format for data interchange.</p>
        </div>
        <div class="border rounded-lg p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl">📊</span>
            <h4 class="font-medium text-gray-900">Excel (XLSX)</h4>
            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-700">Via CSV</span>
          </div>
          <p class="text-xs text-gray-600">Download CSV and open in Excel — it will convert automatically. Save As .xlsx to preserve formatting.</p>
        </div>
        <div class="border rounded-lg p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl">📑</span>
            <h4 class="font-medium text-gray-900">PDF</h4>
            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-700">Per-module</span>
          </div>
          <p class="text-xs text-gray-600">PDF exports available on individual module pages (invoices, report cards, transcripts). Use Print → Save as PDF.</p>
        </div>
      </div>
    </div>

    {/* Compliance note */}
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
      <p class="text-xs text-amber-900">
        <strong>🔒 GDPR / Data Privacy:</strong> Exports contain personal data (names, emails, phone numbers). Handle in accordance with your school's data protection policy. Limit access to authorized personnel only.
      </p>
    </div>
  </div>
</DashboardLayout>
