---
/**
 * Discussion Board Detail - Threaded view
 */
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../lib/school.js';
import { getDb } from '../../../lib/db/index.js';
import { discussionBoards, discussionPosts, courses, users } from '../../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';
import { pageGuard } from '../../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'courses.view')) return Astro.redirect('/dashboard');

const boardId = parseInt(Astro.params.id);
if (!boardId) return Astro.redirect('/dashboard/discussions');

const schoolId = getUserSchoolId(user.id);
const db = getDb();

const board = db.select().from(discussionBoards).where(and(eq(discussionBoards.id, boardId), eq(discussionBoards.schoolId, schoolId || 0))).get();
if (!board) return Astro.redirect('/dashboard/discussions');

const course = board.courseId ? db.select().from(courses).where(eq(courses.id, board.courseId)).get() : null;
const allPosts = db.select().from(discussionPosts).where(eq(discussionPosts.boardId, boardId)).orderBy(desc(discussionPosts.createdAt)).all();

// Enrich with author info
const enrichedPosts = allPosts.map(p => {
  const author = db.select().from(users).where(eq(users.id, p.authorId)).get();
  return { ...p, authorName: author?.name || 'Unknown', authorAvatar: author?.avatarUrl, authorRole: author?.role };
});

// Build thread tree (top-level posts + their replies)
const topPosts = enrichedPosts.filter(p => !p.parentId);
const repliesByParent: Record<number, typeof enrichedPosts> = {};
for (const p of enrichedPosts) {
  if (p.parentId) {
    if (!repliesByParent[p.parentId]) repliesByParent[p.parentId] = [];
    repliesByParent[p.parentId].push(p);
  }
}

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
---

<DashboardLayout title={board.title + ' - Discussion'}>
  <div class="space-y-6">
    <a href="/dashboard/discussions" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Back to Boards
    </a>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            {course && <span class="text-xs font-medium text-primary-600">{course.title}</span>}
            {board.locked && <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-600">LOCKED</span>}
          </div>
          <h1 class="text-2xl font-bold text-gray-900">{board.title}</h1>
          {board.description && <p class="text-sm text-gray-500 mt-1">{board.description}</p>}
        </div>
      </div>
    </div>

    {/* New post form */}
    {!board.locked && (
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Post a Reply</h3>
        <form id="postForm" class="space-y-3">
          <textarea id="postContent" name="content" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Share your thoughts..."></textarea>
          <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Post</button>
        </form>
      </div>
    )}

    {/* Threaded posts */}
    <div class="space-y-4">
      {topPosts.length > 0 ? (
        topPosts.map(post => (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-start gap-3">
              {post.authorAvatar ? <img src={post.authorAvatar} alt={post.authorName} class="w-10 h-10 rounded-full object-cover" /> : <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-sm font-bold text-primary-700">{post.authorName.charAt(0)}</div>}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <p class="text-sm font-medium text-gray-900">{post.authorName}</p>
                  <span class="text-xs text-gray-400 capitalize">{post.authorRole}</span>
                  <span class="text-xs text-gray-400">{formatDate(post.createdAt)}</span>
                </div>
                <p class="text-sm text-gray-700 whitespace-pre-wrap">{post.content}</p>
                <button onclick="toggleReply({post.id})" class="mt-2 text-xs text-primary-600 hover:underline">Reply</button>
                {/* Reply form */}
                <div id="reply-form-{post.id}" class="hidden mt-3">
                  <form data-reply-to={post.id} class="flex items-start gap-2">
                    <textarea name="content" rows="2" required class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Write a reply..."></textarea>
                    <button type="submit" class="px-3 py-2 text-xs font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Reply</button>
                  </form>
                </div>
                {/* Replies */}
                {(repliesByParent[post.id] || []).map(reply => (
                  <div class="mt-4 ml-4 pl-4 border-l-2 border-gray-100">
                    <div class="flex items-start gap-3">
                      {reply.authorAvatar ? <img src={reply.authorAvatar} alt={reply.authorName} class="w-8 h-8 rounded-full object-cover" /> : <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-600">{reply.authorName.charAt(0)}</div>}
                      <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                          <p class="text-sm font-medium text-gray-900">{reply.authorName}</p>
                          <span class="text-xs text-gray-400 capitalize">{reply.authorRole}</span>
                          <span class="text-xs text-gray-400">{formatDate(reply.createdAt)}</span>
                        </div>
                        <p class="text-sm text-gray-700 whitespace-pre-wrap">{reply.content}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      ) : (
        <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
          <p class="text-sm text-gray-500">No posts yet. Be the first to start the discussion!</p>
        </div>
      )}
    </div>
  </div>

  <script is:inline define:vars={{ boardId }}>
    function toggleReply(postId) {
      var form = document.getElementById('reply-form-' + postId);
      if (form) form.classList.toggle('hidden');
    }

    document.getElementById('postForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var content = document.getElementById('postContent').value;
      var res = await fetch('/api/dashboard/discussions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ boardId, content }) });
      if (res.ok) window.location.reload(); else alert('Failed to post');
    });

    document.querySelectorAll('[data-reply-to]').forEach(function(form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var parentId = parseInt(this.dataset.replyTo);
        var content = this.querySelector('[name="content"]').value;
        var res = await fetch('/api/dashboard/discussions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ boardId, content, parentId }) });
        if (res.ok) window.location.reload(); else alert('Failed to reply');
      });
    });
  </script>
</DashboardLayout>
