---
/**
 * Question Bank Management
 *
 * Centralized question bank with tagging (topic, subject, difficulty),
 * bulk import via CSV, and filtering. Questions can be reused across
 * quizzes and CBT exams.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { questions, courses } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';
import { pageGuard } from '../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'cbt.question_bank.manage')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user.id);
const db = getDb();

const allQuestions = schoolId
  ? db.select().from(questions).where(eq(questions.schoolId, schoolId)).orderBy(desc(questions.createdAt)).all()
  : [];

const allCourses = schoolId ? db.select().from(courses).where(eq(courses.schoolId, schoolId)).all() : [];

// Collect all unique tags
const allTags = new Set<string>();
for (const q of allQuestions) {
  const tags = (q.tags as string[]) || [];
  tags.forEach(t => allTags.add(t));
}
const tagList = Array.from(allTags).sort();

const difficultyColors: Record<string, string> = {
  easy: 'bg-green-100 text-green-700',
  medium: 'bg-amber-100 text-amber-700',
  hard: 'bg-red-100 text-red-700',
};
const typeLabels: Record<string, string> = {
  multiple_choice: 'Multiple Choice', true_false: 'True/False', short_answer: 'Short Answer',
  essay: 'Essay', fill_blank: 'Fill Blank', matching: 'Matching',
};
---

<DashboardLayout title="Question Bank - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Question Bank</h2>
        <p class="text-sm text-gray-500 mt-1">Centralized repository of reusable questions with tagging</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="document.getElementById('importModal').classList.remove('hidden')" class="px-3 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">Import CSV</button>
        <button onclick="document.getElementById('createModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Add Question</button>
      </div>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Questions</p>
        <p class="text-2xl font-bold text-gray-900 mt-2">{allQuestions.length}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Easy</p>
        <p class="text-2xl font-bold text-green-600 mt-2">{allQuestions.filter(q => q.difficulty === 'easy').length}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Medium</p>
        <p class="text-2xl font-bold text-amber-600 mt-2">{allQuestions.filter(q => q.difficulty === 'medium').length}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Hard</p>
        <p class="text-2xl font-bold text-red-600 mt-2">{allQuestions.filter(q => q.difficulty === 'hard').length}</p>
      </div>
    </div>

    {/* Filters */}
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <input id="searchInput" type="text" placeholder="Search questions..." class="px-3 py-2 border border-gray-300 rounded-lg text-sm" oninput="filterQuestions()" />
        <select id="typeFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="filterQuestions()">
          <option value="">All Types</option>
          {Object.entries(typeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
        <select id="difficultyFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="filterQuestions()">
          <option value="">All Difficulties</option>
          <option value="easy">Easy</option>
          <option value="medium">Medium</option>
          <option value="hard">Hard</option>
        </select>
        <select id="tagFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="filterQuestions()">
          <option value="">All Tags</option>
          {tagList.map(t => <option value={t}>{t}</option>)}
        </select>
      </div>
    </div>

    {/* Questions list */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      {allQuestions.length > 0 ? (
        <div class="space-y-3" id="questionsList">
          {allQuestions.map(q => {
            const tags = (q.tags as string[]) || [];
            return (
              <div class="question-row border border-gray-200 rounded-lg p-4" data-question-text={q.question?.toLowerCase() || ''} data-type={q.type} data-difficulty={q.difficulty || 'medium'} data-tags={tags.join(',')}>
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-2 flex-wrap">
                      <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-100 text-primary-700">{typeLabels[q.type] || q.type}</span>
                      <span class:list={["inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase", difficultyColors[q.difficulty || 'medium'] || 'bg-gray-100 text-gray-600']}>{q.difficulty || 'medium'}</span>
                      <span class="text-xs text-gray-400">Points: {q.points || 1}</span>
                      {tags.map(t => <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-600">{t}</span>)}
                    </div>
                    <p class="text-sm font-medium text-gray-900">{q.question}</p>
                    {q.options && (
                      <div class="mt-2 space-y-1">
                        {(q.options as string[]).slice(0, 4).map((opt, i) => (
                          <p class="text-xs text-gray-500 pl-3">{String.fromCharCode(65 + i)}. {opt}</p>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    <button data-edit-id={q.id} class="p-1.5 text-gray-400 hover:text-primary-600" aria-label="Edit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></button>
                    <button data-delete-id={q.id} class="p-1.5 text-gray-400 hover:text-red-600" aria-label="Delete"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="py-12 text-center">
          <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          <p class="text-sm text-gray-500 mt-2">No questions yet. Add your first question or import via CSV.</p>
        </div>
      )}
    </div>
  </div>

  {/* Create question modal */}
  <div id="createModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Add Question</h3>
        <button onclick="document.getElementById('createModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="createForm" class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Type</label><select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{Object.entries(typeLabels).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Difficulty</label><select name="difficulty" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="easy">Easy</option><option value="medium" selected>Medium</option><option value="hard">Hard</option></select></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Points</label><input name="points" type="number" min="1" value="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Question</label><textarea name="question" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Options (one per line, for multiple choice/fill blank)</label><textarea name="options" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Option A&#10;Option B&#10;Option C&#10;Option D"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Correct Answer</label><input name="correctAnswer" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g., A or True or the answer text" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Tags (comma-separated)</label><input name="tags" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="algebra, chapter-5, midterm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Explanation (optional)</label><textarea name="explanation" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Save Question</button>
      </form>
    </div>
  </div>

  {/* Import CSV modal */}
  <div id="importModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Import Questions via CSV</h3>
        <button onclick="document.getElementById('importModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <p class="text-xs text-gray-500 mb-3">CSV format: type,question,options (pipe-separated),correctAnswer,difficulty,points,tags (comma-separated)</p>
      <form id="importForm" class="space-y-3">
        <input name="file" type="file" accept=".csv" required class="w-full text-sm" />
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Import</button>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ schoolId }}>
    function filterQuestions() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const type = document.getElementById('typeFilter').value;
      const diff = document.getElementById('difficultyFilter').value;
      const tag = document.getElementById('tagFilter').value;
      document.querySelectorAll('.question-row').forEach(function(row) {
        const text = row.dataset.questionText || '';
        const rowType = row.dataset.type || '';
        const rowDiff = row.dataset.difficulty || '';
        const rowTags = row.dataset.tags || '';
        const matchSearch = !search || text.includes(search);
        const matchType = !type || rowType === type;
        const matchDiff = !diff || rowDiff === diff;
        const matchTag = !tag || rowTags.includes(tag);
        row.style.display = (matchSearch && matchType && matchDiff && matchTag) ? '' : 'none';
      });
    }

    document.getElementById('createForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const fd = new FormData(this);
      const optionsText = fd.get('options') || '';
      const options = optionsText ? optionsText.split('\n').filter(function(l) { return l.trim(); }) : [];
      const tagsText = fd.get('tags') || '';
      const tags = tagsText ? tagsText.split(',').map(function(t) { return t.trim(); }).filter(Boolean) : [];
      const body = {
        schoolId,
        type: fd.get('type'),
        question: fd.get('question'),
        options: options,
        correctAnswer: fd.get('correctAnswer') || null,
        difficulty: fd.get('difficulty'),
        points: parseInt(fd.get('points')) || 1,
        tags: tags,
        explanation: fd.get('explanation') || null,
      };
      const res = await fetch('/api/dashboard/question-bank', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) window.location.reload(); else alert('Failed to save question');
    });

    document.getElementById('importForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const file = this.querySelector('[name="file"]').files[0];
      if (!file) return;
      const text = await file.text();
      const res = await fetch('/api/dashboard/question-bank/import', { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: text });
      if (res.ok) { const d = await res.json(); alert(d.imported + ' questions imported'); window.location.reload(); } else alert('Import failed');
    });

    document.querySelectorAll('[data-delete-id]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        if (!confirm('Delete this question?')) return;
        const id = this.dataset.deleteId;
        const res = await fetch('/api/dashboard/question-bank', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: parseInt(id) }) });
        if (res.ok) window.location.reload(); else alert('Failed');
      });
    });
  </script>
</DashboardLayout>
