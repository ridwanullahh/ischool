---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="New Gallery Item - iSchool">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/gallery" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div><h1 class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">New Gallery Item</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Add an image to the gallery</p></div>
    </div>
    <form method="POST" action="/api/dashboard/gallery" class="mosaic-card p-6 lg:p-8 space-y-6">
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Title *</label><input type="text" name="title" required placeholder="Sports Day 2025" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Image URL *</label><input type="text" name="imageUrl" required placeholder="https://..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Description</label><textarea name="description" rows="3" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);"></textarea></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Album</label><input type="text" name="albumId" placeholder="Album ID" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Sort Order</label><input type="number" name="sortOrder" value="0" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      </div>
      <div class="flex items-center gap-3 pt-4" style="border-top:1px solid var(--mosaic-border);"><button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Add to Gallery</button><a href="/dashboard/gallery" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">Cancel</a></div>
    </form>
  </div>
</DashboardLayout>
