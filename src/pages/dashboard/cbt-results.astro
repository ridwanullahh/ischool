---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { cbtExams, cbtCandidates, cbtAttempts, cbtProctoringLogs, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const exams = db.select().from(cbtExams).where(eq(cbtExams.schoolId, schoolId)).all();
const examIds = exams.map(e => e.id);
const examMap = new Map(exams.map(e => [e.id, e]));

const attempts = examIds.length > 0
  ? db.select({
      id: cbtAttempts.id, examId: cbtAttempts.examId, candidateId: cbtAttempts.candidateId,
      score: cbtAttempts.score, totalMarks: cbtAttempts.totalMarks, timeTaken: cbtAttempts.timeTaken,
      startedAt: cbtAttempts.startedAt, submittedAt: cbtAttempts.submittedAt, status: cbtAttempts.status,
      candidateName: cbtCandidates.name, candidateEmail: cbtCandidates.email,
    }).from(cbtAttempts)
      .leftJoin(cbtCandidates, eq(cbtAttempts.candidateId, cbtCandidates.id))
      .orderBy(desc(cbtAttempts.submittedAt)).all()
    : [];

const submittedAttempts = attempts.filter(a => a.status === 'submitted' || a.status === 'graded');
const totalScore = submittedAttempts.reduce((s, a) => s + (a.score || 0), 0);
const avgScore = submittedAttempts.length > 0 ? Math.round(totalScore / submittedAttempts.length) : 0;
const passCount = submittedAttempts.filter(a => {
  const pct = a.totalMarks ? ((a.score || 0) / a.totalMarks) * 100 : 0;
  return pct >= 50;
}).length;
const passRate = submittedAttempts.length > 0 ? Math.round((passCount / submittedAttempts.length) * 100) : 0;

// Per-exam analytics
const examAnalytics = exams.map(e => {
  const examAttempts = submittedAttempts.filter(a => a.examId === e.id);
  const examScores = examAttempts.map(a => a.score || 0);
  const total = examScores.reduce((s, x) => s + x, 0);
  const avg = examAttempts.length > 0 ? Math.round(total / examAttempts.length) : 0;
  const max = examScores.length > 0 ? Math.max(...examScores) : 0;
  const min = examScores.length > 0 ? Math.min(...examScores) : 0;
  const passed = examAttempts.filter(a => {
    const pct = a.totalMarks ? ((a.score || 0) / a.totalMarks) * 100 : 0;
    return pct >= 50;
  }).length;
  return {
    exam: e,
    attemptCount: examAttempts.length,
    avg, max, min,
    passRate: examAttempts.length > 0 ? Math.round((passed / examAttempts.length) * 100) : 0,
  };
});

// Score distribution buckets
const buckets = [0, 0, 0, 0, 0]; // 0-20, 21-40, 41-60, 61-80, 81-100
for (const a of submittedAttempts) {
  const pct = a.totalMarks ? ((a.score || 0) / a.totalMarks) * 100 : 0;
  if (pct <= 20) buckets[0]++;
  else if (pct <= 40) buckets[1]++;
  else if (pct <= 60) buckets[2]++;
  else if (pct <= 80) buckets[3]++;
  else buckets[4]++;
}
const maxBucket = Math.max(...buckets, 1);

const statusColors: Record<string, string> = { in_progress: 'bg-amber-100 text-amber-700', submitted: 'bg-green-100 text-green-700', graded: 'bg-blue-100 text-blue-700', disqualified: 'bg-red-100 text-red-700' };
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
const fmtDuration = (sec: any) => {
  if (!sec) return '—';
  const m = Math.floor(sec / 60); const s = sec % 60;
  return `${m}m ${s}s`;
};
---

<DashboardLayout title="CBT Results & Analytics - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">CBT Results & Analytics</h2>
      <p class="text-sm text-gray-500 mt-1">Auto-graded results, score distribution, per-exam performance, and per-candidate breakdowns.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Total Attempts</div><div class="text-xl font-bold">{attempts.length}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Submitted</div><div class="text-xl font-bold text-green-600">{submittedAttempts.length}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Average Score</div><div class="text-xl font-bold text-blue-600">{avgScore}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Pass Rate (50%+)</div><div class="text-xl font-bold text-emerald-600">{passRate}%</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Disqualified</div><div class="text-xl font-bold text-red-600">{attempts.filter(a => a.status === 'disqualified').length}</div></div>
    </div>

    {/* Score distribution */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Score Distribution</h3>
      <div class="flex items-end gap-4 h-40">
        {['0-20%', '21-40%', '41-60%', '61-80%', '81-100%'].map((label, i) => (
          <div class="flex-1 flex flex-col items-center">
            <div class="text-sm font-bold text-gray-700 mb-1">{buckets[i]}</div>
            <div class="w-full bg-gray-100 rounded-t" style={`height: ${(buckets[i] / maxBucket) * 100}%; min-height: 4px`}>
              <div class={`h-full ${i === 0 ? 'bg-red-500' : i === 1 ? 'bg-orange-500' : i === 2 ? 'bg-amber-500' : i === 3 ? 'bg-blue-500' : 'bg-green-500'} rounded-t`} style="height: 100%"></div>
            </div>
            <div class="text-xs text-gray-500 mt-2">{label}</div>
          </div>
        ))}
      </div>
    </div>

    {/* Per-exam analytics */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Per-Exam Performance</div>
      {examAnalytics.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No exams created.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Exam</th><th class="px-4 py-3">Type</th>
              <th class="px-4 py-3">Attempts</th><th class="px-4 py-3">Avg Score</th>
              <th class="px-4 py-3">Highest</th><th class="px-4 py-3">Lowest</th>
              <th class="px-4 py-3">Pass Rate</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {examAnalytics.map(ea => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{ea.exam.title}</td>
                  <td class="px-4 py-3 text-gray-700 capitalize">{ea.exam.type}</td>
                  <td class="px-4 py-3 text-gray-600">{ea.attemptCount}</td>
                  <td class="px-4 py-3 font-bold text-blue-700">{ea.attemptCount > 0 ? ea.avg : '—'}</td>
                  <td class="px-4 py-3 text-green-700 font-medium">{ea.attemptCount > 0 ? ea.max : '—'}</td>
                  <td class="px-4 py-3 text-red-700 font-medium">{ea.attemptCount > 0 ? ea.min : '—'}</td>
                  <td class="px-4 py-3">
                    {ea.attemptCount > 0 ? (
                      <div class="flex items-center gap-2">
                        <div class="w-16 h-2 bg-gray-100 rounded">
                          <div class={`h-full rounded ${ea.passRate >= 70 ? 'bg-green-500' : ea.passRate >= 50 ? 'bg-amber-500' : 'bg-red-500'}`} style={`width: ${ea.passRate}%`}></div>
                        </div>
                        <span class="text-xs font-medium">{ea.passRate}%</span>
                      </div>
                    ) : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    {/* Individual attempts */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Individual Attempt Results</div>
      {attempts.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No attempts yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Candidate</th><th class="px-4 py-3">Exam</th>
              <th class="px-4 py-3">Score</th><th class="px-4 py-3">%</th>
              <th class="px-4 py-3">Time Taken</th><th class="px-4 py-3">Submitted</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {attempts.slice(0, 100).map(a => {
                const pct = a.totalMarks ? Math.round(((a.score || 0) / a.totalMarks) * 100) : 0;
                const passed = pct >= 50;
                return (
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium text-gray-900">{a.candidateName}<div class="text-xs text-gray-500">{a.candidateEmail || ''}</div></td>
                    <td class="px-4 py-3 text-gray-700">{examMap.get(a.examId)?.title || '—'}</td>
                    <td class="px-4 py-3 font-bold text-gray-900">{a.score != null ? a.score : '—'}{a.totalMarks ? ` / ${a.totalMarks}` : ''}</td>
                    <td class="px-4 py-3"><span class={`font-bold ${passed ? 'text-green-700' : 'text-red-700'}`}>{a.score != null ? pct + '%' : '—'}</span></td>
                    <td class="px-4 py-3 text-gray-600">{fmtDuration(a.timeTaken)}</td>
                    <td class="px-4 py-3 text-gray-600 text-xs">{fmtDate(a.submittedAt)}</td>
                    <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[a.status]}`}>{a.status.replace('_', ' ')}</span></td>
                    <td class="px-4 py-3">
                      <button onclick={`deleteAttempt(${a.id})`} class="text-xs text-red-600 font-medium">Delete</button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.deleteAttempt = async function(id) {
      if (!confirm('Delete this attempt record?')) return;
      await fetch('/api/dashboard/cbt-candidates', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id, type: 'attempt' }) });
      window.location.reload();
    };
  })();`} />
</DashboardLayout>
