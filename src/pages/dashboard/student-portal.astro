---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { students, announcements, assignments, submissions, attendance, enrollments, classes, courses, exams, examResults } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allStudents = await db.select().from(students).where(eq(students.schoolId, schoolId)).all();
const recentAnnouncements = await db.select().from(announcements).where(and(eq(announcements.schoolId, schoolId), eq(announcements.published, 1))).orderBy(desc(announcements.createdAt)).limit(5).all();
const allClasses = await db.select().from(classes).where(eq(classes.schoolId, schoolId)).all();
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—';
---

<DashboardLayout title="Student Portal - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Student Portal</h2>
      <p class="text-sm text-gray-500 mt-1">Per-student view: class schedule, assignments, grades, attendance, and announcements feed.</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <label class="block text-xs font-medium text-gray-700 mb-2">Select Student</label>
      <select id="studentSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="loadStudentView()">
        <option value="">Choose a student…</option>
        {allStudents.map(s => <option value={s.id}>{s.firstName} {s.lastName} ({s.studentId})</option>)}
      </select>
    </div>

    <div id="emptyState" class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <div class="text-4xl mb-3">🎓</div>
      <h3 class="text-lg font-semibold text-gray-900 mb-1">Select a student</h3>
      <p class="text-sm text-gray-500">View their class schedule, assignments, grades, attendance, and announcements.</p>
    </div>

    <div id="studentView" class="hidden space-y-4">
      {/* KPI cards */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Attendance</div><div class="text-2xl font-bold text-blue-600" id="kpiAttendance">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Pending Assignments</div><div class="text-2xl font-bold text-amber-600" id="kpiPending">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Submitted</div><div class="text-2xl font-bold text-green-600" id="kpiSubmitted">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Average Grade</div><div class="text-2xl font-bold text-purple-600" id="kpiGrade">—</div></div>
      </div>

      {/* Announcements feed */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Announcements Feed</div>
        <div class="divide-y divide-gray-100">
          {recentAnnouncements.length === 0 ? (
            <p class="p-6 text-center text-sm text-gray-500">No announcements.</p>
          ) : recentAnnouncements.map(a => (
            <div class="p-4">
              <div class="flex items-center gap-2">
                {a.isPinned && <span class="text-amber-500">📌</span>}
                <h4 class="font-medium text-sm text-gray-900">{a.title}</h4>
              </div>
              <p class="text-xs text-gray-500 mt-1">{a.excerpt || a.content.substring(0, 150)}</p>
              <p class="text-xs text-gray-400 mt-1">{fmtDate(a.createdAt)}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Recent attendance */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Recent Attendance</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Date</th><th class="px-4 py-3">Period</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Notes</th>
            </tr></thead>
            <tbody id="attendanceBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>

      {/* Assignments */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Assignments</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Title</th><th class="px-4 py-3">Due Date</th>
              <th class="px-4 py-3">Submission Status</th><th class="px-4 py-3">Grade</th>
            </tr></thead>
            <tbody id="assignmentsBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{
    allStudents: allStudents.map(s => ({ id: s.id, name: `${s.firstName} ${s.lastName}`, code: s.studentId }))
  }} set:html={`(function(){
    var students = allStudents;
    function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—'; }

    window.loadStudentView = async function() {
      var sid = parseInt(document.getElementById('studentSelect').value);
      if (!sid) { document.getElementById('studentView').classList.add('hidden'); document.getElementById('emptyState').classList.remove('hidden'); return; }

      // Attendance
      var attRes = await fetch('/api/dashboard/attendance?studentId=' + sid);
      var att = await attRes.json();
      var present = att.filter(function(a){ return a.status === 'present'; }).length;
      var attRate = att.length > 0 ? Math.round((present / att.length) * 100) : null;
      document.getElementById('kpiAttendance').textContent = attRate !== null ? attRate + '%' : '—';
      var attBody = document.getElementById('attendanceBody');
      attBody.innerHTML = '';
      if (att.length === 0) {
        attBody.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-gray-500">No attendance records.</td></tr>';
      } else {
        att.slice(0, 10).forEach(function(a) {
          var colors = { present: 'bg-green-100 text-green-700', absent: 'bg-red-100 text-red-700', late: 'bg-amber-100 text-amber-700', excused: 'bg-blue-100 text-blue-700', early_departure: 'bg-purple-100 text-purple-700' };
          attBody.innerHTML += '<tr><td class="px-4 py-3">' + a.date + '</td><td class="px-4 py-3">' + (a.period || 'Full Day') + '</td><td class="px-4 py-3"><span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (colors[a.status] || '') + '">' + a.status + '</span></td><td class="px-4 py-3 text-gray-600 text-xs">' + (a.notes || '—') + '</td></tr>';
        });
      }

      // Assignments + submissions
      var assRes = await fetch('/api/dashboard/assignments');
      var allAss = await assRes.json();
      var pending = 0, submitted = 0;
      var assBody = document.getElementById('assignmentsBody');
      assBody.innerHTML = '';
      if (allAss.length === 0) {
        assBody.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-gray-500">No assignments.</td></tr>';
      } else {
        // Fetch submissions for each assignment
        for (var i = 0; i < Math.min(allAss.length, 15); i++) {
          var a = allAss[i];
          var subRes = await fetch('/api/dashboard/assignments?action=submissions&assignmentId=' + a.id);
          var subs = await subRes.json();
          var mySub = subs.find(function(s){ return s.studentId === sid; });
          var status = mySub ? mySub.status : 'missing';
          var grade = mySub && mySub.grade != null ? mySub.grade + '/' + (a.maxPoints || 100) : '—';
          if (mySub) submitted++; else if (a.dueDate && new Date(a.dueDate) > new Date()) pending++;
          var colors = { submitted: 'bg-blue-100 text-blue-700', graded: 'bg-green-100 text-green-700', late: 'bg-amber-100 text-amber-700', missing: 'bg-red-100 text-red-700', returned: 'bg-purple-100 text-purple-700' };
          assBody.innerHTML += '<tr><td class="px-4 py-3 font-medium">' + a.title + '</td><td class="px-4 py-3">' + fmtDate(a.dueDate) + '</td><td class="px-4 py-3"><span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (colors[status] || '') + '">' + status + '</span></td><td class="px-4 py-3 font-bold">' + grade + '</td></tr>';
        }
      }
      document.getElementById('kpiPending').textContent = pending;
      document.getElementById('kpiSubmitted').textContent = submitted;
      document.getElementById('kpiGrade').textContent = '—'; // Computed from grades API if needed

      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('studentView').classList.remove('hidden');
    };
  })();`} />
</DashboardLayout>
