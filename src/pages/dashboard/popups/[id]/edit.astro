---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { popups } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';
const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const itemId = Astro.params.id;
if (!itemId) return Astro.redirect('/dashboard/popups');
const db = getDb();
let item: any = null;
if (schoolId) { try { const all = await db.select().from(popups).where(eq(popups.schoolId, schoolId)).all()||[]; item = all.find(i=>String(i.id)===String(itemId))||null; } catch {} }
if (!item) return Astro.redirect('/dashboard/popups');
---
<DashboardLayout title="Edit Popup - iSchool">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/popups" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div><h1 class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Edit Popup</h1></div>
    </div>
    <form method="POST" action="/api/dashboard/popups" class="mosaic-card p-6 lg:p-8 space-y-6">
      <input type="hidden" name="id" value={item.id} />
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Title</label><input type="text" name="title" value={item.title||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Content</label><textarea name="content" rows="5" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);">{item.content||''}</textarea></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Image URL</label><input type="text" name="imageUrl" value={item.imageUrl||item.image_url||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Button Text</label><input type="text" name="buttonText" value={item.buttonText||item.button_text||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Button URL</label><input type="text" name="buttonUrl" value={item.buttonUrl||item.button_url||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      </div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Display Rule</label><select name="displayRule" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);"><option value="immediate" selected={item.displayRule===item.display_rule==='immediate'}>Show immediately</option><option value="delayed" selected={item.displayRule==='delayed'}>Show after delay</option><option value="exit" selected={item.displayRule==='exit'}>Show on exit intent</option><option value="scroll" selected={item.displayRule==='scroll'}>Show on scroll</option></select></div>
      <div class="flex items-center justify-between pt-4" style="border-top:1px solid var(--mosaic-border);">
        <div class="flex items-center gap-3"><button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Save Changes</button><a href="/dashboard/popups" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">Cancel</a></div>
        <form method="POST" action="/api/dashboard/popups" onsubmit="return confirm('Delete?')"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={item.id} /><button type="submit" class="px-4 py-2.5 rounded-xl text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">Delete</button></form>
      </div>
    </form>
  </div>
</DashboardLayout>
