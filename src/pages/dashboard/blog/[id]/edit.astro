---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import RichTextEditor from '../../../../components/RichTextEditor.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { blogPosts } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const school = (user as any).school;
const postId = Astro.params.id;

if (!postId) return Astro.redirect('/dashboard/blog');

const db = getDb();
let post: any = null;
if (schoolId) {
  try {
    const allPosts = await db.select().from(blogPosts).where(eq(blogPosts.schoolId, schoolId)).all();
    post = (allPosts || []).find(p => String(p.id) === String(postId)) || null;
  } catch (e: any) {
    console.error('[blog edit] Error:', e?.message);
  }
}

if (!post) return Astro.redirect('/dashboard/blog');
---

<DashboardLayout title="Edit Blog Post - iSchool">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/blog" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color: var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">Edit Blog Post</h1>
        <p class="text-sm" style="color: var(--mosaic-text-muted);">{post.title}</p>
      </div>
    </div>

    <form method="POST" action="/api/dashboard/blog" class="mosaic-card p-6 lg:p-8 space-y-6">
      <input type="hidden" name="id" value={post.id} />
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Title</label>
        <input type="text" name="title" value={post.title || ''} required class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Slug</label>
          <input type="text" name="slug" value={post.slug || ''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Category</label>
          <input type="text" name="category" value={post.category || ''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Excerpt</label>
        <textarea name="excerpt" rows="2" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);">{post.excerpt || ''}</textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Cover Image URL</label>
        <input type="text" name="coverImageUrl" value={post.coverImageUrl || post.cover_image_url || ''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Content</label>
        <RichTextEditor name="content" value={post.content || ''} id="blog-content-editor" placeholder="Write your blog post..." schoolSlug={school?.slug || ''} />
      </div>
      <div class="flex items-center justify-between pt-4" style="border-top: 1px solid var(--mosaic-border);">
        <div class="flex items-center gap-3">
          <button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Save Changes</button>
          <a href="/dashboard/blog" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color: var(--mosaic-text-muted);">Cancel</a>
        </div>
        <form method="POST" action="/api/dashboard/blog" onsubmit="return confirm('Delete this post?')">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={post.id} />
          <button type="submit" class="px-4 py-2.5 rounded-xl text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">Delete</button>
        </form>
      </div>
    </form>
  </div>
</DashboardLayout>
