---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { moduleSettings, schoolMembers } from '../../lib/db/schema.js';
import { eq, and } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const settings = db.select().from(moduleSettings).where(eq(moduleSettings.schoolId, schoolId)).all();
const settingsMap = new Map(settings.map(s => [s.moduleKey, s]));

const specModules = [
  { key: 'sis', name: 'Student Information System', icon: '👨‍🎓', desc: 'Student records, enrollments, attendance, medical, docs', color: 'from-blue-500 to-blue-600', nav: '/dashboard/students' },
  { key: 'lms', name: 'Learning Management System', icon: '📚', desc: 'Courses, lessons, assignments, quizzes, grades, discussions', color: 'from-purple-500 to-purple-600', nav: '/dashboard/courses' },
  { key: 'timetable', name: 'Timetable & Scheduling', icon: '📅', desc: 'Prayer schedules, timetable, substitutes, periods', color: 'from-teal-500 to-teal-600', nav: '/dashboard/timetable' },
  { key: 'exams', name: 'Examinations & Results', icon: '📝', desc: 'Exams, marks, report cards, transcripts, analytics', color: 'from-red-500 to-red-600', nav: '/dashboard/exams' },
  { key: 'finance', name: 'Finance & Fees', icon: '💰', desc: 'Fees, invoices, payments, finance reports, parent portal', color: 'from-green-500 to-green-600', nav: '/dashboard/fees' },
  { key: 'hr', name: 'HR & Staff Management', icon: '👔', desc: 'Staff, attendance, recruitment, leave, payroll, performance', color: 'from-amber-500 to-amber-600', nav: '/dashboard/staff' },
  { key: 'communication', name: 'Communication & Engagement', icon: '💬', desc: 'Messages, announcements, notifications, parent/student portals', color: 'from-pink-500 to-pink-600', nav: '/dashboard/messages' },
  { key: 'library', name: 'Library Management', icon: '📖', desc: 'Book catalog, loans, members, fines', color: 'from-indigo-500 to-indigo-600', nav: '/dashboard/library' },
  { key: 'hostel', name: 'Hostel / Dormitory', icon: '🛏️', desc: 'Buildings, allocations, check-in/out, maintenance', color: 'from-cyan-500 to-cyan-600', nav: '/dashboard/hostel' },
  { key: 'transport', name: 'Transport Management', icon: '🚌', desc: 'Vehicles, routes, assignments, maintenance, documents', color: 'from-orange-500 to-orange-600', nav: '/dashboard/transport' },
  { key: 'inventory', name: 'Inventory & Assets', icon: '📦', desc: 'Assets, stock, suppliers, audit, procurement', color: 'from-lime-500 to-lime-600', nav: '/dashboard/inventory' },
  { key: 'events', name: 'Events & Calendar', icon: '🎉', desc: 'Events, calendar, venues, RSVP', color: 'from-rose-500 to-rose-600', nav: '/dashboard/events' },
  { key: 'classroom', name: 'Classroom Tools', icon: '🎨', desc: 'Lesson plans, behavior, seating, interactive lessons', color: 'from-violet-500 to-violet-600', nav: '/dashboard/classroom' },
  { key: 'analytics', name: 'Reporting & Analytics', icon: '📊', desc: 'Analytics, reports, custom builder, export', color: 'from-emerald-500 to-emerald-600', nav: '/dashboard/analytics' },
  { key: 'it_admin', name: 'IT & System Administration', icon: '⚙️', desc: 'Users, roles, security, modules, backup, system health', color: 'from-slate-500 to-slate-600', nav: '/dashboard/it-admin' },
  { key: 'cbt', name: 'e-Exam & CBT', icon: '💻', desc: 'CBT exams, question bank, candidates, proctoring, results', color: 'from-fuchsia-500 to-fuchsia-600', nav: '/dashboard/cbt' },
];
---

<DashboardLayout title="Module Settings - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Module Settings</h2>
      <p class="text-sm text-gray-500 mt-1">Enable or disable any of the 16 modules for this school. Disabled modules are hidden from navigation and inaccessible to users.</p>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
      <p class="text-sm text-blue-900">
        <strong>ℹ️ How it works:</strong> When a module is disabled, its nav items are hidden and its pages redirect to this settings page. Database tables are preserved — toggling back on restores all data.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {specModules.map(m => {
        const setting = settingsMap.get(m.key);
        const isEnabled = setting ? setting.isEnabled : true; // Default enabled
        return (
          <div class={`bg-white rounded-xl border-2 ${isEnabled ? 'border-gray-200' : 'border-gray-100 opacity-75'} p-5`}>
            <div class="flex items-start gap-3 mb-3">
              <div class={`text-3xl ${isEnabled ? '' : 'grayscale'}`}>{m.icon}</div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-gray-900">{m.name}</h3>
                <p class="text-xs text-gray-500 mt-0.5">{m.desc}</p>
              </div>
            </div>
            <div class="flex items-center justify-between pt-3 border-t border-gray-100">
              <a href={m.nav} class={`text-xs font-medium ${isEnabled ? 'text-primary-600' : 'text-gray-400 pointer-events-none'}`}>Open module →</a>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" class="sr-only peer" checked={isEnabled} onchange={`toggleModule('${m.key}', this.checked)`} />
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500"></div>
                <span class={`ml-2 text-xs font-medium ${isEnabled ? 'text-green-700' : 'text-gray-500'}`}>{isEnabled ? 'Enabled' : 'Disabled'}</span>
              </label>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.toggleModule = async function(key, enabled) {
      var res = await fetch('/api/dashboard/cms-modules', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ moduleKey: key, isEnabled: enabled })
      });
      if (res.ok) {
        // Visual feedback already from checkbox state
        if (!enabled) alert('Module disabled. Users will no longer see this module in navigation.');
      } else {
        alert('Failed to update module setting');
        window.location.reload();
      }
    };
  })();`} />
</DashboardLayout>
