---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { hostelMaintenanceRequests, hostels, hostelRooms, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const reqs = await db.select({
  id: hostelMaintenanceRequests.id, hostelId: hostelMaintenanceRequests.hostelId,
  roomId: hostelMaintenanceRequests.roomId, title: hostelMaintenanceRequests.title,
  description: hostelMaintenanceRequests.description, category: hostelMaintenanceRequests.category,
  priority: hostelMaintenanceRequests.priority, status: hostelMaintenanceRequests.status,
  assignedTo: hostelMaintenanceRequests.assignedTo, cost: hostelMaintenanceRequests.cost,
  completedAt: hostelMaintenanceRequests.completedAt, notes: hostelMaintenanceRequests.notes,
  createdAt: hostelMaintenanceRequests.createdAt,
  hostelName: hostels.name, roomNumber: hostelRooms.roomNumber,
}).from(hostelMaintenanceRequests)
  .leftJoin(hostels, eq(hostelMaintenanceRequests.hostelId, hostels.id))
  .leftJoin(hostelRooms, eq(hostelMaintenanceRequests.roomId, hostelRooms.id))
  .where(eq(hostelMaintenanceRequests.schoolId, schoolId))
  .orderBy(desc(hostelMaintenanceRequests.createdAt)).all();

const allHostels = await db.select().from(hostels).where(eq(hostels.schoolId, schoolId)).all();
const allRooms = await db.select().from(hostelRooms).all();
const schoolRooms = allRooms.filter(r => allHostels.some(h => h.id === r.hostelId));

const stats = {
  total: reqs.length,
  pending: reqs.filter(r => r.status === 'pending').length,
  inProgress: reqs.filter(r => r.status === 'in_progress').length,
  completed: reqs.filter(r => r.status === 'completed').length,
  urgent: reqs.filter(r => r.priority === 'urgent' && r.status !== 'completed').length,
};

const categoryLabels: Record<string, string> = { electrical: 'Electrical', plumbing: 'Plumbing', furniture: 'Furniture', cleaning: 'Cleaning', structural: 'Structural', other: 'Other' };
const categoryColors: Record<string, string> = { electrical: 'bg-amber-100 text-amber-700', plumbing: 'bg-blue-100 text-blue-700', furniture: 'bg-purple-100 text-purple-700', cleaning: 'bg-green-100 text-green-700', structural: 'bg-red-100 text-red-700', other: 'bg-gray-100 text-gray-700' };
const priorityColors: Record<string, string> = { low: 'bg-gray-100 text-gray-700', medium: 'bg-blue-100 text-blue-700', high: 'bg-amber-100 text-amber-700', urgent: 'bg-red-100 text-red-700' };
const statusColors: Record<string, string> = { pending: 'bg-amber-100 text-amber-700', in_progress: 'bg-blue-100 text-blue-700', completed: 'bg-green-100 text-green-700', cancelled: 'bg-gray-100 text-gray-700' };
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const fmtMoney = (n: any) => n ? '₦' + n.toLocaleString() : '—';
---

<DashboardLayout title="Hostel Maintenance - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Hostel Maintenance Requests</h2>
        <p class="text-sm text-gray-500 mt-1">Track maintenance issues per room/hostel. Categorize, prioritize, assign, and track to completion with cost tracking.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Request</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total</div><div class="text-2xl font-bold">{stats.total}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Pending</div><div class="text-2xl font-bold text-amber-600">{stats.pending}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">In Progress</div><div class="text-2xl font-bold text-blue-600">{stats.inProgress}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Completed</div><div class="text-2xl font-bold text-green-600">{stats.completed}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Urgent Open</div><div class="text-2xl font-bold text-red-600">{stats.urgent}</div></div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      {reqs.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">🔧</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No maintenance requests</h3>
          <p class="text-sm text-gray-500">Report a maintenance issue to get started.</p>
        </div>
      ) : (
        <div class="divide-y divide-gray-100">
          {reqs.map(r => (
            <div class="p-4 hover:bg-gray-50">
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap mb-1">
                    <h3 class="font-semibold text-gray-900">{r.title}</h3>
                    <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${categoryColors[r.category]}`}>{categoryLabels[r.category]}</span>
                    <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${priorityColors[r.priority]}`}>{r.priority}</span>
                    <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[r.status]}`}>{r.status.replace('_', ' ')}</span>
                  </div>
                  <p class="text-sm text-gray-600">{r.description || '—'}</p>
                  <div class="flex flex-wrap gap-3 mt-2 text-xs text-gray-500">
                    <span>🏠 {r.hostelName}{r.roomNumber ? ` · Room ${r.roomNumber}` : ''}</span>
                    {r.assignedTo && <span>👤 Assigned: {r.assignedTo}</span>}
                    {r.cost && <span>💰 Cost: {fmtMoney(r.cost)}</span>}
                    <span>📅 Reported: {fmtDate(r.createdAt)}</span>
                    {r.completedAt && <span>✅ Completed: {fmtDate(r.completedAt)}</span>}
                  </div>
                </div>
                <div class="flex flex-col gap-1 shrink-0 ml-2">
                  {r.status !== 'completed' && r.status !== 'cancelled' && (
                    <>
                      <select onchange={`updateStatus(${r.id}, this.value)`} class="text-xs px-2 py-1 border rounded">
                        <option value="">Change status…</option>
                        <option value="pending">Pending</option>
                        <option value="in_progress">In Progress</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                      </select>
                    </>
                  )}
                  <button onclick={`deleteReq(${r.id})`} class="text-xs text-red-600 font-medium">Delete</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>

  <div id="reqModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New Maintenance Request</h3>
      <form id="reqForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Hostel *</label>
          <select name="hostelId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select hostel…</option>
            {allHostels.map(h => <option value={h.id}>{h.name}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Room (optional)</label>
          <select name="roomId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">— Common area / unspecified —</option>
            {schoolRooms.map(r => <option value={r.id}>Room {r.roomNumber} (Floor {r.floor})</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title *</label><input name="title" required placeholder="e.g. Broken window latch" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="3" placeholder="Detailed description of the issue…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Category</label>
            <select name="category" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              {Object.entries(categoryLabels).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Priority</label>
            <select name="priority" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="low">Low</option><option value="medium" selected>Medium</option>
              <option value="high">High</option><option value="urgent">Urgent</option>
            </select>
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('reqModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Submit Request</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openModal = function() { document.getElementById('reqModal').classList.remove('hidden'); };
    window.updateStatus = async function(id, status) {
      if (!status) return;
      await fetch('/api/dashboard/hostel-maintenance', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'update_status', id: id, status: status }) });
      window.location.reload();
    };
    window.deleteReq = async function(id) {
      if (!confirm('Delete this maintenance request?')) return;
      await fetch('/api/dashboard/hostel-maintenance', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    document.getElementById('reqForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/hostel-maintenance', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        hostelId: parseInt(fd.get('hostelId')),
        roomId: fd.get('roomId') ? parseInt(fd.get('roomId')) : null,
        title: fd.get('title'),
        description: fd.get('description') || null,
        category: fd.get('category'),
        priority: fd.get('priority'),
      }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
