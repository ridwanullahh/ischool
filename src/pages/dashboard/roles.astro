---
/**
 * Roles & Permissions Management
 *
 * Allows school admins and IT admins to view the default permission matrix
 * per role, and to apply per-school overrides (grant or revoke specific
 * permissions for specific roles).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { roleOverrides } from '../../lib/db/schema.js';
import { eq } from 'drizzle-orm';
import {
  ALL_ROLES, ROLE_LABELS, PERMISSIONS, getPermissionsByModule,
  getDefaultPermissions, type Role, type Permission,
} from '../../lib/rbac.js';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login?redirect=/dashboard/roles');

// Only super_admin, school_admin, it_admin can access
const allowedRoles = ['super_admin', 'school_admin', 'it_admin'];
if (!allowedRoles.includes(user.role)) {
  return Astro.redirect('/dashboard');
}

const schoolId = getUserSchoolId(user);
const db = getDb();

// Fetch existing overrides for this school
const overrides = schoolId
  ? await db.select().from(roleOverrides).where(eq(roleOverrides.schoolId, schoolId)).all()
  : [];

// Build override lookup: { role: { permission: 'grant'|'revoke' } }
const overrideMap: Record<string, Record<string, string>> = {};
for (const ov of overrides) {
  if (!overrideMap[ov.role]) overrideMap[ov.role] = {};
  overrideMap[ov.role][ov.permission] = ov.action;
}

const permissionsByModule = getPermissionsByModule();
const moduleLabels: Record<string, string> = {
  platform: 'Platform',
  students: 'Students (SIS)',
  enrollments: 'Enrollment',
  attendance: 'Attendance',
  courses: 'Courses (LMS)',
  assignments: 'Assignments',
  quizzes: 'Quizzes',
  grades: 'Grades',
  timetable: 'Timetable',
  exams: 'Examinations',
  fees: 'Fees',
  invoices: 'Invoices',
  payments: 'Payments',
  staff: 'Staff (HR)',
  leave: 'Leave',
  payroll: 'Payroll',
  recruitment: 'Recruitment',
  performance: 'Performance',
  messages: 'Messages',
  announcements: 'Announcements',
  notifications: 'Notifications',
  library: 'Library',
  hostel: 'Hostel',
  transport: 'Transport',
  inventory: 'Inventory',
  events: 'Events',
  classroom: 'Classroom',
  behavior: 'Behavior',
  lesson_plans: 'Lesson Plans',
  reports: 'Reports',
  it: 'IT Admin',
  cbt: 'CBT / e-Exam',
};

// Roles that can be managed (exclude super_admin - always full access)
const manageableRoles = ALL_ROLES.filter(r => r !== 'super_admin');
---

<DashboardLayout title="Roles & Permissions - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Roles & Permissions</h2>
      <p class="text-sm text-gray-500 mt-1">
        View the default permission matrix and apply per-school overrides.
        Super Admin always has all permissions and cannot be modified.
      </p>
    </div>

    {schoolId ? (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base font-semibold text-gray-900">Permission Matrix</h3>
          <div class="flex items-center gap-2 text-xs">
            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-green-500"></span> Granted</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-gray-200"></span> Not granted</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-red-500"></span> Revoked (override)</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-blue-500"></span> Granted (override)</span>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-3 px-2 font-semibold text-gray-700 sticky left-0 bg-white">Permission</th>
                {manageableRoles.map(role => (
                  <th class="text-center py-3 px-2 font-semibold text-gray-700 min-w-[80px]">{ROLE_LABELS[role]}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {Object.entries(permissionsByModule).map(([mod, perms]) => (
                <>
                  <tr class="bg-gray-50">
                    <td colspan={manageableRoles.length + 1} class="py-2 px-2 font-semibold text-gray-800 uppercase tracking-wider text-[10px]">
                      {moduleLabels[mod] || mod}
                    </td>
                  </tr>
                  {perms.map(perm => {
                    const [modName, ...actionParts] = perm.split('.');
                    const action = actionParts.join('.');
                    return (
                      <tr class="border-b border-gray-100 hover:bg-gray-50">
                        <td class="py-2 px-2 text-gray-700 font-mono text-[11px]">{action}</td>
                        {manageableRoles.map(role => {
                          const defaultHas = getDefaultPermissions(role as Role).has(perm as Permission);
                          const override = overrideMap[role]?.[perm];
                          const effective = override === 'grant' ? true : override === 'revoke' ? false : defaultHas;
                          const bgClass = override === 'grant' ? 'bg-blue-500' : override === 'revoke' ? 'bg-red-500' : effective ? 'bg-green-500' : 'bg-gray-200';
                          return (
                            <td class="text-center py-2 px-2">
                              <button
                                type="button"
                                data-role={role}
                                data-permission={perm}
                                data-default={String(defaultHas)}
                                data-override={override || ''}
                                class={`w-5 h-5 rounded ${bgClass} mx-auto transition-opacity hover:opacity-80 cursor-pointer`}
                                aria-label={`Toggle ${perm} for ${ROLE_LABELS[role]}`}
                              ></button>
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-6 flex items-center justify-between">
          <p class="text-xs text-gray-500">
            Click any cell to cycle: default → grant → revoke → default. Changes apply immediately to this school.
          </p>
          <button id="resetOverrides" class="px-4 py-2 text-sm font-medium text-red-600 border border-red-200 rounded-lg hover:bg-red-50">
            Reset to Defaults
          </button>
        </div>
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <p class="text-gray-500">No school context. Role overrides are per-school.</p>
      </div>
    )}

    {/* Existing overrides list */}
    {overrides.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-base font-semibold text-gray-900 mb-4">Active Overrides ({overrides.length})</h3>
        <div class="space-y-2">
          {overrides.map(ov => (
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <div class="flex items-center gap-3">
                <span class={`px-2 py-0.5 rounded text-xs font-medium ${ov.action === 'grant' ? 'bg-blue-100 text-blue-700' : 'bg-red-100 text-red-700'}`}>
                  {ov.action === 'grant' ? 'GRANT' : 'REVOKE'}
                </span>
                <span class="text-sm font-medium text-gray-900">{ROLE_LABELS[ov.role as Role] || ov.role}</span>
                <span class="text-sm text-gray-500 font-mono">{ov.permission}</span>
              </div>
              <button data-delete-override={ov.id} class="text-red-500 hover:text-red-700 text-xs">Remove</button>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ schoolId }}>
    document.querySelectorAll('[data-role][data-permission]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        const role = this.dataset.role;
        const permission = this.dataset.permission;
        const defaultHas = this.dataset.default === 'true';
        const currentOverride = this.dataset.override || '';

        // Cycle: default -> grant (if not default-yes) -> revoke (if default-yes) -> default
        let nextAction;
        if (!currentOverride) {
          nextAction = defaultHas ? 'revoke' : 'grant';
        } else {
          nextAction = ''; // reset to default
        }

        const res = await fetch('/api/dashboard/roles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role, permission, action: nextAction, schoolId }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'Failed to update permission');
        }
      });
    });

    document.querySelectorAll('[data-delete-override]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        const id = this.dataset.deleteOverride;
        if (!confirm('Remove this override?')) return;
        const res = await fetch('/api/dashboard/roles', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(id), schoolId }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to remove override');
        }
      });
    });

    document.getElementById('resetOverrides')?.addEventListener('click', async function() {
      if (!confirm('Reset ALL overrides to defaults for this school? This cannot be undone.')) return;
      const res = await fetch('/api/dashboard/roles', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resetAll: true, schoolId }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to reset overrides');
      }
    });
  </script>
</DashboardLayout>
