---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { gmbConnections, gmbReviews, gmbPosts } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const connection = db.select().from(gmbConnections).where(eq(gmbConnections.schoolId, schoolId)).get();
const reviews = db.select().from(gmbReviews).where(eq(gmbReviews.schoolId, schoolId)).all();
const posts = db.select().from(gmbPosts).where(eq(gmbPosts.schoolId, schoolId)).all();
const avgRating = reviews.length > 0 ? (reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / reviews.length).toFixed(1) : 'N/A';
const ratingDistribution = [5, 4, 3, 2, 1].map(stars => ({
  stars,
  count: reviews.filter(r => r.rating === stars).length,
  percentage: reviews.length > 0 ? Math.round((reviews.filter(r => r.rating === stars).length / reviews.length) * 100) : 0,
}));
---

<DashboardLayout title="GMB Insights - iSchool">
  <div class="space-y-6">
    <div><h2 class="text-2xl font-bold text-gray-900">Insights</h2><p class="text-sm text-gray-500 mt-1">Analytics for your Google Business profile.</p></div>

    <!-- Overview Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">Avg Rating</p><p class="text-2xl font-bold text-amber-500 mt-1">{avgRating}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">Total Reviews</p><p class="text-2xl font-bold text-gray-900 mt-1">{reviews.length}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">GMB Posts</p><p class="text-2xl font-bold text-blue-600 mt-1">{posts.length}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">Verification</p><p class="text-2xl font-bold text-green-600 mt-1 capitalize">{connection?.verificationStatus || 'N/A'}</p></div>
    </div>

    <!-- Rating Distribution -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Rating Distribution</h3>
      <div class="space-y-2">
        {ratingDistribution.map(d => (
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1 w-20">
              <span class="text-sm font-medium text-gray-700">{d.stars}</span>
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <div class="flex-1 h-4 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width:${d.percentage}%`}></div>
            </div>
            <span class="text-sm text-gray-500 w-12 text-right">{d.count}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Search Performance (placeholder until API connected) -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Search Performance</h3>
      {connection?.isConnected ? (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center p-3"><p class="text-2xl font-bold text-gray-900">—</p><p class="text-xs text-gray-400">Search Views</p></div>
          <div class="text-center p-3"><p class="text-2xl font-bold text-gray-900">—</p><p class="text-xs text-gray-400">Profile Views</p></div>
          <div class="text-center p-3"><p class="text-2xl font-bold text-gray-900">—</p><p class="text-xs text-gray-400">Direction Requests</p></div>
          <div class="text-center p-3"><p class="text-2xl font-bold text-gray-900">—</p><p class="text-xs text-gray-400">Phone Calls</p></div>
        </div>
      ) : (
        <p class="text-sm text-gray-500 text-center py-4">Connect your Google My Business account to view insights data.</p>
      )}
    </div>

    <!-- Customer Actions -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Customer Actions</h3>
      {connection?.isConnected ? (
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 border rounded-lg"><span class="text-sm text-gray-700">Website clicks</span><span class="text-sm font-bold text-gray-900">—</span></div>
          <div class="flex items-center justify-between p-3 border rounded-lg"><span class="text-sm text-gray-700">Direction requests</span><span class="text-sm font-bold text-gray-900">—</span></div>
          <div class="flex items-center justify-between p-3 border rounded-lg"><span class="text-sm text-gray-700">Phone calls</span><span class="text-sm font-bold text-gray-900">—</span></div>
          <div class="flex items-center justify-between p-3 border rounded-lg"><span class="text-sm text-gray-700">Photo views</span><span class="text-sm font-bold text-gray-900">—</span></div>
        </div>
      ) : (
        <p class="text-sm text-gray-500 text-center py-4">Connect your Google My Business account to view customer actions.</p>
      )}
    </div>
  </div>
</DashboardLayout>
