---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { gmbPosts, gmbConnections } from '../../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const connection = await db.select().from(gmbConnections).where(eq(gmbConnections.schoolId, schoolId)).get();
const posts = await db.select().from(gmbPosts).where(eq(gmbPosts.schoolId, schoolId)).orderBy(desc(gmbPosts.createdAt)).all();
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const statusColors: Record<string, string> = { draft: 'bg-gray-100 text-gray-600', published: 'bg-green-100 text-green-700', scheduled: 'bg-blue-100 text-blue-700' };
---

<DashboardLayout title="GMB Posts - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div><h2 class="text-2xl font-bold text-gray-900">GMB Posts</h2><p class="text-sm text-gray-500 mt-1">Manage posts on your Google Business profile.</p></div>
      <button onclick="document.getElementById('postModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Post</button>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map(p => (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-600">{p.postType}</span>
              <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[p.status] || 'bg-gray-100 text-gray-600'}`}>{p.status}</span>
            </div>
            {p.imageUrl && <img src={p.imageUrl} alt={p.title} class="w-full h-32 object-cover rounded-lg mb-3" />}
            <h3 class="font-semibold text-sm text-gray-900 mb-1">{p.title || 'Untitled'}</h3>
            <p class="text-xs text-gray-500 line-clamp-2 mb-2">{p.content}</p>
            <div class="flex items-center justify-between text-xs text-gray-400">
              <span>{formatDate(p.startDate)} - {formatDate(p.endDate)}</span>
              <button onclick={`deletePost(${p.id})`} class="text-red-600 font-medium">Delete</button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/></svg>
        <p class="text-lg font-semibold text-gray-900 mb-2">No GMB posts yet</p>
        <p class="text-sm text-gray-500 mb-4">Create posts to share updates, events, and offers on Google.</p>
        <button onclick="document.getElementById('postModal').classList.remove('hidden')" class="inline-block px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create Post</button>
      </div>
    )}
  </div>

  <!-- New Post Modal -->
  <div id="postModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New GMB Post</h3>
      <form id="gmbPostForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Post Type</label><select name="postType" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="what_new">What's New</option><option value="event">Event</option><option value="offer">Offer</option><option value="covid">COVID Update</option></select></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title</label><input name="title" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Content</label><textarea name="content" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Image URL (optional)</label><input name="imageUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="https://..." /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Start Date</label><input name="startDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">End Date</label><input name="endDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('postModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    document.getElementById('gmbPostForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/gmb', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create_post', title: fd.get('title'), content: fd.get('content'), imageUrl: fd.get('imageUrl'), postType: fd.get('postType'), startDate: fd.get('startDate'), endDate: fd.get('endDate') }) });
      if (res.ok) window.location.reload();
    });
    window.deletePost = async function(id) {
      if (!confirm('Delete this post?')) return;
      await fetch('/api/dashboard/gmb', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_post', postId: id }) });
      window.location.reload();
    };
  })();`} />
</DashboardLayout>
