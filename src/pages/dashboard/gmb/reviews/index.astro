---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { gmbReviews, gmbConnections } from '../../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const connection = await db.select().from(gmbConnections).where(eq(gmbConnections.schoolId, schoolId)).get();
const reviews = await db.select().from(gmbReviews).where(eq(gmbReviews.schoolId, schoolId)).orderBy(desc(gmbReviews.reviewDate)).all();
const avgRating = reviews.length > 0 ? (reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / reviews.length).toFixed(1) : 'N/A';
const totalReviews = reviews.length;
const responded = reviews.filter(r => r.response).length;
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---

<DashboardLayout title="GMB Reviews - iSchool">
  <div class="space-y-6">
    <div><h2 class="text-2xl font-bold text-gray-900">Reviews</h2><p class="text-sm text-gray-500 mt-1">Manage and respond to Google reviews.</p></div>

    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4 text-center"><p class="text-xs text-gray-500 uppercase">Average Rating</p><p class="text-3xl font-bold text-amber-500 mt-1">{avgRating}</p><div class="flex justify-center mt-1">{Array.from({ length: 5 }).map((_, i) => <svg class="w-4 h-4" fill={i < Math.round(Number(avgRating)) ? '#fbbf24' : '#e5e7eb'} viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}</div></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4 text-center"><p class="text-xs text-gray-500 uppercase">Total Reviews</p><p class="text-3xl font-bold text-gray-900 mt-1">{totalReviews}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4 text-center"><p class="text-xs text-gray-500 uppercase">Responded</p><p class="text-3xl font-bold text-green-600 mt-1">{responded}</p><p class="text-xs text-gray-400">{totalReviews > 0 ? Math.round((responded / totalReviews) * 100) : 0}%</p></div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">All Reviews</h3>
      {reviews.length > 0 ? (
        <div class="space-y-4">
          {reviews.map(r => (
            <div class="border rounded-lg p-4">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-500">{(r.author || '?').charAt(0)}</div>
                  <div>
                    <p class="text-sm font-medium text-gray-900">{r.author || 'Anonymous'}</p>
                    <p class="text-xs text-gray-400">{formatDate(r.reviewDate)}</p>
                  </div>
                </div>
                <div class="flex items-center gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => <svg class="w-4 h-4" fill={i < (r.rating || 0) ? '#fbbf24' : '#e5e7eb'} viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}
                </div>
              </div>
              {r.comment && <p class="text-sm text-gray-600 mb-3">{r.comment}</p>}
              {r.response ? (
                <div class="bg-blue-50 p-3 rounded-lg">
                  <p class="text-xs font-semibold text-blue-700 mb-1">Your Response</p>
                  <p class="text-xs text-gray-600">{r.response}</p>
                  <p class="text-[10px] text-gray-400 mt-1">{formatDate(r.responseAt)}</p>
                </div>
              ) : (
                <div class="flex gap-2 mt-2">
                  <input type="text" placeholder="Write a response..." class="flex-1 px-3 py-1.5 border border-gray-300 rounded-lg text-xs" id={`review-reply-${r.id}`} />
                  <button onclick={`respond(${r.id})`} class="px-3 py-1.5 text-xs font-medium text-white bg-primary-600 rounded-lg">Respond</button>
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-8">
          <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          <p class="text-lg font-semibold text-gray-900 mb-2">No reviews yet</p>
          <p class="text-sm text-gray-500">Reviews from your Google Business profile will appear here once connected.</p>
        </div>
      )}
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Quick Response Templates</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <button class="text-left p-3 border rounded-lg hover:border-primary-300 text-xs text-gray-600">Thank you for your kind words! We're delighted to hear about your positive experience at our school.</button>
        <button class="text-left p-3 border rounded-lg hover:border-primary-300 text-xs text-gray-600">We appreciate your feedback. Please contact us directly so we can address your concerns.</button>
        <button class="text-left p-3 border rounded-lg hover:border-primary-300 text-xs text-gray-600">Thank you for taking the time to share your experience. We're committed to continuous improvement.</button>
        <button class="text-left p-3 border rounded-lg hover:border-primary-300 text-xs text-gray-600">We're so glad you chose our school! Thank you for being part of our community.</button>
      </div>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.respond = async function(id) {
      var input = document.getElementById('review-reply-' + id);
      var response = input.value;
      if (!response) return;
      var res = await fetch('/api/dashboard/gmb', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'respond_review', reviewId: id, response: response }) });
      if (res.ok) window.location.reload();
    };
  })();`} />
</DashboardLayout>
