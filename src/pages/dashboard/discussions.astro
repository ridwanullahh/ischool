---
/**
 * Discussion Boards
 *
 * Threaded discussion boards per course. Teachers create boards,
 * students and teachers post and reply.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { discussionBoards, discussionPosts, courses, users } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';
import { pageGuard } from '../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'courses.view')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user.id);
const db = getDb();

const boards = schoolId
  ? await db.select().from(discussionBoards).where(eq(discussionBoards.schoolId, schoolId)).orderBy(desc(discussionBoards.createdAt)).all()
  : [];
const allCourses = schoolId ? await db.select().from(courses).where(eq(courses.schoolId, schoolId)).all() : [];
const allUsers = await db.select().from(users).all();
const allPosts = await db.select().from(discussionPosts).all();

const enrichedBoards = boards.map(b => {
  const course = b.courseId ? allCourses.find(c => c.id === b.courseId) : null;
  const boardPosts = allPosts.filter(p => p.boardId === b.id);
  const postCount = boardPosts.length;
  const lastPost = boardPosts.sort((a, b2) => new Date(b2.createdAt).getTime() - new Date(a.createdAt).getTime())[0] || null;
  const lastAuthor = lastPost ? allUsers.find(u => u.id === lastPost.authorId) : null;
  return { ...b, courseName: course?.title || 'General', postCount, lastPost, lastAuthorName: lastAuthor?.name };
});
const canManage = pageGuard(user, 'courses.create');

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
---

<DashboardLayout title="Discussion Boards - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Discussion Boards</h2>
        <p class="text-sm text-gray-500 mt-1">Threaded discussions for courses</p>
      </div>
      {canManage && (
        <button onclick="document.getElementById('createModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Board</button>
      )}
    </div>

    {enrichedBoards.length > 0 ? (
      <div class="space-y-3">
        {enrichedBoards.map(b => (
          <a href={'/dashboard/discussions/' + b.id} class="block bg-white rounded-xl border border-gray-200 p-5 hover:border-primary-200 hover:bg-primary-50/30">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-medium text-primary-600">{b.courseName}</span>
                  {b.locked && <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-600">LOCKED</span>}
                </div>
                <h3 class="text-sm font-semibold text-gray-900">{b.title}</h3>
                {b.description && <p class="text-xs text-gray-500 mt-1 line-clamp-2">{b.description}</p>}
                <div class="flex items-center gap-4 mt-2 text-xs text-gray-500">
                  <span>{b.postCount} post{b.postCount !== 1 ? 's' : ''}</span>
                  {b.lastAuthorName && <span>Last: {b.lastAuthorName} - {formatDate(b.lastPost?.createdAt)}</span>}
                </div>
              </div>
              <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        <p class="text-sm text-gray-500 mt-2">No discussion boards yet.</p>
      </div>
    )}
  </div>

  {/* Create board modal */}
  <div id="createModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">New Discussion Board</h3>
        <button onclick="document.getElementById('createModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="createForm" class="space-y-4">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title</label><input name="title" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Course (optional)</label><select name="courseId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="">General</option>{allCourses.map(c => <option value={c.id}>{c.title}</option>)}</select></div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create</button>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ schoolId }}>
    document.getElementById('createForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const fd = new FormData(this);
      const body = { schoolId, title: fd.get('title'), description: fd.get('description') || null, courseId: fd.get('courseId') ? parseInt(fd.get('courseId')) : null };
      const res = await fetch('/api/dashboard/discussions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) window.location.reload(); else alert('Failed to create board');
    });
  </script>
</DashboardLayout>
