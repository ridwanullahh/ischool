---
/**
 * Custom Report Builder
 *
 * Build custom reports by selecting fields from different modules,
 * with filters, grouping, and export to CSV/Excel.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { students, staff, attendance, invoices, payments, grades, enrollments, classes } from '../../lib/db/schema.js';
import { eq, desc, sql } from 'drizzle-orm';
import { pageGuard } from '../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'reports.view')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user.id);
const db = getDb();

// Available report types with their data sources
const reportTypes = [
  { id: 'students', label: 'Student Report', table: 'students', fields: ['first_name', 'last_name', 'student_id', 'email', 'phone', 'status', 'enrollment_date'] },
  { id: 'attendance', label: 'Attendance Report', table: 'attendance', fields: ['date', 'status', 'notes'] },
  { id: 'finance', label: 'Finance Report', table: 'invoices', fields: ['invoice_number', 'description', 'amount', 'amount_paid', 'balance', 'status', 'due_date'] },
  { id: 'payments', label: 'Payments Report', table: 'payments', fields: ['amount', 'method', 'reference', 'status', 'paid_at'] },
  { id: 'grades', label: 'Grades Report', table: 'grades', fields: ['assignment_title', 'score', 'max_score', 'grade', 'feedback'] },
  { id: 'staff', label: 'Staff Report', table: 'staff', fields: ['first_name', 'last_name', 'staff_id', 'department', 'designation', 'employment_type', 'status'] },
];

// Saved reports
const savedReports = schoolId
  ? await db.select().from(require('../../lib/db/schema.js').savedReports).where(eq(require('../../lib/db/schema.js').savedReports.schoolId, schoolId)).orderBy(desc(require('../../lib/db/schema.js').savedReports.createdAt)).all()
  : [];

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---

<DashboardLayout title="Custom Reports - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Custom Report Builder</h2>
        <p class="text-sm text-gray-500 mt-1">Build custom reports from your school data</p>
      </div>
      <button onclick="document.getElementById('reportModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Build Report</button>
    </div>

    {/* Saved Reports */}
    {savedReports.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-base font-semibold text-gray-900 mb-4">Saved Reports</h3>
        <div class="space-y-2">
          {savedReports.map(r => (
            <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg">
              <div>
                <p class="text-sm font-medium text-gray-900">{r.name}</p>
                <p class="text-xs text-gray-500">{r.type} - Created {formatDate(r.createdAt)}</p>
              </div>
              <div class="flex items-center gap-2">
                <button onclick={`runSavedReport(${r.id})`} class="px-3 py-1 text-xs font-medium text-primary-600 border border-primary-200 rounded hover:bg-primary-50">Run</button>
                <button onclick={`deleteReport(${r.id})`} class="px-3 py-1 text-xs font-medium text-red-600 border border-red-200 rounded hover:bg-red-50">Delete</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Quick reports */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {reportTypes.map(rt => (
        <button onclick={`quickReport('${rt.id}')`} class="bg-white rounded-xl border border-gray-200 p-5 text-left hover:border-primary-300 hover:shadow-md transition-all">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background:color-mix(in srgb, var(--primary, #2563eb) 10%, transparent)">
              <svg class="w-5 h-5" style="color:var(--primary, #2563eb)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-gray-900">{rt.label}</h3>
          </div>
          <p class="text-xs text-gray-500">{rt.fields.length} fields available</p>
        </button>
      ))}
    </div>

    {/* Report results */}
    <div id="reportResults" class="hidden bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-gray-900" id="reportTitle">Report Results</h3>
        <div class="flex items-center gap-2">
          <button onclick="exportCSV()" class="px-3 py-1.5 text-xs font-medium text-green-700 border border-green-200 rounded-lg hover:bg-green-50">Export CSV</button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="reportTable">
          <thead><tr id="reportHeader"></tr></thead>
          <tbody id="reportBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  {/* Report builder modal */}
  <div id="reportModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Build Custom Report</h3>
        <button onclick="document.getElementById('reportModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="reportForm" class="space-y-4">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Report Name</label><input name="name" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Data Source</label><select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{reportTypes.map(rt => <option value={rt.id}>{rt.label}</option>)}</select></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-2">Fields to Include</label><div id="fieldCheckboxes" class="space-y-1 max-h-48 overflow-y-auto border border-gray-200 rounded-lg p-2"></div></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Save Report?</label><select name="save" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="true">Yes - Save for later</option><option value="false">No - Run once</option></select></div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Generate Report</button>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ schoolId, reportTypes }}>
    var currentReportData = [];

    // Update field checkboxes when type changes
    document.querySelector('[name="type"]')?.addEventListener('change', function() {
      var type = this.value;
      var rt = reportTypes.find(function(r) { return r.id === type; });
      var container = document.getElementById('fieldCheckboxes');
      if (!rt || !container) return;
      container.innerHTML = rt.fields.map(function(f) {
        return '<label class="flex items-center gap-2 p-1.5 hover:bg-gray-50 rounded cursor-pointer"><input type="checkbox" name="fields" value="' + f + '" checked class="w-4 h-4 rounded" /><span class="text-sm text-gray-700">' + f.replace(/_/g, ' ') + '</span></label>';
      }).join('');
    });

    // Trigger initial field load
    document.querySelector('[name="type"]')?.dispatchEvent(new Event('change'));

    document.getElementById('reportForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var fields = fd.getAll('fields');
      var body = { schoolId, name: fd.get('name'), type: fd.get('type'), fields: fields, save: fd.get('save') === 'true' };
      var res = await fetch('/api/dashboard/reports', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      var data = await res.json();
      if (res.ok && data.rows) {
        displayReport(data.rows, fields, body.name);
        document.getElementById('reportModal').classList.add('hidden');
      } else {
        alert(data.error || 'Failed to generate report');
      }
    });

    async function quickReport(type) {
      var rt = reportTypes.find(function(r) { return r.id === type; });
      if (!rt) return;
      var res = await fetch('/api/dashboard/reports', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ schoolId, type: type, fields: rt.fields, save: false }) });
      var data = await res.json();
      if (res.ok && data.rows) {
        displayReport(data.rows, rt.fields, rt.label);
      } else {
        alert(data.error || 'Failed');
      }
    }

    function displayReport(rows, fields, title) {
      currentReportData = rows;
      document.getElementById('reportTitle').textContent = title + ' (' + rows.length + ' records)';
      var headerEl = document.getElementById('reportHeader');
      headerEl.innerHTML = fields.map(function(f) { return '<th class="text-left py-2 px-3 font-medium text-gray-700 text-xs uppercase tracking-wider">' + f.replace(/_/g, ' ') + '</th>'; }).join('');
      var bodyEl = document.getElementById('reportBody');
      bodyEl.innerHTML = rows.map(function(row) {
        return '<tr class="hover:bg-gray-50 border-b border-gray-100">' + fields.map(function(f) {
          var val = row[f];
          if (val === null || val === undefined) val = '-';
          return '<td class="py-2 px-3 text-gray-900 text-xs">' + String(val) + '</td>';
        }).join('') + '</tr>';
      }).join('');
      document.getElementById('reportResults').classList.remove('hidden');
    }

    function exportCSV() {
      if (!currentReportData.length) return;
      var fields = Object.keys(currentReportData[0]);
      var csv = fields.join(',') + '\n';
      currentReportData.forEach(function(row) {
        csv += fields.map(function(f) {
          var val = String(row[f] || '');
          if (val.includes(',')) val = '"' + val.replace(/"/g, '""') + '"';
          return val;
        }).join(',') + '\n';
      });
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'report.csv';
      a.click();
      URL.revokeObjectURL(url);
    }

    async function runSavedReport(id) {
      var res = await fetch('/api/dashboard/reports?id=' + id, { method: 'GET' });
      var data = await res.json();
      if (res.ok && data.rows) {
        displayReport(data.rows, data.fields || Object.keys(data.rows[0] || {}), data.name);
      }
    }

    async function deleteReport(id) {
      if (!confirm('Delete this saved report?')) return;
      var res = await fetch('/api/dashboard/reports', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
      if (res.ok) window.location.reload();
    }
  </script>
</DashboardLayout>
