---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { cbtExams, cbtCandidates, cbtAttempts, cbtProctoringLogs, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const exams = await db.select().from(cbtExams).where(eq(cbtExams.schoolId, schoolId)).all();
const examIds = exams.map(e => e.id);

// All attempts with proctoring data
const attempts = examIds.length > 0
  ? await db.select({
      id: cbtAttempts.id, examId: cbtAttempts.examId, candidateId: cbtAttempts.candidateId,
      score: cbtAttempts.score, ipAddress: cbtAttempts.ipAddress, deviceFingerprint: cbtAttempts.deviceFingerprint,
      startedAt: cbtAttempts.startedAt, submittedAt: cbtAttempts.submittedAt, status: cbtAttempts.status,
      flags: cbtAttempts.flags, proctorNotes: cbtAttempts.proctorNotes,
      candidateName: cbtCandidates.name, candidateEmail: cbtCandidates.email,
      examTitle: cbtExams.title,
    }).from(cbtAttempts)
      .leftJoin(cbtCandidates, eq(cbtAttempts.candidateId, cbtCandidates.id))
      .leftJoin(cbtExams, eq(cbtAttempts.examId, cbtExams.id))
      .orderBy(desc(cbtAttempts.startedAt)).all()
    : [];

// Get all proctoring logs for stats
const allLogs = examIds.length > 0
  ? await db.select({
      id: cbtProctoringLogs.id, attemptId: cbtProctoringLogs.attemptId,
      eventType: cbtProctoringLogs.eventType, timestamp: cbtProctoringLogs.timestamp,
      severity: cbtProctoringLogs.severity, details: cbtProctoringLogs.details,
    }).from(cbtProctoringLogs).orderBy(desc(cbtProctoringLogs.timestamp)).limit(200).all()
  : [];

// Build flag summary per attempt
const attemptFlagCounts = new Map<number, number>();
for (const l of allLogs) {
  attemptFlagCounts.set(l.attemptId, (attemptFlagCounts.get(l.attemptId) || 0) + 1);
}

const stats = {
  totalAttempts: attempts.length,
  inProgress: attempts.filter(a => a.status === 'in_progress').length,
  submitted: attempts.filter(a => a.status === 'submitted').length,
  disqualified: attempts.filter(a => a.status === 'disqualified').length,
  totalFlags: allLogs.length,
  criticalFlags: allLogs.filter(l => l.severity === 'critical').length,
  uniqueIPs: new Set(attempts.filter(a => a.ipAddress).map(a => a.ipAddress)).size,
};

const eventTypeLabels: Record<string, string> = {
  tab_switch: 'Tab Switch', fullscreen_exit: 'Full-screen Exit', window_blur: 'Window Blur',
  copy_attempt: 'Copy Attempt', paste_attempt: 'Paste Attempt', right_click: 'Right Click',
  keyboard_shortcut: 'Keyboard Shortcut', face_not_detected: 'Face Not Detected',
  multiple_faces: 'Multiple Faces', audio_anomaly: 'Audio Anomaly',
  idle_timeout: 'Idle Timeout', connection_lost: 'Connection Lost', session_resume: 'Session Resume',
};
const eventTypeColors: Record<string, string> = {
  tab_switch: 'bg-amber-100 text-amber-700', fullscreen_exit: 'bg-red-100 text-red-700',
  window_blur: 'bg-amber-100 text-amber-700', copy_attempt: 'bg-red-100 text-red-700',
  paste_attempt: 'bg-red-100 text-red-700', right_click: 'bg-amber-100 text-amber-700',
  keyboard_shortcut: 'bg-amber-100 text-amber-700', face_not_detected: 'bg-purple-100 text-purple-700',
  multiple_faces: 'bg-red-100 text-red-700', audio_anomaly: 'bg-orange-100 text-orange-700',
  idle_timeout: 'bg-gray-100 text-gray-700', connection_lost: 'bg-blue-100 text-blue-700',
  session_resume: 'bg-green-100 text-green-700',
};
const severityColors: Record<string, string> = { info: 'bg-blue-100 text-blue-700', warning: 'bg-amber-100 text-amber-700', critical: 'bg-red-100 text-red-700' };
const statusColors: Record<string, string> = { in_progress: 'bg-amber-100 text-amber-700', submitted: 'bg-green-100 text-green-700', graded: 'bg-blue-100 text-blue-700', disqualified: 'bg-red-100 text-red-700' };
const fmtDate = (d: any) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
---

<DashboardLayout title="Proctoring Dashboard - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Proctoring & Integrity Dashboard</h2>
      <p class="text-sm text-gray-500 mt-1">Live monitoring of CBT attempts, proctoring flags, IP/device tracking, and integrity reports.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Attempts</div><div class="text-2xl font-bold">{stats.totalAttempts}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Proctoring Flags</div><div class="text-2xl font-bold text-amber-600">{stats.totalFlags}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Critical Flags</div><div class="text-2xl font-bold text-red-600">{stats.criticalFlags}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Unique IPs</div><div class="text-2xl font-bold text-blue-600">{stats.uniqueIPs}</div></div>
    </div>

    {/* Attempts table */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">CBT Attempts with Proctoring Data</div>
      {attempts.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No CBT attempts recorded yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Candidate</th><th class="px-4 py-3">Exam</th>
              <th class="px-4 py-3">Started</th><th class="px-4 py-3">Submitted</th>
              <th class="px-4 py-3">IP Address</th><th class="px-4 py-3">Device FP</th>
              <th class="px-4 py-3">Flags</th><th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {attempts.map(a => {
                const flagCount = attemptFlagCounts.get(a.id) || 0;
                return (
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium text-gray-900">{a.candidateName}<div class="text-xs text-gray-500">{a.candidateEmail || ''}</div></td>
                    <td class="px-4 py-3 text-gray-700">{a.examTitle || '—'}</td>
                    <td class="px-4 py-3 text-gray-600 text-xs">{fmtDate(a.startedAt)}</td>
                    <td class="px-4 py-3 text-gray-600 text-xs">{fmtDate(a.submittedAt)}</td>
                    <td class="px-4 py-3 text-gray-600 text-xs font-mono">{a.ipAddress || '—'}</td>
                    <td class="px-4 py-3 text-gray-600 text-xs font-mono">{a.deviceFingerprint ? a.deviceFingerprint.substring(0, 12) + '…' : '—'}</td>
                    <td class="px-4 py-3">
                      {flagCount > 0 ? (
                        <button onclick={`viewFlags(${a.id})`} class={`text-xs font-bold uppercase px-2 py-0.5 rounded ${flagCount > 5 ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>{flagCount} flag{flagCount !== 1 ? 's' : ''}</button>
                      ) : (
                        <span class="text-xs text-green-600">✓ Clean</span>
                      )}
                    </td>
                    <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[a.status]}`}>{a.status.replace('_', ' ')}</span></td>
                    <td class="px-4 py-3">
                      <button onclick={`addNote(${a.id})`} class="text-xs text-blue-600 font-medium">Note</button>
                      {a.status !== 'disqualified' && <button onclick={`disqualify(${a.id})`} class="text-xs text-red-600 font-medium ml-2">Disqualify</button>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    {/* Recent proctoring events */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Recent Proctoring Events (Last 200)</div>
      {allLogs.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No proctoring events recorded.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Time</th><th class="px-4 py-3">Event Type</th>
              <th class="px-4 py-3">Severity</th><th class="px-4 py-3">Attempt</th>
              <th class="px-4 py-3">Details</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {allLogs.slice(0, 50).map(l => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-gray-600 text-xs">{fmtDate(l.timestamp)}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${eventTypeColors[l.eventType] || 'bg-gray-100 text-gray-700'}`}>{eventTypeLabels[l.eventType] || l.eventType}</span></td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${severityColors[l.severity]}`}>{l.severity}</span></td>
                  <td class="px-4 py-3 text-gray-600">#{l.attemptId}</td>
                  <td class="px-4 py-3 text-gray-600 text-xs">{l.details || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* View flags modal */}
  <div id="flagsModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-gray-900">Proctoring Flags</h3>
        <button onclick="document.getElementById('flagsModal').classList.add('hidden')" class="text-gray-400 text-2xl">&times;</button>
      </div>
      <div id="flagsList" class="space-y-2"></div>
    </div>
  </div>

  <div id="noteModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Add Proctor Note</h3>
      <form id="noteForm" class="space-y-3">
        <input type="hidden" name="attemptId" />
        <textarea name="notes" rows="4" placeholder="e.g. Student appeared distracted. Verbal warning issued at 14:32." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('noteModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save Note</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    var eventTypeLabels = { tab_switch: 'Tab Switch', fullscreen_exit: 'Full-screen Exit', window_blur: 'Window Blur', copy_attempt: 'Copy Attempt', paste_attempt: 'Paste Attempt', right_click: 'Right Click', keyboard_shortcut: 'Keyboard Shortcut', face_not_detected: 'Face Not Detected', multiple_faces: 'Multiple Faces', audio_anomaly: 'Audio Anomaly', idle_timeout: 'Idle Timeout', connection_lost: 'Connection Lost', session_resume: 'Session Resume' };
    var severityColors = { info: 'bg-blue-100 text-blue-700', warning: 'bg-amber-100 text-amber-700', critical: 'bg-red-100 text-red-700' };

    window.viewFlags = async function(attemptId) {
      var res = await fetch('/api/dashboard/cbt-candidates?action=proctoring_logs&attemptId=' + attemptId);
      var logs = await res.json();
      var list = document.getElementById('flagsList');
      list.innerHTML = '';
      if (logs.length === 0) {
        list.innerHTML = '<p class="text-sm text-gray-500 text-center py-4">No flags recorded.</p>';
      } else {
        logs.forEach(function(l) {
          var div = document.createElement('div');
          div.className = 'border rounded p-3';
          div.innerHTML = '<div class="flex items-center justify-between mb-1"><span class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-700">' + (eventTypeLabels[l.eventType] || l.eventType) + '</span><span class="text-xs font-bold uppercase px-2 py-0.5 rounded ' + (severityColors[l.severity] || '') + '">' + l.severity + '</span></div><div class="text-xs text-gray-500">' + new Date(l.timestamp).toLocaleString() + '</div>' + (l.details ? '<div class="text-xs text-gray-600 mt-1">' + l.details + '</div>' : '');
          list.appendChild(div);
        });
      }
      document.getElementById('flagsModal').classList.remove('hidden');
    };
    window.addNote = function(attemptId) {
      document.getElementById('noteForm').attemptId.value = attemptId;
      document.getElementById('noteModal').classList.remove('hidden');
    };
    window.disqualify = async function(attemptId) {
      if (!confirm('Disqualify this attempt? The candidate will not be able to retake.')) return;
      await fetch('/api/dashboard/cbt-candidates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'disqualify', attemptId: attemptId }) });
      window.location.reload();
    };
    document.getElementById('noteForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/cbt-candidates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'add_proctor_note', attemptId: parseInt(fd.get('attemptId')), notes: fd.get('notes') }) });
      if (res.ok) window.location.reload();
    });
  })();`} />
</DashboardLayout>
