---
// Static shell (zero-workers deployment): dashboard landing redirects the
// authenticated user to their role portal client-side (lb-runtime.js).
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Dashboard - iSchool">
  <div id="lb-shell-banner" class="hidden"></div>
  <div id="lb-workspace"></div>
</DashboardLayout>
<script is:inline define:vars={{ shellMode: "stats", shellCollection: "dashboard", shellTitle: "Dashboard", shellRoles: ["school_admin","super_admin","teacher","student","parent"] }}>
  window.LB_SHELL = { mode: shellMode, collection: shellCollection, title: shellTitle, roles: shellRoles };
</script>
