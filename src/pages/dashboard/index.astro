---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db/index.js';
import {
  announcements, blogPosts, classes, contactSubmissions, galleryItems, faqs,
  students, staff, courses, invoices, payments, attendance, events, messages,
  libraryBooks, vehicles, assets,
} from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = user.schoolId ?? null;

let cmsStats = { announcements: 0, posts: 0, classes: 0, submissions: 0, gallery: 0, faqs: 0 };
let moduleStats = { students: 0, staff: 0, courses: 0, revenue: 0, pendingPayments: 0, events: 0, messages: 0, books: 0, vehicles: 0, assets: 0, exams: 0, todayAttendance: 0 };
let recentActivity: any[] = [];

if (schoolId) {
  const db = getDb();
  try {
    const countOf = async (table: any): Promise<number> => {
      try {
        const rows = await db.select().from(table).where(eq(table.schoolId, schoolId)).all();
        return Array.isArray(rows) ? rows.length : 0;
      } catch { return 0; }
    };

    cmsStats = {
      announcements: await countOf(announcements),
      posts: await countOf(blogPosts),
      classes: await countOf(classes),
      submissions: await countOf(contactSubmissions),
      gallery: await countOf(galleryItems),
      faqs: await countOf(faqs),
    };

    moduleStats = {
      students: await countOf(students),
      staff: await countOf(staff),
      courses: await countOf(courses),
      revenue: 0,
      pendingPayments: 0,
      events: await countOf(events),
      messages: await countOf(messages),
      books: await countOf(libraryBooks),
      vehicles: await countOf(vehicles),
      assets: await countOf(assets),
      exams: 0,
      todayAttendance: 0,
    };

    try {
      const paymentRows = await db.select().from(payments).where(eq(payments.schoolId, schoolId)).all();
      moduleStats.revenue = (paymentRows || []).reduce((sum: number, p: any) => {
        const amt = typeof p.amount === 'number' ? p.amount : Number(p.amount) || 0;
        return sum + amt;
      }, 0);
    } catch { /* ignore */ }

    try {
      const invoiceRows = await db.select().from(invoices).where(eq(invoices.schoolId, schoolId)).all();
      moduleStats.pendingPayments = (invoiceRows || []).filter((i: any) => i.status !== 'paid').length;
    } catch { /* ignore */ }

    try {
      const today = new Date().toISOString().split('T')[0];
      const attRows = await db.select().from(attendance).where(eq(attendance.schoolId, schoolId)).all();
      moduleStats.todayAttendance = (attRows || []).filter((a: any) => {
        if (!a.date) return false;
        const ds = typeof a.date === 'string' ? a.date : new Date(a.date).toISOString().split('T')[0];
        return ds === today;
      }).length;
    } catch { /* ignore */ }

    const [recentStudents, recentEvents, recentCourses] = await Promise.all([
      db.select().from(students).where(eq(students.schoolId, schoolId)).orderBy(desc(students.createdAt)).limit(3).all().catch(() => []),
      db.select().from(events).where(eq(events.schoolId, schoolId)).orderBy(desc(events.createdAt)).limit(3).all().catch(() => []),
      db.select().from(courses).where(eq(courses.schoolId, schoolId)).orderBy(desc(courses.createdAt)).limit(3).all().catch(() => []),
    ]);

    const fmt = (arr: any[], type: string) => (arr || []).map((r: any) => ({
      type,
      name: r.title || [r.firstName, r.lastName].filter(Boolean).join(' ') || r.name || 'Untitled',
      date: r.createdAt || r.created_at,
    }));

    recentActivity = [...fmt(recentStudents, 'student'), ...fmt(recentEvents, 'event'), ...fmt(recentCourses, 'course')]
      .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime())
      .slice(0, 6);
  } catch (e: any) {
    console.error('Dashboard stats error:', e?.message || e);
  }
}

const userDisplayName: string = (() => {
  const name = (user as any)?.name || (user as any)?.email || 'User';
  return String(name).split(' ')[0];
})();

const quickActions = [
  { label: 'Add Student', href: '/dashboard/students', icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z' },
  { label: 'Create Course', href: '/dashboard/courses', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { label: 'Attendance', href: '/dashboard/attendance', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
  { label: 'Send Message', href: '/dashboard/messages', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { label: 'Record Payment', href: '/dashboard/payments', icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z' },
  { label: 'Schedule Event', href: '/dashboard/events', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
];
---

<DashboardLayout title="Dashboard - iSchool">
  
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
    <div class="lg:col-span-2 mosaic-card mosaic-glow p-6 lg:p-8 relative overflow-hidden" style="background: linear-gradient(135deg, var(--mosaic-surface) 0%, var(--mosaic-surface-2) 100%);">
      <div class="relative z-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider" style="background: rgba(5,179,77,0.1); color: #05B34D;">
            <span class="w-1.5 h-1.5 rounded-full mr-1.5" style="background: #05B34D;"></span>
            Live
          </span>
          <span class="text-xs font-medium" style="color: var(--mosaic-text-muted);">{new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}</span>
        </div>
        <h2 class="text-2xl lg:text-3xl font-bold mb-2" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">
          Welcome back, <span class="mosaic-gradient-text">{userDisplayName}</span>
        </h2>
        <p class="text-sm" style="color: var(--mosaic-text-muted);">Here's what's happening at your school today.</p>
      </div>
      <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full opacity-20" style="background: radial-gradient(circle, #05B34D 0%, transparent 70%);"></div>
      <div class="absolute -bottom-8 -right-8 w-32 h-32 rounded-full opacity-10" style="background: radial-gradient(circle, #F2B91C 0%, transparent 70%);"></div>
    </div>

    <div class="mosaic-card p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-bold uppercase tracking-wider" style="color: var(--mosaic-text-subtle);">Today's Summary</h3>
        <svg class="w-4 h-4" style="color: var(--mosaic-text-subtle);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="p-3 rounded-xl" style="background: var(--mosaic-surface-2);">
          <p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">Students</p>
          <p class="text-xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{moduleStats.students}</p>
        </div>
        <div class="p-3 rounded-xl" style="background: var(--mosaic-surface-2);">
          <p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">Staff</p>
          <p class="text-xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{moduleStats.staff}</p>
        </div>
        <div class="p-3 rounded-xl" style="background: var(--mosaic-surface-2);">
          <p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">Courses</p>
          <p class="text-xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{moduleStats.courses}</p>
        </div>
        <div class="p-3 rounded-xl" style="background: linear-gradient(135deg, rgba(5,179,77,0.1) 0%, rgba(5,179,77,0.02) 100%);">
          <p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color: #05B34D;">Attendance</p>
          <p class="text-xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: #05B34D;">{moduleStats.todayAttendance}</p>
        </div>
      </div>
    </div>
  </div>

  
  <div class="mb-6">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">Quick Actions</h3>
    </div>
    <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
      {quickActions.map(action => (
        <a href={action.href} class="mosaic-card p-4 flex flex-col items-center text-center group">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-2 transition-all group-hover:scale-110" style="background: linear-gradient(135deg, rgba(5,179,77,0.12) 0%, rgba(5,179,77,0.04) 100%);">
            <svg class="w-5 h-5" style="color: #05B34D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={action.icon} /></svg>
          </div>
          <p class="text-[11px] font-semibold" style="color: var(--mosaic-text);">{action.label}</p>
        </a>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    
    <div class="md:col-span-2 mosaic-card p-6 relative overflow-hidden">
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">Total Revenue</p>
            <p class="text-3xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">
              N{(moduleStats.revenue / 100).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
            </p>
          </div>
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center" style="background: linear-gradient(135deg, #05B34D 0%, #049940 100%); box-shadow: 0 6px 16px -4px rgba(5,179,77,0.4);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1V6m0 1c-1.11 0-2.08.402-2.599 1M12 6c.829 0 1.576.402 2.599 1M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/></svg>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold" style="background: rgba(5,179,77,0.1); color: #05B34D;">
            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
            Active
          </span>
          <span class="text-xs" style="color: var(--mosaic-text-muted);">{moduleStats.pendingPayments} pending invoices</span>
        </div>
      </div>
      <div class="absolute -bottom-8 -right-8 w-40 h-40 rounded-full opacity-5" style="background: #05B34D;"></div>
    </div>

    <a href="/dashboard/events" class="mosaic-card p-6 group">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3" style="background: rgba(99,102,241,0.1);">
        <svg class="w-5 h-5" style="color: #6366F1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">Events</p>
      <p class="text-2xl font-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{moduleStats.events}</p>
      <p class="text-xs" style="color: var(--mosaic-text-muted);">Scheduled events</p>
    </a>

    <a href="/dashboard/messages" class="mosaic-card p-6 group">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3" style="background: rgba(242,185,28,0.1);">
        <svg class="w-5 h-5" style="color: #F2B91C;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
      <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">Messages</p>
      <p class="text-2xl font-bold mb-1" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{moduleStats.messages}</p>
      <p class="text-xs" style="color: var(--mosaic-text-muted);">Total messages</p>
    </a>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
    {[
      { label: 'Announcements', count: cmsStats.announcements, href: '/dashboard/announcements', color: '#05B34D' },
      { label: 'Blog Posts', count: cmsStats.posts, href: '/dashboard/blog', color: '#6366F1' },
      { label: 'Classes', count: cmsStats.classes, href: '/dashboard/classes', color: '#F2B91C' },
      { label: 'Gallery', count: cmsStats.gallery, href: '/dashboard/gallery', color: '#EC4899' },
      { label: 'FAQs', count: cmsStats.faqs, href: '/dashboard/faqs', color: '#06B6D4' },
      { label: 'Submissions', count: cmsStats.submissions, href: '/dashboard/contacts', color: '#F97316' },
    ].map(card => (
      <a href={card.href} class="mosaic-card p-4 group">
        <p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color: var(--mosaic-text-subtle);">{card.label}</p>
        <p class="text-2xl font-bold mb-2" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{card.count}</p>
        <div class="h-1 rounded-full overflow-hidden" style="background: var(--mosaic-surface-2);">
          <div class="h-full rounded-full" style={`width: ${Math.min(card.count * 20, 100)}%; background: ${card.color};`}></div>
        </div>
      </a>
    ))}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 mosaic-card p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">Recent Activity</h3>
        <span class="text-[10px] font-medium px-2 py-1 rounded-full" style="background: var(--mosaic-surface-2); color: var(--mosaic-text-muted);">Last 6</span>
      </div>
      {recentActivity.length === 0 ? (
        <div class="text-center py-8">
          <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center mb-2" style="background: var(--mosaic-surface-2);">
            <svg class="w-6 h-6" style="color: var(--mosaic-text-subtle);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <p class="text-xs" style="color: var(--mosaic-text-muted);">No recent activity</p>
        </div>
      ) : (
        <div class="space-y-1">
          {recentActivity.map((item, i) => (
            <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-[10px] font-bold" style={`background: ${item.type === 'student' ? 'rgba(59,130,246,0.1)' : item.type === 'event' ? 'rgba(168,85,247,0.1)' : 'rgba(5,179,77,0.1)'}; color: ${item.type === 'student' ? '#3B82F6' : item.type === 'event' ? '#A855F7' : '#05B34D'};`}>
                {item.type === 'student' ? 'S' : item.type === 'event' ? 'E' : 'C'}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium truncate" style="color: var(--mosaic-text);">{item.name}</p>
                <p class="text-[11px]" style="color: var(--mosaic-text-muted);">{item.type === 'student' ? 'New student' : item.type === 'event' ? 'New event' : 'New course'}</p>
              </div>
              {item.date && (
                <span class="text-[11px] whitespace-nowrap" style="color: var(--mosaic-text-subtle);">{new Date(item.date).toLocaleDateString()}</span>
              )}
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="mosaic-card p-6">
      <h3 class="text-sm font-bold mb-4" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">Quick Links</h3>
      <div class="space-y-2">
        <a href="/dashboard/about" class="flex items-center gap-3 p-3 rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-slate-800 group" style="border: 1px solid var(--mosaic-border);">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(5,179,77,0.1);">
            <svg class="w-4 h-4" style="color: #05B34D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-semibold" style="color: var(--mosaic-text);">About Page</p>
            <p class="text-[11px]" style="color: var(--mosaic-text-muted);">Edit mission & vision</p>
          </div>
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 p-3 rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-slate-800 group" style="border: 1px solid var(--mosaic-border);">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(99,102,241,0.1);">
            <svg class="w-4 h-4" style="color: #6366F1;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-semibold" style="color: var(--mosaic-text);">Settings</p>
            <p class="text-[11px]" style="color: var(--mosaic-text-muted);">Theme & branding</p>
          </div>
        </a>
        <a href="/dashboard/ai-setup" class="flex items-center gap-3 p-3 rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-slate-800 group" style="border: 1px solid var(--mosaic-border);">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(168,85,247,0.1);">
            <svg class="w-4 h-4" style="color: #A855F7;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-semibold" style="color: var(--mosaic-text);">AI Content</p>
            <p class="text-[11px]" style="color: var(--mosaic-text-muted);">AI-powered setup</p>
          </div>
        </a>
        <a href="/dashboard/it-admin" class="flex items-center gap-3 p-3 rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-slate-800 group" style="border: 1px solid var(--mosaic-border);">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: rgba(249,115,22,0.1);">
