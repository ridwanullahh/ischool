---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../lib/school.js';
import { getDb } from '../../../lib/db/index.js';
import { staff } from '../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';
const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();
let allStaff: any[] = [];
if (schoolId) { try { allStaff = await db.select().from(staff).where(eq(staff.schoolId, schoolId)).all() || []; } catch {} }
---

<DashboardLayout title="New Class - iSchool">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/classes" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">New Class</h1>
        <p class="text-sm" style="color:var(--mosaic-text-muted);">Create a new class or section</p>
      </div>
    </div>
    <form method="POST" action="/api/dashboard/classes" class="mosaic-card p-6 lg:p-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Class Name *</label>
          <input type="text" name="name" required placeholder="Grade 5 - Section A" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Slug</label>
          <input type="text" name="slug" placeholder="grade-5-a" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" />
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Section</label>
          <input type="text" name="section" placeholder="A" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Grade Level</label>
          <input type="text" name="gradeLevel" placeholder="Grade 5" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Capacity</label>
          <input type="number" name="capacity" placeholder="25" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Homeroom Teacher</label>
        <select name="homeroomTeacherId" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);">
          <option value="">Select teacher</option>
          {allStaff.map(s => <option value={s.id}>{s.firstName||s.first_name||''} {s.lastName||s.last_name||''}</option>)}
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Description</label>
        <textarea name="description" rows="3" placeholder="Class description..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);"></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Image URL</label>
        <input type="text" name="imageUrl" placeholder="https://..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" />
      </div>
      <div class="flex items-center gap-3 pt-4" style="border-top:1px solid var(--mosaic-border);">
        <button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Create Class</button>
        <a href="/dashboard/classes" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">Cancel</a>
      </div>
    </form>
  </div>
</DashboardLayout>
