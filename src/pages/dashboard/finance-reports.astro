---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { invoices, payments, students, feeStructures, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, sql, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// KPIs
const totalCollected = db.select({ total: sql<number>`coalesce(sum(${payments.amount}), 0)` })
  .from(payments).where(and(eq(payments.schoolId, schoolId), eq(payments.status, 'completed'))).all()[0]?.total || 0;
const totalOutstanding = db.select({ total: sql<number>`coalesce(sum(${invoices.balance}), 0)` })
  .from(invoices).where(eq(invoices.schoolId, schoolId)).all()[0]?.total || 0;
const totalDiscounts = db.select({ total: sql<number>`coalesce(sum(${invoices.discount}), 0)` })
  .from(invoices).where(eq(invoices.schoolId, schoolId)).all()[0]?.total || 0;
const totalFines = db.select({ total: sql<number>`coalesce(sum(${invoices.fine}), 0)` })
  .from(invoices).where(eq(invoices.schoolId, schoolId)).all()[0]?.total || 0;

// Aging analysis (overdue invoices grouped by age bucket)
const today = new Date().toISOString().split('T')[0];
const allInvoices = db.select().from(invoices).where(eq(invoices.schoolId, schoolId)).all();
const overdueBuckets = { current: 0, '1-30': 0, '31-60': 0, '61-90': 0, '90+': 0 };
for (const inv of allInvoices) {
  if (inv.status === 'paid' || inv.balance === 0) continue;
  if (!inv.dueDate) { overdueBuckets.current += inv.balance || 0; continue; }
  const due = new Date(inv.dueDate);
  const days = Math.floor((Date.now() - due.getTime()) / (1000 * 60 * 60 * 24));
  if (days <= 0) overdueBuckets.current += inv.balance || 0;
  else if (days <= 30) overdueBuckets['1-30'] += inv.balance || 0;
  else if (days <= 60) overdueBuckets['31-60'] += inv.balance || 0;
  else if (days <= 90) overdueBuckets['61-90'] += inv.balance || 0;
  else overdueBuckets['90+'] += inv.balance || 0;
}

// Payment method breakdown
const methodBreakdown = db.select({
  method: payments.method,
  total: sql<number>`coalesce(sum(${payments.amount}), 0)`,
  count: sql<number>`count(*)`,
}).from(payments)
  .where(and(eq(payments.schoolId, schoolId), eq(payments.status, 'completed')))
  .groupBy(payments.method).all();
const totalMethodSum = methodBreakdown.reduce((s, m) => s + m.total, 0) || 1;

// Recent payments
const recentPayments = db.select({
  id: payments.id, amount: payments.amount, method: payments.method, reference: payments.reference,
  paidAt: payments.paidAt, invoiceNumber: invoices.invoiceNumber,
  studentName: students.firstName, studentLastName: students.lastName, studentCode: students.studentId,
}).from(payments)
  .leftJoin(invoices, eq(payments.invoiceId, invoices.id))
  .leftJoin(students, eq(invoices.studentId, students.id))
  .where(eq(payments.schoolId, schoolId))
  .orderBy(desc(payments.paidAt)).limit(10).all();

// Collection by month (last 6 months)
const monthlyCollection: { month: string, total: number }[] = [];
for (let i = 5; i >= 0; i--) {
  const d = new Date(); d.setMonth(d.getMonth() - i);
  const monthStart = new Date(d.getFullYear(), d.getMonth(), 1).getTime();
  const monthEnd = new Date(d.getFullYear(), d.getMonth() + 1, 1).getTime();
  const monthPayments = db.select().from(payments)
    .where(and(eq(payments.schoolId, schoolId), eq(payments.status, 'completed'))).all()
    .filter(p => p.paidAt && new Date(p.paidAt).getTime() >= monthStart && new Date(p.paidAt).getTime() < monthEnd);
  monthlyCollection.push({
    month: d.toLocaleDateString('en-US', { month: 'short' }),
    total: monthPayments.reduce((s, p) => s + (p.amount || 0), 0),
  });
}
const maxMonthly = Math.max(...monthlyCollection.map(m => m.total), 1);

const fmtMoney = (n: any) => '₦' + (n || 0).toLocaleString();
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—';
const methodColors: Record<string, string> = {
  cash: 'bg-green-500', bank_transfer: 'bg-blue-500', stripe: 'bg-purple-500',
  paystack: 'bg-amber-500', flutterwave: 'bg-orange-500', paypal: 'bg-cyan-500', other: 'bg-gray-500',
};
const methodLabels: Record<string, string> = {
  cash: 'Cash', bank_transfer: 'Bank Transfer', stripe: 'Stripe (Card)',
  paystack: 'Paystack', flutterwave: 'Flutterwave', paypal: 'PayPal', other: 'Other',
};
---

<DashboardLayout title="Financial Reports - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Financial Reports</h2>
        <p class="text-sm text-gray-500 mt-1">Fee collection summary, outstanding aging analysis, revenue trends, and payment method breakdown.</p>
      </div>
      <button onclick="window.print()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Print / PDF</button>
    </div>

    {/* KPI Cards */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Total Collected</div>
        <div class="text-2xl font-bold text-green-600">{fmtMoney(totalCollected)}</div>
      </div>
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Outstanding</div>
        <div class="text-2xl font-bold text-red-600">{fmtMoney(totalOutstanding)}</div>
      </div>
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Total Discounts</div>
        <div class="text-2xl font-bold text-blue-600">{fmtMoney(totalDiscounts)}</div>
      </div>
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Late Fines</div>
        <div class="text-2xl font-bold text-amber-600">{fmtMoney(totalFines)}</div>
      </div>
    </div>

    {/* Collection trend */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">6-Month Collection Trend</h3>
      <div class="flex items-end gap-3 h-40">
        {monthlyCollection.map(m => (
          <div class="flex-1 flex flex-col items-center">
            <div class="text-xs font-bold text-gray-700 mb-1">{m.total > 0 ? fmtMoney(m.total) : ''}</div>
            <div class="w-full bg-gray-100 rounded-t" style={`height: ${(m.total / maxMonthly) * 100}%; min-height: 4px`}>
              <div class="h-full bg-gradient-to-t from-primary-500 to-primary-400 rounded-t"></div>
            </div>
            <div class="text-xs text-gray-500 mt-2">{m.month}</div>
          </div>
        ))}
      </div>
    </div>

    {/* Aging + Method breakdown */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {/* Aging analysis */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Outstanding Aging Analysis</h3>
        <div class="space-y-2">
          <div class="flex justify-between items-center p-3 bg-green-50 rounded">
            <span class="text-sm text-gray-700">Current (not yet due)</span>
            <span class="font-bold text-green-700">{fmtMoney(overdueBuckets.current)}</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-amber-50 rounded">
            <span class="text-sm text-gray-700">1-30 days overdue</span>
            <span class="font-bold text-amber-700">{fmtMoney(overdueBuckets['1-30'])}</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-orange-50 rounded">
            <span class="text-sm text-gray-700">31-60 days overdue</span>
            <span class="font-bold text-orange-700">{fmtMoney(overdueBuckets['31-60'])}</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-red-50 rounded">
            <span class="text-sm text-gray-700">61-90 days overdue</span>
            <span class="font-bold text-red-700">{fmtMoney(overdueBuckets['61-90'])}</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-red-100 rounded">
            <span class="text-sm text-gray-700 font-medium">90+ days overdue</span>
            <span class="font-bold text-red-800">{fmtMoney(overdueBuckets['90+'])}</span>
          </div>
        </div>
      </div>

      {/* Method breakdown */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Payment Method Breakdown</h3>
        {methodBreakdown.length === 0 ? (
          <p class="text-sm text-gray-500 text-center py-8">No payments recorded yet.</p>
        ) : (
          <div class="space-y-3">
            {methodBreakdown.map(m => (
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span class="text-gray-700">{methodLabels[m.method] || m.method}</span>
                  <span class="font-medium text-gray-900">{fmtMoney(m.total)} <span class="text-xs text-gray-500">({m.count})</span></span>
                </div>
                <div class="h-2 bg-gray-100 rounded">
                  <div class={`h-full ${methodColors[m.method] || 'bg-gray-500'} rounded`} style={`width: ${(m.total / totalMethodSum) * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    {/* Recent payments */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Recent Payments</div>
      {recentPayments.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No payments recorded.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Date</th><th class="px-4 py-3">Student</th>
              <th class="px-4 py-3">Invoice</th><th class="px-4 py-3">Method</th>
              <th class="px-4 py-3">Reference</th><th class="px-4 py-3">Amount</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {recentPayments.map(p => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-gray-600">{fmtDate(p.paidAt)}</td>
                  <td class="px-4 py-3 font-medium text-gray-900">{p.studentName} {p.studentLastName}</td>
                  <td class="px-4 py-3 text-gray-600">{p.invoiceNumber || '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded text-white ${methodColors[p.method] || 'bg-gray-500'}`}>{methodLabels[p.method] || p.method}</span></td>
                  <td class="px-4 py-3 text-gray-600 text-xs">{p.reference || '—'}</td>
                  <td class="px-4 py-3 font-bold text-green-700">{fmtMoney(p.amount)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
