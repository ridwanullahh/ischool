---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import { getUserSchool } from '../../lib/school.js';
import { generateDefaultPalette } from '../../lib/palette.js';
import { socialPlatforms } from '../../lib/social.js';
import { listV2Themes } from '../../themes/index.js';
import { PALETTE_PRESETS } from '../../lib/palette-presets.js';
import { FONT_PRESETS } from '../../lib/font-presets.js';

// Issue #1: theme selector shows ONLY the newly reimplemented v3 themes.
// Sort: ready themes first (alphabetically), then coming_soon themes (alphabetically)
const v3Themes = listV2Themes().sort((a, b) => {
  const aReady = a.status === 'ready' ? 0 : 1;
  const bReady = b.status === 'ready' ? 0 : 1;
  if (aReady !== bReady) return aReady - bReady;
  return a.label.localeCompare(b.label);
});

const user = Astro.locals.user!;
const school = getUserSchool(user);
const success = Astro.url.searchParams.get('success');

const settings = (school?.settings as any) || {};
const palette = settings.palette || {};
const fontPresetId = settings.fontPresetId || '';
const socialHandles = (school?.socialHandles as Record<string, string>) || {};
const defaultPalette = generateDefaultPalette(school?.primaryColor || '#2563eb');
---

<DashboardLayout title="Settings - iSchool">
  {success && (
    <div class="mb-6 p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-700">Settings saved successfully.</div>
  )}

  <form method="POST" action="/api/dashboard/settings" class="space-y-6">
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">General</h2>
      <div class="space-y-4">
        <Input label="School Name" name="name" value={school?.name || ''} required />
        <Input label="Tagline" name="tagline" value={school?.tagline || ''} placeholder="A short description of your school" />
        <Input label="URL Slug" name="slug" value={school?.slug || ''} required />
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Default Language</label>
          <select name="locale" class="w-full block rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-600 focus:outline-none focus:ring-1 focus:ring-primary-600">
            <option value="en" selected={(school?.locale || 'en') === 'en'}>English</option>
            <option value="ar" selected={school?.locale === 'ar'}>العربية (Arabic)</option>
            <option value="fr" selected={school?.locale === 'fr'}>Français (French)</option>
            <option value="es" selected={school?.locale === 'es'}>Español (Spanish)</option>
            <option value="de" selected={school?.locale === 'de'}>Deutsch (German)</option>
            <option value="ur" selected={school?.locale === 'ur'}>اردو (Urdu)</option>
            <option value="tr" selected={school?.locale === 'tr'}>Türkçe (Turkish)</option>
            <option value="id" selected={school?.locale === 'id'}>Bahasa Indonesia</option>
            <option value="ha" selected={school?.locale === 'ha'}>Hausa</option>
          </select>
          <p class="text-xs text-gray-500 mt-1">Sets the default language and text direction for your school website</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Branding</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Logo</label>
          <div class="flex items-center gap-3">
            <input type="text" name="logoUrl" id="logoUrl" value={school?.logoUrl || ''} placeholder="Upload or paste URL..." class="flex-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-600 focus:outline-none focus:ring-1 focus:ring-primary-600" />
            <label class="cursor-pointer bg-gray-100 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-200 text-sm font-medium">
              Upload
              <input type="file" accept="image/*" class="hidden" onchange="uploadFile(this, 'logoUrl', 'branding')" />
            </label>
          </div>
          {school?.logoUrl && <img src={school.logoUrl} alt="Logo" class="mt-2 h-12 object-contain rounded" />}
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Favicon</label>
          <div class="flex items-center gap-3">
            <input type="text" name="faviconUrl" id="faviconUrl" value={school?.faviconUrl || ''} placeholder="Upload or paste URL..." class="flex-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-600 focus:outline-none focus:ring-1 focus:ring-primary-600" />
            <label class="cursor-pointer bg-gray-100 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-200 text-sm font-medium">
              Upload
              <input type="file" accept="image/*" class="hidden" onchange="uploadFile(this, 'faviconUrl', 'branding')" />
            </label>
          </div>
          {school?.faviconUrl && <img src={school.faviconUrl} alt="Favicon" class="mt-2 h-8 w-8 object-contain rounded" />}
        </div>
        <div class="space-y-1">
          <label class="block text-sm font-medium text-gray-700">Primary Color</label>
          <div class="flex items-center gap-3">
            <input type="color" name="primaryColor" value={school?.primaryColor || '#2563eb'} class="w-10 h-10 rounded border border-gray-300 cursor-pointer" id="primaryColorPicker" />
            <span class="text-sm text-gray-500" id="primaryColorLabel">{school?.primaryColor || '#2563eb'}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base font-semibold text-gray-900">Color Palette</h2>
        <button type="button" id="autoGeneratePalette" class="text-sm text-primary-600 hover:text-primary-700 font-medium">Auto-generate from primary</button>
      </div>
      <p class="text-xs text-gray-500 mb-4">Customize colors for light and dark modes. Leave blank to use auto-generated defaults.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          { key: 'accent', label: 'Accent' },
          { key: 'backgroundLight', label: 'Background (Light)' },
          { key: 'backgroundDark', label: 'Background (Dark)' },
          { key: 'surfaceLight', label: 'Surface (Light)' },
          { key: 'surfaceDark', label: 'Surface (Dark)' },
          { key: 'textLight', label: 'Text (Light)' },
          { key: 'textDark', label: 'Text (Dark)' },
          { key: 'mutedLight', label: 'Muted (Light)' },
          { key: 'mutedDark', label: 'Muted (Dark)' },
          { key: 'borderLight', label: 'Border (Light)' },
          { key: 'borderDark', label: 'Border (Dark)' },
        ].map(item => (
          <div class="space-y-1">
            <label class="block text-xs font-medium text-gray-600">{item.label}</label>
            <div class="flex items-center gap-2">
              <input type="color" name={`palette_${item.key}`} value={palette[item.key] || defaultPalette[item.key as keyof typeof defaultPalette] || '#000000'} class="w-8 h-8 rounded border border-gray-300 cursor-pointer" />
              <span class="text-[11px] text-gray-400 truncate">{palette[item.key] || 'auto'}</span>
            </div>
          </div>
        ))}
      </div>

      {/* Palette Presets */}
      <div class="mt-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Predefined Palette Library</h3>
        <p class="text-xs text-gray-500 mb-4">Click a preset to apply a professionally curated color combination. You can still customize individual colors above after selecting a preset.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          {PALETTE_PRESETS.map(preset => (
            <button type="button" data-palette-preset={preset.id} class="relative flex flex-col p-3 rounded-lg border-2 cursor-pointer transition-all hover:border-primary-300" style={fontPresetId === preset.id ? 'border-color: var(--primary, #2563eb)' : 'border-color: #e5e7eb'}>
              <div class="flex items-center gap-1.5 mb-2">
                <div class="w-5 h-5 rounded-full" style={`background:${preset.palette.primary}`}></div>
                <div class="w-5 h-5 rounded-full" style={`background:${preset.palette.accent}`}></div>
                <div class="w-5 h-5 rounded-full border" style={`background:${preset.palette.backgroundLight};border-color:${preset.palette.borderLight}`}></div>
                <div class="w-5 h-5 rounded-full" style={`background:${preset.palette.backgroundDark}`}></div>
              </div>
              <span class="text-xs font-semibold text-gray-900">{preset.name}</span>
              <span class="text-[10px] text-gray-500 leading-tight mt-0.5">{preset.description}</span>
            </button>
          ))}
        </div>
        <input type="hidden" name="palettePresetId" id="palettePresetId" value="" />
      </div>
    </div>

    {/* Font Customization */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Typography</h2>
      <p class="text-xs text-gray-500 mb-4">Choose a font combination for your school website. Each preset has been curated for readability and aesthetics.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {FONT_PRESETS.map(font => (
          <button type="button" data-font-preset={font.id} class:list={[
            'relative flex flex-col p-4 rounded-lg border-2 cursor-pointer transition-all hover:border-primary-300 text-left',
            fontPresetId === font.id ? 'border-primary-500 bg-primary-50/30' : 'border-gray-200'
          ]}>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold text-gray-900">{font.name}</span>
              {fontPresetId === font.id && <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>}
            </div>
            <p class="text-lg mb-1" style={`font-family: '${font.headingFont}', sans-serif`}>Heading Sample</p>
            <p class="text-sm text-gray-600" style={`font-family: '${font.bodyFont}', sans-serif`}>Body text sample for readability.</p>
            <p class="text-[10px] text-gray-400 mt-2">{font.description}</p>
          </button>
        ))}
      </div>
      <input type="hidden" name="fontPresetId" id="fontPresetId" value={fontPresetId} />
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base font-semibold text-gray-900">Theme</h2>
          <p class="text-xs text-gray-500 mt-1">Each theme has full layout autonomy with its own header, footer, and page designs. Ready themes are fully implemented; Coming Soon themes are stubs.</p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="px-2 py-1 rounded-full bg-green-100 text-green-700 font-medium">{v3Themes.filter(t => t.status === 'ready').length} ready</span>
          <span class="px-2 py-1 rounded-full bg-amber-100 text-amber-700 font-medium">{v3Themes.filter(t => t.status === 'coming_soon').length} coming soon</span>
        </div>
      </div>
      {v3Themes.length === 0 ? (
        <p class="text-sm text-gray-500 py-8 text-center">No v2 themes registered yet.</p>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {v3Themes.map(theme => {
            const isActive = school?.theme === theme.name;
            const primary = theme.defaultPrimaryColor || school?.primaryColor || '#2563eb';
            const isReady = theme.status === 'ready';
            const isComingSoon = theme.status === 'coming_soon';
            return (
              <label class:list={[
                'relative flex flex-col p-4 rounded-xl border-2 transition-all overflow-hidden',
                isComingSoon ? 'border-gray-100 opacity-60 cursor-not-allowed' : (isActive ? '' : 'border-gray-200 hover:border-gray-300 cursor-pointer')
              ]} style={isActive ? `border-color:${primary};background:${primary}08` : ''}>
                <input type="radio" name="theme" value={theme.name} checked={isActive} disabled={isComingSoon} class="sr-only" onchange="this.form.submit()" />
                <div class="w-full h-20 rounded-lg mb-3 flex items-center justify-center relative overflow-hidden" style={`background:linear-gradient(135deg, ${primary}18, ${primary}08)`}>
                  <svg class="w-8 h-8" fill="none" stroke={primary} viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={theme.iconPath} />
                  </svg>
                  <span class="absolute top-1.5 right-1.5 text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded" style={`color:${primary};background:${primary}15`}>{theme.category === 'mobile' ? 'Mobile' : theme.defaultMode === 'dark' ? 'Dark' : 'Light'}</span>
                  {isComingSoon && (
                    <span class="absolute bottom-1.5 left-1.5 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500 text-white">Coming Soon</span>
                  )}
                  {isReady && !isComingSoon && (
                    <span class="absolute bottom-1.5 left-1.5 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-green-500 text-white">Ready</span>
                  )}
                </div>
                <span class="text-sm font-semibold text-gray-900">{theme.label}</span>
                <span class="text-xs text-gray-500 mt-0.5 leading-snug">{theme.description}</span>
                <div class="mt-2 flex items-center gap-2">
                  <span class="text-[10px] font-medium uppercase tracking-wider text-gray-400">{theme.archetype}</span>
                </div>
                {school?.slug && !isComingSoon && (
                  <a href={`/${school.slug}?preview_theme=${theme.name}`} target="_blank" class="mt-2 text-[11px] font-medium hover:underline" style={`color:${primary}`}>Preview</a>
                )}
                {isActive && (
                  <span class="absolute top-2 right-2 w-5 h-5 rounded-full flex items-center justify-center" style={`background:${primary}`}>
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                )}
              </label>
            );
          })}
        </div>
      )}
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Social Handles</h2>
      <p class="text-xs text-gray-500 mb-4">Enter usernames, handles, or full URLs. Leave blank to hide.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {socialPlatforms.map(p => (
          <Input
            label={p.label}
            name={`social_${p.key}`}
            value={socialHandles[p.key] || ''}
            placeholder={p.key === 'email' ? 'email@school.com' : p.key === 'whatsapp' ? '+1234567890' : `@handle or URL`}
          />
        ))}
      </div>
    </div>

    <Button type="submit">Save Settings</Button>
  </form>

  <!-- CMS Module Control -->
  <div class="bg-white rounded-xl border border-gray-200 p-6 mt-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-base font-semibold text-gray-900">CMS Modules</h2>
        <p class="text-xs text-gray-500 mt-1">Enable or disable post types on your school's public website. Disabled modules are hidden from navigation and inaccessible.</p>
      </div>
    </div>
    <div id="cms-modules-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <div class="text-sm text-gray-500 col-span-full py-4 text-center">Loading modules...</div>
    </div>
  </div>

  <script>
    async function uploadFile(input: HTMLInputElement, fieldId: string, folder: string) {
      const file = input.files?.[0];
      if (!file) return;
      const fd = new FormData();
      fd.append('file', file);
      fd.append('folder', folder);
      const label = input.closest('label')!;
      const origText = label.textContent;
      label.textContent = 'Uploading...';
      try {
        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok && data[0]?.url) {
          (document.getElementById(fieldId) as HTMLInputElement).value = data[0].url;
        } else {
          alert(data.error || 'Upload failed');
        }
      } catch { alert('Upload failed'); }
      label.textContent = origText;
    }

    const btn = document.getElementById('autoGeneratePalette');
    const primaryInput = document.getElementById('primaryColorPicker') as HTMLInputElement;
    btn?.addEventListener('click', () => {
      const form = btn.closest('form');
      if (!form) return;
      const paletteInputs = form.querySelectorAll('input[name^="palette_"]');
      paletteInputs.forEach((input: any) => {
        input.value = '';
      });
    });
    primaryInput?.addEventListener('input', () => {
      const label = document.getElementById('primaryColorLabel');
      if (label) label.textContent = primaryInput.value;
    });

    // Palette preset selection
    document.querySelectorAll('[data-palette-preset]').forEach((btn) => {
      btn.addEventListener('click', function() {
        const presetId = this.getAttribute('data-palette-preset');
        document.getElementById('palettePresetId')?.setAttribute('value', presetId);
        // Visual feedback
        document.querySelectorAll('[data-palette-preset]').forEach(b => b.classList.remove('border-primary-500'));
        this.classList.add('border-primary-500');
      });
    });

    // Font preset selection
    document.querySelectorAll('[data-font-preset]').forEach((btn) => {
      btn.addEventListener('click', function() {
        const presetId = this.getAttribute('data-font-preset');
        const hidden = document.getElementById('fontPresetId') as HTMLInputElement;
        if (hidden) hidden.value = presetId;
        // Visual feedback
        document.querySelectorAll('[data-font-preset]').forEach(b => {
          b.classList.remove('border-primary-500', 'bg-primary-50/30');
          b.classList.add('border-gray-200');
        });
        this.classList.remove('border-gray-200');
        this.classList.add('border-primary-500', 'bg-primary-50/30');
      });
    });
  </script>

  <script is:inline set:html={`(function(){
    var moduleLabels = {
      'about': 'About Page', 'announcements': 'Announcements', 'programs': 'Programs',
      'classes': 'Classes', 'blog': 'Blog', 'gallery': 'Gallery', 'faqs': 'FAQs',
      'contact': 'Contact', 'admissions': 'Admissions', 'banners': 'Banners (Coming Soon)',
      'popups': 'Popups', 'forms': 'Form Builder'
    };
    var disabledModules = ['banners'];

    async function loadModules() {
      try {
        var res = await fetch('/api/dashboard/cms-modules');
        var data = await res.json();
        var modules = data.modules || {};
        var grid = document.getElementById('cms-modules-grid');
        if (!grid) return;
        grid.innerHTML = '';
        Object.keys(moduleLabels).forEach(function(key) {
          var enabled = modules[key] !== false;
          var isDisabled = disabledModules.includes(key);
          var card = document.createElement('div');
          card.className = 'flex items-center justify-between p-3 rounded-lg border ' + (isDisabled ? 'border-gray-100 opacity-60' : 'border-gray-200');
          card.innerHTML = '<div class="flex items-center gap-2"><span class="text-sm font-medium text-gray-700">' + moduleLabels[key] + '</span>' + (isDisabled ? '<span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">Coming Soon</span>' : '') + '</div>';
          if (!isDisabled) {
            var toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'relative inline-flex h-6 w-11 items-center rounded-full transition-colors ' + (enabled ? 'bg-primary-600' : 'bg-gray-300');
            toggle.innerHTML = '<span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform ' + (enabled ? 'translate-x-6' : 'translate-x-1') + '"></span>';
            toggle.setAttribute('data-module', key);
            toggle.setAttribute('data-enabled', enabled ? 'true' : 'false');
            toggle.addEventListener('click', function() { toggleModule(key, toggle); });
            card.appendChild(toggle);
          }
          grid.appendChild(card);
        });
      } catch (e) {
        var grid = document.getElementById('cms-modules-grid');
        if (grid) grid.innerHTML = '<p class="text-sm text-gray-500 col-span-full text-center">Failed to load modules.</p>';
      }
    }

    async function toggleModule(module, btn) {
      var currentEnabled = btn.getAttribute('data-enabled') === 'true';
      var newEnabled = !currentEnabled;
      btn.setAttribute('data-enabled', newEnabled ? 'true' : 'false');
      btn.className = 'relative inline-flex h-6 w-11 items-center rounded-full transition-colors ' + (newEnabled ? 'bg-primary-600' : 'bg-gray-300');
      btn.querySelector('span').className = 'inline-block h-4 w-4 transform rounded-full bg-white transition-transform ' + (newEnabled ? 'translate-x-6' : 'translate-x-1');

      try {
        await fetch('/api/dashboard/cms-modules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle', module: module, enabled: newEnabled })
        });
      } catch (e) {
        // Revert on failure
        btn.setAttribute('data-enabled', currentEnabled ? 'true' : 'false');
        btn.className = 'relative inline-flex h-6 w-11 items-center rounded-full transition-colors ' + (currentEnabled ? 'bg-primary-600' : 'bg-gray-300');
        btn.querySelector('span').className = 'inline-block h-4 w-4 transform rounded-full bg-white transition-transform ' + (currentEnabled ? 'translate-x-6' : 'translate-x-1');
      }
    }

    loadModules();
  })();`} />
</DashboardLayout>
