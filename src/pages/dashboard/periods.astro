---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { academicPeriods, prayerSchedules } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const periods = schoolId ? await db.select().from(academicPeriods).where(eq(academicPeriods.schoolId, schoolId)).orderBy(desc(academicPeriods.createdAt)).all() : [];
const prayers = schoolId ? await db.select().from(prayerSchedules).where(eq(prayerSchedules.schoolId, schoolId)).all() : [];
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const statusColors: Record<string, string> = { draft: 'bg-gray-100 text-gray-600', active: 'bg-green-100 text-green-700', completed: 'bg-blue-100 text-blue-700', scheduled: 'bg-amber-100 text-amber-700' };
const appliesToLabels: Record<string, string> = { weekday: 'Weekday', friday: 'Friday (Jumu\'ah)', weekend: 'Weekend', ramadan: 'Ramadan', exam: 'Exam Day', custom: 'Custom' };
const prayerNames: Record<string, string> = { fajr: 'Fajr', dhuhr: 'Dhuhr', asr: 'Asr', maghrib: 'Maghrib', isha: 'Isha', jumuah: 'Jumu\'ah' };
const periodTypeColors: Record<string, string> = { lesson: 'bg-blue-50 text-blue-700 border-blue-200', break: 'bg-amber-50 text-amber-700 border-amber-200', prayer: 'bg-emerald-50 text-emerald-700 border-emerald-200', assembly: 'bg-purple-50 text-purple-700 border-purple-200' };
---

<DashboardLayout title="Academic Periods & Prayer Schedules - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Academic Periods & Prayer Schedules</h2>
      <p class="text-sm text-gray-500 mt-1">Define academic years, terms, and Adhan-aligned daily prayer schedules (Fajr, Dhuhr, Asr, Maghrib, Isha, Jumu'ah).</p>
    </div>

    <!-- Academic Periods -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-gray-900">Academic Years & Terms</h3>
        <button onclick="document.getElementById('periodModal').classList.remove('hidden')" class="px-3 py-1.5 text-xs font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Period</button>
      </div>
      {periods.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Name</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Start Date</th><th class="px-4 py-3">End Date</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th></tr></thead>
            <tbody class="divide-y divide-gray-200">
              {periods.map(p => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{p.name}</td>
                  <td class="px-4 py-3 text-gray-600 capitalize">{p.type || 'term'}</td>
                  <td class="px-4 py-3 text-gray-600">{formatDate(p.startDate)}</td>
                  <td class="px-4 py-3 text-gray-600">{formatDate(p.endDate)}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[p.status] || 'bg-gray-100 text-gray-600'}`}>{p.status || 'draft'}</span></td>
                  <td class="px-4 py-3"><button onclick={`deletePeriod(${p.id})`} class="text-xs text-red-600 font-medium">Delete</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (<p class="text-sm text-gray-500 text-center py-8">No academic periods yet. Create one to get started.</p>)}
    </div>

    <!-- Islamic Prayer Schedules -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6c-1.5 0-3 .75-3 3 0 2.25 3 4.5 3 4.5s3-2.25 3-4.5c0-2.25-1.5-3-3-3z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 16h14M7 8v8M17 8v8"/></svg>
            Islamic Prayer Schedules (Adhan-Aware)
          </h3>
          <p class="text-xs text-gray-500 mt-1">Align school periods with the five daily prayers. Each schedule can have different periods for weekday, Friday (Jumu'ah), Ramadan, and exam days.</p>
        </div>
        <button onclick="document.getElementById('prayerModal').classList.remove('hidden')" class="px-3 py-1.5 text-xs font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-700">+ New Prayer Schedule</button>
      </div>
      {prayers.length > 0 ? (
        <div class="space-y-4">
          {prayers.map(s => {
            let periodsList: any[] = [];
            try { periodsList = typeof s.periods === 'string' ? JSON.parse(s.periods) : s.periods; } catch {}
            return (
              <div class="border rounded-lg p-4">
                <div class="flex items-center justify-between mb-3">
                  <div>
                    <h4 class="font-semibold text-sm text-gray-900">{s.name}</h4>
                    <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">{appliesToLabels[s.appliesTo] || s.appliesTo}</span>
                    {s.playAdhan && <span class="ml-2 text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200">Adhan Enabled</span>}
                  </div>
                  <div class="flex gap-2">
                    <button onclick={`editPrayer(${s.id})`} class="text-xs text-primary-600 font-medium">Edit</button>
                    <button onclick={`deletePrayer(${s.id})`} class="text-xs text-red-600 font-medium">Delete</button>
                  </div>
                </div>
                {/* Prayer times row */}
                <div class="grid grid-cols-3 md:grid-cols-6 gap-2 mb-3 text-xs">
                  {s.fajrTime && <div class="bg-emerald-50 rounded p-2 text-center"><div class="font-bold text-emerald-700">Fajr</div><div class="text-gray-700">{s.fajrTime}</div></div>}
                  {s.dhuhrTime && <div class="bg-emerald-50 rounded p-2 text-center"><div class="font-bold text-emerald-700">Dhuhr</div><div class="text-gray-700">{s.dhuhrTime}</div></div>}
                  {s.asrTime && <div class="bg-emerald-50 rounded p-2 text-center"><div class="font-bold text-emerald-700">Asr</div><div class="text-gray-700">{s.asrTime}</div></div>}
                  {s.maghribTime && <div class="bg-emerald-50 rounded p-2 text-center"><div class="font-bold text-emerald-700">Maghrib</div><div class="text-gray-700">{s.maghribTime}</div></div>}
                  {s.ishaTime && <div class="bg-emerald-50 rounded p-2 text-center"><div class="font-bold text-emerald-700">Isha</div><div class="text-gray-700">{s.ishaTime}</div></div>}
                  {s.jumuahTime && <div class="bg-emerald-50 rounded p-2 text-center"><div class="font-bold text-emerald-700">Jumu'ah</div><div class="text-gray-700">{s.jumuahTime}</div></div>}
                </div>
                {Array.isArray(periodsList) && periodsList.length > 0 && (
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                    {periodsList.map((per, i) => (
                      <div class={`text-xs rounded p-2 border ${periodTypeColors[per.type] || 'bg-gray-50 border-gray-200'}`}>
                        <div class="font-medium">{per.label || `Period ${i+1}`}{per.prayerName ? ` — ${prayerNames[per.prayerName] || per.prayerName}` : ''}</div>
                        <div class="text-gray-600">{per.start || ''} – {per.end || ''}</div>
                      </div>
                    ))}
                  </div>
                )}
                {s.notes && <p class="text-xs text-gray-500 mt-3 italic">{s.notes}</p>}
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-8">
          <p class="text-sm text-gray-500 mb-3">No prayer schedules yet. Create one aligned with the five daily prayers.</p>
          <button onclick="loadDefaultPrayerSchedule()" class="text-xs font-medium text-emerald-700 hover:text-emerald-800">+ Load default weekday template</button>
        </div>
      )}
    </div>
  </div>

  <!-- Period Modal -->
  <div id="periodModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">New Academic Period</h3>
      <form id="periodForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Name *</label><input name="name" required placeholder="e.g. Fall 2026-2027" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Type</label><select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="year">Academic Year</option><option value="term">Term/Semester</option><option value="quarter">Quarter</option></select></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Start Date *</label><input name="startDate" type="date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">End Date *</label><input name="endDate" type="date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Status</label><select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="draft">Draft</option><option value="active">Active</option><option value="scheduled">Scheduled</option><option value="completed">Completed</option></select></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('periodModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Prayer Schedule Modal -->
  <div id="prayerModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-3xl w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="prayerModalTitle">New Islamic Prayer Schedule</h3>
      <form id="prayerForm" class="space-y-4">
        <input type="hidden" name="id" />
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Schedule Name *</label><input name="name" required placeholder="e.g. Regular Weekday" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Applies To</label><select name="appliesTo" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="weekday">Weekday</option><option value="friday">Friday (Jumu'ah)</option><option value="weekend">Weekend</option><option value="ramadan">Ramadan</option><option value="exam">Exam Day</option><option value="custom">Custom</option></select></div>
        </div>
        <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-3">
          <h4 class="text-sm font-semibold text-emerald-900 mb-2">Five Daily Prayer Times (HH:MM)</h4>
          <div class="grid grid-cols-3 md:grid-cols-6 gap-2">
            <div><label class="block text-[10px] font-medium text-emerald-700 mb-1">Fajr</label><input type="time" name="fajrTime" class="w-full px-2 py-1.5 border border-emerald-300 rounded text-xs" /></div>
            <div><label class="block text-[10px] font-medium text-emerald-700 mb-1">Dhuhr</label><input type="time" name="dhuhrTime" class="w-full px-2 py-1.5 border border-emerald-300 rounded text-xs" /></div>
            <div><label class="block text-[10px] font-medium text-emerald-700 mb-1">Asr</label><input type="time" name="asrTime" class="w-full px-2 py-1.5 border border-emerald-300 rounded text-xs" /></div>
            <div><label class="block text-[10px] font-medium text-emerald-700 mb-1">Maghrib</label><input type="time" name="maghribTime" class="w-full px-2 py-1.5 border border-emerald-300 rounded text-xs" /></div>
            <div><label class="block text-[10px] font-medium text-emerald-700 mb-1">Isha</label><input type="time" name="ishaTime" class="w-full px-2 py-1.5 border border-emerald-300 rounded text-xs" /></div>
            <div><label class="block text-[10px] font-medium text-emerald-700 mb-1">Jumu'ah</label><input type="time" name="jumuahTime" class="w-full px-2 py-1.5 border border-emerald-300 rounded text-xs" /></div>
          </div>
          <div class="flex items-center gap-2 mt-3">
            <input type="checkbox" name="playAdhan" id="playAdhan" class="rounded" />
            <label for="playAdhan" class="text-xs text-emerald-800">Play Adhan reminder at each prayer time</label>
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Periods</label>
          <div id="periodRows" class="space-y-2"></div>
          <button type="button" onclick="addPeriodRow()" class="text-xs text-primary-600 font-medium mt-2">+ Add Period</button>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Notes (optional)</label><textarea name="notes" rows="2" placeholder="e.g. Ramadan-adjusted schedule" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('prayerModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-emerald-600 rounded-lg">Save Schedule</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ prayers: prayers.map(s => { try { return { ...s, periods: typeof s.periods === 'string' ? JSON.parse(s.periods) : s.periods }; } catch { return { ...s, periods: [] }; } }) }} set:html={`(function(){
    var allPrayers = prayers;

    function makePeriodRow(per) {
      per = per || {};
      var row = document.createElement('div');
      row.className = 'flex flex-wrap gap-2 items-center bg-gray-50 p-2 rounded';
      row.innerHTML = '<input type="text" name="periodLabel" placeholder="Label (e.g. Period 1)" class="flex-1 min-w-[120px] px-2 py-1.5 border border-gray-300 rounded text-xs" value="' + (per.label||'') + '" />' +
        '<input type="time" name="periodStart" class="px-2 py-1.5 border border-gray-300 rounded text-xs" value="' + (per.start||'') + '" />' +
        '<span class="text-gray-400 text-xs">-</span>' +
        '<input type="time" name="periodEnd" class="px-2 py-1.5 border border-gray-300 rounded text-xs" value="' + (per.end||'') + '" />' +
        '<select name="periodType" class="px-2 py-1.5 border border-gray-300 rounded text-xs"><option value="lesson"' + (per.type==='lesson'?' selected':'') + '>Lesson</option><option value="break"' + (per.type==='break'?' selected':'') + '>Break</option><option value="prayer"' + (per.type==='prayer'?' selected':'') + '>Prayer</option><option value="assembly"' + (per.type==='assembly'?' selected':'') + '>Assembly</option></select>' +
        '<select name="prayerName" class="px-2 py-1.5 border border-gray-300 rounded text-xs"><option value="">—</option><option value="fajr"' + (per.prayerName==='fajr'?' selected':'') + '>Fajr</option><option value="dhuhr"' + (per.prayerName==='dhuhr'?' selected':'') + '>Dhuhr</option><option value="asr"' + (per.prayerName==='asr'?' selected':'') + '>Asr</option><option value="maghrib"' + (per.prayerName==='maghrib'?' selected':'') + '>Maghrib</option><option value="isha"' + (per.prayerName==='isha'?' selected':'') + '>Isha</option><option value="jumuah"' + (per.prayerName==='jumuah'?' selected':'') + '>Jumu\\'ah</option></select>' +
        '<button type="button" onclick="this.parentElement.remove()" class="text-red-500 text-xs px-2">×</button>';
      return row;
    }

    window.addPeriodRow = function(per) {
      var container = document.getElementById('periodRows');
      container.appendChild(makePeriodRow(per));
    };

    window.editPrayer = function(id) {
      var s = allPrayers.find(function(p){ return p.id === id; });
      if (!s) return;
      var form = document.getElementById('prayerForm');
      form.id.value = s.id;
      form.name.value = s.name;
      form.appliesTo.value = s.appliesTo;
      form.fajrTime.value = s.fajrTime || '';
      form.dhuhrTime.value = s.dhuhrTime || '';
      form.asrTime.value = s.asrTime || '';
      form.maghribTime.value = s.maghribTime || '';
      form.ishaTime.value = s.ishaTime || '';
      form.jumuahTime.value = s.jumuahTime || '';
      form.playAdhan.checked = !!s.playAdhan;
      form.notes.value = s.notes || '';
      document.getElementById('periodRows').innerHTML = '';
      (s.periods || []).forEach(function(p){ window.addPeriodRow(p); });
      document.getElementById('prayerModalTitle').textContent = 'Edit Prayer Schedule';
      document.getElementById('prayerModal').classList.remove('hidden');
    };

    window.deletePrayer = async function(id) {
      if (!confirm('Delete this prayer schedule?')) return;
      await fetch('/api/dashboard/timetable', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_prayer_schedule', id: id }) });
      window.location.reload();
    };

    window.loadDefaultPrayerSchedule = function() {
      var form = document.getElementById('prayerForm');
      form.reset();
      form.id.value = '';
      form.name.value = 'Regular Weekday Schedule';
      form.appliesTo.value = 'weekday';
      form.fajrTime.value = '05:15';
      form.dhuhrTime.value = '12:15';
      form.asrTime.value = '15:30';
      form.maghribTime.value = '18:45';
      form.ishaTime.value = '20:00';
      form.playAdhan.checked = true;
      document.getElementById('periodRows').innerHTML = '';
      [
        { label: 'Morning Assembly', start: '07:30', end: '07:50', type: 'assembly' },
        { label: 'Period 1', start: '07:50', end: '08:35', type: 'lesson' },
        { label: 'Period 2', start: '08:40', end: '09:25', type: 'lesson' },
        { label: 'Period 3', start: '09:30', end: '10:15', type: 'lesson' },
        { label: 'Break', start: '10:15', end: '10:35', type: 'break' },
        { label: 'Period 4', start: '10:35', end: '11:20', type: 'lesson' },
        { label: 'Period 5', start: '11:25', end: '12:10', type: 'lesson' },
        { label: 'Dhuhr Prayer', start: '12:15', end: '12:45', type: 'prayer', prayerName: 'dhuhr' },
        { label: 'Period 6', start: '12:50', end: '13:35', type: 'lesson' },
        { label: 'Period 7', start: '13:40', end: '14:25', type: 'lesson' },
        { label: 'Asr Prayer', start: '15:30', end: '16:00', type: 'prayer', prayerName: 'asr' }
      ].forEach(function(p){ window.addPeriodRow(p); });
      document.getElementById('prayerModalTitle').textContent = 'New Islamic Prayer Schedule';
      document.getElementById('prayerModal').classList.remove('hidden');
    };

    document.getElementById('periodForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/timetable', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create_period', name: fd.get('name'), type: fd.get('type'), startDate: fd.get('startDate'), endDate: fd.get('endDate'), status: fd.get('status') }) });
      if (res.ok) window.location.reload();
    });

    document.getElementById('prayerForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var labels = this.querySelectorAll('[name="periodLabel"]');
      var starts = this.querySelectorAll('[name="periodStart"]');
      var ends = this.querySelectorAll('[name="periodEnd"]');
      var types = this.querySelectorAll('[name="periodType"]');
      var prayers = this.querySelectorAll('[name="prayerName"]');
      var periods = [];
      for (var i = 0; i < labels.length; i++) {
        if (starts[i].value && ends[i].value) {
          periods.push({ label: labels[i].value, start: starts[i].value, end: ends[i].value, type: types[i].value, prayerName: prayers[i].value || undefined });
        }
      }
      var payload = {
        action: fd.get('id') ? 'update_prayer_schedule' : 'create_prayer_schedule',
        id: fd.get('id') ? parseInt(fd.get('id')) : undefined,
        name: fd.get('name'),
        appliesTo: fd.get('appliesTo'),
        periods: periods,
        fajrTime: fd.get('fajrTime') || null,
        dhuhrTime: fd.get('dhuhrTime') || null,
        asrTime: fd.get('asrTime') || null,
        maghribTime: fd.get('maghribTime') || null,
        ishaTime: fd.get('ishaTime') || null,
        jumuahTime: fd.get('jumuahTime') || null,
        playAdhan: fd.get('playAdhan') === 'on',
        notes: fd.get('notes') || null
      };
      var res = await fetch('/api/dashboard/timetable', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed to save schedule'); }
    });

    window.deletePeriod = async function(id) {
      if (!confirm('Delete this academic period?')) return;
      await fetch('/api/dashboard/timetable', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_period', id: id }) });
      window.location.reload();
    };
  })();`} />
</DashboardLayout>
