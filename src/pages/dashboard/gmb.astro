---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId, getUserSchool } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { gmbConnections, gmbPosts, gmbReviews } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const school = getUserSchool(user.id);
const db = getDb();

const connection = db.select().from(gmbConnections).where(eq(gmbConnections.schoolId, schoolId)).get();
const posts = db.select().from(gmbPosts).where(eq(gmbPosts.schoolId, schoolId)).orderBy(desc(gmbPosts.createdAt)).limit(10).all();
const reviews = db.select().from(gmbReviews).where(eq(gmbReviews.schoolId, schoolId)).orderBy(desc(gmbReviews.reviewDate)).limit(5).all();
const avgRating = reviews.length > 0 ? (reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / reviews.length).toFixed(1) : 'N/A';
---

<DashboardLayout title="GMB Profile - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Google My Business</h2>
      <p class="text-sm text-gray-500 mt-1">Manage your Google Business profile for better local search visibility.</p>
    </div>

    <!-- Connection Status -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      {connection?.isConnected ? (
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Connected to Google My Business</p>
              <p class="text-xs text-gray-500">{connection.businessName || school?.name} - {connection.verificationStatus || 'Verified'}</p>
            </div>
          </div>
          <button class="text-xs text-red-600 font-medium">Disconnect</button>
        </div>
      ) : (
        <div class="text-center py-8">
          <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-1">Not Connected</h3>
          <p class="text-sm text-gray-500 mb-4 max-w-md mx-auto">Connect your Google My Business account to manage your profile, posts, and reviews — or let us create one for you.</p>
          <div class="flex gap-3 justify-center">
            <button class="px-5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              Connect Google Account
            </button>
            <button class="px-5 py-2 text-sm font-medium text-primary-600 border border-primary-300 rounded-lg hover:bg-primary-50">Create New Profile</button>
          </div>
        </div>
      )}
    </div>

    {connection?.isConnected && (
      <>
        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-white rounded-xl border border-gray-200 p-4">
            <p class="text-xs text-gray-500 uppercase tracking-wider">Average Rating</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{avgRating} / 5</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-4">
            <p class="text-xs text-gray-500 uppercase tracking-wider">Total Reviews</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{reviews.length}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-4">
            <p class="text-xs text-gray-500 uppercase tracking-wider">GMB Posts</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{posts.length}</p>
          </div>
        </div>

        <!-- Recent Reviews -->
        {reviews.length > 0 && (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="text-base font-semibold text-gray-900 mb-4">Recent Reviews</h3>
            <div class="space-y-3">
              {reviews.map(r => (
                <div class="border rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-medium text-sm text-gray-900">{r.author || 'Anonymous'}</span>
                    <div class="flex items-center gap-1">
                      {Array.from({ length: 5 }).map((_, i) => (
                        <svg class="w-4 h-4" fill={i < (r.rating || 0) ? '#fbbf24' : '#e5e7eb'} viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      ))}
                    </div>
                  </div>
                  {r.comment && <p class="text-sm text-gray-600 mb-2">{r.comment}</p>}
                  {r.response ? (
                    <div class="bg-blue-50 p-2 rounded text-xs text-gray-600"><strong>Response:</strong> {r.response}</div>
                  ) : (
                    <button class="text-xs text-primary-600 font-medium">Respond</button>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- GMB Posts -->
        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h3 class="text-base font-semibold text-gray-900 mb-4">GMB Posts</h3>
          {posts.length > 0 ? (
            <div class="space-y-3">
              {posts.map(p => (
                <div class="border rounded-lg p-4">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold uppercase text-gray-500">{p.postType}</span>
                    <span class="text-xs text-gray-400">{new Date(p.createdAt).toLocaleDateString()}</span>
                  </div>
                  <p class="text-sm text-gray-700">{p.title || p.content}</p>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-gray-500 text-center py-4">No GMB posts yet.</p>
          )}
        </div>
      </>
    )}
  </div>
</DashboardLayout>
