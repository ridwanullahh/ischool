---
/**
 * Form Builder Dashboard
 *
 * Create, edit, and manage forms. View submissions.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { forms, formSubmissions } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';
import { pageGuard } from '../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'announcements.create')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user);
const db = getDb();

const allForms = schoolId
  ? await db.select().from(forms).where(eq(forms.schoolId, schoolId)).orderBy(desc(forms.createdAt)).all()
  : [];

const submissionCounts: Record<number, number> = {};
if (schoolId) {
  const allSubs = await db.select().from(formSubmissions).where(eq(formSubmissions.schoolId, schoolId)).all();
  for (const s of allSubs) {
    submissionCounts[s.formId] = (submissionCounts[s.formId] || 0) + 1;
  }
}

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const statusColors: Record<string, string> = { draft: 'bg-gray-100 text-gray-600', published: 'bg-green-100 text-green-700', closed: 'bg-red-100 text-red-700', archived: 'bg-gray-100 text-gray-500' };
---

<DashboardLayout title="Form Builder - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Form Builder</h2>
        <p class="text-sm text-gray-500 mt-1">Create custom forms for applications, surveys, feedback, and more</p>
      </div>
      <button onclick="document.getElementById('createModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create Form</button>
    </div>

    {allForms.length > 0 ? (
      <div class="space-y-3">
        {allForms.map(f => (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class:list={["inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase", statusColors[f.status] || 'bg-gray-100 text-gray-600']}>{f.status}</span>
                  {f.isPublic && <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">PUBLIC</span>}
                </div>
                <h3 class="text-sm font-semibold text-gray-900">{f.title}</h3>
                {f.description && <p class="text-xs text-gray-500 mt-1 line-clamp-2">{f.description}</p>}
                <div class="flex items-center gap-4 mt-2 text-xs text-gray-500">
                  <span>{submissionCounts[f.id] || 0} submission{(submissionCounts[f.id] || 0) !== 1 ? 's' : ''}</span>
                  <span>Created: {formatDate(f.createdAt)}</span>
                  <a href={`/dashboard/forms/${f.id}`} class="text-primary-600 hover:underline">Edit</a>
                  <a href={`/dashboard/forms/${f.id}/submissions`} class="text-primary-600 hover:underline">View Submissions</a>
                  {f.isPublic && f.status === 'published' && <a href={`/${f.slug}/forms/${f.slug}`} target="_blank" class="text-blue-600 hover:underline">Open Form</a>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <p class="text-sm text-gray-500 mt-2">No forms yet. Create your first form.</p>
      </div>
    )}
  </div>

  {/* Create modal */}
  <div id="createModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Create Form</h3>
        <button onclick="document.getElementById('createModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="createForm" class="space-y-4">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title</label><input name="title" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description (optional)</label><textarea name="description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Slug (URL)</label><input name="slug" type="text" required placeholder="my-form" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="isPublic" checked class="w-4 h-4" /> Public</label>
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="requiresAuth" class="w-4 h-4" /> Requires Login</label>
        </div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create</button>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ schoolId }}>
    document.getElementById('createForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const fd = new FormData(this);
      const body = {
        schoolId,
        title: fd.get('title'),
        description: fd.get('description') || null,
        slug: fd.get('slug'),
        isPublic: fd.get('isPublic') === 'on',
        requiresAuth: fd.get('requiresAuth') === 'on',
      };
      const res = await fetch('/api/dashboard/forms', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) {
        const data = await res.json();
        window.location.href = '/dashboard/forms/' + data.id;
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Failed to create form');
      }
    });
  </script>
</DashboardLayout>
