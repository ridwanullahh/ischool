---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { forms, formSubmissions } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();
let items: any[] = [];
let submissions: any[] = [];
if (schoolId) {
  try {
    items = await db.select().from(forms).where(eq(forms.schoolId, schoolId)).orderBy(desc(forms.createdAt)).all() || [];
    submissions = await db.select().from(formSubmissions).where(eq(formSubmissions.schoolId, schoolId)).orderBy(desc(formSubmissions.createdAt)).limit(10).all() || [];
  } catch {}
}
const success = Astro.url.searchParams.get('success');
---

<DashboardLayout title="Forms - iSchool">
  {success && <div class="mosaic-card p-4 mb-4" style="border-color:#05B34D;background:rgba(5,179,77,0.05);"><p class="text-sm font-medium" style="color:#05B34D;">Form saved successfully.</p></div>}

  <div class="mb-6"><h1 class="text-2xl font-bold mb-1" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Forms</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Create and manage custom forms for your school.</p></div>

  <ListToolbar searchPlaceholder="Search forms..." newItemHref="/dashboard/forms/new" newItemLabel="+ New Form" />

  <div id="list-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {items.length === 0 ? (
      <div class="col-span-full mosaic-card p-12 text-center">
        <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4" style="background:var(--mosaic-surface-2);"><svg class="w-8 h-8" style="color:var(--mosaic-text-subtle);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg></div>
        <h3 class="text-base font-semibold mb-1" style="color:var(--mosaic-text);">No forms yet</h3>
        <p class="text-sm mb-4" style="color:var(--mosaic-text-muted);">Create custom forms for admissions, inquiries, and more.</p>
        <a href="/dashboard/forms/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm">+ New Form</a>
      </div>
    ) : items.map(item => (
      <div data-list-item data-title={item.title||''} data-status={String(item.isActive ?? item.is_active ?? true)} data-date={item.createdAt||item.created_at||''} class="mosaic-card p-5 group">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:rgba(5,179,77,0.1);"><svg class="w-5 h-5" style="color:#05B34D;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg></div>
          <span class:list={["text-[10px] font-medium px-2 py-0.5 rounded-full",(item.isActive ?? item.is_active ?? true)?"bg-green-100 text-green-700":"bg-gray-100 text-gray-600"]}>{(item.isActive ?? item.is_active ?? true) ? 'Active' : 'Inactive'}</span>
        </div>
        <h3 class="text-sm font-bold mb-1" style="color:var(--mosaic-text);">{item.title||'Untitled'}</h3>
        <p class="text-xs line-clamp-2 mb-3" style="color:var(--mosaic-text-muted);">{item.description||'No description.'}</p>
        <div class="flex items-center justify-between">
          <span class="text-[11px]" style="color:var(--mosaic-text-subtle);">{submissions.filter(s => String(s.formId ?? s.form_id) === String(item.id)).length} submissions</span>
          <a href={`/dashboard/forms/${item.id}/edit`} class="p-1.5 rounded-lg transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" title="Edit"><svg class="w-4 h-4" style="color:var(--mosaic-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
