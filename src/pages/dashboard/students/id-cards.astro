---
/**
 * Student ID Card Generator
 *
 * Generates printable ID cards for students. Uses SVG-based card template
 * rendered server-side, with school branding (logo, colors, name).
 */
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getUserSchoolId, getUserSchool } from '../../../lib/school.js';
import { getDb } from '../../../lib/db/index.js';
import { students, classes, enrollments, schools } from '../../../lib/db/schema.js';
import { eq, and } from 'drizzle-orm';
import { pageGuard } from '../../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
if (!pageGuard(user, 'students.view')) return Astro.redirect('/dashboard');

const schoolId = getUserSchoolId(user.id);
const db = getDb();
const school = schoolId ? await db.select().from(schools).where(eq(schools.id, schoolId)).get() : null;
const allStudents = schoolId ? await db.select().from(students).where(eq(students.schoolId, schoolId)).all() : [];
const allEnrollments = schoolId ? await db.select().from(enrollments).all() : [];
const allClasses = schoolId ? await db.select().from(classes).where(eq(classes.schoolId, schoolId)).all() : [];

// Get class names for students
const studentsWithClass = allStudents.map(s => {
  const enrollment = allEnrollments.find(e => e.studentId === s.id);
  const cls = enrollment?.classId ? allClasses.find(c => c.id === enrollment.classId) : null;
  return { ...s, className: cls ? cls.name + (cls.section ? ' - ' + cls.section : '') : 'N/A' };
});

const schoolName = school?.name || 'School';
const schoolLogo = school?.logoUrl || '';
const primaryColor = school?.primaryColor || '#2563eb';
---

<DashboardLayout title="ID Card Generator - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">ID Card Generator</h2>
        <p class="text-sm text-gray-500 mt-1">Generate printable ID cards for students</p>
      </div>
      <button onclick="window.print()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 print:hidden">
        Print All
      </button>
    </div>

    {/* Student selector */}
    <div class="bg-white rounded-xl border border-gray-200 p-4 print:hidden">
      <label class="block text-xs font-medium text-gray-700 mb-1.5">Select Student</label>
      <select id="studentSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="previewCard(this.value)">
        <option value="">Choose a student...</option>
        {studentsWithClass.map(s => (
          <option value={s.id}>{s.firstName} {s.lastName} - {s.studentId}</option>
        ))}
      </select>
    </div>

    {/* ID Card preview */}
    <div id="cardPreview" class="bg-white rounded-xl border border-gray-200 p-8 flex items-center justify-center min-h-[300px]">
      <p class="text-gray-400 text-sm">Select a student to preview their ID card.</p>
    </div>

    {/* All cards for printing */}
    <div id="allCards" class="hidden print:block">
      {studentsWithClass.map(s => (
        <div class="id-card-print" data-student-id={s.id} style="break-inside: avoid; margin-bottom: 20px;">
          {/* Card will be rendered here via the same template */}
        </div>
      ))}
    </div>
  </div>

  <script is:inline define:vars={{ studentsData: studentsWithClass, schoolName, schoolLogo, primaryColor }}>
    function generateCardHTML(s) {
      const photo = s.photoUrl
        ? '<img src="' + s.photoUrl + '" alt="' + s.firstName + '" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid ' + primaryColor + ';" />'
        : '<div style="width:80px;height:80px;border-radius:50%;background:' + primaryColor + '20;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:bold;color:' + primaryColor + ';">' + s.firstName.charAt(0) + '</div>';
      const logo = schoolLogo
        ? '<img src="' + schoolLogo + '" alt="' + schoolName + '" style="height:32px;" />'
        : '<span style="font-size:14px;font-weight:bold;color:' + primaryColor + ';">' + schoolName + '</span>';
      return '<div style="width:350px;border:2px solid ' + primaryColor + ';border-radius:12px;overflow:hidden;font-family:Arial,sans-serif;">' +
        '<div style="background:' + primaryColor + ';padding:12px 16px;display:flex;align-items:center;justify-content:between;gap:8px;">' + logo + '</div>' +
        '<div style="padding:20px;display:flex;gap:16px;align-items:center;">' +
          '<div>' + photo + '</div>' +
          '<div style="flex:1;">' +
            '<p style="font-size:16px;font-weight:bold;margin:0;color:#1f2937;">' + s.firstName + ' ' + s.lastName + '</p>' +
            '<p style="font-size:12px;color:#6b7280;margin:2px 0;">ID: ' + s.studentId + '</p>' +
            '<p style="font-size:12px;color:#6b7280;margin:2px 0;">Class: ' + s.className + '</p>' +
            (s.bloodGroup ? '<p style="font-size:12px;color:#6b7280;margin:2px 0;">Blood: ' + s.bloodGroup + '</p>' : '') +
          '</div>' +
        '</div>' +
        '<div style="padding:8px 16px;border-top:1px solid #e5e7eb;font-size:10px;color:#9ca3af;text-align:center;">' +
          (s.phone || s.email || '') +
        '</div>' +
      '</div>';
    }

    function previewCard(studentId) {
      const preview = document.getElementById('cardPreview');
      if (!studentId) {
        preview.innerHTML = '<p class="text-gray-400 text-sm">Select a student to preview their ID card.</p>';
        return;
      }
      const s = studentsData.find(function(x) { return String(x.id) === studentId; });
      if (s) {
        preview.innerHTML = generateCardHTML(s);
      }
    }
  </script>

  <style is:inline>
    @media print {
      body * { visibility: hidden; }
      #allCards, #allCards * { visibility: visible; }
      #allCards { position: absolute; left: 0; top: 0; width: 100%; }
    }
  </style>
</DashboardLayout>
