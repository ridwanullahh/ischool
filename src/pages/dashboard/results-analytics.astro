---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { exams, examSeries, examResults, students, classes, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, sql, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// Subject performance summary
const subjectPerf = db.select({
  subject: exams.subject,
  totalMarks: exams.totalMarks,
  avgMarks: sql<number>`avg(${examResults.marksObtained})`,
  count: sql<number>`count(*)`,
  passCount: sql<number>`sum(case when ${examResults.marksObtained} >= (${exams.totalMarks} * 0.5) then 1 else 0 end)`,
  examTitle: exams.title,
}).from(examResults)
  .leftJoin(exams, eq(examResults.examId, exams.id))
  .leftJoin(examSeries, eq(exams.seriesId, examSeries.id))
  .where(and(eq(examResults.schoolId, schoolId), eq(examResults.status, 'present')))
  .groupBy(exams.subject).all();

const subjectAnalytics = subjectPerf.map(s => {
  const avgPct = s.totalMarks > 0 ? ((s.avgMarks || 0) / s.totalMarks) * 100 : 0;
  const passRate = s.count > 0 ? ((s.passCount || 0) / s.count) * 100 : 0;
  return { ...s, avgPct: Math.round(avgPct), passRate: Math.round(passRate) };
}).sort((a, b) => b.avgPct - a.avgPct);

// Top performers (highest avg marks across exams)
const topPerformers = db.select({
  studentId: examResults.studentId,
  studentName: students.firstName,
  studentLastName: students.lastName,
  studentCode: students.studentId,
  avgMarks: sql<number>`avg(${examResults.marksObtained})`,
  count: sql<number>`count(*)`,
}).from(examResults)
  .leftJoin(students, eq(examResults.studentId, students.id))
  .where(and(eq(examResults.schoolId, schoolId), eq(examResults.status, 'present')))
  .groupBy(examResults.studentId)
  .orderBy(desc(sql`avg(${examResults.marksObtained})`))
  .limit(10).all();

// Bottom performers
const bottomPerformers = db.select({
  studentId: examResults.studentId,
  studentName: students.firstName,
  studentLastName: students.lastName,
  studentCode: students.studentId,
  avgMarks: sql<number>`avg(${examResults.marksObtained})`,
  count: sql<number>`count(*)`,
}).from(examResults)
  .leftJoin(students, eq(examResults.studentId, students.id))
  .where(and(eq(examResults.schoolId, schoolId), eq(examResults.status, 'present')))
  .groupBy(examResults.studentId)
  .orderBy(sql`avg(${examResults.marksObtained})`)
  .limit(5).all();

// Total counts
const totalExams = db.select({ count: sql<number>`count(*)` }).from(exams).all()[0]?.count || 0;
const totalResults = db.select({ count: sql<number>`count(*)` }).from(examResults).where(eq(examResults.schoolId, schoolId)).all()[0]?.count || 0;
const totalAbsent = db.select({ count: sql<number>`count(*)` }).from(examResults).where(and(eq(examResults.schoolId, schoolId), eq(examResults.status, 'absent'))).all()[0]?.count || 0;
const overallAvg = db.select({ avg: sql<number>`avg(${examResults.marksObtained})` }).from(examResults).where(and(eq(examResults.schoolId, schoolId), eq(examResults.status, 'present'))).all()[0]?.avg || 0;

// Grade distribution
const gradeDist = db.select({
  grade: examResults.grade,
  count: sql<number>`count(*)`,
}).from(examResults)
  .where(and(eq(examResults.schoolId, schoolId), eq(examResults.status, 'present')))
  .groupBy(examResults.grade).all();
const gradeMap = new Map(gradeDist.map(g => [g.grade, g.count]));
const grades = ['A+', 'A', 'B', 'C', 'D', 'F'];
const maxGradeCount = Math.max(...grades.map(g => gradeMap.get(g) || 0), 1);
---

<DashboardLayout title="Results Analytics - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Results Analytics</h2>
      <p class="text-sm text-gray-500 mt-1">Class performance summary per subject, top/bottom performers, grade distribution, and subject difficulty analysis.</p>
    </div>

    {/* KPI cards */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Exams</div><div class="text-2xl font-bold">{totalExams}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Results</div><div class="text-2xl font-bold">{totalResults}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Overall Avg</div><div class="text-2xl font-bold text-blue-600">{Math.round(overallAvg)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Absences</div><div class="text-2xl font-bold text-red-600">{totalAbsent}</div></div>
    </div>

    {/* Subject Performance */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Subject Performance & Difficulty</h3>
      {subjectAnalytics.length === 0 ? (
        <p class="text-sm text-gray-500 text-center py-8">No exam results recorded yet. Enter marks first to see analytics.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Subject</th><th class="px-4 py-3">Students</th>
              <th class="px-4 py-3">Avg %</th><th class="px-4 py-3">Pass Rate</th>
              <th class="px-4 py-3">Difficulty</th><th class="px-4 py-3">Bar</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {subjectAnalytics.map(s => {
                const difficulty = s.avgPct >= 75 ? 'Easy' : s.avgPct >= 60 ? 'Moderate' : s.avgPct >= 50 ? 'Challenging' : 'Hard';
                const diffColor = s.avgPct >= 75 ? 'bg-green-100 text-green-700' : s.avgPct >= 60 ? 'bg-blue-100 text-blue-700' : s.avgPct >= 50 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700';
                return (
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium text-gray-900">{s.subject}</td>
                    <td class="px-4 py-3 text-gray-600">{s.count}</td>
                    <td class="px-4 py-3"><span class={`font-bold ${s.avgPct >= 70 ? 'text-green-600' : s.avgPct >= 50 ? 'text-amber-600' : 'text-red-600'}`}>{s.avgPct}%</span></td>
                    <td class="px-4 py-3 text-gray-600">{s.passRate}%</td>
                    <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${diffColor}`}>{difficulty}</span></td>
                    <td class="px-4 py-3 w-40"><div class="h-2 bg-gray-100 rounded"><div class={`h-full ${s.avgPct >= 70 ? 'bg-green-500' : s.avgPct >= 50 ? 'bg-amber-500' : 'bg-red-500'}`} style={`width: ${s.avgPct}%`}></div></div></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    {/* Top & Bottom performers */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-amber-500">🏆</span> Top 10 Performers
        </h3>
        {topPerformers.length === 0 ? (
          <p class="text-sm text-gray-500 text-center py-8">No data.</p>
        ) : (
          <ol class="space-y-2">
            {topPerformers.map((p, i) => (
              <li class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded">
                <span class={`w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold ${i === 0 ? 'bg-amber-100 text-amber-700' : i === 1 ? 'bg-gray-200 text-gray-700' : i === 2 ? 'bg-orange-100 text-orange-700' : 'bg-gray-100 text-gray-500'}`}>{i+1}</span>
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">{p.studentName} {p.studentLastName}</div>
                  <div class="text-xs text-gray-500">{p.studentCode} · {p.count} exam{p.count !== 1 ? 's' : ''}</div>
                </div>
                <div class="text-sm font-bold text-gray-900">{Math.round(p.avgMarks || 0)}</div>
              </li>
            ))}
          </ol>
        )}
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-red-500">⚠</span> Students Needing Support
        </h3>
        {bottomPerformers.length === 0 ? (
          <p class="text-sm text-gray-500 text-center py-8">No data.</p>
        ) : (
          <ol class="space-y-2">
            {bottomPerformers.map((p, i) => (
              <li class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded">
                <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold bg-red-100 text-red-700">{i+1}</span>
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">{p.studentName} {p.studentLastName}</div>
                  <div class="text-xs text-gray-500">{p.studentCode} · avg {Math.round(p.avgMarks || 0)}/100</div>
                </div>
                <button class="text-xs text-primary-600 font-medium">View Profile</button>
              </li>
            ))}
          </ol>
        )}
      </div>
    </div>

    {/* Grade Distribution */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Grade Distribution</h3>
      <div class="flex items-end gap-4 h-40">
        {grades.map(g => {
          const count = gradeMap.get(g) || 0;
          const pct = (count / maxGradeCount) * 100;
          const color = g === 'A+' ? 'bg-emerald-500' : g === 'A' ? 'bg-green-500' : g === 'B' ? 'bg-blue-500' : g === 'C' ? 'bg-amber-500' : g === 'D' ? 'bg-orange-500' : 'bg-red-500';
          return (
            <div class="flex-1 flex flex-col items-center">
              <div class="text-sm font-bold text-gray-700">{count}</div>
              <div class="w-full bg-gray-100 rounded-t" style={`height: ${pct}%; min-height: 4px`}>
                <div class={`h-full ${color} rounded-t`} style="height: 100%"></div>
              </div>
              <div class="text-sm font-bold mt-2">{g}</div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</DashboardLayout>
