---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { students, staff, users, sessions, schoolMembers, auditLogs } from '../../lib/db/schema.js';
import { eq, sql, desc } from 'drizzle-orm';
import fs from 'fs';
import path from 'path';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// System stats
const uptime = process.uptime();
const uptimeHours = Math.floor(uptime / 3600);
const uptimeDays = Math.floor(uptimeHours / 24);
const memoryUsage = process.memoryUsage();
const memoryMB = (memoryUsage.rss / (1024 * 1024)).toFixed(1);
const heapUsed = (memoryUsage.heapUsed / (1024 * 1024)).toFixed(1);
const heapTotal = (memoryUsage.heapTotal / (1024 * 1024)).toFixed(1);

// DB stats
const dbPath = path.resolve(process.cwd(), 'ischool.db');
let dbSize = 0, dbMtime: Date | null = null;
try { const st = fs.statSync(dbPath); dbSize = st.size; dbMtime = st.mtime; } catch {}
const dbSizeMB = (dbSize / (1024 * 1024)).toFixed(2);

// Counts
const totalUsers = await db.select({ c: sql<number>`count(*)` }).from(users).all()[0]?.c || 0;
const activeSessions = await db.select({ c: sql<number>`count(*)` }).from(sessions).all()[0]?.c || 0;
const totalStudents = await db.select({ c: sql<number>`count(*)` }).from(students).where(eq(students.schoolId, schoolId)).all()[0]?.c || 0;
const totalStaff = await db.select({ c: sql<number>`count(*)` }).from(staff).where(eq(staff.schoolId, schoolId)).all()[0]?.c || 0;
const recentLogs = await db.select().from(auditLogs).orderBy(desc(auditLogs.createdAt)).limit(5).all();

const nodeVersion = process.version;
const platform = `${process.platform} ${process.arch}`;
const fmtDate = (d: any) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
const fmtUptime = () => {
  if (uptimeDays > 0) return `${uptimeDays}d ${uptimeHours % 24}h`;
  if (uptimeHours > 0) return `${uptimeHours}h ${Math.floor((uptime % 3600) / 60)}m`;
  return `${Math.floor(uptime / 60)}m`;
};
---

<DashboardLayout title="System Health - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">System Health & Status</h2>
      <p class="text-sm text-gray-500 mt-1">Real-time server health, database status, and system information.</p>
    </div>

    {/* Health status banner */}
    <div class="bg-green-50 border border-green-200 rounded-xl p-6 flex items-center gap-4">
      <div class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center text-white text-2xl">✓</div>
      <div class="flex-1">
        <h3 class="text-lg font-semibold text-green-900">All Systems Operational</h3>
        <p class="text-sm text-green-700">Server is responding normally. No issues detected.</p>
      </div>
      <div class="text-right">
        <div class="text-xs text-green-700 uppercase">Uptime</div>
        <div class="text-2xl font-bold text-green-900">{fmtUptime()}</div>
      </div>
    </div>

    {/* Health metrics */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Memory Usage</div>
        <div class="text-2xl font-bold text-gray-900">{memoryMB} MB</div>
        <div class="text-xs text-gray-500 mt-1">RSS total</div>
        <div class="mt-2 h-1.5 bg-gray-100 rounded">
          <div class="h-full bg-blue-500 rounded" style={`width: ${Math.min(100, (parseFloat(memoryMB) / 512) * 100)}%`}></div>
        </div>
      </div>
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Heap Used</div>
        <div class="text-2xl font-bold text-gray-900">{heapUsed} MB</div>
        <div class="text-xs text-gray-500 mt-1">of {heapTotal} MB allocated</div>
        <div class="mt-2 h-1.5 bg-gray-100 rounded">
          <div class="h-full bg-green-500 rounded" style={`width: ${Math.min(100, (parseFloat(heapUsed) / parseFloat(heapTotal)) * 100)}%`}></div>
        </div>
      </div>
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Database Size</div>
        <div class="text-2xl font-bold text-gray-900">{dbSizeMB} MB</div>
        <div class="text-xs text-gray-500 mt-1">SQLite</div>
        <div class="mt-2 h-1.5 bg-gray-100 rounded">
          <div class="h-full bg-purple-500 rounded" style={`width: ${Math.min(100, (parseFloat(dbSizeMB) / 100) * 100)}%`}></div>
        </div>
      </div>
      <div class="bg-white rounded-xl border p-4">
        <div class="text-xs text-gray-500 uppercase">Active Sessions</div>
        <div class="text-2xl font-bold text-green-600">{activeSessions}</div>
        <div class="text-xs text-gray-500 mt-1">logged-in users</div>
      </div>
    </div>

    {/* System info */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">System Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm">
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Node.js Version</span><span class="font-medium text-gray-900">{nodeVersion}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Platform</span><span class="font-medium text-gray-900">{platform}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Process PID</span><span class="font-medium text-gray-900">{process.pid}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Server Uptime</span><span class="font-medium text-gray-900">{fmtUptime()}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Database Type</span><span class="font-medium text-gray-900">SQLite (better-sqlite3)</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">DB Last Modified</span><span class="font-medium text-gray-900">{fmtDate(dbMtime)}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Total Users</span><span class="font-medium text-gray-900">{totalUsers}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">School Students</span><span class="font-medium text-gray-900">{totalStudents}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">School Staff</span><span class="font-medium text-gray-900">{totalStaff}</span></div>
        <div class="flex justify-between py-2 border-b border-gray-100"><span class="text-gray-500">Runtime</span><span class="font-medium text-gray-900">Astro SSR (Node adapter)</span></div>
      </div>
    </div>

    {/* Recent activity */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Recent System Activity</div>
      {recentLogs.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No recent activity.</p>
      ) : (
        <div class="divide-y divide-gray-100">
          {recentLogs.map((l: any) => (
            <div class="p-3 flex items-center justify-between text-sm">
              <div>
                <span class="font-medium text-gray-900">{l.action || '—'}</span>
                <span class="text-gray-500 ml-2">{l.entityType || ''}</span>
              </div>
              <span class="text-xs text-gray-500">{fmtDate(l.createdAt)}</span>
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Maintenance mode */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">🔧 Maintenance Mode</h3>
      <p class="text-sm text-gray-600 mb-3">When enabled, all non-admin users see a maintenance banner. Admins retain full access.</p>
      <button onclick="toggleMaintenance()" class="px-4 py-2 text-sm font-medium text-white bg-amber-600 rounded-lg hover:bg-amber-700">Enable Maintenance Mode</button>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.toggleMaintenance = function() {
      if (!confirm('Enable maintenance mode? Non-admin users will see a banner.')) return;
      alert('Maintenance mode configuration requires platform admin access. Visit /admin/settings to configure.');
    };
  })();`} />
</DashboardLayout>
