---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { cbtExams, cbtCandidates, students, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const exams = db.select().from(cbtExams).where(eq(cbtExams.schoolId, schoolId)).orderBy(desc(cbtExams.createdAt)).all();

// Get all candidates across all school exams
const allCandidates = exams.length > 0
  ? db.select({
      id: cbtCandidates.id, examId: cbtCandidates.examId, userId: cbtCandidates.userId,
      name: cbtCandidates.name, email: cbtCandidates.email, accessPin: cbtCandidates.accessPin,
      status: cbtCandidates.status, createdAt: cbtCandidates.createdAt,
    }).from(cbtCandidates).orderBy(desc(cbtCandidates.createdAt)).all()
    .filter(c => exams.some(e => e.id === c.examId))
  : [];

const examMap = new Map(exams.map(e => [e.id, e]));
const allStudents = db.select({ id: students.id, name: students.firstName, lastName: students.lastName, code: students.studentId, email: students.email })
  .from(students).where(eq(students.schoolId, schoolId)).all();

const stats = {
  total: allCandidates.length,
  registered: allCandidates.filter(c => c.status === 'registered').length,
  started: allCandidates.filter(c => c.status === 'started').length,
  submitted: allCandidates.filter(c => c.status === 'submitted').length,
  absent: allCandidates.filter(c => c.status === 'absent').length,
  disqualified: allCandidates.filter(c => c.status === 'disqualified').length,
};

const statusColors: Record<string, string> = {
  registered: 'bg-blue-100 text-blue-700', started: 'bg-amber-100 text-amber-700',
  submitted: 'bg-green-100 text-green-700', absent: 'bg-gray-100 text-gray-700',
  disqualified: 'bg-red-100 text-red-700',
};
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
---

<DashboardLayout title="CBT Candidates - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">CBT Candidates</h2>
        <p class="text-sm text-gray-500 mt-1">Register candidates for CBT exams, generate access PINs, bulk-register from classes, and track candidate status.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Add Candidate</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Total</div><div class="text-xl font-bold">{stats.total}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Registered</div><div class="text-xl font-bold text-blue-600">{stats.registered}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Started</div><div class="text-xl font-bold text-amber-600">{stats.started}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Submitted</div><div class="text-xl font-bold text-green-600">{stats.submitted}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Absent</div><div class="text-xl font-bold text-gray-600">{stats.absent}</div></div>
      <div class="bg-white rounded-xl border p-3"><div class="text-xs text-gray-500 uppercase">Disqualified</div><div class="text-xl font-bold text-red-600">{stats.disqualified}</div></div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b flex gap-3">
        <input id="searchInput" type="text" placeholder="Search by name, email, or PIN…" class="flex-1 px-3 py-2 border rounded-lg text-sm" oninput="filterCandidates()" />
        <select id="examFilter" class="px-3 py-2 border rounded-lg text-sm" onchange="filterCandidates()">
          <option value="">All Exams</option>
          {exams.map(e => <option value={e.id}>{e.title}</option>)}
        </select>
        <select id="statusFilter" class="px-3 py-2 border rounded-lg text-sm" onchange="filterCandidates()">
          <option value="">All Status</option>
          <option value="registered">Registered</option><option value="started">Started</option>
          <option value="submitted">Submitted</option><option value="absent">Absent</option>
          <option value="disqualified">Disqualified</option>
        </select>
      </div>
      {allCandidates.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">👥</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No candidates registered</h3>
          <p class="text-sm text-gray-500">Add candidates individually or bulk-register from a class.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Candidate</th><th class="px-4 py-3">Email</th>
              <th class="px-4 py-3">Exam</th><th class="px-4 py-3">Access PIN</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Registered</th>
              <th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {allCandidates.map(c => (
                <tr class="hover:bg-gray-50 candidate-row" data-search={`${c.name} ${c.email || ''} ${c.accessPin || ''}`.toLowerCase()} data-exam={c.examId} data-status={c.status}>
                  <td class="px-4 py-3 font-medium text-gray-900">{c.name}</td>
                  <td class="px-4 py-3 text-gray-600">{c.email || '—'}</td>
                  <td class="px-4 py-3 text-gray-700">{examMap.get(c.examId)?.title || '—'}</td>
                  <td class="px-4 py-3 font-mono text-xs text-purple-700 font-bold">{c.accessPin || '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[c.status]}`}>{c.status}</span></td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(c.createdAt)}</td>
                  <td class="px-4 py-3">
                    <select onchange={`updateStatus(${c.id}, this.value)`} class="text-xs px-2 py-1 border rounded">
                      <option value="">Change…</option>
                      <option value="registered">Registered</option><option value="started">Started</option>
                      <option value="submitted">Submitted</option><option value="absent">Absent</option>
                      <option value="disqualified">Disqualified</option>
                    </select>
                    <button onclick={`deleteCandidate(${c.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <div id="candModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Register Candidate</h3>
      <form id="candForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Exam *</label>
          <select name="examId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select exam…</option>
            {exams.map(e => <option value={e.id}>{e.title} ({e.type})</option>)}
          </select>
        </div>
        <div class="border-t pt-3">
          <h4 class="text-sm font-semibold text-gray-900 mb-2">Option A: Single Candidate</h4>
          <div class="space-y-3">
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Name *</label><input name="name" placeholder="Candidate full name" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Email (optional)</label><input name="email" type="email" placeholder="candidate@example.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          </div>
        </div>
        <div class="border-t pt-3">
          <h4 class="text-sm font-semibold text-gray-900 mb-2">Option B: Bulk Register from Students</h4>
          <p class="text-xs text-gray-500 mb-2">Select students to register for this exam. Auto-generates access PINs.</p>
          <div class="max-h-40 overflow-y-auto border rounded p-2 space-y-1">
            {allStudents.map(s => (
              <label class="flex items-center gap-2 text-xs text-gray-700">
                <input type="checkbox" name="studentIds" value={s.id} class="rounded" />
                {s.name} {s.lastName} ({s.code})
              </label>
            ))}
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('candModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Register</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openModal = function() { document.getElementById('candModal').classList.remove('hidden'); };
    window.updateStatus = async function(id, status) {
      if (!status) return;
      await fetch('/api/dashboard/cbt-candidates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'update_status', id: id, status: status }) });
      window.location.reload();
    };
    window.deleteCandidate = async function(id) {
      if (!confirm('Delete this candidate record?')) return;
      await fetch('/api/dashboard/cbt-candidates', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.filterCandidates = function() {
      var q = document.getElementById('searchInput').value.toLowerCase();
      var examId = document.getElementById('examFilter').value;
      var status = document.getElementById('statusFilter').value;
      document.querySelectorAll('.candidate-row').forEach(function(row) {
        var matchQ = !q || row.dataset.search.indexOf(q) >= 0;
        var matchE = !examId || row.dataset.exam === examId;
        var matchS = !status || row.dataset.status === status;
        row.style.display = (matchQ && matchE && matchS) ? '' : 'none';
      });
    };
    document.getElementById('candForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var examId = parseInt(fd.get('examId'));
      var studentIds = [];
      document.querySelectorAll('input[name="studentIds"]:checked').forEach(function(c) { studentIds.push(parseInt(c.value)); });

      if (studentIds.length > 0) {
        // Bulk register
        var res = await fetch('/api/dashboard/cbt-candidates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'bulk_register_class', examId: examId, studentIds: studentIds }) });
        if (res.ok) { var data = await res.json(); alert('Registered ' + data.created + ' candidates!'); window.location.reload(); }
      } else if (fd.get('name')) {
        // Single candidate
        var res = await fetch('/api/dashboard/cbt-candidates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
          examId: examId, name: fd.get('name'), email: fd.get('email') || null,
        }) });
        if (res.ok) window.location.reload();
      } else {
        alert('Either enter a name or select students');
      }
    });
  })();`} />
</DashboardLayout>
