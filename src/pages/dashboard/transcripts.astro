---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { reportCards, students, schools, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const school = db.select().from(schools).where(eq(schools.id, schoolId)).get();
const allStudents = db.select({ id: students.id, name: students.firstName, lastName: students.lastName, code: students.studentId, status: students.status })
  .from(students).where(eq(students.schoolId, schoolId)).all();

// All report cards grouped by student
const allCards = db.select().from(reportCards).where(eq(reportCards.schoolId, schoolId)).orderBy(desc(reportCards.academicYear)).all();
const cardsByStudent = new Map<number, typeof allCards>();
for (const c of allCards) {
  if (!cardsByStudent.has(c.studentId)) cardsByStudent.set(c.studentId, []);
  cardsByStudent.get(c.studentId)!.push(c);
}
---

<DashboardLayout title="Transcripts - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Official Transcripts</h2>
      <p class="text-sm text-gray-500 mt-1">Generate multi-year transcripts for students with cumulative grades, school seal, and principal signature line.</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <label class="block text-xs font-medium text-gray-700 mb-2">Select Student</label>
      <select id="studentSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="loadTranscript()">
        <option value="">Choose a student…</option>
        {allStudents.map(s => <option value={s.id}>{s.name} {s.lastName} ({s.code})</option>)}
      </select>
    </div>

    <div id="emptyState" class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <div class="text-4xl mb-3">📜</div>
      <h3 class="text-lg font-semibold text-gray-900 mb-1">Select a student to view transcript</h3>
      <p class="text-sm text-gray-500">Transcripts aggregate all report cards across academic years with cumulative GPA.</p>
    </div>

    <div id="transcriptContainer" class="hidden bg-white rounded-xl border border-gray-200 p-8 max-w-4xl mx-auto"></div>
  </div>

  <script is:inline define:vars={{ school, allStudents, cardsByStudent: Object.fromEntries(cardsByStudent) }} set:html={`(function(){
    var schoolInfo = school;
    var studentsList = allStudents;
    var cardsByStu = cardsByStudent;

    window.loadTranscript = function() {
      var sid = parseInt(document.getElementById('studentSelect').value);
      if (!sid) { document.getElementById('transcriptContainer').classList.add('hidden'); document.getElementById('emptyState').classList.remove('hidden'); return; }
      var student = studentsList.find(function(s) { return s.id === sid; });
      if (!student) return;
      var cards = cardsByStu[sid] || [];

      var totalMarks = 0, maxTotal = 0;
      cards.forEach(function(c) {
        totalMarks += c.totalMarks || 0;
        try {
          var results = JSON.parse(c.results || '[]');
          results.forEach(function(r) { maxTotal += r.totalMarks || 100; });
        } catch {}
      });
      var cumulativePct = maxTotal > 0 ? Math.round((totalMarks / maxTotal) * 100) : null;
      var gpa = cumulativePct !== null ? (cumulativePct / 100 * 4).toFixed(2) : '—';

      var html = '<div class="text-center mb-8">' +
        '<div style="font-size: 28px; font-weight: bold; color: #111;">' + (schoolInfo?.name || 'School') + '</div>' +
        '<div style="font-size: 14px; color: #666;">' + (schoolInfo?.address || '') + '</div>' +
        '<div style="font-size: 18px; color: #111; margin-top: 16px; font-weight: bold; border-top: 2px solid #111; border-bottom: 2px solid #111; padding: 8px; display: inline-block;">OFFICIAL TRANSCRIPT</div>' +
        '</div>' +
        '<div class="grid grid-cols-2 gap-4 mb-6">' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Student Name</div><div style="font-weight: bold;">' + student.name + ' ' + (student.lastName || '') + '</div></div>' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Student ID</div><div style="font-weight: bold;">' + student.code + '</div></div>' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Status</div><div style="font-weight: bold; text-transform: capitalize;">' + student.status + '</div></div>' +
        '<div style="padding: 12px; background: #f9fafb; border-radius: 8px;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Years on Record</div><div style="font-weight: bold;">' + cards.length + '</div></div>' +
        '</div>';

      if (cards.length === 0) {
        html += '<div class="text-center py-8 text-gray-500">No report cards on file for this student.</div>';
      } else {
        cards.forEach(function(c) {
          var results = [];
          try { results = JSON.parse(c.results || '[]'); } catch {}
          html += '<div style="margin-bottom: 16px;"><div style="background: #f3f4f6; padding: 8px 12px; font-weight: bold;">' + c.academicYear + ' · ' + c.term + (c.classRank ? ' · Rank #' + c.classRank : '') + (c.percentage ? ' · ' + c.percentage + '%' : '') + '</div>' +
            '<table style="width: 100%; border-collapse: collapse;"><tbody>';
          if (results.length === 0) {
            html += '<tr><td style="padding: 8px; color: #999; text-align: center;">No subject results</td></tr>';
          } else {
            results.forEach(function(r) {
              html += '<tr><td style="padding: 6px 12px; border-bottom: 1px solid #f3f4f6;">' + (r.subject || '—') + (r.title ? ' — ' + r.title : '') + '</td>' +
                '<td style="padding: 6px 12px; border-bottom: 1px solid #f3f4f6; text-align: right;">' + (r.marksObtained != null ? r.marksObtained + ' / ' + (r.totalMarks || 100) : '—') + '</td>' +
                '<td style="padding: 6px 12px; border-bottom: 1px solid #f3f4f6; text-align: right; font-weight: bold;">' + (r.grade || '—') + '</td></tr>';
            });
          }
          html += '</tbody></table>';
          if (c.classTeacherComment || c.principalRemark) {
            html += '<div style="padding: 8px 12px; background: #fefefe; font-size: 12px; color: #555;">';
            if (c.classTeacherComment) html += '<div><strong>Class Teacher:</strong> ' + c.classTeacherComment + '</div>';
            if (c.principalRemark) html += '<div><strong>Principal:</strong> ' + c.principalRemark + '</div>';
            html += '</div>';
          }
          html += '</div>';
        });
      }

      html += '<div class="grid grid-cols-3 gap-4 my-6">' +
        '<div style="padding: 16px; background: #f9fafb; border-radius: 8px; text-align: center;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Cumulative Total</div><div style="font-size: 24px; font-weight: bold;">' + totalMarks + '</div></div>' +
        '<div style="padding: 16px; background: #f9fafb; border-radius: 8px; text-align: center;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">Cumulative %</div><div style="font-size: 24px; font-weight: bold;">' + (cumulativePct !== null ? cumulativePct + '%' : '—') + '</div></div>' +
        '<div style="padding: 16px; background: #f9fafb; border-radius: 8px; text-align: center;"><div style="font-size: 10px; color: #666; text-transform: uppercase;">GPA (4.0 scale)</div><div style="font-size: 24px; font-weight: bold;">' + gpa + '</div></div>' +
        '</div>';

      html += '<div style="margin-top: 32px; display: flex; justify-content: space-between; align-items: flex-end;">' +
        '<div style="text-align: center;"><div style="border-top: 1px solid #000; padding-top: 4px; font-size: 12px; min-width: 200px;">Principal Signature</div></div>' +
        '<div style="text-align: center;"><div style="border: 2px solid #999; border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #999; transform: rotate(-15deg);">SCHOOL SEAL</div></div>' +
        '<div style="text-align: center;"><div style="border-top: 1px solid #000; padding-top: 4px; font-size: 12px; min-width: 200px;">Date Issued</div></div>' +
        '</div>';
      html += '<div class="text-center mt-6"><button onclick="window.print()" class="px-4 py-2 bg-primary-600 text-white rounded text-sm">Print / Save as PDF</button></div>';

      document.getElementById('transcriptContainer').innerHTML = html;
      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('transcriptContainer').classList.remove('hidden');
    };
  })();`} />
</DashboardLayout>
