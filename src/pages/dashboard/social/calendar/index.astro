---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { socialPosts } from '../../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const posts = await db.select().from(socialPosts).where(eq(socialPosts.schoolId, schoolId)).orderBy(desc(socialPosts.createdAt)).all();

const today = new Date();
const month = today.getMonth();
const year = today.getFullYear();
const daysInMonth = new Date(year, month + 1, 0).getDate();
const monthName = today.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const scheduledPosts = posts.filter(p => p.status === 'scheduled' && p.scheduledAt);
const publishedPosts = posts.filter(p => p.status === 'published');
const draftPosts = posts.filter(p => p.status === 'draft');
---

<DashboardLayout title="Content Calendar - Social Media">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div><h2 class="text-2xl font-bold text-gray-900">Content Calendar</h2><p class="text-sm text-gray-500 mt-1">{monthName}</p></div>
      <a href="/dashboard/social/composer" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Post</a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">Scheduled</p><p class="text-2xl font-bold text-blue-600 mt-1">{scheduledPosts.length}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">Published</p><p class="text-2xl font-bold text-green-600 mt-1">{publishedPosts.length}</p></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><p class="text-xs text-gray-500 uppercase">Drafts</p><p class="text-2xl font-bold text-gray-600 mt-1">{draftPosts.length}</p></div>
    </div>

    <!-- Calendar Grid -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 overflow-x-auto">
      <div class="grid grid-cols-7 gap-1 min-w-[700px]">
        {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => <div class="text-center text-xs font-semibold text-gray-500 py-2">{d}</div>)}
        {Array.from({ length: daysInMonth }).map((_, i) => {
          const day = i + 1;
          const date = new Date(year, month, day);
          const dayPosts = scheduledPosts.filter(p => {
            try { return new Date(p.scheduledAt).toDateString() === date.toDateString(); } catch { return false; }
          });
          return (
            <div class={`min-h-[80px] border rounded-lg p-1 ${dayPosts.length > 0 ? 'bg-blue-50/50 border-blue-200' : 'border-gray-100'}`}>
              <p class="text-xs text-gray-400 mb-1">{day}</p>
              {dayPosts.map(p => <div class="text-[10px] bg-blue-100 text-blue-700 rounded px-1 py-0.5 mb-0.5 truncate" title={p.content}>{p.platform}: {p.content.slice(0, 20)}</div>)}
            </div>
          );
        })}
      </div>
    </div>

    <!-- Upcoming Scheduled -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Upcoming Scheduled Posts</h3>
      {scheduledPosts.length > 0 ? (
        <div class="space-y-2">
          {scheduledPosts.map(p => (
            <div class="flex items-center justify-between border rounded-lg p-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-100 text-blue-700">{p.platform}</span>
                  <span class="text-xs text-gray-400">{new Date(p.scheduledAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                </div>
                <p class="text-sm text-gray-700 truncate">{p.content}</p>
              </div>
              <button onclick={`deletePost(${p.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
            </div>
          ))}
        </div>
      ) : (<p class="text-sm text-gray-500 text-center py-4">No scheduled posts. <a href="/dashboard/social/composer" class="text-primary-600 font-medium">Create one</a>.</p>)}
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.deletePost = async function(id) {
      if (!confirm('Delete this post?')) return;
      await fetch('/api/dashboard/social', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete_post', postId: id }) });
      window.location.reload();
    };
  })();`} />
</DashboardLayout>
