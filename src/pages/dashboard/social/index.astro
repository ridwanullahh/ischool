---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../lib/school.js';
import { getDb } from '../../../lib/db/index.js';
import { socialAccounts, socialPosts } from '../../../lib/db/schema.js';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const accounts = await db.select().from(socialAccounts).where(eq(socialAccounts.schoolId, schoolId)).all();
const posts = await db.select().from(socialPosts).where(eq(socialPosts.schoolId, schoolId)).orderBy(desc(socialPosts.createdAt)).limit(20).all();
const totalPosts = await db.select({ c: sql<number>`count(*)` }).from(socialPosts).where(eq(socialPosts.schoolId, schoolId)).get()?.c || 0;
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';

const PLATFORMS = [
  { id: 'facebook', name: 'Facebook', icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { id: 'instagram', name: 'Instagram', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z' },
  { id: 'twitter', name: 'Twitter/X', icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { id: 'linkedin', name: 'LinkedIn', icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z' },
  { id: 'whatsapp', name: 'WhatsApp', icon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z' },
];
---

<DashboardLayout title="Social Media - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Social Media</h2>
        <p class="text-sm text-gray-500 mt-1">Schedule and manage social media posts across platforms.</p>
      </div>
      <button onclick="document.getElementById('postModal').classList.remove('hidden')" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">New Post</button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider">Total Posts</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">{totalPosts}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider">Connected Accounts</p>
        <p class="text-2xl font-bold text-gray-900 mt-1">{accounts.length}</p>
      </div>
    </div>

    <!-- Connected Accounts -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Connected Accounts</h3>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        {PLATFORMS.map(p => (
          <div class="flex flex-col items-center gap-2 p-4 border rounded-lg">
            <svg class="w-8 h-8 text-gray-600" fill="currentColor" viewBox="0 0 24 24"><path d={p.icon} /></svg>
            <span class="text-xs font-medium text-gray-700">{p.name}</span>
            {accounts.find(a => a.platform === p.id) ? (
              <span class="text-[10px] text-green-600 font-medium">Connected</span>
            ) : (
              <span class="text-[10px] text-gray-400">Not connected</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Posts -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Recent Posts</h3>
      {posts.length > 0 ? (
        <div class="space-y-3">
          {posts.map(p => (
            <div class="border rounded-lg p-4">
              <div class="flex items-start justify-between mb-2">
                <div>
                  <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-600">{p.platform}</span>
                  <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ml-1 ${p.status === 'published' ? 'bg-green-100 text-green-700' : p.status === 'scheduled' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600'}`}>{p.status}</span>
                </div>
                <span class="text-xs text-gray-400">{formatDate(p.scheduledAt || p.publishedAt || p.createdAt)}</span>
              </div>
              <p class="text-sm text-gray-700 line-clamp-2">{p.content}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-gray-500 text-center py-8">No posts yet. Create your first post.</p>
      )}
    </div>
  </div>

  <!-- New Post Modal -->
  <div id="postModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Create Social Post</h3>
      <div class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Platform</label><select id="pPlatform" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{PLATFORMS.map(p => <option value={p.id}>{p.name}</option>)}</select></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Content</label><textarea id="pContent" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Write your post..."></textarea></div>
        <div class="flex gap-2">
          <button onclick="aiGenerate()" class="px-3 py-2 text-xs font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-700">AI Generate</button>
        </div>
        <div id="aiStatus" class="hidden text-xs"></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Schedule (optional)</label><input id="pSchedule" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button onclick="document.getElementById('postModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="createPost()" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Create</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.createPost = async function() {
      var content = document.getElementById('pContent').value;
      if (!content) return alert('Content required');
      var res = await fetch('/api/dashboard/social', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create_post', platform: document.getElementById('pPlatform').value, content, scheduledAt: document.getElementById('pSchedule').value || null }) });
      if (res.ok) window.location.reload();
    };

    window.aiGenerate = async function() {
      var status = document.getElementById('aiStatus');
      status.className = 'text-xs text-blue-600';
      status.textContent = 'AI is generating...';
      status.classList.remove('hidden');
      try {
        var res = await fetch('/api/dashboard/social', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'ai_generate', prompt: document.getElementById('pContent').value || 'Write a school social media post' }) });
        var data = await res.json();
        if (data.success) { document.getElementById('pContent').value = data.content; status.textContent = 'Generated!'; }
        else throw new Error(data.error);
      } catch (e) { status.textContent = 'Error: ' + e.message; status.className = 'text-xs text-red-600'; }
    };
  })();`} />
</DashboardLayout>
