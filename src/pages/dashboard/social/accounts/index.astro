---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { socialAccounts } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();
const accounts = await db.select().from(socialAccounts).where(eq(socialAccounts.schoolId, schoolId)).all();

const PLATFORMS = [
  { id: 'facebook', name: 'Facebook', color: '#1877F2', icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { id: 'instagram', name: 'Instagram', color: '#E4405F', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z' },
  { id: 'twitter', name: 'Twitter/X', color: '#000000', icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  { id: 'linkedin', name: 'LinkedIn', color: '#0A66C2', icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z' },
  { id: 'whatsapp', name: 'WhatsApp', color: '#25D366', icon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z' },
];
---

<DashboardLayout title="Accounts - Social Media">
  <div class="space-y-6">
    <div><h2 class="text-2xl font-bold text-gray-900">Social Accounts</h2><p class="text-sm text-gray-500 mt-1">Connect and manage your social media accounts.</p></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {PLATFORMS.map(p => {
        const account = accounts.find(a => a.platform === p.id);
        return (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center" style={`background:${p.color}15`}>
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" style={`color:${p.color}`}><path d={p.icon} /></svg>
                </div>
                <div>
                  <p class="font-semibold text-gray-900">{p.name}</p>
                  {account ? <p class="text-xs text-gray-500">{account.accountName || 'Connected'}</p> : <p class="text-xs text-gray-400">Not connected</p>}
                </div>
              </div>
              {account ? (
                <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-green-100 text-green-700">CONNECTED</span>
              ) : (
                <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-gray-100 text-gray-500">OFFLINE</span>
              )}
            </div>
            {account ? (
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs"><span class="text-gray-500">Followers</span><span class="font-medium text-gray-900">{account.followersCount || 0}</span></div>
                <div class="flex gap-2 pt-2">
                  <button class="text-xs text-primary-600 font-medium">Settings</button>
                  <button onclick={`disconnect('${p.id}')`} class="text-xs text-red-600 font-medium">Disconnect</button>
                </div>
              </div>
            ) : (
              <button onclick={`connect('${p.id}')`} class="w-full px-4 py-2 text-sm font-medium text-white rounded-lg" style={`background:${p.color}`}>Connect {p.name}</button>
            )}
          </div>
        );
      })}
    </div>

    
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h3 class="text-base font-semibold text-gray-900 mb-4">Auto-Post Settings</h3>
      <p class="text-sm text-gray-500 mb-4">Automatically post to social media when you publish content on your website.</p>
      <div class="space-y-3">
        {['Blog Posts', 'Announcements', 'Events', 'Gallery Photos'].map((type, i) => (
          <div class="flex items-center justify-between p-3 border rounded-lg">
            <span class="text-sm font-medium text-gray-700">{type}</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer" />
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-600"></div>
            </label>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.connect = function(platform) {
      alert('OAuth connection for ' + platform + ' will be available once credentials are configured. You can create posts manually in the composer.');
    };
    window.disconnect = function(platform) {
      if (!confirm('Disconnect ' + platform + ' account?')) return;
      fetch('/api/dashboard/social', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'disconnect', platform: platform }) }).then(function() { window.location.reload(); });
    };
  })();`} />
</DashboardLayout>
