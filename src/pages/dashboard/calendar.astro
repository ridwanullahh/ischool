---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { events, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allEvents = db.select().from(events).where(eq(events.schoolId, schoolId)).orderBy(desc(events.startDate)).all();

// Calendar state — current month
const today = new Date();
const viewYear = today.getFullYear();
const viewMonth = today.getMonth();
const firstDay = new Date(viewYear, viewMonth, 1);
const lastDay = new Date(viewYear, viewMonth + 1, 0);
const startDay = firstDay.getDay(); // 0 = Sunday
const totalDays = lastDay.getDate();

// Filter events in current month
const monthStart = new Date(viewYear, viewMonth, 1).toISOString().split('T')[0];
const monthEnd = new Date(viewYear, viewMonth + 1, 0).toISOString().split('T')[0];
const monthEvents = allEvents.filter(e => e.startDate >= monthStart && e.startDate <= monthEnd);

// Build calendar grid (6 weeks)
const weeks: Date[][] = [];
let currentWeek: Date[] = [];
for (let i = 0; i < startDay; i++) {
  const d = new Date(viewYear, viewMonth, 1 - (startDay - i));
  currentWeek.push(d);
}
for (let day = 1; day <= totalDays; day++) {
  currentWeek.push(new Date(viewYear, viewMonth, day));
  if (currentWeek.length === 7) {
    weeks.push(currentWeek);
    currentWeek = [];
  }
}
// Pad final week
if (currentWeek.length > 0) {
  while (currentWeek.length < 7) {
    const last = currentWeek[currentWeek.length - 1];
    currentWeek.push(new Date(last.getFullYear(), last.getMonth(), last.getDate() + 1));
  }
  weeks.push(currentWeek);
}

const categoryColors: Record<string, string> = {
  academic: 'bg-blue-500', sports: 'bg-green-500', cultural: 'bg-purple-500',
  holiday: 'bg-amber-500', exam: 'bg-red-500', meeting: 'bg-cyan-500', other: 'bg-gray-500',
};
const categoryLabels: Record<string, string> = {
  academic: 'Academic', sports: 'Sports', cultural: 'Cultural',
  holiday: 'Holiday', exam: 'Exam', meeting: 'Meeting', other: 'Other',
};
const monthName = today.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const isToday = (d: Date) => d.toISOString().split('T')[0] === today.toISOString().split('T')[0];
const isCurrentMonth = (d: Date) => d.getMonth() === viewMonth;
const eventOnDay = (d: Date) => {
  const ds = d.toISOString().split('T')[0];
  return monthEvents.filter(e => e.startDate === ds);
};
---

<DashboardLayout title="Calendar - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">School Calendar</h2>
      <p class="text-sm text-gray-500 mt-1">Month view of all school events. Color-coded by category.</p>
    </div>

    {/* Category legend */}
    <div class="flex flex-wrap gap-3 text-xs">
      {Object.entries(categoryLabels).map(([k, v]) => (
        <span class="flex items-center gap-1.5">
          <span class={`w-3 h-3 rounded ${categoryColors[k]}`}></span>
          {v}
        </span>
      ))}
    </div>

    {/* Calendar grid */}
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="p-4 border-b flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900">{monthName}</h3>
        <div class="flex gap-2">
          <a href="/dashboard/events" class="text-xs text-primary-600 font-medium">Manage Events →</a>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse min-w-[700px]">
          <thead>
            <tr class="bg-gray-50">
              {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => <th class="px-2 py-2 text-xs font-medium text-gray-500 uppercase border-r border-gray-100">{d}</th>)}
            </tr>
          </thead>
          <tbody>
            {weeks.map(week => (
              <tr>
                {week.map(d => {
                  const dayEvents = eventOnDay(d);
                  const inMonth = isCurrentMonth(d);
                  const today_flag = isToday(d);
                  return (
                    <td class={`border-r border-b border-gray-100 p-1 h-24 align-top ${inMonth ? 'bg-white' : 'bg-gray-50'}`}>
                      <div class={`text-xs font-medium mb-1 ${today_flag ? 'inline-flex items-center justify-center w-6 h-6 rounded-full bg-primary-600 text-white' : inMonth ? 'text-gray-700' : 'text-gray-400'}`}>{d.getDate()}</div>
                      <div class="space-y-0.5">
                        {dayEvents.slice(0, 3).map(e => (
                          <div class={`text-[10px] px-1.5 py-0.5 rounded text-white truncate ${categoryColors[e.category] || 'bg-gray-500'}`} title={`${e.title}${e.startTime ? ' · ' + e.startTime : ''}${e.venue ? ' · ' + e.venue : ''}`}>
                            {e.startTime ? `${e.startTime} ` : ''}{e.title}
                          </div>
                        ))}
                        {dayEvents.length > 3 && <div class="text-[10px] text-gray-500 px-1">+{dayEvents.length - 3} more</div>}
                      </div>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Upcoming events list */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Upcoming Events</div>
      {allEvents.filter(e => e.startDate >= today.toISOString().split('T')[0]).slice(0, 10).length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No upcoming events.</p>
      ) : (
        <div class="divide-y divide-gray-100">
          {allEvents.filter(e => e.startDate >= today.toISOString().split('T')[0]).slice(0, 10).map(e => (
            <div class="p-4 flex items-start gap-3">
              <span class={`w-3 h-3 rounded mt-1 shrink-0 ${categoryColors[e.category]}`}></span>
              <div class="flex-1 min-w-0">
                <h4 class="font-medium text-sm text-gray-900">{e.title}</h4>
                <p class="text-xs text-gray-500">
                  {new Date(e.startDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}
                  {e.startTime ? ` · ${e.startTime}` : ''}
                  {e.venue ? ` · ${e.venue}` : ''}
                </p>
                {e.description && <p class="text-xs text-gray-600 mt-1 line-clamp-2">{e.description.substring(0, 150)}</p>}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
