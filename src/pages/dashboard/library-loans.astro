---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { libraryLoans, libraryBooks, users, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const loans = await db.select({
  id: libraryLoans.id, bookId: libraryLoans.bookId, borrowerId: libraryLoans.borrowerId,
  issueDate: libraryLoans.issueDate, dueDate: libraryLoans.dueDate, returnDate: libraryLoans.returnDate,
  renewals: libraryLoans.renewals, fine: libraryLoans.fine, finePaid: libraryLoans.finePaid,
  status: libraryLoans.status, createdAt: libraryLoans.createdAt,
  bookTitle: libraryBooks.title, bookAuthor: libraryBooks.author,
  borrowerName: users.name, borrowerEmail: users.email,
}).from(libraryLoans)
  .leftJoin(libraryBooks, eq(libraryLoans.bookId, libraryBooks.id))
  .leftJoin(users, eq(libraryLoans.borrowerId, users.id))
  .where(eq(libraryLoans.schoolId, schoolId))
  .orderBy(desc(libraryLoans.createdAt)).all();

const allBooks = await db.select({ id: libraryBooks.id, title: libraryBooks.title, author: libraryBooks.author, availableCopies: libraryBooks.availableCopies })
  .from(libraryBooks).where(eq(libraryBooks.schoolId, schoolId)).all();
const allUsers = await db.select({ id: users.id, name: users.name, email: users.email })
  .from(users).innerJoin(schoolMembers, eq(users.id, schoolMembers.userId))
  .where(eq(schoolMembers.schoolId, schoolId)).all();

const stats = {
  total: loans.length,
  active: loans.filter(l => l.status === 'active').length,
  overdue: loans.filter(l => l.status === 'overdue' || (l.status === 'active' && l.dueDate && new Date(l.dueDate) < new Date())).length,
  returned: loans.filter(l => l.status === 'returned').length,
};

const statusColors: Record<string, string> = {
  active: 'bg-blue-100 text-blue-700', returned: 'bg-green-100 text-green-700',
  overdue: 'bg-red-100 text-red-700', lost: 'bg-gray-100 text-gray-700',
};
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';

const defaultDue = new Date(); defaultDue.setDate(defaultDue.getDate() + 14);
---

<DashboardLayout title="Library Loans - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Loans & Returns</h2>
        <p class="text-sm text-gray-500 mt-1">Issue books to members, track due dates, process returns with auto-fine calculation, and renew loans.</p>
      </div>
      <button onclick="openIssueModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Issue Book</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Loans</div><div class="text-2xl font-bold">{stats.total}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Active</div><div class="text-2xl font-bold text-blue-600">{stats.active}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Overdue</div><div class="text-2xl font-bold text-red-600">{stats.overdue}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Returned</div><div class="text-2xl font-bold text-green-600">{stats.returned}</div></div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b flex gap-3">
        <input id="searchInput" type="text" placeholder="Search by book or borrower…" class="flex-1 px-3 py-2 border rounded-lg text-sm" oninput="filterLoans()" />
        <select id="statusFilter" class="px-3 py-2 border rounded-lg text-sm" onchange="filterLoans()">
          <option value="">All Status</option>
          <option value="active">Active</option><option value="overdue">Overdue</option>
          <option value="returned">Returned</option><option value="lost">Lost</option>
        </select>
      </div>
      {loans.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">📚</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No loans recorded</h3>
          <p class="text-sm text-gray-500">Issue a book to get started.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Book</th><th class="px-4 py-3">Borrower</th>
              <th class="px-4 py-3">Issued</th><th class="px-4 py-3">Due</th>
              <th class="px-4 py-3">Returned</th><th class="px-4 py-3">Renewals</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {loans.map(l => {
                const isOverdue = l.status === 'active' && l.dueDate && new Date(l.dueDate) < new Date();
                const effectiveStatus = isOverdue ? 'overdue' : l.status;
                return (
                  <tr class="hover:bg-gray-50 loan-row" data-search={`${l.bookTitle || ''} ${l.borrowerName || ''}`.toLowerCase()} data-status={effectiveStatus}>
                    <td class="px-4 py-3 font-medium text-gray-900">{l.bookTitle || '—'}<div class="text-xs text-gray-500">{l.bookAuthor || ''}</div></td>
                    <td class="px-4 py-3 text-gray-700">{l.borrowerName || '—'}<div class="text-xs text-gray-500">{l.borrowerEmail || ''}</div></td>
                    <td class="px-4 py-3 text-gray-600">{fmtDate(l.issueDate)}</td>
                    <td class="px-4 py-3 text-gray-600">{fmtDate(l.dueDate)}</td>
                    <td class="px-4 py-3 text-gray-600">{fmtDate(l.returnDate)}</td>
                    <td class="px-4 py-3 text-gray-600">{l.renewals || 0}</td>
                    <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[effectiveStatus]}`}>{effectiveStatus}</span></td>
                    <td class="px-4 py-3">
                      {l.status !== 'returned' && (
                        <div class="flex gap-2">
                          <button onclick={`returnBook(${l.id})`} class="text-xs text-green-600 font-medium">Return</button>
                          <button onclick={`renewBook(${l.id})`} class="text-xs text-blue-600 font-medium">Renew</button>
                        </div>
                      )}
                      {l.fine && !l.finePaid && <span class="text-xs text-red-600 font-medium ml-2">Fine: ₦{l.fine}</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* Issue Modal */}
  <div id="issueModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Issue Book</h3>
      <form id="issueForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Book *</label>
          <select name="bookId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select book…</option>
            {allBooks.filter(b => (b.availableCopies || 0) > 0).map(b => <option value={b.id}>{b.title} — {b.author || 'Unknown'} ({b.availableCopies} available)</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Borrower *</label>
          <select name="borrowerId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select member…</option>
            {allUsers.map(u => <option value={u.id}>{u.name} ({u.email})</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Due Date *</label><input name="dueDate" type="date" required value={defaultDue.toISOString().split('T')[0]} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('issueModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Issue</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openIssueModal = function() { document.getElementById('issueModal').classList.remove('hidden'); };
    window.returnBook = async function(loanId) {
      if (!confirm('Process return for this book?')) return;
      var res = await fetch('/api/dashboard/library', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'return', loanId: loanId }) });
      if (res.ok) { var data = await res.json(); if (data.fine > 0) alert('Book returned. Overdue fine: ₦' + data.fine); window.location.reload(); }
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    };
    window.renewBook = async function(loanId) {
      var res = await fetch('/api/dashboard/library', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'renew', loanId: loanId }) });
      if (res.ok) { var data = await res.json(); alert('Renewed! New due date: ' + data.newDueDate); window.location.reload(); }
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    };
    window.filterLoans = function() {
      var q = document.getElementById('searchInput').value.toLowerCase();
      var s = document.getElementById('statusFilter').value;
      document.querySelectorAll('.loan-row').forEach(function(row) {
        var matchQ = !q || row.dataset.search.indexOf(q) >= 0;
        var matchS = !s || row.dataset.status === s;
        row.style.display = (matchQ && matchS) ? '' : 'none';
      });
    };
    document.getElementById('issueForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/library', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'issue', bookId: parseInt(fd.get('bookId')), borrowerId: parseInt(fd.get('borrowerId')), dueDate: fd.get('dueDate') }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
