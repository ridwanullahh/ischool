---
/**
 * Form Submissions Viewer
 */
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { forms, formSubmissions } from '../../../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
const formId = parseInt(Astro.params.id);
const db = getDb();
const form = schoolId ? db.select().from(forms).where(and(eq(forms.id, formId), eq(forms.schoolId, schoolId))).get() : null;
if (!form) return Astro.redirect('/dashboard/forms');
const submissions = db.select().from(formSubmissions).where(eq(formSubmissions.formId, formId)).orderBy(desc(formSubmissions.createdAt)).all();
const fields = ((form.fields as any[]) || []).filter(f => f.type !== 'heading' && f.type !== 'paragraph');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
---

<DashboardLayout title={`Submissions: ${form.title} - iSchool`}>
  <div class="space-y-6">
    <a href={'/dashboard/forms/' + formId} class="text-sm text-gray-500 hover:text-gray-700">Back to Form</a>
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Submissions ({submissions.length})</h2>
      <p class="text-sm text-gray-500 mt-1">View and export form submissions</p>
    </div>

    {submissions.length > 0 ? (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b">
              <tr>
                <th class="text-left py-2 px-3 font-medium text-gray-700">#</th>
                {fields.map(f => <th class="text-left py-2 px-3 font-medium text-gray-700">{f.label}</th>)}
                <th class="text-left py-2 px-3 font-medium text-gray-700">Date</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {submissions.map((s, i) => {
                const data: any = s.data || {};
                return (
                  <tr class="hover:bg-gray-50">
                    <td class="py-2.5 px-3 text-gray-400 text-xs">{i + 1}</td>
                    {fields.map(f => <td class="py-2.5 px-3 text-gray-900 text-xs truncate max-w-[200px]">{String(data[f.label] || '-')}</td>)}
                    <td class="py-2.5 px-3 text-gray-500 text-xs">{formatDate(s.createdAt)}</td>
                    <td class="py-2.5 px-3"><span class:list={["inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase", s.status === 'new' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-500']}>{s.status}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div class="p-4 border-t">
          <button onclick="exportCSV()" class="px-3 py-1.5 text-xs font-medium text-green-700 border border-green-200 rounded-lg hover:bg-green-50">Export CSV</button>
        </div>
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <p class="text-sm text-gray-500">No submissions yet.</p>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ submissions: submissions.map(s => ({ data: s.data, createdAt: s.createdAt, status: s.status })), fields: fields.map(f => f.label) }}>
    function exportCSV() {
      var csv = fields.join(',') + ',Submitted,Status\n';
      submissions.forEach(function(s) {
        var row = fields.map(function(f) {
          var val = s.data[f];
          if (Array.isArray(val)) val = val.join('; ');
          val = String(val || '');
          if (val.includes(',')) val = '"' + val.replace(/"/g, '""') + '"';
          return val;
        });
        var date = s.createdAt ? new Date(s.createdAt).toLocaleDateString() : '';
        row.push(date, s.status);
        csv += row.join(',') + '\n';
      });
      var blob = new Blob([csv], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'form-submissions.csv';
      a.click();
      URL.revokeObjectURL(url);
    }
  </script>
</DashboardLayout>
