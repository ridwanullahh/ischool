---
/**
 * Form Editor - build forms with drag-and-drop field builder
 */
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { forms } from '../../../../lib/db/schema.js';
import { eq, and } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
const formId = parseInt(Astro.params.id);
const db = getDb();
const form = schoolId ? db.select().from(forms).where(and(eq(forms.id, formId), eq(forms.schoolId, schoolId))).get() : null;
if (!form) return Astro.redirect('/dashboard/forms');
let fields: any[] = [];
try {
  if (Array.isArray(form.fields)) fields = form.fields;
  else if (typeof form.fields === 'string') fields = JSON.parse(form.fields);
  else fields = [];
} catch { fields = []; }
---

<DashboardLayout title={`Edit: ${form.title} - iSchool`}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <a href="/dashboard/forms" class="text-sm text-gray-500 hover:text-gray-700 mb-2 inline-block">Back to Forms</a>
        <h2 class="text-2xl font-bold text-gray-900">{form.title}</h2>
        <p class="text-sm text-gray-500 mt-1">Public URL: /{form.slug}/forms/{form.slug}</p>
      </div>
      <div class="flex items-center gap-2">
        <select id="statusSelect" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="updateStatus(this.value)">
          <option value="draft" selected={form.status === 'draft'}>Draft</option>
          <option value="published" selected={form.status === 'published'}>Published</option>
          <option value="closed" selected={form.status === 'closed'}>Closed</option>
        </select>
        <button onclick="saveForm()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Save Form</button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {/* Field types palette */}
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Add Field</h3>
        <div class="space-y-2">
          {[
            { type: 'text', label: 'Text Input', icon: 'M4 6h16M4 12h16M4 18h7' },
            { type: 'textarea', label: 'Long Text', icon: 'M4 6h16M4 12h16M4 18h16' },
            { type: 'email', label: 'Email', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
            { type: 'phone', label: 'Phone', icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' },
            { type: 'number', label: 'Number', icon: 'M7 20l4-16m2 16l4-16M6 9h14M4 15h14' },
            { type: 'select', label: 'Dropdown', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
            { type: 'radio', label: 'Radio', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
            { type: 'checkbox', label: 'Checkbox', icon: 'M5 13l4 4L19 7' },
            { type: 'date', label: 'Date', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
            { type: 'file', label: 'File Upload', icon: 'M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12' },
            { type: 'heading', label: 'Section Heading', icon: 'M4 6h16M4 12h8' },
            { type: 'paragraph', label: 'Info Text', icon: 'M4 6h16M4 10h16M4 14h16M4 18h10' },
          ].map(ft => (
            <button type="button" data-field-type={ft.type} onclick={`addField('${ft.type}')`} class="w-full flex items-center gap-3 p-2.5 rounded-lg border border-gray-200 hover:border-primary-300 hover:bg-primary-50/30 text-left transition-colors">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={ft.icon}/></svg>
              <span class="text-sm font-medium text-gray-700">{ft.label}</span>
            </button>
          ))}
        </div>
      </div>

      {/* Form preview */}
      <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Form Preview</h3>
        {form.description && <p class="text-sm text-gray-600 mb-6">{form.description}</p>}
        <div id="fieldsContainer" class="space-y-4">
          {fields.length > 0 ? fields.map((f, i) => (
            <div class="border border-gray-200 rounded-lg p-4 field-item" data-field-index={i}>
              <div class="flex items-start justify-between mb-2">
                <div class="flex-1">
                  <label class="block text-sm font-medium text-gray-900">{f.label || 'Untitled'} {f.required && <span class="text-red-500">*</span>}</label>
                  {f.helpText && <p class="text-xs text-gray-500 mt-0.5">{f.helpText}</p>}
                </div>
                <div class="flex items-center gap-1">
                  <button onclick={`editField(${i})`} class="text-gray-400 hover:text-primary-600 p-1" aria-label="Edit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></button>
                  <button onclick={`removeField(${i})`} class="text-gray-400 hover:text-red-600 p-1" aria-label="Remove"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/></svg></button>
                </div>
              </div>
              {f.type === 'text' && <input type="text" disabled placeholder={f.placeholder || ''} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50" />}
              {f.type === 'textarea' && <textarea disabled rows="3" placeholder={f.placeholder || ''} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50"></textarea>}
              {f.type === 'email' && <input type="email" disabled placeholder="email@example.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50" />}
              {f.type === 'phone' && <input type="tel" disabled placeholder="+1234567890" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50" />}
              {f.type === 'number' && <input type="number" disabled class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50" />}
              {f.type === 'select' && <select disabled class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50"><option>Choose...</option>{(f.options || []).map((o: string) => <option>{o}</option>)}</select>}
              {f.type === 'radio' && <div class="space-y-1">{(f.options || []).map((o: string) => <label class="flex items-center gap-2 text-sm"><input type="radio" disabled /> {o}</label>)}</div>}
              {f.type === 'checkbox' && <div class="space-y-1">{(f.options || []).map((o: string) => <label class="flex items-center gap-2 text-sm"><input type="checkbox" disabled /> {o}</label>)}</div>}
              {f.type === 'date' && <input type="date" disabled class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50" />}
              {f.type === 'file' && <input type="file" disabled class="w-full text-sm text-gray-500" />}
              {f.type === 'heading' && <h4 class="text-lg font-bold text-gray-900">{f.label}</h4>}
              {f.type === 'paragraph' && <p class="text-sm text-gray-600">{f.helpText || f.label}</p>}
            </div>
          )) : (
            <p class="text-sm text-gray-400 text-center py-8">No fields yet. Add fields from the left panel.</p>
          )}
        </div>

        {/* Form settings */}
        <div class="mt-6 pt-6 border-t border-gray-200 space-y-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Submit Button Text</label><input id="submitButtonText" type="text" value={form.submitButtonText || 'Submit'} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Success Message</label><input id="successMessage" type="text" value={form.successMessage || ''} placeholder="Thank you for your submission!" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
      </div>
    </div>
  </div>

  {/* Field editor modal */}
  <div id="fieldModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900" id="fieldModalTitle">Add Field</h3>
        <button onclick="document.getElementById('fieldModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="fieldForm" class="space-y-3">
        <input type="hidden" name="fieldIndex" id="fieldIndex" value="-1" />
        <input type="hidden" name="type" id="fieldType" value="" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Label</label><input name="label" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Placeholder (optional)</label><input name="placeholder" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Help Text (optional)</label><input name="helpText" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div id="optionsContainer" class="hidden"><label class="block text-xs font-medium text-gray-700 mb-1">Options (one per line)</label><textarea name="options" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Option 1&#10;Option 2"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Required</label><select name="required" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="false">No</option><option value="true">Yes</option></select></div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Save Field</button>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ formId, schoolId, existingFields: fields }}>
    var fields = JSON.parse(JSON.stringify(existingFields));

    function addField(type) {
      document.getElementById('fieldIndex').value = '-1';
      document.getElementById('fieldType').value = type;
      document.getElementById('fieldModalTitle').textContent = 'Add ' + type.charAt(0).toUpperCase() + type.slice(1) + ' Field';
      document.getElementById('fieldForm').reset();
      document.getElementById('fieldType').value = type;
      document.getElementById('optionsContainer').classList.toggle('hidden', !['select', 'radio', 'checkbox'].includes(type));
      document.getElementById('fieldModal').classList.remove('hidden');
    }

    function editField(index) {
      var f = fields[index];
      document.getElementById('fieldIndex').value = String(index);
      document.getElementById('fieldType').value = f.type;
      document.getElementById('fieldModalTitle').textContent = 'Edit Field';
      document.querySelector('[name="label"]').value = f.label || '';
      document.querySelector('[name="placeholder"]').value = f.placeholder || '';
      document.querySelector('[name="helpText"]').value = f.helpText || '';
      document.querySelector('[name="required"]').value = f.required ? 'true' : 'false';
      if (f.options) document.querySelector('[name="options"]').value = f.options.join('\n');
      document.getElementById('optionsContainer').classList.toggle('hidden', !['select', 'radio', 'checkbox'].includes(f.type));
      document.getElementById('fieldModal').classList.remove('hidden');
    }

    document.getElementById('fieldForm').addEventListener('submit', function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var index = parseInt(fd.get('fieldIndex'));
      var field = {
        type: fd.get('type'),
        label: fd.get('label'),
        placeholder: fd.get('placeholder') || '',
        helpText: fd.get('helpText') || '',
        required: fd.get('required') === 'true',
      };
      var options = fd.get('options');
      if (options && options.trim()) field.options = options.split('\n').filter(function(l) { return l.trim(); });
      if (index >= 0) { fields[index] = field; } else { fields.push(field); }
      document.getElementById('fieldModal').classList.add('hidden');
      // Reload to show updated fields
      saveForm(true);
    });

    function removeField(index) {
      if (!confirm('Remove this field?')) return;
      fields.splice(index, 1);
      saveForm(true);
    }

    async function saveForm(silent) {
      var body = {
        formId,
        schoolId,
        fields: fields,
        submitButtonText: document.getElementById('submitButtonText').value,
        successMessage: document.getElementById('successMessage').value,
      };
      var res = await fetch('/api/dashboard/forms', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) {
        if (!silent) alert('Form saved successfully');
        if (silent) window.location.reload();
      } else {
        alert('Failed to save form');
      }
    }

    async function updateStatus(status) {
      var res = await fetch('/api/dashboard/forms', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ formId, schoolId, status }) });
      if (!res.ok) alert('Failed to update status');
    }
  </script>
</DashboardLayout>
