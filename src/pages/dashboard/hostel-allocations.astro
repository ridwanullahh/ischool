---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { hostelAllocations, hostelRooms, hostels, students, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allHostels = await db.select().from(hostels).where(eq(hostels.schoolId, schoolId)).all();
const allRooms = await db.select({
  id: hostelRooms.id, roomNumber: hostelRooms.roomNumber, floor: hostelRooms.floor,
  type: hostelRooms.type, capacity: hostelRooms.capacity, occupants: hostelRooms.occupants,
  status: hostelRooms.status, hostelId: hostelRooms.hostelId,
}).from(hostelRooms).all();
const schoolRooms = allRooms.filter(r => allHostels.some(h => h.id === r.hostelId));

const allocations = await db.select({
  id: hostelAllocations.id, studentId: hostelAllocations.studentId, roomId: hostelAllocations.roomId,
  academicYear: hostelAllocations.academicYear, status: hostelAllocations.status, createdAt: hostelAllocations.createdAt,
  studentName: students.firstName, studentLastName: students.lastName, studentCode: students.studentId,
  roomNumber: hostelRooms.roomNumber, hostelName: hostels.name, hostelType: hostels.type,
}).from(hostelAllocations)
  .leftJoin(students, eq(hostelAllocations.studentId, students.id))
  .leftJoin(hostelRooms, eq(hostelAllocations.roomId, hostelRooms.id))
  .leftJoin(hostels, eq(hostelRooms.hostelId, hostels.id))
  .where(eq(hostelAllocations.schoolId, schoolId))
  .orderBy(desc(hostelAllocations.createdAt)).all();

const allStudents = await db.select({ id: students.id, name: students.firstName, lastName: students.lastName, code: students.studentId })
  .from(students).where(eq(students.schoolId, schoolId)).all();

const stats = {
  total: allocations.length,
  active: allocations.filter(a => a.status === 'active').length,
  checkedOut: allocations.filter(a => a.status === 'checked_out').length,
  availableRooms: schoolRooms.filter(r => r.status === 'available').length,
};
const statusColors: Record<string, string> = { active: 'bg-green-100 text-green-700', checked_out: 'bg-gray-100 text-gray-700', cancelled: 'bg-red-100 text-red-700' };
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
---

<DashboardLayout title="Hostel Allocations - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Hostel Allocations</h2>
        <p class="text-sm text-gray-500 mt-1">Allocate students to hostel rooms. Room capacity auto-updates; full rooms become unavailable.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Allocate Room</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Allocations</div><div class="text-2xl font-bold">{stats.total}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Active</div><div class="text-2xl font-bold text-green-600">{stats.active}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Checked Out</div><div class="text-2xl font-bold text-gray-600">{stats.checkedOut}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Available Rooms</div><div class="text-2xl font-bold text-blue-600">{stats.availableRooms}</div></div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      {allocations.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">🛏️</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No allocations yet</h3>
          <p class="text-sm text-gray-500">Allocate a student to a hostel room.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Student</th><th class="px-4 py-3">Hostel</th>
              <th class="px-4 py-3">Room</th><th class="px-4 py-3">Academic Year</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Allocated On</th>
              <th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {allocations.map(a => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{a.studentName} {a.studentLastName}<div class="text-xs text-gray-500">{a.studentCode}</div></td>
                  <td class="px-4 py-3 text-gray-700">{a.hostelName}<div class="text-xs text-gray-500 capitalize">{a.hostelType || ''}</div></td>
                  <td class="px-4 py-3 text-gray-700">{a.roomNumber || '—'}</td>
                  <td class="px-4 py-3 text-gray-600">{a.academicYear}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[a.status]}`}>{a.status.replace('_', ' ')}</span></td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(a.createdAt)}</td>
                  <td class="px-4 py-3">
                    {a.status === 'active' && <button onclick={`deallocate(${a.id})`} class="text-xs text-amber-600 font-medium">Check Out</button>}
                    <button onclick={`deleteAlloc(${a.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <div id="allocModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Allocate Room</h3>
      <form id="allocForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Student *</label>
          <select name="studentId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select student…</option>
            {allStudents.map(s => <option value={s.id}>{s.name} {s.lastName} ({s.code})</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Room *</label>
          <select name="roomId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select room…</option>
            {schoolRooms.filter(r => r.status !== 'full' && r.status !== 'maintenance').map(r => {
              const h = allHostels.find(x => x.id === r.hostelId);
              return <option value={r.id}>{h?.name} — Room {r.roomNumber} (Floor {r.floor}, {r.occupants}/{r.capacity} occupied, {r.type})</option>;
            })}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Academic Year *</label><input name="academicYear" required placeholder="2025-2026" value="2025-2026" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('allocModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Allocate</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openModal = function() { document.getElementById('allocModal').classList.remove('hidden'); };
    window.deallocate = async function(id) {
      if (!confirm('Check out this student? Room occupancy will be decremented.')) return;
      await fetch('/api/dashboard/hostel-allocations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'deallocate', id: id }) });
      window.location.reload();
    };
    window.deleteAlloc = async function(id) {
      if (!confirm('Delete this allocation record?')) return;
      await fetch('/api/dashboard/hostel-allocations', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    document.getElementById('allocForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/hostel-allocations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ studentId: parseInt(fd.get('studentId')), roomId: parseInt(fd.get('roomId')), academicYear: fd.get('academicYear') }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
