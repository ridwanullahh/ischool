---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../../../lib/school.js';
import { getDb } from '../../../../lib/db/index.js';
import { banners } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';
const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const itemId = Astro.params.id;
if (!itemId) return Astro.redirect('/dashboard/banners');
const db = getDb();
let item: any = null;
if (schoolId) { try { const all = await db.select().from(banners).where(eq(banners.schoolId, schoolId)).all()||[]; item = all.find(i=>String(i.id)===String(itemId))||null; } catch {} }
if (!item) return Astro.redirect('/dashboard/banners');
---
<DashboardLayout title="Edit Banner - iSchool">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/banners" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div><h1 class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Edit Banner</h1></div>
    </div>
    <form method="POST" action="/api/dashboard/banners" class="mosaic-card p-6 lg:p-8 space-y-6">
      <input type="hidden" name="id" value={item.id} />
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Title</label><input type="text" name="title" value={item.title||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Image URL</label><input type="text" name="imageUrl" value={item.imageUrl||item.image_url||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Link URL</label><input type="text" name="linkUrl" value={item.linkUrl||item.link_url||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Position</label><select name="position" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);"><option value="hero" selected={item.position==='hero'}>Hero</option><option value="top" selected={item.position==='top'}>Top Banner</option><option value="sidebar" selected={item.position==='sidebar'}>Sidebar</option><option value="footer" selected={item.position==='footer'}>Footer</option></select></div>
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Start Date</label><input type="date" name="startDate" value={item.startDate||item.start_date||''} class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      </div>
      <div class="flex items-center justify-between pt-4" style="border-top:1px solid var(--mosaic-border);">
        <div class="flex items-center gap-3"><button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Save Changes</button><a href="/dashboard/banners" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">Cancel</a></div>
        <form method="POST" action="/api/dashboard/banners" onsubmit="return confirm('Delete?')"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={item.id} /><button type="submit" class="px-4 py-2.5 rounded-xl text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">Delete</button></form>
      </div>
    </form>
  </div>
</DashboardLayout>
