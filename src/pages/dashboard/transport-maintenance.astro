---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { vehicleMaintenance, vehicleDocuments, vehicles, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const maintenance = await db.select({
  id: vehicleMaintenance.id, vehicleId: vehicleMaintenance.vehicleId,
  serviceType: vehicleMaintenance.serviceType, description: vehicleMaintenance.description,
  serviceDate: vehicleMaintenance.serviceDate, nextServiceDate: vehicleMaintenance.nextServiceDate,
  odometer: vehicleMaintenance.odometer, cost: vehicleMaintenance.cost,
  serviceProvider: vehicleMaintenance.serviceProvider, status: vehicleMaintenance.status,
  notes: vehicleMaintenance.notes, createdAt: vehicleMaintenance.createdAt,
  vehicleName: vehicles.name, vehiclePlate: vehicles.plateNumber,
}).from(vehicleMaintenance)
  .leftJoin(vehicles, eq(vehicleMaintenance.vehicleId, vehicles.id))
  .where(eq(vehicleMaintenance.schoolId, schoolId))
  .orderBy(desc(vehicleMaintenance.serviceDate)).all();

const documents = await db.select({
  id: vehicleDocuments.id, vehicleId: vehicleDocuments.vehicleId, driverId: vehicleDocuments.driverId,
  documentType: vehicleDocuments.documentType, documentNumber: vehicleDocuments.documentNumber,
  issueDate: vehicleDocuments.issueDate, expiryDate: vehicleDocuments.expiryDate,
  fileUrl: vehicleDocuments.fileUrl, notes: vehicleDocuments.notes,
  vehicleName: vehicles.name, vehiclePlate: vehicles.plateNumber,
}).from(vehicleDocuments)
  .leftJoin(vehicles, eq(vehicleDocuments.vehicleId, vehicles.id))
  .where(eq(vehicleDocuments.schoolId, schoolId))
  .orderBy(desc(vehicleDocuments.expiryDate)).all();

const allVehicles = await db.select().from(vehicles).where(eq(vehicles.schoolId, schoolId)).all();

// Today + 30 days for "expiring soon"
const today = new Date().toISOString().split('T')[0];
const in30 = new Date(); in30.setDate(in30.getDate() + 30);
const in30Str = in30.toISOString().split('T')[0];

const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const fmtMoney = (n: any) => n ? '₦' + n.toLocaleString() : '—';

// Pre-compute document status to avoid < in JSX expressions
const docsEnriched = documents.map(d => {
  const isExpired = d.expiryDate < today;
  const isExpiring = isExpired ? false : d.expiryDate <= in30Str;
  return {
    ...d,
    badgeClass: isExpired ? 'bg-red-100 text-red-700' : isExpiring ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700',
    badgeText: isExpired ? 'Expired' : isExpiring ? 'Expiring Soon' : 'Valid',
  };
});
const expiringSoon = docsEnriched.filter(d => d.badgeText === 'Expiring Soon');
const expired = docsEnriched.filter(d => d.badgeText === 'Expired');

const stats = {
  totalServices: maintenance.length,
  pendingServices: maintenance.filter(m => m.status === 'scheduled' || m.status === 'in_progress').length,
  totalCost: maintenance.reduce((s, m) => s + (m.cost || 0), 0),
  expiredDocs: expired.length,
  expiringSoon: expiringSoon.length,
};
const serviceTypeLabels: Record<string, string> = { routine: 'Routine Service', repair: 'Repair', inspection: 'Inspection', registration: 'Registration', insurance: 'Insurance', other: 'Other' };
const serviceTypeColors: Record<string, string> = { routine: 'bg-blue-100 text-blue-700', repair: 'bg-red-100 text-red-700', inspection: 'bg-amber-100 text-amber-700', registration: 'bg-purple-100 text-purple-700', insurance: 'bg-green-100 text-green-700', other: 'bg-gray-100 text-gray-700' };
const statusColors: Record<string, string> = { scheduled: 'bg-amber-100 text-amber-700', in_progress: 'bg-blue-100 text-blue-700', completed: 'bg-green-100 text-green-700', cancelled: 'bg-gray-100 text-gray-700' };
const docTypeLabels: Record<string, string> = { driver_license: "Driver's License", vehicle_registration: 'Vehicle Registration', insurance: 'Insurance', road_worthiness: 'Road Worthiness', permit: 'Permit', other: 'Other' };
// remove the fmtDate/fmtMoney redeclarations below by deleting them
---

<DashboardLayout title="Transport Maintenance - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Vehicle Maintenance & Documents</h2>
        <p class="text-sm text-gray-500 mt-1">Track vehicle service history, upcoming maintenance, and document expiry (driver licenses, insurance, registrations, permits).</p>
      </div>
      <div class="flex gap-2">
        <button onclick="openServiceModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Log Service</button>
        <button onclick="openDocModal()" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">+ Add Document</button>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Services</div><div class="text-2xl font-bold">{stats.totalServices}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Pending</div><div class="text-2xl font-bold text-amber-600">{stats.pendingServices}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Cost</div><div class="text-2xl font-bold text-blue-600">{fmtMoney(stats.totalCost)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Expiring Soon</div><div class="text-2xl font-bold text-amber-600">{stats.expiringSoon}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Expired</div><div class="text-2xl font-bold text-red-600">{stats.expiredDocs}</div></div>
    </div>

    {/* Documents with expiry alerts */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Documents & Expiry Alerts ({docsEnriched.length})</div>
      {docsEnriched.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No documents tracked yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Vehicle</th><th class="px-4 py-3">Document Type</th>
              <th class="px-4 py-3">Number</th><th class="px-4 py-3">Issue Date</th>
              <th class="px-4 py-3">Expiry Date</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {docsEnriched.map(d => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{d.vehicleName || '—'}<div class="text-xs text-gray-500">{d.vehiclePlate || ''}</div></td>
                  <td class="px-4 py-3 text-gray-700">{docTypeLabels[d.documentType] || d.documentType}</td>
                  <td class="px-4 py-3 text-gray-600">{d.documentNumber || '—'}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(d.issueDate)}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(d.expiryDate)}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${d.badgeClass}`}>{d.badgeText}</span></td>
                  <td class="px-4 py-3"><button onclick={`deleteDoc(${d.id})`} class="text-xs text-red-600 font-medium">Delete</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    {/* Maintenance log */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Service History ({maintenance.length})</div>
      {maintenance.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No service records.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Vehicle</th><th class="px-4 py-3">Type</th>
              <th class="px-4 py-3">Date</th><th class="px-4 py-3">Odometer</th>
              <th class="px-4 py-3">Provider</th><th class="px-4 py-3">Cost</th>
              <th class="px-4 py-3">Next Service</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {maintenance.map(m => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{m.vehicleName}<div class="text-xs text-gray-500">{m.vehiclePlate}</div></td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${serviceTypeColors[m.serviceType]}`}>{serviceTypeLabels[m.serviceType] || m.serviceType}</span></td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(m.serviceDate)}</td>
                  <td class="px-4 py-3 text-gray-600">{m.odometer ? m.odometer.toLocaleString() + ' km' : '—'}</td>
                  <td class="px-4 py-3 text-gray-600">{m.serviceProvider || '—'}</td>
                  <td class="px-4 py-3 font-medium text-gray-900">{fmtMoney(m.cost)}</td>
                  <td class="px-4 py-3 text-gray-600">{m.nextServiceDate ? fmtDate(m.nextServiceDate) : '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[m.status]}`}>{m.status.replace('_', ' ')}</span></td>
                  <td class="px-4 py-3"><button onclick={`deleteService(${m.id})`} class="text-xs text-red-600 font-medium">Delete</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* Service Modal */}
  <div id="serviceModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Log Vehicle Service</h3>
      <form id="serviceForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Vehicle *</label>
          <select name="vehicleId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select vehicle…</option>
            {allVehicles.map(v => <option value={v.id}>{v.name} ({v.plateNumber})</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Service Type</label>
            <select name="serviceType" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              {Object.entries(serviceTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Service Date *</label><input name="serviceDate" type="date" required value={today} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="2" placeholder="e.g. Oil change, brake pad replacement" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Odometer (km)</label><input name="odometer" type="number" placeholder="45000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Cost (₦)</label><input name="cost" type="number" placeholder="15000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Service Provider</label><input name="serviceProvider" placeholder="e.g. ABC Motors" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Next Service Date</label><input name="nextServiceDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
          <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="completed">Completed</option><option value="scheduled">Scheduled</option>
            <option value="in_progress">In Progress</option><option value="cancelled">Cancelled</option>
          </select>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('serviceModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Log Service</button>
        </div>
      </form>
    </div>
  </div>

  {/* Document Modal */}
  <div id="docModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Add Document</h3>
      <form id="docForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Vehicle</label>
          <select name="vehicleId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">—</option>
            {allVehicles.map(v => <option value={v.id}>{v.name} ({v.plateNumber})</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Document Type *</label>
            <select name="documentType" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              {Object.entries(docTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Document Number</label><input name="documentNumber" placeholder="e.g. DL-12345678" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Issue Date</label><input name="issueDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Expiry Date *</label><input name="expiryDate" type="date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">File URL (optional)</label><input name="fileUrl" placeholder="https://…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Notes</label><input name="notes" placeholder="Optional" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('docModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg">Add Document</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openServiceModal = function() { document.getElementById('serviceModal').classList.remove('hidden'); };
    window.openDocModal = function() { document.getElementById('docModal').classList.remove('hidden'); };
    window.deleteService = async function(id) {
      if (!confirm('Delete this service record?')) return;
      await fetch('/api/dashboard/transport-maintenance', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.deleteDoc = async function(id) {
      if (!confirm('Delete this document?')) return;
      await fetch('/api/dashboard/transport-maintenance', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id, type: 'document' }) });
      window.location.reload();
    };
    document.getElementById('serviceForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/transport-maintenance', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        vehicleId: parseInt(fd.get('vehicleId')),
        serviceType: fd.get('serviceType'),
        description: fd.get('description') || null,
        serviceDate: fd.get('serviceDate'),
        nextServiceDate: fd.get('nextServiceDate') || null,
        odometer: fd.get('odometer') ? parseInt(fd.get('odometer')) : null,
        cost: fd.get('cost') ? parseInt(fd.get('cost')) : null,
        serviceProvider: fd.get('serviceProvider') || null,
        status: fd.get('status'),
        notes: fd.get('notes') || null,
      }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
    document.getElementById('docForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/transport-maintenance', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        action: 'add_document',
        vehicleId: fd.get('vehicleId') ? parseInt(fd.get('vehicleId')) : null,
        documentType: fd.get('documentType'),
        documentNumber: fd.get('documentNumber') || null,
        issueDate: fd.get('issueDate') || null,
        expiryDate: fd.get('expiryDate'),
        fileUrl: fd.get('fileUrl') || null,
        notes: fd.get('notes') || null,
      }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
