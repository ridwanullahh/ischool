---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { jobPostings, jobApplications, interviews, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const jobs = await db.select().from(jobPostings).where(eq(jobPostings.schoolId, schoolId)).orderBy(desc(jobPostings.createdAt)).all();
const apps = await db.select().from(jobApplications).all();
const jobMap = new Map(jobs.map(j => [j.id, j]));
const schoolApps = apps.filter(a => jobMap.has(a.jobId));

const ints = await db.select({
  id: interviews.id, scheduledAt: interviews.scheduledAt, location: interviews.location,
  notes: interviews.notes, status: interviews.status, applicationId: interviews.applicationId,
  applicantName: jobApplications.applicantName, applicantEmail: jobApplications.applicantEmail,
  jobTitle: jobPostings.title,
}).from(interviews)
  .leftJoin(jobApplications, eq(interviews.applicationId, jobApplications.id))
  .leftJoin(jobPostings, eq(jobApplications.jobId, jobPostings.id))
  .where(eq(jobPostings.schoolId, schoolId))
  .orderBy(desc(interviews.scheduledAt)).all();

const stats = {
  totalJobs: jobs.length,
  openJobs: jobs.filter(j => j.status === 'open').length,
  totalApps: schoolApps.length,
  pendingReview: schoolApps.filter(a => a.status === 'submitted' || a.status === 'reviewing').length,
  interviewed: schoolApps.filter(a => a.status === 'interviewed').length,
  hired: schoolApps.filter(a => a.status === 'hired').length,
};

const statusColors: Record<string, string> = {
  draft: 'bg-gray-100 text-gray-700', open: 'bg-green-100 text-green-700',
  closed: 'bg-amber-100 text-amber-700', filled: 'bg-blue-100 text-blue-700',
  submitted: 'bg-blue-100 text-blue-700', reviewing: 'bg-amber-100 text-amber-700',
  interviewed: 'bg-purple-100 text-purple-700', offered: 'bg-cyan-100 text-cyan-700',
  hired: 'bg-green-100 text-green-700', rejected: 'bg-red-100 text-red-700',
};
const empTypeLabels: Record<string, string> = { full_time: 'Full-time', part_time: 'Part-time', contract: 'Contract', volunteer: 'Volunteer' };
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const fmtDateTime = (d: any) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
---

<DashboardLayout title="Recruitment - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Recruitment</h2>
        <p class="text-sm text-gray-500 mt-1">Manage job postings, track applications, schedule interviews, and onboard new hires.</p>
      </div>
      <button onclick="openJobModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Post a Job</button>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Open Jobs</div><div class="text-2xl font-bold text-green-600">{stats.openJobs}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Jobs</div><div class="text-2xl font-bold">{stats.totalJobs}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Applications</div><div class="text-2xl font-bold text-blue-600">{stats.totalApps}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Interviewed</div><div class="text-2xl font-bold text-purple-600">{stats.interviewed}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Hired</div><div class="text-2xl font-bold text-emerald-600">{stats.hired}</div></div>
    </div>

    {/* Job Postings */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Job Postings</div>
      {jobs.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">💼</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No job postings yet</h3>
          <p class="text-sm text-gray-500">Post your first job opening to start receiving applications.</p>
        </div>
      ) : (
        <div class="divide-y divide-gray-100">
          {jobs.map(j => {
            const jobApps = schoolApps.filter(a => a.jobId === j.id);
            return (
              <div class="p-4">
                <div class="flex items-start justify-between">
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-semibold text-gray-900">{j.title}</h3>
                      <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[j.status]}`}>{j.status}</span>
                      <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-700">{empTypeLabels[j.employmentType] || j.employmentType}</span>
                    </div>
                    <p class="text-xs text-gray-500 mt-0.5">
                      {j.department && <span>{j.department}</span>}
                      {j.salaryRange && <span> · {j.salaryRange}</span>}
                      {j.applicationDeadline && <span> · Apply by {fmtDate(j.applicationDeadline)}</span>}
                    </p>
                    {j.description && <p class="text-sm text-gray-600 mt-2 line-clamp-2">{j.description.substring(0, 200)}{j.description.length > 200 ? '…' : ''}</p>}
                  </div>
                  <div class="flex gap-2 shrink-0">
                    <button onclick={`viewApplications(${j.id})`} class="text-xs text-primary-600 font-medium">View Applications ({jobApps.length})</button>
                    <button onclick={`editJob(${j.id})`} class="text-xs text-amber-600 font-medium">Edit</button>
                    <button onclick={`deleteJob(${j.id})`} class="text-xs text-red-600 font-medium">Delete</button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    {/* Upcoming Interviews */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Interviews</div>
      {ints.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No interviews scheduled.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">When</th><th class="px-4 py-3">Applicant</th>
              <th class="px-4 py-3">Position</th><th class="px-4 py-3">Location</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Notes</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {ints.map(i => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-gray-700">{fmtDateTime(i.scheduledAt)}</td>
                  <td class="px-4 py-3 font-medium text-gray-900">{i.applicantName}<div class="text-xs text-gray-500">{i.applicantEmail}</div></td>
                  <td class="px-4 py-3 text-gray-700">{i.jobTitle}</td>
                  <td class="px-4 py-3 text-gray-600">{i.location || '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[i.status] || 'bg-gray-100'}`}>{i.status}</span></td>
                  <td class="px-4 py-3 text-gray-600 text-xs">{i.notes || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* Job Modal */}
  <div id="jobModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="jobModalTitle">Post a Job</h3>
      <form id="jobForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Job Title *</label><input name="title" required placeholder="e.g. Mathematics Teacher" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Department</label><input name="department" placeholder="e.g. Science" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Employment Type</label>
            <select name="employmentType" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="full_time">Full-time</option><option value="part_time">Part-time</option>
              <option value="contract">Contract</option><option value="volunteer">Volunteer</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Salary Range</label><input name="salaryRange" placeholder="e.g. ₦80,000 - ₦120,000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="4" placeholder="Job description, responsibilities, etc." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Requirements (one per line)</label><textarea name="requirements" rows="3" placeholder="Bachelor's degree in Education&#10;3+ years teaching experience" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Application Deadline</label><input name="applicationDeadline" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
            <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="draft">Draft</option><option value="open">Open</option>
              <option value="closed">Closed</option><option value="filled">Filled</option>
            </select>
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('jobModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save</button>
        </div>
      </form>
    </div>
  </div>

  {/* Applications Modal */}
  <div id="appsModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-3xl w-full max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-gray-900" id="appsModalTitle">Applications</h3>
        <button onclick="document.getElementById('appsModal').classList.add('hidden')" class="text-gray-400 text-2xl">&times;</button>
      </div>
      <div id="appsList" class="space-y-3"></div>
    </div>
  </div>

  {/* Schedule Interview Modal */}
  <div id="interviewModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Schedule Interview</h3>
      <form id="interviewForm" class="space-y-3">
        <input type="hidden" name="applicationId" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">When *</label><input name="scheduledAt" type="datetime-local" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Location</label><input name="location" placeholder="e.g. Conference Room A / Zoom link" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Notes</label><textarea name="notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('interviewModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Schedule</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ jobs, schoolApps }} set:html={`(function(){
    var allJobs = jobs;
    var allApps = schoolApps;
    var statusColors = { draft: 'bg-gray-100 text-gray-700', open: 'bg-green-100 text-green-700', closed: 'bg-amber-100 text-amber-700', filled: 'bg-blue-100 text-blue-700', submitted: 'bg-blue-100 text-blue-700', reviewing: 'bg-amber-100 text-amber-700', interviewed: 'bg-purple-100 text-purple-700', offered: 'bg-cyan-100 text-cyan-700', hired: 'bg-green-100 text-green-700', rejected: 'bg-red-100 text-red-700' };

    window.openJobModal = function() {
      var form = document.getElementById('jobForm');
      form.reset(); form.id.value = '';
      document.getElementById('jobModalTitle').textContent = 'Post a Job';
      document.getElementById('jobModal').classList.remove('hidden');
    };
    window.editJob = function(id) {
      var j = allJobs.find(function(x){ return x.id === id; });
      if (!j) return;
      var form = document.getElementById('jobForm');
      form.id.value = j.id; form.title.value = j.title;
      form.department.value = j.department || '';
      form.employmentType.value = j.employmentType || 'full_time';
      form.salaryRange.value = j.salaryRange || '';
      form.description.value = j.description || '';
      // Requirements stored as JSON array
      try { var reqs = JSON.parse(j.requirements || '[]'); form.requirements.value = reqs.join('\\n'); } catch {}
      form.applicationDeadline.value = j.applicationDeadline || '';
      form.status.value = j.status || 'draft';
      document.getElementById('jobModalTitle').textContent = 'Edit Job';
      document.getElementById('jobModal').classList.remove('hidden');
    };
    window.deleteJob = async function(id) {
      if (!confirm('Delete this job posting? All applications will also be deleted.')) return;
      await fetch('/api/dashboard/recruitment', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.viewApplications = function(jobId) {
      var job = allJobs.find(function(j){ return j.id === jobId; });
      if (!job) return;
      document.getElementById('appsModalTitle').textContent = 'Applications — ' + job.title;
      var jobApps = allApps.filter(function(a){ return a.jobId === jobId; });
      var list = document.getElementById('appsList');
      list.innerHTML = '';
      if (jobApps.length === 0) {
        list.innerHTML = '<p class="text-sm text-gray-500 text-center py-8">No applications yet.</p>';
      } else {
        jobApps.forEach(function(a) {
          var row = document.createElement('div');
          row.className = 'border rounded-lg p-3';
          row.innerHTML = '<div class="flex items-start justify-between mb-2">' +
            '<div><div class="font-medium text-sm">' + a.applicantName + '</div>' +
            '<div class="text-xs text-gray-500">' + a.applicantEmail + (a.applicantPhone ? ' · ' + a.applicantPhone : '') + '</div></div>' +
            '<span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (statusColors[a.status] || '') + '">' + a.status + '</span></div>' +
            (a.coverLetter ? '<div class="text-xs text-gray-600 mb-2 p-2 bg-gray-50 rounded">' + (a.coverLetter.substring(0, 300)) + (a.coverLetter.length > 300 ? '…' : '') + '</div>' : '') +
            (a.resumeUrl ? '<a href="' + a.resumeUrl + '" target="_blank" class="text-xs text-blue-600 underline">View Resume</a>' : '') +
            '<div class="flex flex-wrap gap-2 mt-3">' +
            '<button onclick="updateAppStatus(' + a.id + ', \'reviewing\')" class="text-xs px-2 py-1 bg-amber-100 text-amber-700 rounded">Mark Reviewing</button>' +
            '<button onclick="openInterviewModal(' + a.id + ')" class="text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded">Schedule Interview</button>' +
            '<button onclick="updateAppStatus(' + a.id + ', \'rejected\')" class="text-xs px-2 py-1 bg-red-100 text-red-700 rounded">Reject</button>' +
            '<button onclick="hireApplicant(' + a.id + ')" class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded">Hire & Onboard</button>' +
            '</div>';
          list.appendChild(row);
        });
      }
      document.getElementById('appsModal').classList.remove('hidden');
    };
    window.openInterviewModal = function(appId) {
      document.getElementById('interviewForm').applicationId.value = appId;
      document.getElementById('interviewModal').classList.remove('hidden');
    };
    window.updateAppStatus = async function(id, status) {
      await fetch('/api/dashboard/recruitment', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'update_application_status', id: id, status: status }) });
      window.location.reload();
    };
    window.hireApplicant = async function(appId) {
      if (!confirm('Mark this applicant as hired and create a staff record?')) return;
      await fetch('/api/dashboard/recruitment', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'hire_applicant', applicationId: appId, createStaffRecord: true }) });
      alert('Applicant hired and staff record created!');
      window.location.reload();
    };

    document.getElementById('jobForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var id = fd.get('id');
      var payload = {
        action: 'create_job',
        title: fd.get('title'),
        department: fd.get('department') || null,
        employmentType: fd.get('employmentType'),
        salaryRange: fd.get('salaryRange') || null,
        description: fd.get('description') || null,
        requirements: fd.get('requirements') ? fd.get('requirements').split('\\n').filter(function(r){ return r.trim(); }) : [],
        applicationDeadline: fd.get('applicationDeadline') || null,
        status: fd.get('status'),
      };
      if (id) {
        payload.action = 'update_job';
        payload.id = parseInt(id);
        var res = await fetch('/api/dashboard/recruitment', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      } else {
        var res = await fetch('/api/dashboard/recruitment', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      }
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
    document.getElementById('interviewForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/recruitment', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'schedule_interview', applicationId: parseInt(fd.get('applicationId')), scheduledAt: fd.get('scheduledAt'), location: fd.get('location') || null, notes: fd.get('notes') || null })
      });
      if (res.ok) window.location.reload();
    });
  })();`} />
</DashboardLayout>
