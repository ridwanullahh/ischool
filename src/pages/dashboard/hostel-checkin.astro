---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { hostelCheckins, hostelVisitors, students, hostels, hostelRooms, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const checkins = db.select({
  id: hostelCheckins.id, studentId: hostelCheckins.studentId, roomId: hostelCheckins.roomId,
  type: hostelCheckins.type, timestamp: hostelCheckins.timestamp, notes: hostelCheckins.notes,
  studentName: students.firstName, studentLastName: students.lastName, studentCode: students.studentId,
  roomNumber: hostelRooms.roomNumber,
}).from(hostelCheckins)
  .leftJoin(students, eq(hostelCheckins.studentId, students.id))
  .leftJoin(hostelRooms, eq(hostelCheckins.roomId, hostelRooms.id))
  .where(eq(hostelCheckins.schoolId, schoolId))
  .orderBy(desc(hostelCheckins.timestamp)).all();

const visitors = db.select({
  id: hostelVisitors.id, visitorName: hostelVisitors.visitorName, visitorPhone: hostelVisitors.visitorPhone,
  visitorRelation: hostelVisitors.visitorRelation, timeIn: hostelVisitors.timeIn, timeOut: hostelVisitors.timeOut,
  purpose: hostelVisitors.purpose, notes: hostelVisitors.notes,
  visitingStudentName: students.firstName, visitingStudentLastName: students.lastName,
  hostelName: hostels.name,
}).from(hostelVisitors)
  .leftJoin(students, eq(hostelVisitors.visitingStudentId, students.id))
  .leftJoin(hostels, eq(hostelVisitors.hostelId, hostels.id))
  .where(eq(hostelVisitors.schoolId, schoolId))
  .orderBy(desc(hostelVisitors.createdAt)).all();

const allStudents = db.select({ id: students.id, name: students.firstName, lastName: students.lastName, code: students.studentId })
  .from(students).where(eq(students.schoolId, schoolId)).all();
const allHostels = db.select().from(hostels).where(eq(hostels.schoolId, schoolId)).all();

const stats = {
  totalCheckins: checkins.length,
  checkIns: checkins.filter(c => c.type === 'check_in').length,
  checkOuts: checkins.filter(c => c.type === 'check_out').length,
  activeVisitors: visitors.filter(v => !v.timeOut).length,
};

const fmtDateTime = (d: any) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
const typeColors: Record<string, string> = { check_in: 'bg-green-100 text-green-700', check_out: 'bg-amber-100 text-amber-700' };
---

<DashboardLayout title="Hostel Check-in/out - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Hostel Check-in / Check-out</h2>
      <p class="text-sm text-gray-500 mt-1">Log student check-ins/check-outs and manage the visitor log for hostel access control.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Logs</div><div class="text-2xl font-bold">{stats.totalCheckins}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Check-ins</div><div class="text-2xl font-bold text-green-600">{stats.checkIns}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Check-outs</div><div class="text-2xl font-bold text-amber-600">{stats.checkOuts}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Active Visitors</div><div class="text-2xl font-bold text-blue-600">{stats.activeVisitors}</div></div>
    </div>

    {/* Quick actions */}
    <div class="flex gap-2">
      <button onclick="openCheckinModal('checkin')" class="px-3 py-2 text-xs font-medium text-white bg-green-600 rounded-lg">Check In Student</button>
      <button onclick="openCheckinModal('checkout')" class="px-3 py-2 text-xs font-medium text-white bg-amber-600 rounded-lg">Check Out Student</button>
      <button onclick="openVisitorModal()" class="px-3 py-2 text-xs font-medium text-white bg-blue-600 rounded-lg">Log Visitor</button>
    </div>

    {/* Check-in/out log */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Student Check-in / Check-out Log</div>
      {checkins.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No check-in/out records.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Time</th><th class="px-4 py-3">Student</th>
              <th class="px-4 py-3">Room</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Notes</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {checkins.map(c => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 text-gray-600">{fmtDateTime(c.timestamp)}</td>
                  <td class="px-4 py-3 font-medium text-gray-900">{c.studentName} {c.studentLastName}<div class="text-xs text-gray-500">{c.studentCode}</div></td>
                  <td class="px-4 py-3 text-gray-700">{c.roomNumber || '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${typeColors[c.type]}`}>{c.type.replace('_', '-')}</span></td>
                  <td class="px-4 py-3 text-gray-600 text-xs">{c.notes || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    {/* Visitor log */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Visitor Log</div>
      {visitors.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No visitors logged.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Visitor</th><th class="px-4 py-3">Phone</th>
              <th class="px-4 py-3">Visiting</th><th class="px-4 py-3">Hostel</th>
              <th class="px-4 py-3">Time In</th><th class="px-4 py-3">Time Out</th>
              <th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {visitors.map(v => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{v.visitorName}<div class="text-xs text-gray-500">{v.visitorRelation || ''}</div></td>
                  <td class="px-4 py-3 text-gray-700">{v.visitorPhone || '—'}</td>
                  <td class="px-4 py-3 text-gray-700">{v.visitingStudentName} {v.visitingStudentLastName || ''}</td>
                  <td class="px-4 py-3 text-gray-700">{v.hostelName || '—'}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDateTime(v.timeIn)}</td>
                  <td class="px-4 py-3 text-gray-600">{v.timeOut ? fmtDateTime(v.timeOut) : <span class="text-amber-600 font-medium">Inside</span>}</td>
                  <td class="px-4 py-3">
                    {!v.timeOut && <button onclick={`signOutVisitor(${v.id})`} class="text-xs text-amber-600 font-medium">Sign Out</button>}
                    <button onclick={`deleteVisitor(${v.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* Check-in/out Modal */}
  <div id="checkinModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="checkinTitle">Check In Student</h3>
      <form id="checkinForm" class="space-y-3">
        <input type="hidden" name="action" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Student *</label>
          <select name="studentId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select student…</option>
            {allStudents.map(s => <option value={s.id}>{s.name} {s.lastName} ({s.code})</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Notes</label><textarea name="notes" rows="2" placeholder="Optional notes…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('checkinModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Log</button>
        </div>
      </form>
    </div>
  </div>

  {/* Visitor Modal */}
  <div id="visitorModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Log Visitor</h3>
      <form id="visitorForm" class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Visitor Name *</label><input name="visitorName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Phone</label><input name="visitorPhone" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Relation to Student</label><input name="visitorRelation" placeholder="e.g. Parent, Sibling, Guardian" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Visiting Student</label>
          <select name="visitingStudentId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">—</option>
            {allStudents.map(s => <option value={s.id}>{s.name} {s.lastName} ({s.code})</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Hostel</label>
          <select name="hostelId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">—</option>
            {allHostels.map(h => <option value={h.id}>{h.name}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Purpose of Visit</label><input name="purpose" placeholder="e.g. Family visit" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('visitorModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg">Sign In Visitor</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openCheckinModal = function(type) {
      document.getElementById('checkinForm').action.value = type;
      document.getElementById('checkinTitle').textContent = type === 'checkin' ? 'Check In Student' : 'Check Out Student';
      document.getElementById('checkinModal').classList.remove('hidden');
    };
    window.openVisitorModal = function() { document.getElementById('visitorModal').classList.remove('hidden'); };
    window.signOutVisitor = async function(id) {
      await fetch('/api/dashboard/hostel-checkin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'visitor_out', id: id, timeOut: new Date().toISOString() }) });
      window.location.reload();
    };
    window.deleteVisitor = async function(id) {
      if (!confirm('Delete this visitor record?')) return;
      await fetch('/api/dashboard/hostel-checkin', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id, type: 'visitor' }) });
      window.location.reload();
    };
    document.getElementById('checkinForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/hostel-checkin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: fd.get('action'), studentId: parseInt(fd.get('studentId')), notes: fd.get('notes') || null }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
    document.getElementById('visitorForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/hostel-checkin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        action: 'visitor_in',
        visitorName: fd.get('visitorName'),
        visitorPhone: fd.get('visitorPhone') || null,
        visitorRelation: fd.get('visitorRelation') || null,
        visitingStudentId: fd.get('visitingStudentId') ? parseInt(fd.get('visitingStudentId')) : null,
        hostelId: fd.get('hostelId') ? parseInt(fd.get('hostelId')) : null,
        timeIn: new Date().toISOString(),
        purpose: fd.get('purpose') || null,
      }) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
