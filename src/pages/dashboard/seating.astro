---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { seatingPlans, classes, students, enrollments, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const plans = await db.select().from(seatingPlans).where(eq(seatingPlans.schoolId, schoolId)).orderBy(desc(seatingPlans.createdAt)).all();
const allClasses = await db.select().from(classes).where(eq(classes.schoolId, schoolId)).all();
const allEnrollments = await db.select().from(enrollments).where(and(eq(enrollments.schoolId, schoolId), eq(enrollments.status, 'accepted'))).all();
const allStudents = await db.select({ id: students.id, name: students.firstName, lastName: students.lastName, code: students.studentId }).from(students).where(eq(students.schoolId, schoolId)).all();

const classMap = new Map(allClasses.map(c => [c.id, c.name]));
const studentsByClass = new Map<number, typeof allStudents>();
for (const e of allEnrollments) {
  if (e.classId && !studentsByClass.has(e.classId)) studentsByClass.set(e.classId, []);
  if (e.classId) {
    const s = allStudents.find(st => st.id === e.studentId);
    if (s) studentsByClass.get(e.classId)!.push(s);
  }
}
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
---

<DashboardLayout title="Seating Plans - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Seating Plans</h2>
        <p class="text-sm text-gray-500 mt-1">Create visual seating layouts per class. Drag students to seats, save multiple variants (regular, exam, group work).</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Seating Plan</button>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Plans</div><div class="text-2xl font-bold">{plans.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Classes</div><div class="text-2xl font-bold text-blue-600">{allClasses.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Default Plans</div><div class="text-2xl font-bold text-green-600">{plans.filter(p => p.isDefault).length}</div></div>
    </div>

    <div class="space-y-4">
      {plans.length === 0 ? (
        <div class="bg-white rounded-xl border p-12 text-center">
          <div class="text-4xl mb-3">🪑</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No seating plans yet</h3>
          <p class="text-sm text-gray-500">Create a seating plan for any class.</p>
        </div>
      ) : plans.map(p => {
        let layout: any = null;
        try { layout = typeof p.layout === 'string' ? JSON.parse(p.layout) : p.layout; } catch {}
        return (
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="p-4 border-b flex items-center justify-between">
              <div>
                <h3 class="font-semibold text-gray-900">{p.name}</h3>
                <p class="text-xs text-gray-500">
                  {classMap.get(p.classId) || 'Class'} · {p.rows}×{p.cols} grid · Created {fmtDate(p.createdAt)}
                  {p.isDefault && <span class="ml-2 text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-green-100 text-green-700">Default</span>}
                </p>
              </div>
              <div class="flex gap-2">
                <button onclick={`editPlan(${p.id})`} class="text-xs text-amber-600 font-medium">Edit</button>
                <button onclick={`deletePlan(${p.id})`} class="text-xs text-red-600 font-medium">Delete</button>
              </div>
            </div>
            {layout && Array.isArray(layout) && (
              <div class="p-6 overflow-x-auto bg-gray-50">
                <div class="text-xs text-center text-gray-500 mb-2">📋 Front of Class / Whiteboard</div>
                <div class="inline-grid gap-1 mx-auto" style={`grid-template-columns: repeat(${p.cols}, minmax(60px, 1fr));`}>
                  {layout.flat().map((seat: any, i: number) => (
                    <div class={`border-2 ${seat && seat.studentId ? 'border-blue-300 bg-blue-50' : 'border-dashed border-gray-300 bg-white'} rounded p-2 text-center min-h-[50px] flex items-center justify-center`}>
                      {seat && seat.studentId ? (
                        <div class="text-xs">
                          <div class="font-medium text-gray-900 truncate">{seat.label || 'Seat ' + (i + 1)}</div>
                        </div>
                      ) : (
                        <span class="text-[10px] text-gray-400">Empty</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <div id="planModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="modalTitle">New Seating Plan</h3>
      <form id="planForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Plan Name *</label><input name="name" required placeholder="e.g. Regular Layout" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Class *</label>
            <select name="classId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="loadClassStudents()">
              <option value="">Select class…</option>
              {allClasses.map(c => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Rows</label><input name="rows" type="number" value="5" min="1" max="10" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="regenerateGrid()" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Columns</label><input name="cols" type="number" value="6" min="1" max="10" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="regenerateGrid()" /></div>
          <div class="flex items-end"><label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="isDefault" class="rounded" /> Set as default</label></div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Click cells to assign students</label>
          <div id="gridContainer" class="overflow-x-auto bg-gray-50 p-4 rounded-lg"></div>
          <div class="mt-2 flex items-center gap-2">
            <label class="text-xs text-gray-600">Selected cell:</label>
            <select id="studentAssign" class="flex-1 px-2 py-1 border rounded text-xs" onchange="assignToSelected()">
              <option value="">— Empty seat —</option>
            </select>
            <button type="button" onclick="randomizeSeats()" class="text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded">🎲 Randomize</button>
            <button type="button" onclick="clearAllSeats()" class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Clear All</button>
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('planModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save Plan</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{
    plans,
    studentsByClass: Object.fromEntries(Array.from(studentsByClass.entries()).map(([k, v]) => [k, v.map(s => ({ id: s.id, name: `${s.name} ${s.lastName}` }))]))
  }} set:html={`(function(){
    var allPlans = plans;
    var classStudents = studentsByClass;
    var currentLayout = [];
    var selectedCell = null;

    window.openModal = function() {
      var form = document.getElementById('planForm');
      form.reset(); form.id.value = '';
      document.getElementById('modalTitle').textContent = 'New Seating Plan';
      document.getElementById('planModal').classList.remove('hidden');
      setTimeout(regenerateGrid, 100);
    };
    window.editPlan = function(id) {
      var p = allPlans.find(function(x){ return x.id === id; });
      if (!p) return;
      var form = document.getElementById('planForm');
      form.id.value = p.id; form.name.value = p.name;
      form.classId.value = p.classId;
      form.rows.value = p.rows; form.cols.value = p.cols;
      form.isDefault.checked = !!p.isDefault;
      try { currentLayout = JSON.parse(p.layout || '[]'); } catch { currentLayout = []; }
      loadClassStudents();
      renderGrid();
      document.getElementById('modalTitle').textContent = 'Edit Seating Plan';
      document.getElementById('planModal').classList.remove('hidden');
    };
    window.deletePlan = async function(id) {
      if (!confirm('Delete this seating plan?')) return;
      await fetch('/api/dashboard/seating', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.loadClassStudents = function() {
      var classId = parseInt(document.getElementById('planForm').classId.value);
      var students = classStudents[classId] || [];
      var sel = document.getElementById('studentAssign');
      sel.innerHTML = '<option value="">— Empty seat —</option>';
      students.forEach(function(s) { sel.innerHTML += '<option value="' + s.id + '">' + s.name + '</option>'; });
      regenerateGrid();
    };
    window.regenerateGrid = function() {
      var form = document.getElementById('planForm');
      var rows = parseInt(form.rows.value) || 5;
      var cols = parseInt(form.cols.value) || 6;
      // Preserve existing assignments where possible
      var newLayout = [];
      for (var r = 0; r < rows; r++) {
        var row = [];
        for (var c = 0; c < cols; c++) {
          if (currentLayout[r] && currentLayout[r][c]) row.push(currentLayout[r][c]);
          else row.push(null);
        }
        newLayout.push(row);
      }
      currentLayout = newLayout;
      renderGrid();
    };
    function renderGrid() {
      var form = document.getElementById('planForm');
      var rows = parseInt(form.rows.value) || 5;
      var cols = parseInt(form.cols.value) || 6;
      var container = document.getElementById('gridContainer');
      var html = '<div class="text-xs text-center text-gray-500 mb-2">📋 Front of Class</div>';
      html += '<div class="inline-grid gap-1" style="grid-template-columns: repeat(' + cols + ', minmax(60px, 1fr));">';
      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var seat = currentLayout[r] && currentLayout[r][c];
          var hasStudent = seat && seat.studentId;
          html += '<div data-row="' + r + '" data-col="' + c + '" onclick="selectCell(' + r + ',' + c + ')" class="border-2 cursor-pointer ' + (hasStudent ? 'border-blue-300 bg-blue-50' : 'border-dashed border-gray-300 bg-white') + ' rounded p-2 text-center min-h-[50px] flex items-center justify-center hover:border-primary-400">' + (hasStudent ? '<div class="text-xs font-medium truncate">' + (seat.label || 'Seat') + '</div>' : '<span class="text-[10px] text-gray-400">Empty</span>') + '</div>';
        }
      }
      html += '</div>';
      container.innerHTML = html;
    }
    window.selectCell = function(r, c) {
      selectedCell = { r: r, c: c };
      // Highlight selected
      document.querySelectorAll('#gridContainer > div > div').forEach(function(d) { d.classList.remove('ring-2', 'ring-primary-500'); });
      var cells = document.querySelectorAll('#gridContainer > div > div');
      var idx = r * (parseInt(document.getElementById('planForm').cols.value) || 6) + c;
      if (cells[idx]) cells[idx].classList.add('ring-2', 'ring-primary-500');
      // Show currently assigned student
      var seat = currentLayout[r] && currentLayout[r][c];
      document.getElementById('studentAssign').value = seat && seat.studentId ? seat.studentId : '';
    };
    window.assignToSelected = function() {
      if (!selectedCell) { alert('Click a cell first'); return; }
      var studentId = parseInt(document.getElementById('studentAssign').value) || null;
      var classId = parseInt(document.getElementById('planForm').classId.value);
      var students = classStudents[classId] || [];
      var student = students.find(function(s){ return s.id === studentId; });
      if (studentId && student) {
        currentLayout[selectedCell.r][selectedCell.c] = { studentId: studentId, label: student.name };
      } else {
        currentLayout[selectedCell.r][selectedCell.c] = null;
      }
      renderGrid();
    };
    window.randomizeSeats = function() {
      var classId = parseInt(document.getElementById('planForm').classId.value);
      var students = (classStudents[classId] || []).slice();
      // Shuffle
      for (var i = students.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = students[i]; students[i] = students[j]; students[j] = tmp;
      }
      var rows = parseInt(document.getElementById('planForm').rows.value) || 5;
      var cols = parseInt(document.getElementById('planForm').cols.value) || 6;
      currentLayout = [];
      var idx = 0;
      for (var r = 0; r < rows; r++) {
        var row = [];
        for (var c = 0; c < cols; c++) {
          if (idx < students.length) {
            row.push({ studentId: students[idx].id, label: students[idx].name });
            idx++;
          } else row.push(null);
        }
        currentLayout.push(row);
      }
      renderGrid();
    };
    window.clearAllSeats = function() {
      var rows = parseInt(document.getElementById('planForm').rows.value) || 5;
      var cols = parseInt(document.getElementById('planForm').cols.value) || 6;
      currentLayout = [];
      for (var r = 0; r < rows; r++) {
        var row = [];
        for (var c = 0; c < cols; c++) row.push(null);
        currentLayout.push(row);
      }
      renderGrid();
    };
    document.getElementById('planForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var id = fd.get('id');
      var payload = {
        classId: parseInt(fd.get('classId')),
        name: fd.get('name'),
        layout: currentLayout,
        rows: parseInt(fd.get('rows')) || 5,
        cols: parseInt(fd.get('cols')) || 6,
        isDefault: fd.get('isDefault') === 'on',
      };
      var method = id ? 'PUT' : 'POST';
      if (id) payload.id = parseInt(id);
      var res = await fetch('/api/dashboard/seating', { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
