---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { invoices, students, feeStructures, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allInvoices = db.select({
  id: invoices.id, invoiceNumber: invoices.invoiceNumber, studentId: invoices.studentId,
  feeStructureId: invoices.feeStructureId, amount: invoices.amount, discount: invoices.discount,
  fine: invoices.fine, paidAmount: invoices.paidAmount, balance: invoices.balance,
  status: invoices.status, dueDate: invoices.dueDate, issuedAt: invoices.issuedAt,
  studentName: students.firstName, studentLastName: students.lastName, studentCode: students.studentId,
}).from(invoices)
  .leftJoin(students, eq(invoices.studentId, students.id))
  .where(eq(invoices.schoolId, schoolId))
  .orderBy(desc(invoices.issuedAt)).all();

const allStudents = db.select({ id: students.id, name: students.firstName, lastName: students.lastName, code: students.studentId })
  .from(students).where(eq(students.schoolId, schoolId)).all();
const allFeeStructures = db.select().from(feeStructures).where(eq(feeStructures.schoolId, schoolId)).all();

const stats = {
  total: allInvoices.length,
  pending: allInvoices.filter(i => i.status === 'pending').length,
  paid: allInvoices.filter(i => i.status === 'paid').length,
  overdue: allInvoices.filter(i => i.status === 'overdue').length,
  totalCollected: allInvoices.reduce((s, i) => s + (i.paidAmount || 0), 0),
  totalOutstanding: allInvoices.reduce((s, i) => s + (i.balance || 0), 0),
};

const statusColors: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-700', partial: 'bg-blue-100 text-blue-700',
  paid: 'bg-green-100 text-green-700', overdue: 'bg-red-100 text-red-700',
  cancelled: 'bg-gray-100 text-gray-600',
};
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const formatMoney = (n: any) => '₦' + (n || 0).toLocaleString();
---

<DashboardLayout title="Invoices - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Invoices</h2>
        <p class="text-sm text-gray-500 mt-1">Create, track, and manage student invoices. Supports bulk generation from fee structures, partial payments, discounts, fines, and credit notes.</p>
      </div>
      <div class="flex gap-2">
        <button onclick="openBulkModal()" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">Bulk Generate</button>
        <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Create Invoice</button>
        <button onclick="exportCsv()" class="px-3 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700">Export CSV</button>
      </div>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Invoices</div><div class="text-2xl font-bold">{stats.total}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Collected</div><div class="text-2xl font-bold text-green-600">{formatMoney(stats.totalCollected)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Outstanding</div><div class="text-2xl font-bold text-red-600">{formatMoney(stats.totalOutstanding)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Overdue</div><div class="text-2xl font-bold text-amber-600">{stats.overdue}</div></div>
    </div>

    {/* Filter & Table */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b flex gap-3">
        <input id="searchInput" type="text" placeholder="Search by invoice # or student…" class="flex-1 px-3 py-2 border rounded-lg text-sm" oninput="filterTable()" />
        <select id="statusFilter" class="px-3 py-2 border rounded-lg text-sm" onchange="filterTable()">
          <option value="">All Status</option>
          <option value="pending">Pending</option><option value="partial">Partial</option>
          <option value="paid">Paid</option><option value="overdue">Overdue</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
            <th class="px-4 py-3">Invoice #</th><th class="px-4 py-3">Student</th>
            <th class="px-4 py-3">Amount</th><th class="px-4 py-3">Discount</th>
            <th class="px-4 py-3">Fine</th><th class="px-4 py-3">Paid</th>
            <th class="px-4 py-3">Balance</th><th class="px-4 py-3">Due Date</th>
            <th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
          </tr></thead>
          <tbody class="divide-y divide-gray-200">
            {allInvoices.length === 0 ? (
              <tr><td colspan="10" class="px-4 py-8 text-center text-gray-500">No invoices yet. Create one or bulk-generate from a fee structure.</td></tr>
            ) : allInvoices.map(inv => (
              <tr class="hover:bg-gray-50 inv-row" data-search={`${inv.invoiceNumber} ${inv.studentName} ${inv.studentLastName} ${inv.studentCode}`.toLowerCase()} data-status={inv.status}>
                <td class="px-4 py-3 font-medium text-gray-900">{inv.invoiceNumber}</td>
                <td class="px-4 py-3 text-gray-700">{inv.studentName} {inv.studentLastName}<div class="text-xs text-gray-500">{inv.studentCode}</div></td>
                <td class="px-4 py-3 text-gray-900">{formatMoney(inv.amount)}</td>
                <td class="px-4 py-3 text-gray-600">{inv.discount ? formatMoney(inv.discount) : '—'}</td>
                <td class="px-4 py-3 text-gray-600">{inv.fine ? formatMoney(inv.fine) : '—'}</td>
                <td class="px-4 py-3 text-green-700 font-medium">{inv.paidAmount ? formatMoney(inv.paidAmount) : '—'}</td>
                <td class="px-4 py-3 text-red-700 font-medium">{inv.balance ? formatMoney(inv.balance) : '—'}</td>
                <td class="px-4 py-3 text-gray-600">{formatDate(inv.dueDate)}</td>
                <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[inv.status]}`}>{inv.status}</span></td>
                <td class="px-4 py-3">
                  <button onclick={`viewInvoice(${JSON.stringify(inv).replace(/"/g, '&quot;')})`} class="text-xs text-primary-600 font-medium">View</button>
                  <button onclick={`editInvoice(${inv.id})`} class="text-xs text-amber-600 font-medium ml-2">Edit</button>
                  <button onclick={`deleteInvoice(${inv.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {/* Create Invoice Modal */}
  <div id="invModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="modalTitle">Create Invoice</h3>
      <form id="invForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Student *</label>
          <select name="studentId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select student…</option>
            {allStudents.map(s => <option value={s.id}>{s.name} {s.lastName} ({s.code})</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Amount (₦) *</label><input name="amount" type="number" required min="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Due Date</label><input name="dueDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Discount (₦)</label><input name="discount" type="number" min="0" value="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Fine (₦)</label><input name="fine" type="number" min="0" value="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Fee Structure (optional)</label>
          <select name="feeStructureId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">— None —</option>
            {allFeeStructures.map(f => <option value={f.id}>{f.name} ({formatMoney(f.totalAmount)})</option>)}
          </select>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('invModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save</button>
        </div>
      </form>
    </div>
  </div>

  {/* Bulk Generate Modal */}
  <div id="bulkModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Bulk Generate Invoices</h3>
      <form id="bulkForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Fee Structure *</label>
          <select name="feeStructureId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select fee structure…</option>
            {allFeeStructures.map(f => <option value={f.id}>{f.name} — {formatMoney(f.totalAmount)} ({f.frequency})</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Due Date</label><input name="dueDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <p class="text-xs text-gray-500">This will create one invoice for every active student with the selected fee structure's amount.</p>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('bulkModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg">Bulk Generate</button>
        </div>
      </form>
    </div>
  </div>

  {/* View Modal */}
  <div id="viewModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto" id="viewContent"></div>
  </div>

  <script is:inline define:vars={{ allInvoices, allStudents: allStudents.map(s => ({ id: s.id, name: `${s.name} ${s.lastName}` })) }} set:html={`(function(){
    var invs = allInvoices;
    var students = allStudents;
    function fmt(n) { return '₦' + (n || 0).toLocaleString(); }
    function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'; }

    window.openModal = function() {
      var form = document.getElementById('invForm');
      form.reset(); form.id.value = '';
      // Auto-generate invoice number
      form.querySelector('[name="amount"]').value = '';
      document.getElementById('modalTitle').textContent = 'Create Invoice';
      document.getElementById('invModal').classList.remove('hidden');
    };
    window.openBulkModal = function() { document.getElementById('bulkModal').classList.remove('hidden'); };
    window.editInvoice = function(id) {
      var inv = invs.find(function(x) { return x.id === id; });
      if (!inv) return;
      var form = document.getElementById('invForm');
      form.id.value = inv.id;
      form.studentId.value = inv.studentId;
      form.amount.value = inv.amount;
      form.discount.value = inv.discount || 0;
      form.fine.value = inv.fine || 0;
      form.dueDate.value = inv.dueDate || '';
      form.feeStructureId.value = inv.feeStructureId || '';
      document.getElementById('modalTitle').textContent = 'Edit Invoice #' + inv.invoiceNumber;
      document.getElementById('invModal').classList.remove('hidden');
    };
    window.deleteInvoice = async function(id) {
      if (!confirm('Delete this invoice? All linked payments will also be deleted.')) return;
      await fetch('/api/dashboard/invoices', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.viewInvoice = function(inv) {
      var total = inv.amount - (inv.discount || 0) + (inv.fine || 0);
      var html = '<div class="text-center mb-6">' +
        '<h1 style="font-size: 20px; font-weight: bold;">INVOICE</h1>' +
        '<div style="font-size: 12px; color: #666;">' + inv.invoiceNumber + '</div>' +
        '</div>' +
        '<div class="grid grid-cols-2 gap-4 mb-6">' +
        '<div><div style="font-size: 10px; color: #666; text-transform: uppercase;">Billed To</div><div style="font-weight: bold;">' + inv.studentName + ' ' + (inv.studentLastName || '') + '</div><div style="font-size: 12px; color: #666;">' + inv.studentCode + '</div></div>' +
        '<div><div style="font-size: 10px; color: #666; text-transform: uppercase;">Issued</div><div>' + fmtDate(inv.issuedAt) + '</div><div style="font-size: 10px; color: #666; text-transform: uppercase; margin-top: 8px;">Due</div><div>' + fmtDate(inv.dueDate) + '</div></div>' +
        '</div>' +
        '<table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">' +
        '<tr><td style="padding: 8px; border-bottom: 1px solid #eee;">Subtotal</td><td style="padding: 8px; border-bottom: 1px solid #eee; text-align: right;">' + fmt(inv.amount) + '</td></tr>' +
        (inv.discount ? '<tr><td style="padding: 8px; border-bottom: 1px solid #eee;">Discount</td><td style="padding: 8px; border-bottom: 1px solid #eee; text-align: right; color: green;">-' + fmt(inv.discount) + '</td></tr>' : '') +
        (inv.fine ? '<tr><td style="padding: 8px; border-bottom: 1px solid #eee;">Late Fine</td><td style="padding: 8px; border-bottom: 1px solid #eee; text-align: right; color: red;">+' + fmt(inv.fine) + '</td></tr>' : '') +
        '<tr><td style="padding: 8px; font-weight: bold;">Total Due</td><td style="padding: 8px; text-align: right; font-weight: bold;">' + fmt(total) + '</td></tr>' +
        '<tr><td style="padding: 8px; color: green;">Paid</td><td style="padding: 8px; text-align: right; color: green;">-' + fmt(inv.paidAmount) + '</td></tr>' +
        '<tr><td style="padding: 8px; font-weight: bold; font-size: 18px; color: ' + (inv.balance > 0 ? 'red' : 'green') + ';">Balance</td><td style="padding: 8px; text-align: right; font-weight: bold; font-size: 18px; color: ' + (inv.balance > 0 ? 'red' : 'green') + ';">' + fmt(inv.balance) + '</td></tr>' +
        '</table>' +
        '<div class="text-center mt-6"><button onclick="window.print()" class="px-4 py-2 bg-primary-600 text-white rounded text-sm">Print / Save as PDF</button>' +
        (inv.balance > 0 ? '<a href="/dashboard/payments?invoiceId=' + inv.id + '" class="ml-2 px-4 py-2 bg-green-600 text-white rounded text-sm">Record Payment</a>' : '') +
        '</div>';
      document.getElementById('viewContent').innerHTML = html;
      document.getElementById('viewModal').classList.remove('hidden');
    };
    window.filterTable = function() {
      var q = document.getElementById('searchInput').value.toLowerCase();
      var s = document.getElementById('statusFilter').value;
      document.querySelectorAll('.inv-row').forEach(function(row) {
        var matchQ = !q || row.dataset.search.indexOf(q) >= 0;
        var matchS = !s || row.dataset.status === s;
        row.style.display = (matchQ && matchS) ? '' : 'none';
      });
    };
    window.exportCsv = function() { window.location.href = '/api/dashboard/invoices?action=export'; };

    document.getElementById('invForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var id = fd.get('id');
      var payload = {
        studentId: parseInt(fd.get('studentId')),
        amount: parseInt(fd.get('amount')),
        discount: parseInt(fd.get('discount')) || 0,
        fine: parseInt(fd.get('fine')) || 0,
        dueDate: fd.get('dueDate') || null,
        feeStructureId: fd.get('feeStructureId') ? parseInt(fd.get('feeStructureId')) : null,
      };
      if (!id) {
        // Auto-generate invoice number
        payload.invoiceNumber = 'INV-' + new Date().getFullYear() + '-' + Date.now().toString().slice(-6);
      } else {
        payload.id = parseInt(id);
      }
      var method = id ? 'PUT' : 'POST';
      var res = await fetch('/api/dashboard/invoices', { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });

    document.getElementById('bulkForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var res = await fetch('/api/dashboard/invoices', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'bulk_generate', feeStructureId: parseInt(fd.get('feeStructureId')), dueDate: fd.get('dueDate') || null })
      });
      if (res.ok) { var data = await res.json(); alert('Created ' + data.created + ' invoices!'); window.location.reload(); }
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
