---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import RichTextEditor from '../../../components/RichTextEditor.astro';
const user = Astro.locals.user!;
const school = (user as any).school;
---
<DashboardLayout title="New Program - iSchool">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/programs" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div><h1 class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">New Program</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Create a new academic program</p></div>
    </div>
    <form method="POST" action="/api/dashboard/programs" class="mosaic-card p-6 lg:p-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Name *</label><input type="text" name="name" required placeholder="Program name" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
        <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Slug</label><input type="text" name="slug" placeholder="program-slug" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      </div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Description</label><textarea name="description" rows="3" placeholder="Program description..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);"></textarea></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Content</label><RichTextEditor name="content" id="prog-content-editor" placeholder="Write program details..." schoolSlug={school?.slug||''} /></div>
      <div><label class="block text-sm font-semibold mb-2" style="color:var(--mosaic-text);">Image URL</label><input type="text" name="imageUrl" placeholder="https://..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background:var(--mosaic-surface-2);border:1px solid var(--mosaic-border);color:var(--mosaic-text);" /></div>
      <div class="flex items-center gap-3 pt-4" style="border-top:1px solid var(--mosaic-border);"><button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Create Program</button><a href="/dashboard/programs" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color:var(--mosaic-text-muted);">Cancel</a></div>
    </form>
  </div>
</DashboardLayout>
