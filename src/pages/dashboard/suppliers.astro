---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { suppliers, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const suppliersList = await db.select().from(suppliers).where(eq(suppliers.schoolId, schoolId)).orderBy(desc(suppliers.createdAt)).all();
---

<DashboardLayout title="Suppliers - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Suppliers</h2>
        <p class="text-sm text-gray-500 mt-1">Manage vendor contacts for procurement. Link suppliers to purchase requests.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Add Supplier</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Suppliers</div><div class="text-2xl font-bold">{suppliersList.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">With Email</div><div class="text-2xl font-bold text-blue-600">{suppliersList.filter(s => s.email).length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">With Phone</div><div class="text-2xl font-bold text-green-600">{suppliersList.filter(s => s.phone).length}</div></div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b">
        <input id="searchInput" type="text" placeholder="Search suppliers…" class="w-full px-3 py-2 border rounded-lg text-sm" oninput="filterSuppliers()" />
      </div>
      {suppliersList.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">🏢</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No suppliers yet</h3>
          <p class="text-sm text-gray-500">Add your first supplier to start procurement.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Name</th><th class="px-4 py-3">Contact Person</th>
              <th class="px-4 py-3">Email</th><th class="px-4 py-3">Phone</th>
              <th class="px-4 py-3">Address</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {suppliersList.map(s => (
                <tr class="hover:bg-gray-50 supplier-row" data-search={`${s.name} ${s.contactPerson || ''} ${s.email || ''}`.toLowerCase()}>
                  <td class="px-4 py-3 font-medium text-gray-900">{s.name}</td>
                  <td class="px-4 py-3 text-gray-700">{s.contactPerson || '—'}</td>
                  <td class="px-4 py-3 text-gray-600">{s.email ? <a href={`mailto:${s.email}`} class="text-blue-600 underline">{s.email}</a> : '—'}</td>
                  <td class="px-4 py-3 text-gray-600">{s.phone || '—'}</td>
                  <td class="px-4 py-3 text-gray-600 text-xs">{s.address || '—'}</td>
                  <td class="px-4 py-3">
                    <button onclick={`editSupplier(${s.id})`} class="text-xs text-amber-600 font-medium">Edit</button>
                    <button onclick={`deleteSupplier(${s.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <div id="supplierModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="modalTitle">Add Supplier</h3>
      <form id="supplierForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Supplier Name *</label><input name="name" required placeholder="e.g. ABC Office Supplies Ltd" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Contact Person</label><input name="contactPerson" placeholder="e.g. John Doe" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Email</label><input name="email" type="email" placeholder="sales@abc.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Phone</label><input name="phone" placeholder="+234…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Address</label><textarea name="address" rows="2" placeholder="Street, City, State" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('supplierModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ suppliersList }} set:html={`(function(){
    var allSuppliers = suppliersList;
    window.openModal = function() {
      var form = document.getElementById('supplierForm');
      form.reset(); form.id.value = '';
      document.getElementById('modalTitle').textContent = 'Add Supplier';
      document.getElementById('supplierModal').classList.remove('hidden');
    };
    window.editSupplier = function(id) {
      var s = allSuppliers.find(function(x){ return x.id === id; });
      if (!s) return;
      var form = document.getElementById('supplierForm');
      form.id.value = s.id; form.name.value = s.name;
      form.contactPerson.value = s.contactPerson || '';
      form.email.value = s.email || '';
      form.phone.value = s.phone || '';
      form.address.value = s.address || '';
      document.getElementById('modalTitle').textContent = 'Edit Supplier';
      document.getElementById('supplierModal').classList.remove('hidden');
    };
    window.deleteSupplier = async function(id) {
      if (!confirm('Delete this supplier?')) return;
      await fetch('/api/dashboard/suppliers', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.filterSuppliers = function() {
      var q = document.getElementById('searchInput').value.toLowerCase();
      document.querySelectorAll('.supplier-row').forEach(function(row) {
        row.style.display = !q || row.dataset.search.indexOf(q) >= 0 ? '' : 'none';
      });
    };
    document.getElementById('supplierForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var id = fd.get('id');
      var payload = {
        name: fd.get('name'),
        contactPerson: fd.get('contactPerson') || null,
        email: fd.get('email') || null,
        phone: fd.get('phone') || null,
        address: fd.get('address') || null,
      };
      var method = id ? 'PUT' : 'POST';
      if (id) payload.id = parseInt(id);
      var res = await fetch('/api/dashboard/suppliers', { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
