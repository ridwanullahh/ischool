---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import RichTextEditor from '../../../components/RichTextEditor.astro';
import { getUserSchoolId } from '../../../lib/school.js';
const user = Astro.locals.user!;
const school = (user as any).school;
---

<DashboardLayout title="New Announcement - iSchool">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <a href="/dashboard/announcements" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color: var(--mosaic-text-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">New Announcement</h1>
        <p class="text-sm" style="color: var(--mosaic-text-muted);">Create a new announcement for your school</p>
      </div>
    </div>
    <form method="POST" action="/api/dashboard/announcements" class="mosaic-card p-6 lg:p-8 space-y-6">
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Title</label>
        <input type="text" name="title" required placeholder="Announcement title..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Slug</label>
          <input type="text" name="slug" placeholder="announcement-slug" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Banner Image URL</label>
          <input type="text" name="bannerImageUrl" placeholder="https://..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Excerpt</label>
        <textarea name="excerpt" rows="2" placeholder="Brief summary..." class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);"></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">Content</label>
        <RichTextEditor name="content" id="ann-content-editor" placeholder="Write announcement..." schoolSlug={school?.slug || ''} />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">CTA Text</label>
          <input type="text" name="ctaText" placeholder="Read More" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2" style="color: var(--mosaic-text);">CTA URL</label>
          <input type="text" name="ctaUrl" placeholder="/link" class="w-full px-4 py-3 rounded-xl text-sm focus:outline-none transition-all" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text);" />
        </div>
      </div>
      <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid var(--mosaic-border);">
        <button type="submit" class="mosaic-btn-primary px-6 py-2.5 text-sm">Publish</button>
        <a href="/dashboard/announcements" class="px-4 py-2.5 rounded-xl text-sm font-medium transition-colors hover:bg-gray-100 dark:hover:bg-slate-800" style="color: var(--mosaic-text-muted);">Cancel</a>
      </div>
    </form>
  </div>
</DashboardLayout>
