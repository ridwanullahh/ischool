---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { invoices, payments, students, attendance, assignments, submissions, examResults, exams, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allStudents = await db.select().from(students).where(eq(students.schoolId, schoolId)).all();
const allInvoices = await db.select().from(invoices).where(eq(invoices.schoolId, schoolId)).all();
const allPayments = await db.select().from(payments).where(eq(payments.schoolId, schoolId)).all();
const allAttendance = await db.select().from(attendance).where(eq(attendance.schoolId, schoolId)).all();

// Per-student summary
const studentSummaries = allStudents.map(s => {
  const studentInvoices = allInvoices.filter(i => i.studentId === s.id);
  const studentPayments = allPayments.filter(p => studentInvoices.some(i => i.id === p.invoiceId));
  const totalBilled = studentInvoices.reduce((sum, i) => sum + (i.amount - (i.discount || 0) + (i.fine || 0)), 0);
  const totalPaid = studentPayments.filter(p => p.status === 'completed').reduce((sum, p) => sum + (p.amount || 0), 0);
  const balance = studentInvoices.reduce((sum, i) => sum + (i.balance || 0), 0);
  // Recent attendance
  const studentAttendance = allAttendance.filter(a => a.studentId === s.id).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 5);
  const presentCount = studentAttendance.filter(a => a.status === 'present').length;
  const attendanceRate = studentAttendance.length > 0 ? Math.round((presentCount / studentAttendance.length) * 100) : null;
  return {
    student: s,
    totalBilled, totalPaid, balance,
    invoiceCount: studentInvoices.length,
    attendanceRate,
    recentAttendance: studentAttendance,
  };
});

const fmtMoney = (n: any) => '₦' + (n || 0).toLocaleString();
const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—';
const statusColors: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-700', partial: 'bg-blue-100 text-blue-700',
  paid: 'bg-green-100 text-green-700', overdue: 'bg-red-100 text-red-700',
};
---

<DashboardLayout title="Parent Payment Portal - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Parent Payment Portal</h2>
      <p class="text-sm text-gray-500 mt-1">Per-student fee statements, payment history, outstanding balances, and attendance summary for parent communication.</p>
    </div>

    {/* Student selector */}
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <label class="block text-xs font-medium text-gray-700 mb-2">Select Student</label>
      <select id="studentSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="loadStatement()">
        <option value="">Choose a student…</option>
        {allStudents.map(s => <option value={s.id}>{s.firstName} {s.lastName} ({s.studentId})</option>)}
      </select>
    </div>

    {/* Empty state */}
    <div id="emptyState" class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <div class="text-4xl mb-3">👨‍👩‍👧</div>
      <h3 class="text-lg font-semibold text-gray-900 mb-1">Select a student to view parent statement</h3>
      <p class="text-sm text-gray-500">Parents can view their child's fee statement, payment history, and download receipts.</p>
    </div>

    {/* Statement */}
    <div id="statementContainer" class="hidden space-y-4">
      {/* KPI cards */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Billed</div><div class="text-2xl font-bold" id="kpiBilled">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Paid</div><div class="text-2xl font-bold text-green-600" id="kpiPaid">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Balance Due</div><div class="text-2xl font-bold text-red-600" id="kpiBalance">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Attendance</div><div class="text-2xl font-bold text-blue-600" id="kpiAttendance">—</div></div>
      </div>

      {/* Invoices */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Invoices</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Invoice #</th><th class="px-4 py-3">Issued</th>
              <th class="px-4 py-3">Due Date</th><th class="px-4 py-3">Amount</th>
              <th class="px-4 py-3">Paid</th><th class="px-4 py-3">Balance</th>
              <th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody id="invoicesBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>

      {/* Payment history */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Payment History</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Date</th><th class="px-4 py-3">Invoice</th>
              <th class="px-4 py-3">Method</th><th class="px-4 py-3">Reference</th>
              <th class="px-4 py-3">Amount</th><th class="px-4 py-3">Receipt</th>
            </tr></thead>
            <tbody id="paymentsBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ studentSummaries: studentSummaries.map(s => ({ id: s.student.id, name: `${s.student.firstName} ${s.student.lastName}`, code: s.student.studentId, totalBilled: s.totalBilled, totalPaid: s.totalPaid, balance: s.balance, invoiceCount: s.invoiceCount, attendanceRate: s.attendanceRate })), allInvoices: allInvoices.map(i => ({ id: i.id, invoiceNumber: i.invoiceNumber, studentId: i.studentId, amount: i.amount, discount: i.discount, fine: i.fine, paidAmount: i.paidAmount, balance: i.balance, status: i.status, dueDate: i.dueDate, issuedAt: i.issuedAt })), allPayments: allPayments.map(p => ({ id: p.id, invoiceId: p.invoiceId, amount: p.amount, method: p.method, reference: p.reference, status: p.status, paidAt: p.paidAt })) }} set:html={`(function(){
    var summaries = studentSummaries;
    var invoices = allInvoices;
    var payments = allPayments;
    function fmt(n) { return '₦' + (n || 0).toLocaleString(); }
    function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'; }
    var statusColors = { pending: 'bg-amber-100 text-amber-700', partial: 'bg-blue-100 text-blue-700', paid: 'bg-green-100 text-green-700', overdue: 'bg-red-100 text-red-700', cancelled: 'bg-gray-100 text-gray-600' };

    window.loadStatement = function() {
      var sid = parseInt(document.getElementById('studentSelect').value);
      if (!sid) { document.getElementById('statementContainer').classList.add('hidden'); document.getElementById('emptyState').classList.remove('hidden'); return; }
      var summary = summaries.find(function(s) { return s.id === sid; });
      if (!summary) return;

      document.getElementById('kpiBilled').textContent = fmt(summary.totalBilled);
      document.getElementById('kpiPaid').textContent = fmt(summary.totalPaid);
      document.getElementById('kpiBalance').textContent = fmt(summary.balance);
      document.getElementById('kpiAttendance').textContent = summary.attendanceRate !== null ? summary.attendanceRate + '%' : '—';

      var studentInvoices = invoices.filter(function(i) { return i.studentId === sid; });
      var invBody = document.getElementById('invoicesBody');
      invBody.innerHTML = '';
      if (studentInvoices.length === 0) {
        invBody.innerHTML = '<tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">No invoices for this student.</td></tr>';
      } else {
        studentInvoices.forEach(function(inv) {
          var total = inv.amount - (inv.discount || 0) + (inv.fine || 0);
          var row = document.createElement('tr');
          row.className = 'hover:bg-gray-50';
          row.innerHTML = '<td class="px-4 py-3 font-medium">' + inv.invoiceNumber + '</td>' +
            '<td class="px-4 py-3 text-gray-600">' + fmtDate(inv.issuedAt) + '</td>' +
            '<td class="px-4 py-3 text-gray-600">' + fmtDate(inv.dueDate) + '</td>' +
            '<td class="px-4 py-3 text-gray-900">' + fmt(total) + '</td>' +
            '<td class="px-4 py-3 text-green-700">' + fmt(inv.paidAmount) + '</td>' +
            '<td class="px-4 py-3 text-red-700 font-medium">' + fmt(inv.balance) + '</td>' +
            '<td class="px-4 py-3"><span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (statusColors[inv.status] || '') + '">' + inv.status + '</span></td>' +
            '<td class="px-4 py-3"><button onclick="printInvoice(' + inv.id + ')" class="text-xs text-primary-600 font-medium">Print</button>' + (inv.balance > 0 ? ' <button onclick="recordPayment(' + inv.id + ')" class="text-xs text-green-600 font-medium ml-2">Pay</button>' : '') + '</td>';
          invBody.appendChild(row);
        });
      }

      var studentInvoiceIds = studentInvoices.map(function(i) { return i.id; });
      var studentPayments = payments.filter(function(p) { return studentInvoiceIds.indexOf(p.invoiceId) >= 0 && p.status === 'completed'; });
      var payBody = document.getElementById('paymentsBody');
      payBody.innerHTML = '';
      if (studentPayments.length === 0) {
        payBody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No payments yet.</td></tr>';
      } else {
        studentPayments.forEach(function(p) {
          var inv = studentInvoices.find(function(i) { return i.id === p.invoiceId; });
          var row = document.createElement('tr');
          row.className = 'hover:bg-gray-50';
          row.innerHTML = '<td class="px-4 py-3 text-gray-600">' + fmtDate(p.paidAt) + '</td>' +
            '<td class="px-4 py-3 font-medium">' + (inv ? inv.invoiceNumber : '—') + '</td>' +
            '<td class="px-4 py-3 capitalize">' + (p.method || '—').replace('_', ' ') + '</td>' +
            '<td class="px-4 py-3 text-gray-600 text-xs">' + (p.reference || '—') + '</td>' +
            '<td class="px-4 py-3 font-bold text-green-700">' + fmt(p.amount) + '</td>' +
            '<td class="px-4 py-3"><button onclick="printReceipt(' + p.id + ')" class="text-xs text-primary-600 font-medium">Receipt</button></td>';
          payBody.appendChild(row);
        });
      }

      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('statementContainer').classList.remove('hidden');
    };

    window.printInvoice = function(invId) {
      var inv = invoices.find(function(i) { return i.id === invId; });
      if (!inv) return;
      var total = inv.amount - (inv.discount || 0) + (inv.fine || 0);
      var w = window.open('', '_blank');
      w.document.write('<html><head><title>Invoice ' + inv.invoiceNumber + '</title><style>body{font-family:Arial;padding:40px;}table{width:100%;border-collapse:collapse;}td,th{padding:8px;border-bottom:1px solid #eee;text-align:left;}</style></head><body>' +
        '<h1>Invoice ' + inv.invoiceNumber + '</h1>' +
        '<p>Issued: ' + fmtDate(inv.issuedAt) + '<br>Due: ' + fmtDate(inv.dueDate) + '</p>' +
        '<table><tr><th>Subtotal</th><td>' + fmt(inv.amount) + '</td></tr>' +
        (inv.discount ? '<tr><th>Discount</th><td>-' + fmt(inv.discount) + '</td></tr>' : '') +
        (inv.fine ? '<tr><th>Fine</th><td>+' + fmt(inv.fine) + '</td></tr>' : '') +
        '<tr><th>Total</th><td>' + fmt(total) + '</td></tr>' +
        '<tr><th>Paid</th><td>' + fmt(inv.paidAmount) + '</td></tr>' +
        '<tr><th>Balance</th><td>' + fmt(inv.balance) + '</td></tr></table>' +
        '<script>window.print();</scr' + 'ipt></body></html>');
      w.document.close();
    };
    window.printReceipt = function(payId) {
      var p = payments.find(function(x) { return x.id === payId; });
      if (!p) return;
      var inv = invoices.find(function(i) { return i.id === p.invoiceId; });
      var w = window.open('', '_blank');
      w.document.write('<html><head><title>Receipt ' + (p.reference || p.id) + '</title><style>body{font-family:Arial;padding:40px;}table{width:100%;border-collapse:collapse;}td,th{padding:8px;border-bottom:1px solid #eee;text-align:left;}</style></head><body>' +
        '<h1>Payment Receipt</h1>' +
        '<p>Reference: ' + (p.reference || '—') + '<br>Date: ' + fmtDate(p.paidAt) + '<br>Method: ' + (p.method || '—').replace('_', ' ') + '</p>' +
        '<table><tr><th>Invoice</th><td>' + (inv ? inv.invoiceNumber : '—') + '</td></tr>' +
        '<tr><th>Amount Paid</th><td>' + fmt(p.amount) + '</td></tr></table>' +
        '<p>Thank you for your payment.</p>' +
        '<script>window.print();</scr' + 'ipt></body></html>');
      w.document.close();
    };
    window.recordPayment = function(invId) {
      window.location.href = '/dashboard/payments?invoiceId=' + invId;
    };
  })();`} />
</DashboardLayout>
