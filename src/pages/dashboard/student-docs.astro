---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { studentDocuments, students } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();
let docs: any[] = [];
let allStudents: any[] = [];
if (schoolId) {
  try {
    allStudents = await db.select().from(students).where(eq(students.schoolId, schoolId)).all() || [];
    const studentMap = new Map((allStudents||[]).map((s:any) => [s.id, s]));
    const raw = await db.select().from(studentDocuments).where(eq(studentDocuments.schoolId, schoolId)).orderBy(desc(studentDocuments.createdAt)).all() || [];
    docs = raw.map((d:any) => { const s = studentMap.get(d.studentId ?? d.student_id); return { ...d, studentName: s ? `${s.firstName||s.first_name||''} ${s.lastName||s.last_name||''}`.trim() : 'Unknown', studentIdCode: s?.studentId || s?.student_id || '' }; });
  } catch {}
}
const categoryLabels: Record<string,string> = { birth_certificate:'Birth Certificate', passport:'Passport', health_record:'Health Record', transfer_certificate:'Transfer Certificate', report_card:'Report Card', id_card:'ID Card', other:'Other' };
const categoryColors: Record<string,string> = { birth_certificate:'rgba(59,130,246,0.1)', passport:'rgba(168,85,247,0.1)', health_record:'rgba(5,179,77,0.1)', transfer_certificate:'rgba(242,185,28,0.1)', report_card:'rgba(99,102,241,0.1)', id_card:'rgba(107,114,128,0.1)', other:'rgba(107,114,128,0.1)' };
const categoryTextColors: Record<string,string> = { birth_certificate:'#3B82F6', passport:'#A855F7', health_record:'#05B34D', transfer_certificate:'#F2B91C', report_card:'#6366F1', id_card:'#6B7280', other:'#6B7280' };
---

<DashboardLayout title="Documents - iSchool">
  <div class="mb-6"><h1 class="text-2xl font-bold mb-1" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Student Documents</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Manage student documents and certificates.</p></div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Total</p><p class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">{docs.length}</p></div>
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Birth Certs</p><p class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#3B82F6;">{docs.filter(d => d.category==='birth_certificate').length}</p></div>
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Health Records</p><p class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#05B34D;">{docs.filter(d => d.category==='health_record').length}</p></div>
    <div class="mosaic-card p-4"><p class="text-[10px] font-medium uppercase tracking-wider mb-1" style="color:var(--mosaic-text-subtle);">Passports</p><p class="text-2xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#A855F7;">{docs.filter(d => d.category==='passport').length}</p></div>
  </div>

  <ListToolbar searchPlaceholder="Search documents..." filterOptions={Object.entries(categoryLabels).map(([v,l]) => ({value:v,label:l}))} filterField="category" newItemHref="/dashboard/student-docs/new" newItemLabel="+ Upload Document" />

  <div id="list-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {docs.length === 0 ? (
      <div class="col-span-full mosaic-card p-12 text-center"><h3 class="text-base font-semibold mb-1" style="color:var(--mosaic-text);">No documents yet</h3><a href="/dashboard/student-docs/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm mt-2">+ Upload Document</a></div>
    ) : docs.map(d => (
      <div data-list-item data-title={d.title||d.studentName||''} data-status={d.category||'other'} data-date={d.createdAt||d.created_at||''} class="mosaic-card p-5 group">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background:${categoryColors[d.category]||'rgba(107,114,128,0.1)'};`}><svg class="w-5 h-5" style={`color:${categoryTextColors[d.category]||'#6B7280'};`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg></div>
          <div class="flex-1 min-w-0"><h3 class="text-sm font-bold truncate" style="color:var(--mosaic-text);">{d.title || d.fileName || d.file_name || 'Untitled'}</h3><p class="text-xs" style="color:var(--mosaic-text-muted);">{d.studentName}</p></div>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full" style={`background:${categoryColors[d.category]||'rgba(107,114,128,0.1)'};color:${categoryTextColors[d.category]||'#6B7280'};`}>{categoryLabels[d.category]||d.category||'Other'}</span>
          <span class="text-[11px]" style="color:var(--mosaic-text-subtle);">{d.createdAt||d.created_at?new Date(d.createdAt||d.created_at).toLocaleDateString():''}</span>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
