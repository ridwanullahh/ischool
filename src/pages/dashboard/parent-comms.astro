---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { students, announcements, attendance, invoices, examResults, exams, schoolMembers, classes, enrollments, events } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allStudents = db.select().from(students).where(eq(students.schoolId, schoolId)).all();
const recentAnnouncements = db.select().from(announcements).where(and(eq(announcements.schoolId, schoolId), eq(announcements.published, 1))).orderBy(desc(announcements.createdAt)).limit(5).all();
const upcomingEvents = db.select().from(events).where(eq(events.schoolId, schoolId)).orderBy(desc(events.startDate)).limit(5).all();
const allClasses = db.select().from(classes).where(eq(classes.schoolId, schoolId)).all();

const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
const fmtMoney = (n: any) => '₦' + (n || 0).toLocaleString();
---

<DashboardLayout title="Parent Communication - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Parent Communication Hub</h2>
      <p class="text-sm text-gray-500 mt-1">Per-student view for parent communication: announcements, attendance, fees, exam results, and upcoming events.</p>
    </div>

    {/* Student selector */}
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <label class="block text-xs font-medium text-gray-700 mb-2">Select Student</label>
      <select id="studentSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="loadParentView()">
        <option value="">Choose a student…</option>
        {allStudents.map(s => <option value={s.id}>{s.firstName} {s.lastName} ({s.studentId})</option>)}
      </select>
    </div>

    <div id="emptyState" class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <div class="text-4xl mb-3">👨‍👩‍👧</div>
      <h3 class="text-lg font-semibold text-gray-900 mb-1">Select a student</h3>
      <p class="text-sm text-gray-500">View their attendance, fees, exam results, and recent announcements.</p>
    </div>

    <div id="parentView" class="hidden space-y-4">
      {/* KPI cards */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Attendance Rate</div><div class="text-2xl font-bold text-blue-600" id="kpiAttendance">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Outstanding Fees</div><div class="text-2xl font-bold text-red-600" id="kpiFees">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Exams Taken</div><div class="text-2xl font-bold" id="kpiExams">—</div></div>
        <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Average Score</div><div class="text-2xl font-bold text-green-600" id="kpiAvg">—</div></div>
      </div>

      {/* Recent announcements */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Recent Announcements</div>
        <div class="divide-y divide-gray-100">
          {recentAnnouncements.length === 0 ? (
            <p class="p-6 text-center text-sm text-gray-500">No announcements.</p>
          ) : recentAnnouncements.map(a => (
            <div class="p-4">
              <div class="flex items-center gap-2">
                {a.isPinned && <span class="text-amber-500">📌</span>}
                <h4 class="font-medium text-sm text-gray-900">{a.title}</h4>
              </div>
              <p class="text-xs text-gray-500 mt-1">{a.excerpt || a.content.substring(0, 150)}</p>
              <p class="text-xs text-gray-400 mt-1">{fmtDate(a.createdAt)}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Recent attendance */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Recent Attendance</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Date</th><th class="px-4 py-3">Period</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Notes</th>
            </tr></thead>
            <tbody id="attendanceBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>

      {/* Recent exam results */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Recent Exam Results</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Exam</th><th class="px-4 py-3">Subject</th>
              <th class="px-4 py-3">Marks</th><th class="px-4 py-3">Grade</th><th class="px-4 py-3">Status</th>
            </tr></thead>
            <tbody id="resultsBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>

      {/* Outstanding invoices */}
      <div class="bg-white rounded-xl border border-gray-200">
        <div class="p-4 border-b font-semibold text-gray-900">Outstanding Invoices</div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Invoice #</th><th class="px-4 py-3">Due Date</th>
              <th class="px-4 py-3">Amount</th><th class="px-4 py-3">Balance</th><th class="px-4 py-3">Status</th>
            </tr></thead>
            <tbody id="invoicesBody" class="divide-y divide-gray-200"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{
    allStudents: allStudents.map(s => ({ id: s.id, name: `${s.firstName} ${s.lastName}`, code: s.studentId }))
  }} set:html={`(function(){
    var students = allStudents;
    function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'; }
    function fmtMoney(n) { return '₦' + (n || 0).toLocaleString(); }

    window.loadParentView = async function() {
      var sid = parseInt(document.getElementById('studentSelect').value);
      if (!sid) { document.getElementById('parentView').classList.add('hidden'); document.getElementById('emptyState').classList.remove('hidden'); return; }
      // Fetch attendance
      var attRes = await fetch('/api/dashboard/attendance?studentId=' + sid);
      var att = await attRes.json();
      var attBody = document.getElementById('attendanceBody');
      attBody.innerHTML = '';
      var present = att.filter(function(a){ return a.status === 'present'; }).length;
      var attRate = att.length > 0 ? Math.round((present / att.length) * 100) : null;
      document.getElementById('kpiAttendance').textContent = attRate !== null ? attRate + '%' : '—';
      if (att.length === 0) {
        attBody.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-gray-500">No attendance records.</td></tr>';
      } else {
        att.slice(0, 10).forEach(function(a) {
          var colors = { present: 'bg-green-100 text-green-700', absent: 'bg-red-100 text-red-700', late: 'bg-amber-100 text-amber-700', excused: 'bg-blue-100 text-blue-700', early_departure: 'bg-purple-100 text-purple-700' };
          attBody.innerHTML += '<tr><td class="px-4 py-3">' + a.date + '</td><td class="px-4 py-3">' + (a.period || 'Full Day') + '</td><td class="px-4 py-3"><span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (colors[a.status] || '') + '">' + a.status + '</span></td><td class="px-4 py-3 text-gray-600 text-xs">' + (a.notes || '—') + '</td></tr>';
        });
      }
      // Fetch invoices
      var invRes = await fetch('/api/dashboard/invoices');
      var allInv = await invRes.json();
      var studentInv = allInv.filter(function(i){ return i.studentId === sid; });
      var outstanding = studentInv.filter(function(i){ return i.balance > 0; });
      document.getElementById('kpiFees').textContent = fmtMoney(outstanding.reduce(function(s, i){ return s + i.balance; }, 0));
      var invBody = document.getElementById('invoicesBody');
      invBody.innerHTML = '';
      if (outstanding.length === 0) {
        invBody.innerHTML = '<tr><td colspan="5" class="px-4 py-6 text-center text-green-600">No outstanding fees. 🎉</td></tr>';
      } else {
        outstanding.forEach(function(inv) {
          var colors = { pending: 'bg-amber-100 text-amber-700', partial: 'bg-blue-100 text-blue-700', overdue: 'bg-red-100 text-red-700' };
          invBody.innerHTML += '<tr><td class="px-4 py-3 font-medium">' + inv.invoiceNumber + '</td><td class="px-4 py-3">' + fmtDate(inv.dueDate) + '</td><td class="px-4 py-3">' + fmtMoney(inv.amount) + '</td><td class="px-4 py-3 font-bold text-red-700">' + fmtMoney(inv.balance) + '</td><td class="px-4 py-3"><span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (colors[inv.status] || '') + '">' + inv.status + '</span></td></tr>';
        });
      }
      // Fetch exam results — we'll just compute counts via API call to exams
      var exRes = await fetch('/api/dashboard/exams');
      var exData = await exRes.json();
      var allExams = exData.exams || [];
      var studentResults = [];
      // For each exam, fetch results
      for (var i = 0; i < Math.min(allExams.length, 20); i++) {
        var rRes = await fetch('/api/dashboard/exams?action=results&examId=' + allExams[i].id);
        var results = await rRes.json();
        var studentResult = results.find(function(r){ return r.studentId === sid; });
        if (studentResult) studentResults.push({ exam: allExams[i], result: studentResult });
      }
      document.getElementById('kpiExams').textContent = studentResults.length;
      var avgScore = studentResults.length > 0 ? Math.round(studentResults.reduce(function(s, r){ return s + (r.result.marksObtained || 0); }, 0) / studentResults.length) : null;
      document.getElementById('kpiAvg').textContent = avgScore !== null ? avgScore + '/100' : '—';
      var resBody = document.getElementById('resultsBody');
      resBody.innerHTML = '';
      if (studentResults.length === 0) {
        resBody.innerHTML = '<tr><td colspan="5" class="px-4 py-6 text-center text-gray-500">No exam results yet.</td></tr>';
      } else {
        studentResults.forEach(function(r) {
          var colors = { present: 'bg-green-100 text-green-700', absent: 'bg-red-100 text-red-700', withheld: 'bg-amber-100 text-amber-700' };
          resBody.innerHTML += '<tr><td class="px-4 py-3">' + r.exam.title + '</td><td class="px-4 py-3">' + r.exam.subject + '</td><td class="px-4 py-3 font-medium">' + (r.result.marksObtained != null ? r.result.marksObtained + '/' + r.exam.totalMarks : '—') + '</td><td class="px-4 py-3 font-bold">' + (r.result.grade || '—') + '</td><td class="px-4 py-3"><span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ' + (colors[r.result.status] || '') + '">' + r.result.status + '</span></td></tr>';
        });
      }
      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('parentView').classList.remove('hidden');
    };
  })();`} />
</DashboardLayout>
