---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { classes, staff, enrollments, classSubjects, courses } from '../../lib/db/schema.js';
import { eq, asc, and, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allClasses = await db.select().from(classes).where(eq(classes.schoolId, schoolId)).orderBy(asc(classes.sortOrder)).all();
const allStaff = await db.select({ id: staff.id, firstName: staff.firstName, lastName: staff.lastName, designation: staff.designation }).from(staff).where(eq(staff.schoolId, schoolId)).all();
const allCourses = await db.select({ id: courses.id, title: courses.title }).from(courses).where(eq(courses.schoolId, schoolId)).all();
const allSubjects = await db.select().from(classSubjects).where(eq(classSubjects.schoolId, schoolId)).all();

// Enrollment counts per class
const enrollmentCounts = await db.select({
  classId: enrollments.classId,
  count: sql<number>`count(*)`,
}).from(enrollments)
  .where(and(eq(enrollments.schoolId, schoolId), eq(enrollments.status, 'accepted')))
  .groupBy(enrollments.classId).all();
const countMap = new Map(enrollmentCounts.map(e => [e.classId, e.count]));

// Waitlist counts per class
const waitlistCounts = await db.select({
  classId: enrollments.classId,
  count: sql<number>`count(*)`,
}).from(enrollments)
  .where(and(eq(enrollments.schoolId, schoolId), eq(enrollments.status, 'waitlisted')))
  .groupBy(enrollments.classId).all();
const waitlistMap = new Map(waitlistCounts.map(e => [e.classId, e.count]));

const success = Astro.url.searchParams.get('success');
const editId = Astro.url.searchParams.get('edit');
const editing = editId ? allClasses.find(c => c.id === Number(editId)) : null;

const staffMap = new Map(allStaff.map(s => [s.id, `${s.firstName} ${s.lastName}`]));
const courseMap = new Map(allCourses.map(c => [c.id, c.title]));
const subjectsByClass = new Map<number, typeof allSubjects>();
for (const s of allSubjects) {
  if (!subjectsByClass.has(s.classId)) subjectsByClass.set(s.classId, []);
  subjectsByClass.get(s.classId)!.push(s);
}
---

<DashboardLayout title="Classes & Sections - iSchool">
  {success && (
    <div class="mb-6 p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-700">Class saved successfully.</div>
  )}

  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Classes & Sections</h2>
      <p class="text-sm text-gray-500 mt-1">Academic class sections with capacity limits, homeroom teacher assignment, subject-to-class mapping, and waitlist management.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Form column -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-xl border border-gray-200 p-6 sticky top-4">
          <h3 class="text-base font-semibold text-gray-900 mb-4">{editing ? 'Edit' : 'New'} Class / Section</h3>
          <form method="POST" action="/api/dashboard/classes" class="space-y-3">
            {editing && <input type="hidden" name="id" value={editing.id} />}
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Class Name *</label><input name="name" value={editing?.name || ''} placeholder="e.g. Grade 5 - Section A" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Slug *</label><input name="slug" value={editing?.slug || ''} placeholder="grade-5-section-a" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            <div class="grid grid-cols-2 gap-3">
              <div><label class="block text-xs font-medium text-gray-700 mb-1">Grade Level</label><input name="gradeLevel" value={editing?.gradeLevel || ''} placeholder="Grade 5" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
              <div><label class="block text-xs font-medium text-gray-700 mb-1">Section</label><input name="section" value={editing?.section || ''} placeholder="A" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            </div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Capacity</label><input name="capacity" type="number" value={editing?.capacity?.toString() || ''} placeholder="25" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Homeroom Teacher</label>
              <select name="homeroomTeacherId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <option value="">— None —</option>
                {allStaff.map(s => <option value={s.id} selected={editing?.homeroomTeacherId === s.id}>{s.firstName} {s.lastName}{s.designation ? ` (${s.designation})` : ''}</option>)}
              </select>
            </div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="2" placeholder="Short description…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{editing?.description || ''}</textarea></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Image URL</label><input name="imageUrl" value={editing?.imageUrl || ''} placeholder="https://..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Sort Order</label><input name="sortOrder" type="number" value={editing?.sortOrder?.toString() || '0'} class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
            <div class="flex items-center gap-2">
              <input type="checkbox" id="hasDetailPage" name="hasDetailPage" checked={editing ? editing.hasDetailPage : true} class="rounded border-gray-300" />
              <label for="hasDetailPage" class="text-sm text-gray-700">Show on public website</label>
            </div>
            <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">{editing ? 'Update' : 'Add'} Class</button>
            {editing && <a href="/dashboard/classes" class="block text-center text-sm text-gray-500 hover:text-gray-700">Cancel Edit</a>}
          </form>
        </div>
      </div>

      <!-- List column -->
      <div class="lg:col-span-2 space-y-4">
        {allClasses.length === 0 ? (
          <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
            <div class="text-4xl mb-3">🏫</div>
            <h3 class="text-lg font-semibold text-gray-900 mb-1">No classes yet</h3>
            <p class="text-sm text-gray-500">Create your first class or section to get started.</p>
          </div>
        ) : allClasses.map(c => {
          const enrolled = countMap.get(c.id) || 0;
          const waitlisted = waitlistMap.get(c.id) || 0;
          const capacity = c.capacity || 0;
          const pct = capacity > 0 ? Math.min(100, (enrolled / capacity) * 100) : 0;
          const isFull = capacity > 0 && enrolled >= capacity;
          const subjects = subjectsByClass.get(c.id) || [];
          return (
            <div class="bg-white rounded-xl border border-gray-200 p-5">
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <h3 class="font-semibold text-gray-900">{c.name}</h3>
                  <p class="text-xs text-gray-500 mt-0.5">
                    {c.gradeLevel && <span>{c.gradeLevel}</span>}
                    {c.section && <span> · Section {c.section}</span>}
                    {c.homeroomTeacherId && <span> · Homeroom: {staffMap.get(c.homeroomTeacherId) || '—'}</span>}
                  </p>
                </div>
                <div class="flex gap-2 shrink-0">
                  <a href={`?edit=${c.id}`} class="text-xs text-primary-600 font-medium">Edit</a>
                  <form method="POST" action="/api/dashboard/classes" onsubmit="return confirm('Delete this class? Enrollments will be unassigned.')">
                    <input type="hidden" name="id" value={c.id} />
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="text-xs text-red-600 font-medium">Delete</button>
                  </form>
                </div>
              </div>

              {c.description && <p class="text-sm text-gray-600 mb-3">{c.description}</p>}

              {/* Capacity & enrollment bar */}
              <div class="mb-3">
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-gray-600">Enrollment: <strong>{enrolled}</strong>{capacity > 0 ? ` / ${capacity}` : ''}</span>
                  <span class={isFull ? 'text-red-600 font-medium' : 'text-gray-500'}>
                    {isFull ? 'Full' : capacity > 0 ? `${pct.toFixed(0)}%` : 'No limit'}
                  </span>
                </div>
                <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div class={`h-full ${isFull ? 'bg-red-500' : pct > 80 ? 'bg-amber-500' : 'bg-green-500'}`} style={`width: ${pct}%`}></div>
                </div>
                {waitlisted > 0 && (
                  <p class="text-xs text-amber-600 mt-1">⚠ {waitlisted} student{waitlisted !== 1 ? 's' : ''} on waitlist</p>
                )}
              </div>

              {/* Subject mapping */}
              <div class="border-t border-gray-100 pt-3">
                <div class="flex items-center justify-between mb-2">
                  <h4 class="text-xs font-semibold text-gray-700 uppercase">Subject Mapping ({subjects.length})</h4>
                  <button onclick={`openSubjectModal(${c.id})`} class="text-xs text-primary-600 font-medium">+ Add Subject</button>
                </div>
                {subjects.length === 0 ? (
                  <p class="text-xs text-gray-400">No subjects assigned. Add subjects and assign teachers.</p>
                ) : (
                  <div class="flex flex-wrap gap-1.5">
                    {subjects.map(s => (
                      <span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded text-xs">
                        <strong>{s.subjectName}</strong>
                        {s.teacherId && <span class="text-blue-500">· {staffMap.get(s.teacherId) || '—'}</span>}
                        <button onclick={`deleteSubject(${s.id})`} class="text-red-500 hover:text-red-700 ml-1">×</button>
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Subject mapping modal -->
  <div id="subjectModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Add Subject to Class</h3>
      <form id="subjectForm" class="space-y-3">
        <input type="hidden" name="classId" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Subject Name *</label><input name="subjectName" required placeholder="e.g. Mathematics" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Teacher</label>
          <select name="teacherId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">— Unassigned —</option>
            {allStaff.map(s => <option value={s.id}>{s.firstName} {s.lastName}{s.designation ? ` (${s.designation})` : ''}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Linked Course (optional)</label>
          <select name="courseId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">— None —</option>
            {allCourses.map(c => <option value={c.id}>{c.title}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><input name="description" placeholder="Optional notes" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('subjectModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Add</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openSubjectModal = function(classId) {
      var form = document.getElementById('subjectForm');
      form.classId.value = classId;
      form.reset(); form.classId.value = classId;
      document.getElementById('subjectModal').classList.remove('hidden');
    };
    window.deleteSubject = async function(id) {
      if (!confirm('Remove this subject from the class?')) return;
      await fetch('/api/dashboard/class-subjects', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    document.getElementById('subjectForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var payload = {
        classId: parseInt(fd.get('classId')),
        subjectName: fd.get('subjectName'),
        teacherId: fd.get('teacherId') ? parseInt(fd.get('teacherId')) : null,
        courseId: fd.get('courseId') ? parseInt(fd.get('courseId')) : null,
        description: fd.get('description') || null,
      };
      var res = await fetch('/api/dashboard/class-subjects', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed to add subject'); }
    });
  })();`} />
</DashboardLayout>
