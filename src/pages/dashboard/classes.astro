---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { classes, staff, enrollments } from '../../lib/db/schema.js';
import { eq, asc, and } from 'drizzle-orm';

const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allClasses = await db.select().from(classes).where(eq(classes.schoolId, schoolId)).orderBy(asc(classes.sortOrder)).all();
const allStaff = await db.select().from(staff).where(eq(staff.schoolId, schoolId)).all() || [];
const allEnrollments = await db.select().from(enrollments).where(eq(enrollments.schoolId, schoolId)).all() || [];

const staffMap = new Map((allStaff||[]).map((s:any) => [s.id, `${s.firstName||s.first_name||''} ${s.lastName||s.last_name||''}`.trim()]));
const countMap = new Map<string, number>();
for (const e of (allEnrollments||[])) {
  const cid = e.classId ?? e.class_id;
  if (cid && e.status === 'accepted') countMap.set(cid, (countMap.get(cid)||0)+1);
}
const success = Astro.url.searchParams.get('success');
---

<DashboardLayout title="Classes & Sections - iSchool">
  {success && <div class="mosaic-card p-4 mb-4" style="border-color:#05B34D;background:rgba(5,179,77,0.05);"><p class="text-sm font-medium" style="color:#05B34D;">Class saved successfully.</p></div>}
  <div class="mb-6"><h1 class="text-2xl font-bold mb-1" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Classes & Sections</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Manage classes, sections, and enrollment.</p></div>
  <ListToolbar searchPlaceholder="Search classes..." newItemHref="/dashboard/classes/new" newItemLabel="+ New Class" />
  <div id="list-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {allClasses.length === 0 ? (
      <div class="col-span-full mosaic-card p-12 text-center"><h3 class="text-base font-semibold mb-1" style="color:var(--mosaic-text);">No classes yet</h3><a href="/dashboard/classes/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm mt-2">+ New Class</a></div>
    ) : allClasses.map(cls => (
      <div data-list-item data-title={cls.name||''} data-status="active" data-date={cls.createdAt||cls.created_at||''} class="mosaic-card p-5 group">
        <div class="flex items-center justify-between mb-3">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,rgba(5,179,77,0.12) 0%,rgba(5,179,77,0.04) 100%);">
            <span class="text-base font-bold" style="font-family:'Space Grotesk',sans-serif;color:#05B34D;">{(cls.name||'C').charAt(0)}</span>
          </div>
          <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full" style="background:rgba(99,102,241,0.1);color:#6366F1;">{cls.section || '—'}</span>
        </div>
        <h3 class="text-sm font-bold mb-1" style="color:var(--mosaic-text);">{cls.name||'Untitled'}</h3>
        <p class="text-xs mb-3" style="color:var(--mosaic-text-muted);">{cls.gradeLevel||cls.grade_level||''} {cls.teacherName||cls.teacher_name ? '· '+cls.teacherName||cls.teacher_name : ''}</p>
        <div class="grid grid-cols-2 gap-2 mb-3">
          <div class="p-2 rounded-lg" style="background:var(--mosaic-surface-2);"><p class="text-[10px] uppercase tracking-wider" style="color:var(--mosaic-text-subtle);">Enrolled</p><p class="text-sm font-bold" style="color:var(--mosaic-text);">{countMap.get(cls.id)||0}/{cls.capacity||'—'}</p></div>
          <div class="p-2 rounded-lg" style="background:var(--mosaic-surface-2);"><p class="text-[10px] uppercase tracking-wider" style="color:var(--mosaic-text-subtle);">Homeroom</p><p class="text-sm font-bold truncate" style="color:var(--mosaic-text);">{staffMap.get(cls.homeroomTeacherId ?? cls.homeroom_teacher_id) || '—'}</p></div>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[11px]" style="color:var(--mosaic-text-subtle);">{cls.sortOrder ?? cls.sort_order ?? 0}</span>
          <a href={`/dashboard/classes/${cls.id}/edit`} class="p-1.5 rounded-lg transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" title="Edit"><svg class="w-4 h-4" style="color:var(--mosaic-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
