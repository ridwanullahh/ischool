---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ListToolbar from '../../components/ListToolbar.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { programs } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';
const user = Astro.locals.user!;
const schoolId = getUserSchoolId(user);
const db = getDb();
let items: any[] = [];
if (schoolId) { try { items = await db.select().from(programs).where(eq(programs.schoolId, schoolId)).orderBy(desc(programs.createdAt)).all() || []; } catch {} }
const success = Astro.url.searchParams.get('success');
---
<DashboardLayout title="Programs - iSchool">
  {success && <div class="mosaic-card p-4 mb-4" style="border-color:#05B34D;background:rgba(5,179,77,0.05);"><p class="text-sm font-medium" style="color:#05B34D;">Program saved successfully.</p></div>}
  <div class="mb-6"><h1 class="text-2xl font-bold mb-1" style="font-family:'Space Grotesk',sans-serif;color:var(--mosaic-text);">Programs</h1><p class="text-sm" style="color:var(--mosaic-text-muted);">Manage academic programs.</p></div>
  <ListToolbar searchPlaceholder="Search programs..." newItemHref="/dashboard/programs/new" newItemLabel="+ New Program" />
  <div id="list-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {items.length === 0 ? (
      <div class="col-span-full mosaic-card p-12 text-center"><h3 class="text-base font-semibold mb-1" style="color:var(--mosaic-text);">No programs yet</h3><a href="/dashboard/programs/new" class="mosaic-btn-primary inline-block px-6 py-2.5 text-sm mt-2">+ New Program</a></div>
    ) : items.map(item => (
      <div data-list-item data-title={item.name||''} data-status="published" data-date={item.createdAt||item.created_at||''} class="mosaic-card overflow-hidden group">
        {item.imageUrl||item.image_url ? <div class="h-32 overflow-hidden"><img src={item.imageUrl||item.image_url} alt={item.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" /></div> : <div class="h-32 flex items-center justify-center" style="background:linear-gradient(135deg,rgba(5,179,77,0.08) 0%,rgba(5,179,77,0.02) 100%);"><svg class="w-10 h-10" style="color:rgba(5,179,77,0.3);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div>}
        <div class="p-4">
          <h3 class="text-sm font-bold mb-1 line-clamp-2" style="color:var(--mosaic-text);">{item.name||'Untitled'}</h3>
          <p class="text-xs line-clamp-2 mb-3" style="color:var(--mosaic-text-muted);">{item.description||'No description.'}</p>
          <div class="flex items-center justify-between"><span class="text-[11px]" style="color:var(--mosaic-text-subtle);">{(item.isPublished ?? item.is_published ?? true) ? 'Published' : 'Draft'}</span><a href={`/dashboard/programs/${item.id}/edit`} class="p-1.5 rounded-lg transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" title="Edit"><svg class="w-4 h-4" style="color:var(--mosaic-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a></div>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>
