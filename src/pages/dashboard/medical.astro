---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { studentMedicalRecords, students, schoolMembers } from '../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const records = db.select({
  id: studentMedicalRecords.id,
  studentId: studentMedicalRecords.studentId,
  studentName: students.firstName,
  studentLastName: students.lastName,
  studentIdCode: students.studentId,
  type: studentMedicalRecords.type,
  title: studentMedicalRecords.title,
  description: studentMedicalRecords.description,
  severity: studentMedicalRecords.severity,
  date: studentMedicalRecords.date,
  createdAt: studentMedicalRecords.createdAt,
}).from(studentMedicalRecords)
  .leftJoin(students, eq(studentMedicalRecords.studentId, students.id))
  .where(eq(studentMedicalRecords.schoolId, schoolId)).all();

const allStudents = db.select({ id: students.id, name: students.firstName, lastName: students.lastName, sid: students.studentId })
  .from(students).where(eq(students.schoolId, schoolId)).all();

const typeLabels: Record<string, string> = {
  condition: 'Medical Condition', allergy: 'Allergy', medication: 'Medication',
  immunization: 'Immunization', nurse_visit: 'Nurse Visit', incident: 'Incident Report', action_plan: 'Action Plan',
};
const typeColors: Record<string, string> = {
  condition: 'bg-blue-50 text-blue-700 border-blue-200', allergy: 'bg-red-50 text-red-700 border-red-200',
  medication: 'bg-purple-50 text-purple-700 border-purple-200', immunization: 'bg-green-50 text-green-700 border-green-200',
  nurse_visit: 'bg-amber-50 text-amber-700 border-amber-200', incident: 'bg-orange-50 text-orange-700 border-orange-200',
  action_plan: 'bg-emerald-50 text-emerald-700 border-emerald-200',
};
const severityColors: Record<string, string> = {
  low: 'bg-gray-100 text-gray-700', medium: 'bg-amber-100 text-amber-700',
  high: 'bg-orange-100 text-orange-700', critical: 'bg-red-100 text-red-700',
};
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---

<DashboardLayout title="Medical Records - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Health & Medical Records</h2>
        <p class="text-sm text-gray-500 mt-1">Track student medical conditions, allergies, medications, immunizations, nurse visits, incidents, and emergency action plans.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Add Medical Record</button>
    </div>

    <!-- Summary cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {['allergy', 'condition', 'medication', 'incident'].map(t => (
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <div class="text-xs text-gray-500 uppercase">{typeLabels[t]}</div>
          <div class="text-2xl font-bold text-gray-900 mt-1">{records.filter(r => r.type === t).length}</div>
        </div>
      ))}
    </div>

    <!-- Records table -->
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b border-gray-200 flex flex-col sm:flex-row gap-3">
        <input id="searchInput" type="text" placeholder="Search by student or title..." class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm" oninput="filterRecords()" />
        <select id="typeFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="filterRecords()">
          <option value="">All Types</option>
          {Object.entries(typeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
        <select id="severityFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" onchange="filterRecords()">
          <option value="">All Severities</option>
          <option value="low">Low</option><option value="medium">Medium</option>
          <option value="high">High</option><option value="critical">Critical</option>
        </select>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
            <th class="px-4 py-3">Student</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Title</th>
            <th class="px-4 py-3">Severity</th><th class="px-4 py-3">Date</th><th class="px-4 py-3">Actions</th>
          </tr></thead>
          <tbody id="recordsBody" class="divide-y divide-gray-200">
            {records.length === 0 ? (
              <tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No medical records yet.</td></tr>
            ) : records.map(r => (
              <tr class="hover:bg-gray-50 record-row" data-student={`${r.studentName || ''} ${r.studentLastName || ''}`.toLowerCase()} data-title={(r.title || '').toLowerCase()} data-type={r.type} data-severity={r.severity || ''}>
                <td class="px-4 py-3 font-medium text-gray-900">{r.studentName} {r.studentLastName} <span class="text-xs text-gray-500">({r.studentIdCode})</span></td>
                <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded border ${typeColors[r.type] || 'bg-gray-50 text-gray-700 border-gray-200'}`}>{typeLabels[r.type] || r.type}</span></td>
                <td class="px-4 py-3 text-gray-900">{r.title}{r.description ? <div class="text-xs text-gray-500 mt-0.5">{r.description}</div> : null}</td>
                <td class="px-4 py-3">{r.severity ? <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${severityColors[r.severity]}`}>{r.severity}</span> : <span class="text-gray-400">—</span>}</td>
                <td class="px-4 py-3 text-gray-600">{formatDate(r.date)}</td>
                <td class="px-4 py-3"><button onclick={`editRecord(${r.id})`} class="text-xs text-primary-600 font-medium">Edit</button> <button onclick={`deleteRecord(${r.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div id="recordModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="modalTitle">Add Medical Record</h3>
      <form id="recordForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Student *</label>
          <select name="studentId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select student…</option>
            {allStudents.map(s => <option value={s.id}>{s.name} {s.lastName} ({s.sid})</option>)}
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Type *</label>
            <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              {Object.entries(typeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Severity</label>
            <select name="severity" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="">—</option><option value="low">Low</option><option value="medium">Medium</option>
              <option value="high">High</option><option value="critical">Critical</option>
            </select>
          </div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title *</label><input name="title" required placeholder="e.g. Asthma, Penicillin allergy" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="3" placeholder="Details, symptoms, treatment notes…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Date</label><input name="date" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeModal()" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ records }} set:html={`(function(){
    var allRecords = records;
    window.openModal = function() {
      var form = document.getElementById('recordForm');
      form.reset(); form.id.value = '';
      document.getElementById('modalTitle').textContent = 'Add Medical Record';
      document.getElementById('recordModal').classList.remove('hidden');
    };
    window.closeModal = function() { document.getElementById('recordModal').classList.add('hidden'); };
    window.editRecord = function(id) {
      var r = allRecords.find(function(x){ return x.id === id; });
      if (!r) return;
      var form = document.getElementById('recordForm');
      form.id.value = r.id;
      form.studentId.value = r.studentId;
      form.type.value = r.type;
      form.title.value = r.title || '';
      form.description.value = r.description || '';
      form.severity.value = r.severity || '';
      form.date.value = r.date || '';
      document.getElementById('modalTitle').textContent = 'Edit Medical Record';
      document.getElementById('recordModal').classList.remove('hidden');
    };
    window.deleteRecord = async function(id) {
      if (!confirm('Delete this medical record?')) return;
      await fetch('/api/dashboard/student-medical', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    window.filterRecords = function() {
      var q = document.getElementById('searchInput').value.toLowerCase();
      var t = document.getElementById('typeFilter').value;
      var s = document.getElementById('severityFilter').value;
      document.querySelectorAll('.record-row').forEach(function(row) {
        var matchQ = !q || row.dataset.student.indexOf(q) >= 0 || row.dataset.title.indexOf(q) >= 0;
        var matchT = !t || row.dataset.type === t;
        var matchS = !s || row.dataset.severity === s;
        row.style.display = (matchQ && matchT && matchS) ? '' : 'none';
      });
    };
    document.getElementById('recordForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var payload = {
        studentId: fd.get('studentId'), type: fd.get('type'), title: fd.get('title'),
        description: fd.get('description') || null, severity: fd.get('severity') || null,
        date: fd.get('date') || null,
      };
      var id = fd.get('id');
      var method = id ? 'PUT' : 'POST';
      if (id) payload.id = parseInt(id);
      var res = await fetch('/api/dashboard/student-medical', { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed to save record'); }
    });
  })();`} />
</DashboardLayout>
