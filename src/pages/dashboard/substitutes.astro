---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { substituteTeachers, timetableEntries, classes, courses, users, schoolMembers, staff } from '../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const subs = await db.select({
  id: substituteTeachers.id,
  timetableEntryId: substituteTeachers.timetableEntryId,
  originalTeacherId: substituteTeachers.originalTeacherId,
  substituteTeacherId: substituteTeachers.substituteTeacherId,
  date: substituteTeachers.date,
  reason: substituteTeachers.reason,
  notes: substituteTeachers.notes,
  status: substituteTeachers.status,
  createdAt: substituteTeachers.createdAt,
  dayOfWeek: timetableEntries.dayOfWeek,
  periodNumber: timetableEntries.periodNumber,
  startTime: timetableEntries.startTime,
  endTime: timetableEntries.endTime,
  room: timetableEntries.room,
  className: classes.name,
  courseTitle: courses.title,
  originalTeacherName: users.name,
}).from(substituteTeachers)
  .leftJoin(timetableEntries, eq(substituteTeachers.timetableEntryId, timetableEntries.id))
  .leftJoin(classes, eq(timetableEntries.classId, classes.id))
  .leftJoin(courses, eq(timetableEntries.courseId, courses.id))
  .leftJoin(users, eq(substituteTeachers.originalTeacherId, users.id))
  .where(eq(substituteTeachers.schoolId, schoolId))
  .orderBy(desc(substituteTeachers.date)).all();

const subTeacherIds = [...new Set(subs.map(s => s.substituteTeacherId).filter(Boolean))] as number[];
const subTeacherMap = new Map<number, string>();
for (const tid of subTeacherIds) {
  const u = await db.select().from(users).where(eq(users.id, tid)).get();
  if (u) subTeacherMap.set(tid, u.name);
}
for (const s of subs) (s as any).substituteTeacherName = s.substituteTeacherId ? subTeacherMap.get(s.substituteTeacherId) || '—' : '—';

// Available teachers (users with teacher role or staff records)
const teachers = await db.select().from(users).innerJoin(schoolMembers, eq(users.id, schoolMembers.userId))
  .where(and(eq(schoolMembers.schoolId, schoolId), eq(users.role, 'teacher'))).all();
const teacherList = teachers.map(t => ({ id: t.users.id, name: t.users.name }));

// Timetable entries to choose from
const entries = await db.select({
  id: timetableEntries.id, dayOfWeek: timetableEntries.dayOfWeek, periodNumber: timetableEntries.periodNumber,
  startTime: timetableEntries.startTime, endTime: timetableEntries.endTime, room: timetableEntries.room,
  className: classes.name, courseTitle: courses.title, teacherName: users.name, teacherId: timetableEntries.teacherId,
}).from(timetableEntries)
  .leftJoin(classes, eq(timetableEntries.classId, classes.id))
  .leftJoin(courses, eq(timetableEntries.courseId, courses.id))
  .leftJoin(users, eq(timetableEntries.teacherId, users.id))
  .where(eq(timetableEntries.schoolId, schoolId))
  .orderBy(timetableEntries.dayOfWeek, timetableEntries.periodNumber).all();

const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const statusColors: Record<string, string> = {
  pending: 'bg-amber-100 text-amber-700', approved: 'bg-green-100 text-green-700',
  declined: 'bg-red-100 text-red-700', completed: 'bg-blue-100 text-blue-700',
};
const formatDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---

<DashboardLayout title="Substitute Teachers - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Substitute Teacher Scheduling</h2>
        <p class="text-sm text-gray-500 mt-1">Schedule substitute teachers for specific dates when regular teachers are unavailable.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ New Substitution</button>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-4"><div class="text-xs text-gray-500 uppercase">Total</div><div class="text-2xl font-bold text-gray-900">{subs.length}</div></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><div class="text-xs text-gray-500 uppercase">Pending</div><div class="text-2xl font-bold text-amber-600">{subs.filter(s => s.status === 'pending').length}</div></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><div class="text-xs text-gray-500 uppercase">Approved</div><div class="text-2xl font-bold text-green-600">{subs.filter(s => s.status === 'approved').length}</div></div>
      <div class="bg-white rounded-xl border border-gray-200 p-4"><div class="text-xs text-gray-500 uppercase">Declined</div><div class="text-2xl font-bold text-red-600">{subs.filter(s => s.status === 'declined').length}</div></div>
    </div>

    {/* Substitutions table */}
    <div class="bg-white rounded-xl border border-gray-200">
      {subs.length === 0 ? (
        <div class="p-12 text-center">
          <div class="text-4xl mb-3">👥</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No substitutions scheduled</h3>
          <p class="text-sm text-gray-500">When a teacher is absent, schedule a substitute for their classes here.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Date</th><th class="px-4 py-3">Class / Period</th>
              <th class="px-4 py-3">Original Teacher</th><th class="px-4 py-3">Substitute</th>
              <th class="px-4 py-3">Reason</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {subs.map(s => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{formatDate(s.date)}</td>
                  <td class="px-4 py-3 text-gray-700">
                    <div className="font-medium">{s.className || '—'}</div>
                    <div className="text-xs text-gray-500">
                      {days[(s.dayOfWeek || 1) - 1]} · Period {s.periodNumber} · {s.startTime}–{s.endTime}
                      {s.room && ` · Room ${s.room}`}
                    </div>
                    {s.courseTitle && <div className="text-xs text-gray-400">{s.courseTitle}</div>}
                  </td>
                  <td class="px-4 py-3 text-gray-700">{s.originalTeacherName || '—'}</td>
                  <td class="px-4 py-3 text-gray-700">{(s as any).substituteTeacherName}</td>
                  <td class="px-4 py-3 text-gray-600">{s.reason || '—'}</td>
                  <td class="px-4 py-3"><span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[s.status]}`}>{s.status}</span></td>
                  <td class="px-4 py-3">
                    {s.status === 'pending' && (
                      <div class="flex gap-2">
                        <button onclick={`approveSub(${s.id})`} class="text-xs text-green-600 font-medium">Approve</button>
                        <button onclick={`declineSub(${s.id})`} class="text-xs text-red-600 font-medium">Decline</button>
                      </div>
                    )}
                    <button onclick={`deleteSub(${s.id})`} class="text-xs text-gray-500 font-medium ml-2">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  {/* New Substitution Modal */}
  <div id="subModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Schedule Substitute Teacher</h3>
      <form id="subForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Timetable Entry *</label>
          <select name="timetableEntryId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select class period…</option>
            {entries.map(e => <option value={e.id}>{days[(e.dayOfWeek || 1) - 1]} · P{e.periodNumber} · {e.startTime}–{e.endTime} · {e.className} {e.courseTitle ? `(${e.courseTitle})` : ''} · {e.teacherName || 'No teacher'}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Date *</label><input name="date" type="date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" value={new Date().toISOString().split('T')[0]} /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Substitute Teacher *</label>
          <select name="substituteTeacherId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">Select teacher…</option>
            {teacherList.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Reason</label>
          <select name="reason" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="">—</option>
            <option value="sick">Sick Leave</option>
            <option value="personal">Personal Leave</option>
            <option value="conference">Conference / Training</option>
            <option value="emergency">Family Emergency</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Notes</label><textarea name="notes" rows="2" placeholder="Optional notes…" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('subModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Schedule</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.openModal = function() { document.getElementById('subModal').classList.remove('hidden'); };
    window.approveSub = async function(id) {
      await fetch('/api/dashboard/substitutes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'approve', id: id }) });
      window.location.reload();
    };
    window.declineSub = async function(id) {
      await fetch('/api/dashboard/substitutes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'decline', id: id }) });
      window.location.reload();
    };
    window.deleteSub = async function(id) {
      if (!confirm('Delete this substitution record?')) return;
      await fetch('/api/dashboard/substitutes', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    document.getElementById('subForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var payload = {
        timetableEntryId: parseInt(fd.get('timetableEntryId')),
        substituteTeacherId: parseInt(fd.get('substituteTeacherId')),
        date: fd.get('date'),
        reason: fd.get('reason') || null,
        notes: fd.get('notes') || null,
        status: 'pending',
      };
      var res = await fetch('/api/dashboard/substitutes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
