---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { libraryLoans, libraryBooks, users, schoolMembers } from '../../lib/db/schema.js';
import { eq, and, sql, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// Loans with fines
const fineLoans = await db.select({
  id: libraryLoans.id, bookId: libraryLoans.bookId, borrowerId: libraryLoans.borrowerId,
  issueDate: libraryLoans.issueDate, dueDate: libraryLoans.dueDate, returnDate: libraryLoans.returnDate,
  fine: libraryLoans.fine, finePaid: libraryLoans.finePaid, status: libraryLoans.status,
  bookTitle: libraryBooks.title, borrowerName: users.name, borrowerEmail: users.email,
}).from(libraryLoans)
  .leftJoin(libraryBooks, eq(libraryLoans.bookId, libraryBooks.id))
  .leftJoin(users, eq(libraryLoans.borrowerId, users.id))
  .where(and(eq(libraryLoans.schoolId, schoolId), sql`${libraryLoans.fine} > 0`))
  .orderBy(desc(libraryLoans.createdAt)).all();

const unpaid = fineLoans.filter(l => !l.finePaid);
const paid = fineLoans.filter(l => l.finePaid);
const totalUnpaid = unpaid.reduce((s, l) => s + (l.fine || 0), 0);
const totalPaid = paid.reduce((s, l) => s + (l.fine || 0), 0);

const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
---

<DashboardLayout title="Library Fines - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Library Fines</h2>
      <p class="text-sm text-gray-500 mt-1">Overdue fines are auto-calculated at ₦50/day when books are returned late. Mark fines as paid or waive them.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Fines</div><div class="text-2xl font-bold">{fineLoans.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Unpaid</div><div class="text-2xl font-bold text-red-600">{unpaid.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Unpaid</div><div class="text-2xl font-bold text-amber-600">₦{totalUnpaid.toLocaleString()}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Collected</div><div class="text-2xl font-bold text-green-600">₦{totalPaid.toLocaleString()}</div></div>
    </div>

    {/* Unpaid fines */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Unpaid Fines ({unpaid.length})</div>
      {unpaid.length === 0 ? (
        <p class="p-8 text-center text-sm text-green-600">No unpaid fines. 🎉</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Borrower</th><th class="px-4 py-3">Book</th>
              <th class="px-4 py-3">Due Date</th><th class="px-4 py-3">Returned</th>
              <th class="px-4 py-3">Fine</th><th class="px-4 py-3">Actions</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {unpaid.map(l => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{l.borrowerName}<div class="text-xs text-gray-500">{l.borrowerEmail}</div></td>
                  <td class="px-4 py-3 text-gray-700">{l.bookTitle}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(l.dueDate)}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(l.returnDate)}</td>
                  <td class="px-4 py-3 text-red-700 font-bold">₦{(l.fine || 0).toLocaleString()}</td>
                  <td class="px-4 py-3">
                    <button onclick={`payFine(${l.id})`} class="text-xs text-green-600 font-medium">Mark Paid</button>
                    <button onclick={`waiveFine(${l.id})`} class="text-xs text-amber-600 font-medium ml-2">Waive</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    {/* Paid fines history */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Paid Fines History ({paid.length})</div>
      {paid.length === 0 ? (
        <p class="p-8 text-center text-sm text-gray-500">No paid fines yet.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
              <th class="px-4 py-3">Borrower</th><th class="px-4 py-3">Book</th>
              <th class="px-4 py-3">Due Date</th><th class="px-4 py-3">Returned</th>
              <th class="px-4 py-3">Fine Paid</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
              {paid.map(l => (
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 font-medium text-gray-900">{l.borrowerName}</td>
                  <td class="px-4 py-3 text-gray-700">{l.bookTitle}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(l.dueDate)}</td>
                  <td class="px-4 py-3 text-gray-600">{fmtDate(l.returnDate)}</td>
                  <td class="px-4 py-3 text-green-700 font-bold">₦{(l.fine || 0).toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.payFine = async function(loanId) {
      if (!confirm('Mark this fine as paid?')) return;
      await fetch('/api/dashboard/library', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'pay_fine', loanId: loanId }) });
      window.location.reload();
    };
    window.waiveFine = async function(loanId) {
      if (!confirm('Waive this fine? This cannot be undone.')) return;
      await fetch('/api/dashboard/library', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'waive_fine', loanId: loanId }) });
      window.location.reload();
    };
  })();`} />
</DashboardLayout>
