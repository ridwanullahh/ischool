---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { venues, events, schoolMembers } from '../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

const allVenues = await db.select().from(venues).where(eq(venues.schoolId, schoolId)).orderBy(desc(venues.createdAt)).all();
const allEvents = await db.select().from(events).where(eq(events.schoolId, schoolId)).all();
const today = new Date().toISOString().split('T')[0];
const upcomingEvents = allEvents.filter(e => e.startDate >= today);

const venueTypeLabels: Record<string, string> = { hall: 'Hall', classroom: 'Classroom', lab: 'Laboratory', sports_field: 'Sports Field', auditorium: 'Auditorium', meeting_room: 'Meeting Room', outdoor: 'Outdoor', other: 'Other' };
const venueTypeColors: Record<string, string> = { hall: 'bg-purple-100 text-purple-700', classroom: 'bg-blue-100 text-blue-700', lab: 'bg-green-100 text-green-700', sports_field: 'bg-amber-100 text-amber-700', auditorium: 'bg-red-100 text-red-700', meeting_room: 'bg-cyan-100 text-cyan-700', outdoor: 'bg-emerald-100 text-emerald-700', other: 'bg-gray-100 text-gray-700' };
const statusColors: Record<string, string> = { available: 'bg-green-100 text-green-700', maintenance: 'bg-amber-100 text-amber-700', retired: 'bg-red-100 text-red-700' };
const facilityOptions = ['Projector', 'Air Conditioning', 'Sound System', 'Whiteboard', 'Smartboard', 'WiFi', 'Stage', 'Lighting', 'Power Outlets', 'Wheelchair Access', 'Parking'];
---

<DashboardLayout title="Venues - iSchool">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Venues & Rooms</h2>
        <p class="text-sm text-gray-500 mt-1">Manage school venues (halls, classrooms, labs, sports fields). Track capacity, facilities, and booking schedule.</p>
      </div>
      <button onclick="openModal()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">+ Add Venue</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Venues</div><div class="text-2xl font-bold">{allVenues.length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Available</div><div class="text-2xl font-bold text-green-600">{allVenues.filter(v => v.status === 'available').length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Maintenance</div><div class="text-2xl font-bold text-amber-600">{allVenues.filter(v => v.status === 'maintenance').length}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Capacity</div><div class="text-2xl font-bold text-blue-600">{allVenues.reduce((s, v) => s + (v.capacity || 0), 0).toLocaleString()}</div></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {allVenues.length === 0 ? (
        <div class="md:col-span-2 lg:col-span-3 bg-white rounded-xl border p-12 text-center">
          <div class="text-4xl mb-3">🏫</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1">No venues yet</h3>
          <p class="text-sm text-gray-500">Add your first venue or room.</p>
        </div>
      ) : allVenues.map(v => {
        let facilities: any[] = [];
        try { facilities = typeof v.facilities === 'string' ? JSON.parse(v.facilities) : v.facilities; } catch {}
        const venueEvents = upcomingEvents.filter(e => e.venue === v.name);
        return (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-start justify-between mb-2">
              <div>
                <h3 class="font-semibold text-gray-900">{v.name}</h3>
                <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${venueTypeColors[v.type] || venueTypeColors.other}`}>{venueTypeLabels[v.type] || v.type}</span>
              </div>
              <span class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${statusColors[v.status] || ''}`}>{v.status}</span>
            </div>
            {v.location && <p class="text-xs text-gray-500 mb-2">📍 {v.location}</p>}
            <p class="text-sm text-gray-700">👥 Capacity: <strong>{v.capacity || '—'}</strong></p>
            {Array.isArray(facilities) && facilities.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-2">
                {facilities.map(f => <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 text-gray-700 rounded">{f}</span>)}
              </div>
            )}
            {venueEvents.length > 0 && (
              <div class="mt-3 pt-3 border-t border-gray-100">
                <p class="text-xs text-gray-500 mb-1">📅 Upcoming bookings ({venueEvents.length}):</p>
                <div class="space-y-1">
                  {venueEvents.slice(0, 3).map(e => (
                    <div class="text-xs text-gray-700">
                      {new Date(e.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} · {e.title}
                    </div>
                  ))}
                  {venueEvents.length > 3 && <div class="text-xs text-gray-400">+ {venueEvents.length - 3} more</div>}
                </div>
              </div>
            )}
            {v.notes && <p class="text-xs text-gray-500 italic mt-2">{v.notes}</p>}
            <div class="flex gap-2 mt-3 pt-3 border-t border-gray-100">
              <button onclick={`editVenue(${v.id})`} class="text-xs text-amber-600 font-medium">Edit</button>
              <button onclick={`deleteVenue(${v.id})`} class="text-xs text-red-600 font-medium ml-2">Delete</button>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div id="venueModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold text-gray-900 mb-4" id="modalTitle">Add Venue</h3>
      <form id="venueForm" class="space-y-3">
        <input type="hidden" name="id" />
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Venue Name *</label><input name="name" required placeholder="e.g. Main Hall" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Type</label>
            <select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              {Object.entries(venueTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
            </select>
          </div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Capacity</label><input name="capacity" type="number" placeholder="e.g. 200" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Location</label><input name="location" placeholder="e.g. Block A, Ground Floor" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Facilities</label>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
            {facilityOptions.map(f => (
              <label class="flex items-center gap-2 text-xs text-gray-700">
                <input type="checkbox" name="facilities" value={f} class="rounded" />
                {f}
              </label>
            ))}
          </div>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Status</label>
          <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="available">Available</option>
            <option value="maintenance">Maintenance</option>
            <option value="retired">Retired</option>
          </select>
        </div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Notes</label><textarea name="notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="document.getElementById('venueModal').classList.add('hidden')" class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg">Cancel</button>
          <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ allVenues }} set:html={`(function(){
    var venues = allVenues;
    window.openModal = function() {
      var form = document.getElementById('venueForm');
      form.reset(); form.id.value = '';
      document.querySelectorAll('input[name="facilities"]').forEach(function(c){ c.checked = false; });
      document.getElementById('modalTitle').textContent = 'Add Venue';
      document.getElementById('venueModal').classList.remove('hidden');
    };
    window.editVenue = function(id) {
      var v = venues.find(function(x){ return x.id === id; });
      if (!v) return;
      var form = document.getElementById('venueForm');
      form.id.value = v.id; form.name.value = v.name;
      form.type.value = v.type;
      form.capacity.value = v.capacity || '';
      form.location.value = v.location || '';
      form.status.value = v.status;
      form.notes.value = v.notes || '';
      var facs = [];
      try { facs = JSON.parse(v.facilities || '[]'); } catch {}
      document.querySelectorAll('input[name="facilities"]').forEach(function(c){
        c.checked = facs.indexOf(c.value) >= 0;
      });
      document.getElementById('modalTitle').textContent = 'Edit Venue';
      document.getElementById('venueModal').classList.remove('hidden');
    };
    window.deleteVenue = async function(id) {
      if (!confirm('Delete this venue?')) return;
      await fetch('/api/dashboard/venues', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: id }) });
      window.location.reload();
    };
    document.getElementById('venueForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var facilities = [];
      document.querySelectorAll('input[name="facilities"]:checked').forEach(function(c){ facilities.push(c.value); });
      var id = fd.get('id');
      var payload = {
        name: fd.get('name'),
        type: fd.get('type'),
        capacity: fd.get('capacity') ? parseInt(fd.get('capacity')) : null,
        location: fd.get('location') || null,
        facilities: facilities,
        status: fd.get('status'),
        notes: fd.get('notes') || null,
      };
      var method = id ? 'PUT' : 'POST';
      if (id) payload.id = parseInt(id);
      var res = await fetch('/api/dashboard/venues', { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) window.location.reload();
      else { var err = await res.json(); alert(err.error || 'Failed'); }
    });
  })();`} />
</DashboardLayout>
