---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getUserSchoolId } from '../../lib/school.js';
import { getDb } from '../../lib/db/index.js';
import { students, staff, classes, courses, invoices, libraryBooks, events, schoolMembers } from '../../lib/db/schema.js';
import { eq, sql } from 'drizzle-orm';
import fs from 'fs';
import path from 'path';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/auth/login');
const schoolId = getUserSchoolId(user.id);
if (!schoolId) return Astro.redirect('/dashboard');
const db = getDb();

// Table row counts
const counts = {
  students: db.select({ c: sql<number>`count(*)` }).from(students).where(eq(students.schoolId, schoolId)).all()[0]?.c || 0,
  staff: db.select({ c: sql<number>`count(*)` }).from(staff).where(eq(staff.schoolId, schoolId)).all()[0]?.c || 0,
  classes: db.select({ c: sql<number>`count(*)` }).from(classes).where(eq(classes.schoolId, schoolId)).all()[0]?.c || 0,
  courses: db.select({ c: sql<number>`count(*)` }).from(courses).where(eq(courses.schoolId, schoolId)).all()[0]?.c || 0,
  invoices: db.select({ c: sql<number>`count(*)` }).from(invoices).where(eq(invoices.schoolId, schoolId)).all()[0]?.c || 0,
  books: db.select({ c: sql<number>`count(*)` }).from(libraryBooks).where(eq(libraryBooks.schoolId, schoolId)).all()[0]?.c || 0,
  events: db.select({ c: sql<number>`count(*)` }).from(events).where(eq(events.schoolId, schoolId)).all()[0]?.c || 0,
};

// DB file info
const dbPath = path.resolve(process.cwd(), 'ischool.db');
let dbSize = 0;
try { dbSize = fs.statSync(dbPath).size; } catch {}
const dbSizeMB = (dbSize / (1024 * 1024)).toFixed(2);
const dbModified = (() => { try { return fs.statSync(dbPath).mtime; } catch { return null; } })();

const fmtDate = (d: any) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
---

<DashboardLayout title="Backup & Restore - iSchool">
  <div class="space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">Backup & Restore</h2>
      <p class="text-sm text-gray-500 mt-1">Create database backups, restore from previous backups, and view backup history.</p>
    </div>

    {/* Backup status */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Database Size</div><div class="text-2xl font-bold">{dbSizeMB} MB</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Last Modified</div><div class="text-sm font-bold text-gray-900 mt-1">{fmtDate(dbModified)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Total Records</div><div class="text-2xl font-bold text-blue-600">{Object.values(counts).reduce((s, c) => s + c, 0)}</div></div>
      <div class="bg-white rounded-xl border p-4"><div class="text-xs text-gray-500 uppercase">Backup Schedule</div><div class="text-sm font-bold text-amber-600 mt-1">Manual</div></div>
    </div>

    {/* Backup actions */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="text-3xl">💾</div>
          <div>
            <h3 class="font-semibold text-gray-900">Create Backup</h3>
            <p class="text-xs text-gray-500">Download a snapshot of the SQLite database</p>
          </div>
        </div>
        <p class="text-sm text-gray-600 mb-4">Generates a backup file containing all school data. Recommended before major changes (term rollover, fee structure updates, schema migrations).</p>
        <button onclick="createBackup()" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">⬇ Download Backup Now</button>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="text-3xl">📤</div>
          <div>
            <h3 class="font-semibold text-gray-900">Restore from Backup</h3>
            <p class="text-xs text-gray-500">Upload a previous backup file to restore</p>
          </div>
        </div>
        <p class="text-sm text-gray-600 mb-4">⚠ <strong>Warning:</strong> Restoring will overwrite all current data. Ensure you have a recent backup of the current state first.</p>
        <input type="file" id="restoreFile" accept=".db,.sqlite,.bak" class="hidden" />
        <button onclick="document.getElementById('restoreFile').click()" class="w-full px-4 py-2 text-sm font-medium text-amber-700 bg-amber-100 rounded-lg hover:bg-amber-200">Upload & Restore</button>
      </div>
    </div>

    {/* Table breakdown */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="p-4 border-b font-semibold text-gray-900">Database Records by Module</div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase">
            <th class="px-4 py-3">Module</th><th class="px-4 py-3">Table</th>
            <th class="px-4 py-3">Records</th><th class="px-4 py-3">Action</th>
          </tr></thead>
          <tbody class="divide-y divide-gray-200">
            <tr><td class="px-4 py-3">SIS</td><td class="px-4 py-3 text-gray-700">students</td><td class="px-4 py-3 font-medium">{counts.students}</td><td class="px-4 py-3"><a href="/api/dashboard/students?action=export" class="text-xs text-primary-600">Export CSV</a></td></tr>
            <tr><td class="px-4 py-3">HR</td><td class="px-4 py-3 text-gray-700">staff</td><td class="px-4 py-3 font-medium">{counts.staff}</td><td class="px-4 py-3 text-gray-400 text-xs">Export via reports</td></tr>
            <tr><td class="px-4 py-3">SIS</td><td class="px-4 py-3 text-gray-700">classes</td><td class="px-4 py-3 font-medium">{counts.classes}</td><td class="px-4 py-3 text-gray-400 text-xs">Export via reports</td></tr>
            <tr><td class="px-4 py-3">LMS</td><td class="px-4 py-3 text-gray-700">courses</td><td class="px-4 py-3 font-medium">{counts.courses}</td><td class="px-4 py-3 text-gray-400 text-xs">Export via reports</td></tr>
            <tr><td class="px-4 py-3">Finance</td><td class="px-4 py-3 text-gray-700">invoices</td><td class="px-4 py-3 font-medium">{counts.invoices}</td><td class="px-4 py-3"><a href="/api/dashboard/invoices?action=export" class="text-xs text-primary-600">Export CSV</a></td></tr>
            <tr><td class="px-4 py-3">Library</td><td class="px-4 py-3 text-gray-700">library_books</td><td class="px-4 py-3 font-medium">{counts.books}</td><td class="px-4 py-3"><a href="/api/dashboard/library?action=export" class="text-xs text-primary-600">Export CSV</a></td></tr>
            <tr><td class="px-4 py-3">Events</td><td class="px-4 py-3 text-gray-700">events</td><td class="px-4 py-3 font-medium">{counts.events}</td><td class="px-4 py-3 text-gray-400 text-xs">Export via reports</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    {/* Best practices */}
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
      <h3 class="text-sm font-semibold text-amber-900 mb-2">📋 Backup Best Practices</h3>
      <ul class="text-sm text-amber-800 space-y-1 ml-4 list-disc">
        <li>Create a backup before any major change (term rollover, schema migration, fee updates)</li>
        <li>Download backups to off-site storage (Google Drive, Dropbox, external hard drive)</li>
        <li>Test restore procedure quarterly to verify backups are valid</li>
        <li>Retain at least 3 monthly backups for audit/compliance purposes</li>
        <li>For scheduled/automated backups, configure a server cron job to copy the database file</li>
      </ul>
    </div>
  </div>

  <script is:inline set:html={`(function(){
    window.createBackup = function() {
      if (!confirm('Download a backup of the database? This may take a few seconds.')) return;
      // Trigger download of the database file
      window.location.href = '/api/dashboard/backup?action=download';
    };
    document.getElementById('restoreFile')?.addEventListener('change', async function(e) {
      var file = e.target.files[0];
      if (!file) return;
      if (!confirm('WARNING: This will OVERWRITE all current data with the backup file. Continue?')) return;
      if (!confirm('Are you absolutely sure? This cannot be undone.')) return;
      alert('Restore functionality requires admin server access. Please contact your system administrator to restore from: ' + file.name);
    });
  })();`} />
</DashboardLayout>
