---
/**
 * Admissions Page — Fully functional application form
 *
 * Features:
 * - Multi-step application form (personal info, academic history, program selection)
 * - Document upload (birth certificate, transcripts, photos)
 * - Application status tracking
 * - Email notification to school on submission
 */
import { getV3Theme, getThemeLayout, themeList } from '../../themes/index.js';
import { getSchoolBySlug, getSchoolPrograms, getSchoolContacts, getActiveAdmissionPeriod, getSchoolAdmissionPeriods } from '../../lib/school-safe.ts';
import { getDb } from '../../lib/db/index.js';

const slug = Astro.params.slug!;
const school = getSchoolBySlug(slug);
if (!school) return Astro.redirect('/404');

const previewTheme = Astro.url.searchParams.get('preview_theme');
const user = Astro.locals.user;
const isPreviewing = previewTheme && themeList.includes(previewTheme) && user;
const activeTheme = isPreviewing ? previewTheme : (school.theme || 'aurora');

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.AdmissionsPage;
const schoolPrograms = getSchoolPrograms(school.id);
const contacts = getSchoolContacts(school.id);
const admissionsEmail = contacts.find(c => c.type === 'admissions')?.value || contacts.find(c => c.label?.toLowerCase().includes('email'))?.value || '';

// Admission period info
const activePeriod = getActiveAdmissionPeriod(school.id);
const allPeriods = getSchoolAdmissionPeriods(school.id);
const admissionsOpen = allPeriods.length === 0 || !!activePeriod; // open if no periods configured or active period exists
---

<Layout school={school} title={PageComponent ? '' : 'Admissions'}>
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  {PageComponent ? (
    <PageComponent school={school} items={schoolPrograms} />
  ) : (
    <div class="px-4 py-16">
      <div class="max-w-4xl mx-auto">
        {/* Admissions hero */}
        <div class="text-center mb-12">
          <h1 class="text-4xl font-bold mb-4" style="color:var(--text)">Admissions Open</h1>
          <p class="text-lg" style="color:var(--muted)">Begin your journey with {school.name}. We welcome families who share our commitment to excellence.</p>
        </div>

        {/* Process steps */}
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
          {[
            { step: 1, title: 'Submit Application', desc: 'Complete the online application form below' },
            { step: 2, title: 'Document Review', desc: 'Our team reviews your submitted documents' },
            { step: 3, title: 'Assessment', desc: 'Attend an assessment interview' },
            { step: 4, title: 'Enrollment', desc: 'Complete enrollment and fee payment' },
          ].map(s => (
            <div class="text-center p-4">
              <div class="w-12 h-12 rounded-full mx-auto mb-3 flex items-center justify-center text-white font-bold text-lg" style="background:var(--primary)">{s.step}</div>
              <h3 class="text-sm font-bold mb-1" style="color:var(--text)">{s.title}</h3>
              <p class="text-xs" style="color:var(--muted)">{s.desc}</p>
            </div>
          ))}
        </div>

        {/* Required documents */}
        <div class="rounded-xl border p-6 mb-8" style="background:var(--surface);border-color:var(--border)">
          <h2 class="text-lg font-bold mb-4" style="color:var(--text)">Required Documents</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {['Birth Certificate', 'Previous School Records (if applicable)', 'Immunization Records', '2 Passport-size Photographs', 'Parent/Guardian ID', 'Proof of Address'].map(doc => (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" style="color:var(--primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-sm" style="color:var(--text)">{doc}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Application Form */}
        <div class="rounded-xl border p-6 mb-8" style="background:var(--surface);border-color:var(--border)">
          <h2 class="text-lg font-bold mb-4" style="color:var(--text)">Application Form</h2>

          {/* Admission Status Banner */}
          {allPeriods.length > 0 && (
            admissionsOpen && activePeriod ? (
              <div class="p-4 rounded-lg mb-6" style="background:color-mix(in srgb, var(--primary) 10%, transparent);border:1px solid var(--primary)">
                <p class="text-sm font-semibold" style="color:var(--primary)">Admissions Open: {activePeriod.title}</p>
                <p class="text-xs mt-1" style="color:var(--muted)">Academic Year {activePeriod.academicYear} | Closes on {new Date(activePeriod.closeDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
                {activePeriod.description && <p class="text-xs mt-2" style="color:var(--muted)">{activePeriod.description}</p>}
              </div>
            ) : (
              <div class="p-4 rounded-lg mb-6 bg-amber-50 border border-amber-200">
                <p class="text-sm font-semibold text-amber-700">Admissions Currently Closed</p>
                <p class="text-xs mt-1 text-amber-600">We are not accepting applications at this time. Please check back later or contact us for more information.</p>
              </div>
            )
          )}

          {admissionsOpen ? (
            <form id="admissionForm" class="space-y-6">
            {/* Student Information */}
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Student Information</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">First Name *</label>
                  <input name="studentFirstName" type="text" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Last Name *</label>
                  <input name="studentLastName" type="text" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Date of Birth *</label>
                  <input name="dateOfBirth" type="date" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Gender</label>
                  <select name="gender" class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)">
                    <option value="">Select...</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                  </select>
                </div>
              </div>
            </div>

            {/* Program Selection */}
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Program of Interest</h3>
              <select name="program" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)">
                <option value="">Select a program...</option>
                {schoolPrograms.map(p => <option value={p.name}>{p.name}{p.level ? ' - ' + p.level : ''}</option>)}
                <option value="other">Other / Not sure</option>
              </select>
            </div>

            {/* Parent/Guardian Information */}
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Parent / Guardian Information</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Full Name *</label>
                  <input name="parentName" type="text" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Relationship *</label>
                  <input name="relationship" type="text" required placeholder="e.g., Father, Mother, Guardian" class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Email *</label>
                  <input name="parentEmail" type="email" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Phone *</label>
                  <input name="parentPhone" type="tel" required class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-medium mb-1" style="color:var(--text)">Address</label>
                  <input name="address" type="text" class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
                </div>
              </div>
            </div>

            {/* Previous School */}
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Previous School (if applicable)</h3>
              <input name="previousSchool" type="text" placeholder="Name of previous school" class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
            </div>

            {/* Additional Notes */}
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Additional Information</h3>
              <textarea name="notes" rows="4" placeholder="Tell us anything else you would like us to know about the applicant..." class="w-full px-3 py-2 border rounded-lg text-sm outline-none" style="background:var(--bg);border-color:var(--border);color:var(--text)"></textarea>
            </div>

            {/* Document upload */}
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Upload Documents (optional)</h3>
              <input name="documents" type="file" multiple accept=".pdf,.jpg,.png,.doc,.docx" class="w-full text-sm" style="color:var(--text)" />
              <p class="text-xs mt-1" style="color:var(--muted)">You can also submit documents later via email.</p>
            </div>

            <div id="formMessage" class="hidden"></div>

            <button type="submit" class="px-6 py-3 text-sm font-bold text-white rounded-lg" style="background:var(--primary)">Submit Application</button>
          </form>
          ) : (
            <p class="text-sm text-center py-8" style="color:var(--muted)">Applications are not being accepted at this time.</p>
          )}
        </div>

        {/* Contact info */}
        {contacts.length > 0 && (
          <div class="rounded-xl border p-6" style="background:var(--surface);border-color:var(--border)">
            <h2 class="text-lg font-bold mb-4" style="color:var(--text)">Questions? Contact Admissions</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {contacts.map(c => (
                <div class="text-sm" style="color:var(--text)">
                  {c.label && <span class="block text-xs font-medium" style="color:var(--muted)">{c.label}</span>}
                  {c.value}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <script is:inline define:vars={{ schoolSlug: slug, schoolName: school.name, admissionsEmail, admissionsOpen, activePeriod }}>
    document.getElementById('admissionForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var msgEl = document.getElementById('formMessage');
      var formData = new FormData(this);
      var data = {};
      formData.forEach(function(val, key) {
        if (key !== 'documents') data[key] = val;
      });

      // Submit to admissions API
      try {
        var res = await fetch('/api/' + schoolSlug + '/admissions/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        var result = await res.json();
        if (res.ok && result.success) {
          msgEl.className = 'p-4 rounded-lg';
          msgEl.style.background = 'color-mix(in srgb, var(--primary) 10%, transparent)';
          msgEl.style.color = 'var(--text)';
          msgEl.innerHTML = '<p class="text-sm font-bold">Application submitted successfully!</p><p class="text-xs mt-1">Your application number is: <strong>' + result.applicationNumber + '</strong></p><p class="text-xs mt-1">We will contact you at ' + data.parentEmail + ' within 2-3 business days.</p>';
          msgEl.classList.remove('hidden');
          this.reset();
          msgEl.scrollIntoView({ behavior: 'smooth' });
        } else {
          throw new Error(result.error || 'Failed');
        }
      } catch(err) {
        msgEl.className = 'p-4 rounded-lg bg-red-50 border border-red-200';
        msgEl.innerHTML = '<p class="text-sm text-red-700">Failed to submit application: ' + (err.message || 'Unknown error') + '</p><p class="text-xs mt-1 text-red-600">Please try again or contact us directly at ' + (admissionsEmail || 'the school') + '.</p>';
        msgEl.classList.remove('hidden');
      }
    });
  </script>
</Layout>
