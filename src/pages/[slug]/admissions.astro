---
import { getV3Theme, getThemeLayout, themeList } from '../../themes/index.js';
import { getSchoolBySlug, getSchoolAdmissionPeriods, getSchoolPrograms, getSchoolContacts } from '../../lib/school-safe.ts';

const slug = Astro.params.slug!;
const school = getSchoolBySlug(slug);
if (!school) return Astro.redirect('/404');

const previewTheme = Astro.url.searchParams.get('preview_theme');
const user = Astro.locals.user;
const isPreviewing = previewTheme && themeList.includes(previewTheme) && user;
const activeTheme = isPreviewing ? previewTheme : (school.theme || 'aurora');

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.AdmissionsPage;
const schoolPrograms = getSchoolPrograms(school.id);
const contacts = getSchoolContacts(school.id);

// Get all admission periods
const allPeriods = getSchoolAdmissionPeriods(school.id);
const today = new Date().toISOString().split('T')[0];

// Categorize periods
const openPeriods = allPeriods.filter((p: any) => p.is_active && p.open_date <= today && p.close_date >= today);
const upcomingPeriods = allPeriods.filter((p: any) => p.is_active && p.open_date > today);
const closedPeriods = allPeriods.filter((p: any) => !p.is_active || p.close_date < today);

const formatDate = (d: string | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '';

const pageData = {
  schoolPrograms,
  contacts,
  openPeriods,
  upcomingPeriods,
  closedPeriods,
  allPeriods,
  formatDate,
  prefix: '/' + school.slug,
};
---

<Layout school={school} title="Admissions">
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  <div class="px-4 py-16">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl font-extrabold mb-4" style="color:var(--text)">Admissions</h1>
        <p class="text-lg mb-10" style="color:var(--muted)">Begin your journey with {school.name}. Explore our open admission periods below.</p>

        {/* Open Admission Periods */}
        {openPeriods.length > 0 ? (
          <div class="mb-12">
            <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Now Open</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {openPeriods.map((p: any) => (
                <div class="rounded-2xl border p-6" style="background:var(--surface);border-color:var(--border)">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full text-white" style="background:var(--primary)">Open</span>
                    <span class="text-xs" style="color:var(--muted)">AY {p.academic_year}</span>
                  </div>
                  <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.title}</h3>
                  {p.description && <p class="text-sm mb-3 line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                  <div class="text-xs space-y-1 mb-4" style="color:var(--muted)">
                    <p>Closes: <strong style="color:var(--text)">{formatDate(p.close_date)}</strong></p>
                    {p.available_seats && <p>Available seats: <strong style="color:var(--text)">{p.available_seats}</strong></p>}
                    {p.eligible_grades && <p>Eligible: <strong style="color:var(--text)">{p.eligible_grades}</strong></p>}
                  </div>
                  <div class="flex gap-2">
                    <a href={`/${school.slug}/admissions/${p.slug || p.id}`} class="flex-1 text-center px-4 py-2 text-sm font-semibold text-white rounded-lg" style="background:var(--primary)">View Details</a>
                    <a href={`/${school.slug}/admissions/${p.slug || p.id}/apply`} class="flex-1 text-center px-4 py-2 text-sm font-semibold rounded-lg border" style="border-color:var(--primary);color:var(--primary)">Apply Now</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="rounded-2xl border p-8 mb-12 text-center" style="background:var(--surface);border-color:var(--border)">
            <p class="text-lg font-semibold mb-2" style="color:var(--text)">No admissions currently open</p>
            <p class="text-sm" style="color:var(--muted)">Please check back later or contact us for more information.</p>
          </div>
        )}

        {/* Upcoming Periods */}
        {upcomingPeriods.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Upcoming</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {upcomingPeriods.map((p: any) => (
                <div class="rounded-2xl border p-6" style="background:var(--surface);border-color:var(--border)">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full" style="background:color-mix(in srgb, var(--primary) 10%, transparent);color:var(--primary)">Upcoming</span>
                    <span class="text-xs" style="color:var(--muted)">AY {p.academic_year}</span>
                  </div>
                  <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.title}</h3>
                  {p.description && <p class="text-sm mb-3 line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                  <p class="text-xs mb-4" style="color:var(--muted)">Opens: <strong style="color:var(--text)">{formatDate(p.open_date)}</strong></p>
                  <a href={`/${school.slug}/admissions/${p.slug || p.id}`} class="inline-block text-sm font-semibold hover:underline" style="color:var(--primary)">View Details</a>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Process Steps (generic) */}
        <div class="mb-12">
          <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Admission Process</h2>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="rounded-2xl border p-6 text-center" style="background:var(--surface);border-color:var(--border)">
              <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg" style="background:var(--primary)">1</div>
              <h3 class="font-bold mb-2 text-sm" style="color:var(--text)">Submit Application</h3>
              <p class="text-xs" style="color:var(--muted)">Complete the online application form with student and family information.</p>
            </div>
            <div class="rounded-2xl border p-6 text-center" style="background:var(--surface);border-color:var(--border)">
              <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg" style="background:var(--primary)">2</div>
              <h3 class="font-bold mb-2 text-sm" style="color:var(--text)">Assessment</h3>
              <p class="text-xs" style="color:var(--muted)">Student assessment in reading, math, and age-appropriate skills.</p>
            </div>
            <div class="rounded-2xl border p-6 text-center" style="background:var(--surface);border-color:var(--border)">
              <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg" style="background:var(--primary)">3</div>
              <h3 class="font-bold mb-2 text-sm" style="color:var(--text)">Family Interview</h3>
              <p class="text-xs" style="color:var(--muted)">Meet with our admissions team to discuss goals and expectations.</p>
            </div>
            <div class="rounded-2xl border p-6 text-center" style="background:var(--surface);border-color:var(--border)">
              <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-lg" style="background:var(--primary)">4</div>
              <h3 class="font-bold mb-2 text-sm" style="color:var(--text)">Decision</h3>
              <p class="text-xs" style="color:var(--muted)">Receive admission decision within 2 weeks of completing the process.</p>
            </div>
          </div>
        </div>

        {/* Contact CTA */}
        <div class="rounded-2xl p-8 text-center text-white" style="background:var(--primary)">
          <h2 class="text-2xl font-bold mb-3">Have Questions?</h2>
          <p class="mb-6 opacity-90">Our admissions team is here to help. Contact us for more information.</p>
          <a href={`/${school.slug}/contact`} class="inline-block bg-white px-8 py-3 rounded-full font-semibold hover:scale-105 transition-transform" style="color:var(--primary)">Contact Us</a>
        </div>
      </div>
    </div>
</Layout>
