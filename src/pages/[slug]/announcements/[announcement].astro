---
import { getV3Theme, getThemeLayout, themeList } from '../../../themes/index.js';
import { getSchoolBySlug, getSchoolAnnouncementBySlug, getSchoolAnnouncements } from '../../../lib/school-safe.ts';

const slug = Astro.params.slug!;

const school = getSchoolBySlug(slug);
if (!school) return Astro.redirect('/404');

const previewTheme = Astro.url.searchParams.get('preview_theme');
const user = Astro.locals.user;
const isPreviewing = previewTheme && themeList.includes(previewTheme) && user;
const activeTheme = isPreviewing ? previewTheme : (school.theme || 'aurora');

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.AnnouncementDetailPage;

const announcementSlug = Astro.params.announcement!;
const item = getSchoolAnnouncementBySlug(school.id, announcementSlug);
if (!item) return Astro.redirect('/404');

// Try to fetch related items for engagement features
const relatedAnnouncements = getSchoolAnnouncements(school.id, 5).filter(a => a.id !== item.id).slice(0, 3);
const pageData = { item, related: relatedAnnouncements };
---
<Layout school={school} title={PageComponent ? '' : (item.title || 'Announcement')}>
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  {PageComponent ? (
    <PageComponent school={school} {...pageData} />
  ) : (
    <div class="px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-8" style="color:var(--text)">{item.title || 'Announcement'}</h1>
        <p class="text-[var(--muted)]">Announcement details are not available for this theme.</p>
      </div>
    </div>
  )}
</Layout>
