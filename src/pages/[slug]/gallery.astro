---
import { getV3Theme, getThemeLayout, themeList } from '../../themes/index.js';
import { getSchoolBySlug, getSchoolGallery, getSchoolGalleryAlbums, getSchoolVirtualTours } from '../../lib/school-safe.ts';
import { schoolStaticPaths } from '../../lib/prerender-data.ts';

export async function getStaticPaths() {
  return await schoolStaticPaths('school');
}

const slug = Astro.params.slug!;

const school = getSchoolBySlug(slug);

const previewTheme = null; // theme preview was an authenticated SSR feature; static pages use the saved theme
const isPreviewing = false;
const activeTheme = school.theme || 'aurora';

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.GalleryPage;

const galleryItems = getSchoolGallery(school.id);
const galleryAlbums = getSchoolGalleryAlbums(school.id);
const virtualTours = getSchoolVirtualTours(school.id);

// Extract unique categories for filtering
const categories = [...new Set(galleryItems.map((g: any) => g.category || 'General').filter(Boolean))];

const pageData = { items: galleryItems, albums: galleryAlbums, virtualTours, categories };
---
<Layout school={school} title={PageComponent ? "" : "Gallery"}>
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  {PageComponent ? (
    <PageComponent school={school} {...pageData} />
  ) : (
    <div class="px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-[var(--text)] mb-8">Gallery</h1>
        <p class="text-[var(--muted)]">This page uses a legacy theme. Please switch to a v3 theme for full page autonomy.</p>
      </div>
    </div>
  )}
</Layout>
