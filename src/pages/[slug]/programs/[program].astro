---
import { getV3Theme, getThemeLayout, themeList } from '../../../themes/index.js';
import { getSchoolBySlug, getSchoolProgramBySlug, getSchoolPrograms } from '../../../lib/school-safe.ts';
import { schoolStaticPaths } from '../../../lib/prerender-data.ts';

export async function getStaticPaths() {
  return await schoolStaticPaths('programs');
}

const slug = Astro.params.slug!;

const school = getSchoolBySlug(slug);

const previewTheme = null; // theme preview was an authenticated SSR feature; static pages use the saved theme
const isPreviewing = false;
const activeTheme = school.theme || 'aurora';

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.ProgramDetailPage;

const programSlug = Astro.params.program!;
const item = getSchoolProgramBySlug(school.id, programSlug);

const relatedPrograms = getSchoolPrograms(school.id).filter(p => p.id !== item.id).slice(0, 3);
const pageData = { item, related: relatedPrograms };
---
<Layout school={school} title={PageComponent ? '' : (item.name || item.title || 'Program')}>
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  {PageComponent ? (
    <PageComponent school={school} {...pageData} />
  ) : (
    <div class="px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-8" style="color:var(--text)">{item.name || item.title || 'Program'}</h1>
        <p class="text-[var(--muted)]">Program details are not available for this theme.</p>
      </div>
    </div>
  )}
</Layout>
