---
import { getV3Theme, getThemeLayout, themeList } from '../../themes/index.js';
import { getSchoolBySlug, getSchoolClasses } from '../../lib/school-safe.ts';

const slug = Astro.params.slug!;

const school = getSchoolBySlug(slug);
if (!school) return Astro.redirect('/404');

const previewTheme = Astro.url.searchParams.get('preview_theme');
const user = Astro.locals.user;
const isPreviewing = previewTheme && themeList.includes(previewTheme) && user;
const activeTheme = isPreviewing ? previewTheme : (school.theme || 'aurora');

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.ClassesPage;

// Search/filter/sort params
const search = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const sort = Astro.url.searchParams.get('sort') || 'newest';

let schoolClasses = getSchoolClasses(school.id);

// Apply search
if (search) {
  schoolClasses = schoolClasses.filter((c: any) =>
    (c.name || '').toLowerCase().includes(search) ||
    (c.description || '').toLowerCase().includes(search) ||
    (c.gradeLevel || c.grade_level || '').toLowerCase().includes(search) ||
    (c.teacherName || c.teacher_name || '').toLowerCase().includes(search)
  );
}

// Apply sort
if (sort === 'title') {
  schoolClasses = schoolClasses.slice().sort((a: any, b: any) => (a.name || '').localeCompare(b.name || ''));
} else if (sort === 'grade') {
  schoolClasses = schoolClasses.slice().sort((a: any, b: any) => (a.gradeLevel || a.grade_level || '').localeCompare(b.gradeLevel || b.grade_level || ''));
}

const pageData = { items: schoolClasses, search, sort, total: schoolClasses.length };
---
<Layout school={school} title={PageComponent ? "" : "Classes"}>
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  {PageComponent ? (
    <PageComponent school={school} {...pageData} />
  ) : (
    <div class="px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-[var(--text)] mb-8">Classes</h1>
        <p class="text-[var(--muted)]">This page uses a legacy theme. Please switch to a v3 theme for full page autonomy.</p>
      </div>
    </div>
  )}
</Layout>
