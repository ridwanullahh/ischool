---
import { getV3Theme, getThemeLayout, themeList } from '../../themes/index.js';
import { getSchoolBySlug, getSchoolAbout, getSchoolAnnouncements, getSchoolPosts, getSchoolPrograms } from '../../lib/school-safe.ts';

const slug = Astro.params.slug!;
const school = getSchoolBySlug(slug);
if (!school) return Astro.redirect('/404');

const previewTheme = Astro.url.searchParams.get('preview_theme');
const user = Astro.locals.user;
const isPreviewing = previewTheme && themeList.includes(previewTheme) && user;
const activeTheme = isPreviewing ? previewTheme : (school.theme || 'aurora');

const about = getSchoolAbout(school.id);
// getSchoolAbout() already parses JSON columns via parseJsonCol.
// Use the arrays directly; only parse if they're still strings (legacy data).
let features: Array<{ title: string; description: string }> = [];
let stats: Array<{ label: string; value: string }> = [];
if (Array.isArray(about?.features)) features = about.features;
else if (typeof about?.features === 'string') { try { features = JSON.parse(about.features); } catch { features = []; } }
if (Array.isArray(about?.stats)) stats = about.stats;
else if (typeof about?.stats === 'string') { try { stats = JSON.parse(about.stats); } catch { stats = []; } }

const recentAnnouncements = getSchoolAnnouncements(school.id, 3);
const recentPosts = getSchoolPosts(school.id, 3);
const schoolPrograms = getSchoolPrograms(school.id);

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const HomePage = v3Theme?.HomePage;
---

<Layout school={school}>
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100] flex items-center justify-center gap-4">
      <span>Previewing <strong>{previewTheme}</strong> theme</span>
      <form method="POST" action="/api/dashboard/settings" class="inline">
        <input type="hidden" name="name" value={school.name} />
        <input type="hidden" name="slug" value={school.slug} />
        <input type="hidden" name="primaryColor" value={school.primaryColor || '#2563eb'} />
        <input type="hidden" name="theme" value={previewTheme} />
        <input type="hidden" name="tagline" value={school.tagline || ''} />
        <input type="hidden" name="logoUrl" value={school.logoUrl || ''} />
        <input type="hidden" name="faviconUrl" value={school.faviconUrl || ''} />
        <button type="submit" class="bg-white text-blue-600 px-3 py-1 rounded font-bold text-xs hover:bg-blue-50">Apply</button>
      </form>
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200">Close</a>
    </div>
  )}
  {HomePage ? (
    <HomePage
      school={school}
      about={about}
      features={features}
      stats={stats}
      recentAnnouncements={recentAnnouncements}
      recentPosts={recentPosts}
      schoolPrograms={schoolPrograms}
    />
  ) : (
    <section class="relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-36">
        <div class="max-w-3xl">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight" style="color:var(--text)">{school.name}</h1>
          {school.tagline && <p class="mt-4 text-xl leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href={`/${slug}/admissions`} class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white rounded-xl" style="background:var(--primary)">Apply for Admission</a>
            <a href={`/${slug}/about`} class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold rounded-xl border" style="border-color:var(--border);background:var(--surface);color:var(--text)">Learn More</a>
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>
