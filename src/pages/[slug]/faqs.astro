---
import { getV3Theme, getThemeLayout, themeList } from '../../themes/index.js';
import { getDb } from '../../lib/db/index.js';
import { schools } from '../../lib/db/schema.js';
import { eq, desc, and } from 'drizzle-orm';

const slug = Astro.params.slug!;
const db = getDb();
const school = db.select().from(schools).where(eq(schools.slug, slug)).get();
if (!school) return Astro.redirect('/404');

const previewTheme = Astro.url.searchParams.get('preview_theme');
const user = Astro.locals.user;
const isPreviewing = previewTheme && themeList.includes(previewTheme) && user;
const activeTheme = isPreviewing ? previewTheme : (school.theme || 'aurora');

const v3Theme = getV3Theme(activeTheme);
const Layout = v3Theme?.Layout || getThemeLayout(activeTheme);
const PageComponent = v3Theme?.FaqsPage;
import { faqs } from '../../lib/db/schema.js';
const schoolFaqs = db.select().from(faqs).where(eq(faqs.schoolId, school.id)).all();
const pageData = { items: schoolFaqs };
---
<Layout school={school} title="{PageComponent ? '' : 'Faqs'}">
  {isPreviewing && (
    <div class="bg-blue-600 text-white py-2 px-4 text-center text-sm font-medium sticky top-0 z-[100]">
      Previewing <strong>{previewTheme}</strong> theme
      <a href={`/${slug}`} class="underline text-xs hover:text-blue-200 ml-2">Close</a>
    </div>
  )}
  {PageComponent ? (
    <PageComponent school={school} {...pageData} />
  ) : (
    <div class="px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-[var(--text)] mb-8">Faqs</h1>
        <p class="text-[var(--muted)]">This page uses a legacy theme. Please switch to a v3 theme for full page autonomy.</p>
      </div>
    </div>
  )}
</Layout>
