---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { platformList } from '../../lib/prerender-data.ts';

export async function getStaticPaths() {
  const docs = await platformList('platform_docs', { field: 'is_published', op: 'eq', value: true });
  return docs.filter((d) => d.slug).map((d) => ({ params: { slug: d.slug }, props: { doc: d, allDocs: docs } }));
}

const { doc, allDocs } = Astro.props;

const categories = [...new Set((allDocs || []).map((d: any) => d.category || 'Getting Started'))];

// Defensive field access
const docTitle: string = doc.title || 'Untitled Document';
const docExcerpt: string = doc.excerpt || '';
const docCategory: string = doc.category || 'Documentation';
const docContent: string = typeof doc.content === 'string' ? doc.content : String(doc.content || '');
const docSlug: string = doc.slug || '';
---

<MarketingLayout title={`${docTitle} - iSchool Docs`}>
  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/docs" class="text-sm text-primary-600 hover:underline mb-4 inline-block">&larr; Back to Documentation</a>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <aside class="lg:col-span-1">
          <nav class="space-y-6">
            {categories.map(cat => (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">{cat}</h3>
                <div class="space-y-1">
                  {allDocs.filter(d => (d.category || 'Getting Started') === cat).map(d => (
                    <a
                      href={`/docs/${d.slug}`}
                      class:list={[
                        'block px-3 py-2 text-sm rounded-lg transition-colors',
                        d.slug === docSlug ? 'bg-primary-50 text-primary-700 font-medium' : 'text-gray-700 hover:bg-gray-100'
                      ]}
                    >
                      {d.title}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </nav>
        </aside>

        <article class="lg:col-span-3">
          <header class="mb-8">
            <span class="text-sm font-medium bg-primary-50 text-primary-700 px-3 py-1 rounded-full">{docCategory}</span>
            <h1 class="text-3xl font-bold text-gray-900 mt-4">{docTitle}</h1>
            {docExcerpt && <p class="mt-3 text-lg text-gray-600">{docExcerpt}</p>}
          </header>

          <div class="prose prose-gray max-w-none">
            {docContent.split('\n').map(para => para.trim()).filter(Boolean).map(para => (
              <p class="text-gray-700 leading-relaxed mb-4">{para}</p>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>
