---
/**
 * Parent Portal - Fees
 *
 * Shows all invoices and payments across all linked children.
 */
import ParentPortalLayout from '../../../layouts/ParentPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { invoices, payments, students } from '../../../lib/db/schema.js';
import { eq, and, desc, inArray, sql } from 'drizzle-orm';
import { getChildrenForParent } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/parent/fees');

const children = getChildrenForParent(user.id);
const db = getDb();

const childIds = children.map(c => c.id);
const childMap = new Map(children.map(c => [c.id, c]));

const allInvoices = childIds.length > 0
  ? await db.select().from(invoices).where(inArray(invoices.studentId, childIds)).orderBy(desc(invoices.issuedAt)).all()
  : [];

const allPayments = childIds.length > 0
  ? await db.select().from(payments).where(inArray(payments.invoiceId, allInvoices.map(i => i.id))).orderBy(desc(payments.paidAt)).all()
  : [];

const totalBilled = allInvoices.reduce((s, i) => s + (i.amount || 0), 0);
const totalPaid = allInvoices.reduce((s, i) => s + (i.amountPaid || 0), 0);
const outstanding = allInvoices.reduce((s, i) => s + (i.balance || 0), 0);

const formatCurrency = (n: number | null) => n == null ? '0' : n.toLocaleString();
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const statusColors: Record<string, string> = { paid: 'bg-green-100 text-green-700', partial: 'bg-amber-100 text-amber-700', unpaid: 'bg-red-100 text-red-700', overdue: 'bg-red-100 text-red-700', draft: 'bg-gray-100 text-gray-500' };
---

<ParentPortalLayout title="Fees - Parent Portal">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Fees & Payments</h1>
      <p class="text-sm text-gray-500 mt-1">View invoices and payment history for all your children</p>
    </div>

    {/* Summary */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Billed</p>
        <p class="text-2xl font-bold text-gray-900 mt-2">{formatCurrency(totalBilled)}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Paid</p>
        <p class="text-2xl font-bold text-green-600 mt-2">{formatCurrency(totalPaid)}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Outstanding</p>
        <p class:list={["text-2xl font-bold mt-2", outstanding > 0 ? 'text-red-600' : 'text-green-600']}>{formatCurrency(outstanding)}</p>
      </div>
    </div>

    {/* Invoices */}
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Invoices</h2>
      {allInvoices.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b">
              <tr>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Child</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Invoice #</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Description</th>
                <th class="text-left py-2 px-3 font-medium text-gray-700">Issued</th>
                <th class="text-right py-2 px-3 font-medium text-gray-700">Amount</th>
                <th class="text-right py-2 px-3 font-medium text-gray-700">Balance</th>
                <th class="text-center py-2 px-3 font-medium text-gray-700">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {allInvoices.map(inv => {
                const child = childMap.get(inv.studentId);
                return (
                  <tr class="hover:bg-gray-50">
                    <td class="py-2.5 px-3 text-gray-900">{child ? `${child.firstName} ${child.lastName}` : '-'}</td>
                    <td class="py-2.5 px-3 font-mono text-xs text-gray-700">{inv.invoiceNumber || `INV-${inv.id}`}</td>
                    <td class="py-2.5 px-3 text-gray-900">{inv.description || 'Tuition Fee'}</td>
                    <td class="py-2.5 px-3 text-gray-500 text-xs">{formatDate(inv.issuedAt)}</td>
                    <td class="py-2.5 px-3 text-right text-gray-900">{formatCurrency(inv.amount)}</td>
                    <td class="py-2.5 px-3 text-right font-bold text-gray-900">{formatCurrency(inv.balance)}</td>
                    <td class="py-2.5 px-3 text-center">
                      <span class:list={["inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase", statusColors[inv.status] || 'bg-gray-100 text-gray-500']}>{inv.status}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-sm text-gray-500 py-8 text-center">No invoices yet.</p>
      )}
    </div>

    {/* Payment history */}
    {allPayments.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Payment History</h2>
        <div class="space-y-2">
          {allPayments.map(p => {
            const inv = allInvoices.find(i => i.id === p.invoiceId);
            const child = inv ? childMap.get(inv.studentId) : null;
            return (
              <div class="flex items-center justify-between p-3 rounded-lg bg-gray-50">
                <div>
                  <p class="text-sm font-medium text-gray-900">{formatCurrency(p.amount)}</p>
                  <p class="text-xs text-gray-500">{child ? `${child.firstName} ${child.lastName} - ` : ''}{formatDate(p.paidAt)} via {p.method}</p>
                </div>
                <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-700 uppercase">{p.status}</span>
              </div>
            );
          })}
        </div>
      </div>
    )}
  </div>
</ParentPortalLayout>
