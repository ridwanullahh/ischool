---
/**
 * Parent Portal - Messages
 *
 * Allows parents to message their children's teachers directly.
 */
import ParentPortalLayout from '../../../layouts/ParentPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { messages, schoolMembers, users, staff, students, enrollments, classes } from '../../../lib/db/schema.js';
import { eq, and, desc, or, inArray } from 'drizzle-orm';
import { getChildrenForParent } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/parent/messages');

const children = getChildrenForParent(user.id);
const db = getDb();

// Get teachers of the parent's children (via enrollments -> classes -> teacher assignments)
const childIds = children.map(c => c.id);
const childEnrollments = childIds.length > 0
  ? db.select().from(enrollments).where(inArray(enrollments.studentId, childIds)).all()
  : [];
const classIds = [...new Set(childEnrollments.map(e => e.classId).filter(Boolean))];

// Get staff members who teach these classes (via timetable entries or class teacher field)
// For now, get all teachers in the school
const schoolId = children[0]?.schoolId;
const teachers = schoolId
  ? db.select({
      id: users.id, name: users.name, email: users.email,
      staffRole: staff.role, staffId: staff.id,
    }).from(staff)
    .leftJoin(users, eq(staff.userId, users.id))
    .where(and(eq(staff.schoolId, schoolId), inArray(staff.role, ['teacher', 'head_teacher', 'principal'])))
    .all()
  : [];

// Get messages between this parent and any teacher
const myMessages = db.select().from(messages)
  .where(or(eq(messages.senderId, user.id), eq(messages.receiverId, user.id)))
  .orderBy(desc(messages.sentAt)).limit(50).all();

// Group by conversation partner
const conversations: Record<number, { partner: any, lastMessage: any, unread: number }> = {};
for (const msg of myMessages) {
  const partnerId = msg.senderId === user.id ? msg.receiverId : msg.senderId;
  if (!conversations[partnerId]) {
    const partner = db.select().from(users).where(eq(users.id, partnerId)).get();
    conversations[partnerId] = { partner, lastMessage: msg, unread: 0 };
  }
  if (msg.receiverId === user.id && !msg.readAt) {
    conversations[partnerId].unread++;
  }
  if (new Date(msg.sentAt) > new Date(conversations[partnerId].lastMessage.sentAt)) {
    conversations[partnerId].lastMessage = msg;
  }
}

const conversationList = Object.entries(conversations).map(([pid, data]) => ({ partnerId: parseInt(pid), ...data }))
  .sort((a, b) => new Date(b.lastMessage.sentAt).getTime() - new Date(a.lastMessage.sentAt).getTime());

const formatTime = (d: string | Date | null) => {
  if (!d) return '';
  try {
    const date = new Date(d);
    const now = new Date();
    if (date.toDateString() === now.toDateString()) return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch { return ''; }
};
---

<ParentPortalLayout title="Messages - Parent Portal">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Messages</h1>
      <p class="text-sm text-gray-500 mt-1">Communicate with your children's teachers</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {/* Teachers list */}
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h2 class="text-sm font-semibold text-gray-900 mb-3">Teachers</h2>
        {teachers.length > 0 ? (
          <div class="space-y-2">
            {teachers.map(t => (
              <button onclick={`startConversation(${t.id})`} class="w-full flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 text-left">
                <div class="w-9 h-9 rounded-full bg-primary-100 flex items-center justify-center text-sm font-bold text-primary-700">
                  {t.name.charAt(0)}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">{t.name}</p>
                  <p class="text-xs text-gray-500 capitalize">{t.staffRole || 'Teacher'}</p>
                </div>
              </button>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-4 text-center">No teachers found.</p>
        )}
      </div>

      {/* Conversations */}
      <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 p-5">
        <h2 class="text-sm font-semibold text-gray-900 mb-3">Recent Conversations</h2>
        {conversationList.length > 0 ? (
          <div class="space-y-2">
            {conversationList.map(conv => (
              <a href={`/portal/parent/messages/chat?to=${conv.partnerId}`} class="block p-3 rounded-lg border border-gray-100 hover:border-primary-200 hover:bg-primary-50/30">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-600">
                      {conv.partner.name.charAt(0)}
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-gray-900 truncate">{conv.partner.name}</p>
                      <p class="text-xs text-gray-500 truncate">{conv.lastMessage.content || '(no message)'}</p>
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="text-xs text-gray-400">{formatTime(conv.lastMessage.sentAt)}</p>
                    {conv.unread > 0 && (
                      <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary-600 text-white text-[10px] font-bold mt-1">{conv.unread}</span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="py-8 text-center">
            <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <p class="text-sm text-gray-500 mt-2">No conversations yet. Select a teacher to start messaging.</p>
          </div>
        )}
      </div>
    </div>
  </div>

  <script is:inline>
    function startConversation(teacherId) {
      window.location.href = `/portal/parent/messages/chat?to=${teacherId}`;
    }
  </script>
</ParentPortalLayout>
