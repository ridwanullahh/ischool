---
/**
 * Parent Portal - Dashboard
 *
 * Shows overview of all linked children with quick stats (attendance,
 * pending assignments, outstanding fees) and links to each child's detail.
 */
import ParentPortalLayout from '../../../layouts/ParentPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { attendance, assignments, submissions, invoices, students } from '../../../lib/db/schema.js';
import { eq, and, sql, desc } from 'drizzle-orm';
import { getChildrenForParent, getUserSchoolId, getStudentClassName } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/parent');

const children = getChildrenForParent(user.id);
const schoolId = getUserSchoolId(user.id);
const db = getDb();

// Build per-child summary
const allAttendance = await db.select().from(attendance).all();
const allAssignments = schoolId ? await db.select().from(assignments).where(eq(assignments.schoolId, schoolId)).all() : [];
const allSubmissions = await db.select().from(submissions).all();
const allInvoices = await db.select().from(invoices).all();

const childSummaries = children.map(child => {
  const childAttendance = allAttendance.filter(a => a.studentId === child.id);
  const totalDays = childAttendance.length;
  const presentDays = childAttendance.filter(a => a.status === 'present').length;
  const attendanceRate = totalDays > 0 ? Math.round((presentDays / totalDays) * 100) : 100;

  const submittedIds = new Set(allSubmissions.filter(s => s.studentId === child.id).map(s => s.assignmentId));
  const pendingAssignments = allAssignments.filter(a => a.dueDate && new Date(a.dueDate) >= new Date()).length;
  const overdueAssignments = allAssignments.filter(a => a.dueDate && new Date(a.dueDate) < new Date() && !submittedIds.has(a.id)).length;

  const outstandingInvoices = allInvoices.filter(i => i.studentId === child.id && i.status !== 'paid');
  const outstandingFees = outstandingInvoices.reduce((s, i) => s + (i.balance || 0), 0);

  const className = getStudentClassName(child.id);

  return { child, attendanceRate, pendingAssignments, overdueAssignments, outstandingFees, className };
});
---

<ParentPortalLayout title="Dashboard - Parent Portal">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Welcome, {user.name}</h1>
      <p class="text-sm text-gray-500 mt-1">Overview of your {children.length === 1 ? 'child' : 'children'}'s progress</p>
    </div>

    {children.length > 0 ? (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {childSummaries.map(({ child, attendanceRate, pendingAssignments, overdueAssignments, outstandingFees, className }) => (
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            {/* Child header */}
            <div class="bg-gradient-to-r from-primary-600 to-primary-700 p-5 text-white">
              <div class="flex items-center gap-4">
                {child.photoUrl ? (
                  <img src={child.photoUrl} alt={child.firstName} class="w-14 h-14 rounded-full border-2 border-white/30 object-cover" />
                ) : (
                  <div class="w-14 h-14 rounded-full bg-white/20 flex items-center justify-center text-xl font-bold">
                    {child.firstName.charAt(0)}{child.lastName.charAt(0)}
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h2 class="text-lg font-bold">{child.firstName} {child.lastName}</h2>
                  {className && <p class="text-sm text-primary-100">{className}</p>}
                  <p class="text-xs text-primary-200">ID: {child.studentId}</p>
                </div>
                <a href={`/portal/parent/child/${child.id}`} class="shrink-0 px-3 py-1.5 text-xs font-medium bg-white/20 rounded-lg hover:bg-white/30">
                  View Details
                </a>
              </div>
            </div>

            {/* Quick stats */}
            <div class="p-5 grid grid-cols-3 gap-4">
              <div class="text-center">
                <p class="text-xs text-gray-500 uppercase tracking-wider">Attendance</p>
                <p class:list={["text-xl font-bold mt-1", attendanceRate >= 80 ? 'text-green-600' : attendanceRate >= 60 ? 'text-amber-600' : 'text-red-600']}>{attendanceRate}%</p>
              </div>
              <div class="text-center">
                <p class="text-xs text-gray-500 uppercase tracking-wider">Pending</p>
                <p class="text-xl font-bold text-amber-600 mt-1">{pendingAssignments}</p>
              </div>
              <div class="text-center">
                <p class="text-xs text-gray-500 uppercase tracking-wider">Fees Due</p>
                <p class:list={["text-xl font-bold mt-1", outstandingFees > 0 ? 'text-red-600' : 'text-green-600']}>{outstandingFees > 0 ? outstandingFees.toLocaleString() : '0'}</p>
              </div>
            </div>

            {overdueAssignments > 0 && (
              <div class="px-5 pb-4">
                <div class="p-3 bg-red-50 border border-red-100 rounded-lg">
                  <p class="text-xs text-red-700"><strong>{overdueAssignments}</strong> overdue assignment{overdueAssignments !== 1 ? 's' : ''} - please follow up.</p>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <p class="text-sm text-gray-500 mt-2">No children are linked to your account yet.</p>
        <p class="text-xs text-gray-400 mt-1">Please contact the school administrator to link your child's profile.</p>
      </div>
    )}
  </div>
</ParentPortalLayout>
