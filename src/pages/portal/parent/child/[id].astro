---
/**
 * Parent Portal - Child Detail
 *
 * Shows a single child's detailed overview: attendance, recent grades,
 * pending assignments, and fee summary.
 */
import ParentPortalLayout from '../../../../layouts/ParentPortalLayout.astro';
import { getDb } from '../../../../lib/db/index.js';
import { students, attendance, grades, assignments, submissions, invoices } from '../../../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';
import { getChildrenForParent, getStudentClassName } from '../../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

const childId = parseInt(Astro.params.id);
if (!childId) return Astro.redirect('/portal/parent');

// Verify this child belongs to the parent
const children = getChildrenForParent(user.id);
const child = children.find(c => c.id === childId);
if (!child) {
  return Astro.redirect('/portal/parent');
}

const db = getDb();

// Attendance
const totalDays = db.select({ c: sql<number>`count(*)` }).from(attendance).where(eq(attendance.studentId, child.id)).get()?.c || 0;
const presentDays = db.select({ c: sql<number>`count(*)` }).from(attendance).where(and(eq(attendance.studentId, child.id), eq(attendance.status, 'present'))).get()?.c || 0;
const attendanceRate = totalDays > 0 ? Math.round((presentDays / totalDays) * 100) : 100;
const recentAttendance = db.select().from(attendance).where(eq(attendance.studentId, child.id)).orderBy(desc(attendance.date)).limit(10).all();

// Grades
const recentGrades = db.select().from(grades).where(eq(grades.studentId, child.id)).orderBy(desc(grades.createdAt)).limit(10).all();

// Assignments
const submittedIds = new Set(db.select().from(submissions).where(eq(submissions.studentId, child.id)).all().map(s => s.assignmentId));
const pendingAssignments = db.select().from(assignments)
  .where(and(eq(assignments.schoolId, child.schoolId), sql`${assignments.dueDate} >= date('now')`))
  .orderBy(assignments.dueDate).limit(5).all()
  .filter(a => !submittedIds.has(a.id));

// Fees
const outstandingInvoices = db.select().from(invoices).where(and(eq(invoices.studentId, child.id), sql`${invoices.status} != 'paid'`)).all();
const outstandingFees = outstandingInvoices.reduce((s, i) => s + (i.balance || 0), 0);

const className = getStudentClassName(child.id);
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const statusColors: Record<string, string> = { present: 'bg-green-100 text-green-700', absent: 'bg-red-100 text-red-700', late: 'bg-amber-100 text-amber-700', excused: 'bg-blue-100 text-blue-700' };
---

<ParentPortalLayout title={`${child.firstName} ${child.lastName} - Parent Portal`}>
  <div class="space-y-6">
    <!-- Back link + header -->
    <div>
      <a href="/portal/parent" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700 mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back to Overview
      </a>
      <div class="flex items-center gap-4">
        {child.photoUrl ? (
          <img src={child.photoUrl} alt={child.firstName} class="w-16 h-16 rounded-full object-cover" />
        ) : (
          <div class="w-16 h-16 rounded-full bg-primary-100 flex items-center justify-center text-xl font-bold text-primary-700">
            {child.firstName.charAt(0)}{child.lastName.charAt(0)}
          </div>
        )}
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{child.firstName} {child.lastName}</h1>
          {className && <p class="text-sm text-gray-500">{className}</p>}
          <p class="text-xs text-gray-400">Student ID: {child.studentId}</p>
        </div>
      </div>
    </div>

    {/* Stats grid */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Attendance</p>
        <p class:list={["text-2xl font-bold mt-2", attendanceRate >= 80 ? 'text-green-600' : attendanceRate >= 60 ? 'text-amber-600' : 'text-red-600']}>{attendanceRate}%</p>
        <p class="text-xs text-gray-500 mt-1">{presentDays}/{totalDays} days</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Pending</p>
        <p class="text-2xl font-bold text-amber-600 mt-2">{pendingAssignments.length}</p>
        <p class="text-xs text-gray-500 mt-1">Assignments due</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Recent Grades</p>
        <p class="text-2xl font-bold text-blue-600 mt-2">{recentGrades.length}</p>
        <p class="text-xs text-gray-500 mt-1">Assessments graded</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Fees Due</p>
        <p class:list={["text-2xl font-bold mt-2", outstandingFees > 0 ? 'text-red-600' : 'text-green-600']}>{outstandingFees > 0 ? outstandingFees.toLocaleString() : '0'}</p>
        <p class="text-xs text-gray-500 mt-1">{outstandingInvoices.length} invoice{outstandingInvoices.length !== 1 ? 's' : ''}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {/* Recent attendance */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Recent Attendance</h2>
        {recentAttendance.length > 0 ? (
          <div class="space-y-2">
            {recentAttendance.map(r => (
              <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50">
                <span class="text-sm text-gray-700">{formatDate(r.date)}</span>
                <span class:list={["inline-flex px-2 py-0.5 rounded-full text-xs font-bold capitalize", statusColors[r.status] || 'bg-gray-100 text-gray-700']}>{r.status}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No attendance records.</p>
        )}
      </div>

      {/* Recent grades */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Recent Grades</h2>
        {recentGrades.length > 0 ? (
          <div class="space-y-2">
            {recentGrades.map(g => (
              <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">{g.assignmentTitle || g.examTitle || 'Assessment'}</p>
                  <p class="text-xs text-gray-500">{formatDate(g.createdAt)}</p>
                </div>
                <span class="text-sm font-bold text-gray-900">{g.score != null ? `${g.score}${g.maxScore ? `/${g.maxScore}` : ''}` : '-'}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No grades published yet.</p>
        )}
      </div>
    </div>

    {/* Pending assignments */}
    {pendingAssignments.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Pending Assignments</h2>
        <div class="space-y-2">
          {pendingAssignments.map(a => (
            <div class="flex items-center justify-between p-3 rounded-lg border border-gray-100">
              <div>
                <p class="text-sm font-medium text-gray-900">{a.title}</p>
                <p class="text-xs text-gray-500">Due: {formatDate(a.dueDate)}</p>
              </div>
              {a.dueDate && new Date(a.dueDate) < new Date(Date.now() + 3 * 24 * 60 * 60 * 1000) && (
                <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700">DUE SOON</span>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</ParentPortalLayout>
