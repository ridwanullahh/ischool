---
/**
 * Student Portal Dashboard
 *
 * Shows the student's at-a-glance overview: today's schedule, pending
 * assignments, recent grades, attendance rate, and outstanding fees.
 */
import StudentPortalLayout from '../../../layouts/StudentPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { students, attendance, assignments, submissions, grades, courses, invoices, timetableEntries, classes, quizAttempts, quizzes } from '../../../lib/db/schema.js';
import { eq, and, desc, sql } from 'drizzle-orm';
import { getStudentForUser, getUserSchoolId } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/student');

const student = getStudentForUser(user.id);
if (!student) {
  return Astro.redirect('/portal/no-profile');
}
const schoolId = getUserSchoolId(user.id) ?? student.schoolId;
const db = getDb();

// Attendance rate
const totalDays = db.select({ c: sql<number>`count(*)` }).from(attendance).where(eq(attendance.studentId, student.id)).get()?.c || 0;
const presentDays = db.select({ c: sql<number>`count(*)` }).from(attendance).where(and(eq(attendance.studentId, student.id), eq(attendance.status, 'present'))).get()?.c || 0;
const attendanceRate = totalDays > 0 ? Math.round((presentDays / totalDays) * 100) : 100;

// Today's schedule (timetable entries for today)
const today = new Date().toLocaleDateString('en-US', { weekday: 'lowercase' });
const dayMap: Record<string, number> = { sunday: 0, monday: 1, tuesday: 2, wednesday: 3, thursday: 4, friday: 5, saturday: 6 };
const todayDow = dayMap[today] ?? new Date().getDay();
const todaysSchedule = db.select().from(timetableEntries)
  .where(and(eq(timetableEntries.schoolId, schoolId), eq(timetableEntries.dayOfWeek, todayDow)))
  .orderBy(timetableEntries.startTime).all().slice(0, 6);

// Pending assignments (due in the future, not yet submitted)
const allAssignments = db.select().from(assignments)
  .where(and(eq(assignments.schoolId, schoolId), sql`${assignments.dueDate} >= date('now')`))
  .orderBy(assignments.dueDate).limit(10).all();

const submittedIds = new Set(
  db.select().from(submissions).where(eq(submissions.studentId, student.id)).all().map(s => s.assignmentId)
);
const pendingAssignments = allAssignments.filter(a => !submittedIds.has(a.id)).slice(0, 5);

// Recent grades
const recentGrades = db.select().from(grades)
  .where(eq(grades.studentId, student.id))
  .orderBy(desc(grades.createdAt)).limit(5).all();

// Outstanding fees
const outstandingInvoices = db.select().from(invoices)
  .where(and(eq(invoices.studentId, student.id), sql`${invoices.status} != 'paid'`))
  .all();
const outstandingFees = outstandingInvoices.reduce((sum, inv) => sum + (inv.balance || 0), 0);

// Course count
const courseCount = db.select({ c: sql<number>`count(*)` }).from(courses)
  .where(eq(courses.schoolId, schoolId)).get()?.c || 0;

// Recent quiz attempts
const recentQuizAttempts = db.select().from(quizAttempts)
  .where(eq(quizAttempts.studentId, student.id))
  .orderBy(desc(quizAttempts.startedAt)).limit(3).all();

const formatTime = (t: string | null) => {
  if (!t) return '';
  try { return new Date(`2000-01-01T${t}`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }); } catch { return t; }
};

const formatDate = (d: string | Date | null) => {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); } catch { return String(d); }
};
---

<StudentPortalLayout title="Dashboard - Student Portal">
  <div class="space-y-6">
    <!-- Welcome header -->
    <div class="bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl p-6 text-white">
      <h1 class="text-2xl font-bold">As-salamu alaykum, {student.firstName}!</h1>
      <p class="text-primary-100 mt-1 text-sm">Here is your overview for today, {new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}.</p>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Attendance</p>
          <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mt-2">{attendanceRate}%</p>
        <p class="text-xs text-gray-500 mt-1">{presentDays} of {totalDays} days present</p>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Courses</p>
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mt-2">{courseCount}</p>
        <p class="text-xs text-gray-500 mt-1">Enrolled courses</p>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Pending</p>
          <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mt-2">{pendingAssignments.length}</p>
        <p class="text-xs text-gray-500 mt-1">Assignments due</p>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="flex items-center justify-between">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Fees</p>
          <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </div>
        <p class="text-2xl font-bold text-gray-900 mt-2">{outstandingFees > 0 ? outstandingFees.toLocaleString() : '0'}</p>
        <p class="text-xs text-gray-500 mt-1">{outstandingFees > 0 ? 'Outstanding balance' : 'All clear'}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Today's schedule -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Today's Schedule</h2>
          <a href="/portal/student/timetable" class="text-xs font-medium text-primary-600 hover:underline">View full timetable</a>
        </div>
        {todaysSchedule.length > 0 ? (
          <div class="space-y-3">
            {todaysSchedule.map(entry => (
              <div class="flex items-center gap-3 p-3 rounded-lg bg-gray-50">
                <div class="text-center min-w-[60px]">
                  <p class="text-xs font-bold text-gray-900">{formatTime(entry.startTime)}</p>
                  <p class="text-[10px] text-gray-400">{formatTime(entry.endTime)}</p>
                </div>
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900">{entry.subject || 'Period'}</p>
                  {entry.room && <p class="text-xs text-gray-500">Room: {entry.room}</p>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No classes scheduled for today.</p>
        )}
      </div>

      <!-- Pending assignments -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Pending Assignments</h2>
          <a href="/portal/student/assignments" class="text-xs font-medium text-primary-600 hover:underline">View all</a>
        </div>
        {pendingAssignments.length > 0 ? (
          <div class="space-y-3">
            {pendingAssignments.map(a => (
              <a href={`/portal/student/assignments#${a.id}`} class="block p-3 rounded-lg border border-gray-100 hover:border-primary-200 hover:bg-primary-50/30 transition-colors">
                <div class="flex items-start justify-between gap-2">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">{a.title}</p>
                    {a.dueDate && (
                      <p class="text-xs text-gray-500 mt-0.5">Due: {formatDate(a.dueDate)}</p>
                    )}
                  </div>
                  {a.dueDate && new Date(a.dueDate) < new Date(Date.now() + 3 * 24 * 60 * 60 * 1000) && (
                    <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700">DUE SOON</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="py-8 text-center">
            <svg class="w-12 h-12 mx-auto text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-sm text-gray-500 mt-2">No pending assignments. You are all caught up!</p>
          </div>
        )}
      </div>

      <!-- Recent grades -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Recent Grades</h2>
          <a href="/portal/student/grades" class="text-xs font-medium text-primary-600 hover:underline">View all</a>
        </div>
        {recentGrades.length > 0 ? (
          <div class="space-y-2">
            {recentGrades.map(g => (
              <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">{g.assignmentTitle || g.examTitle || 'Assessment'}</p>
                  <p class="text-xs text-gray-500">{formatDate(g.createdAt)}</p>
                </div>
                <div class="text-right">
                  <span class="text-sm font-bold text-gray-900">{g.score}{g.maxScore ? `/${g.maxScore}` : ''}</span>
                  {g.grade && <span class="ml-2 inline-flex px-1.5 py-0.5 rounded text-[10px] font-bold bg-primary-100 text-primary-700">{g.grade}</span>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No grades published yet.</p>
        )}
      </div>

      <!-- Recent quiz attempts -->
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Recent Quizzes</h2>
          <a href="/portal/student/quizzes" class="text-xs font-medium text-primary-600 hover:underline">View all</a>
        </div>
        {recentQuizAttempts.length > 0 ? (
          <div class="space-y-2">
            {recentQuizAttempts.map(att => {
              const quiz = db.select().from(quizzes).where(eq(quizzes.id, att.quizId)).get();
              return (
                <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50">
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">{quiz?.title || 'Quiz'}</p>
                    <p class="text-xs text-gray-500">{formatDate(att.startedAt)}</p>
                  </div>
                  <div class="text-right">
                    {att.score != null ? (
                      <span class="text-sm font-bold text-gray-900">{att.score}{quiz?.maxScore ? `/${quiz.maxScore}` : ''}</span>
                    ) : (
                      <span class="text-xs text-gray-400">In progress</span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No quiz attempts yet.</p>
        )}
      </div>
    </div>
  </div>
</StudentPortalLayout>
