---
/**
 * CBT Exam Results — Student View
 */
import StudentPortalLayout from '../../../../layouts/StudentPortalLayout.astro';
import { getDb } from '../../../../lib/db/index.js';
import { cbtAttempts, cbtExams, cbtCandidates, cbtProctoringLogs } from '../../../../lib/db/schema.js';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

const attemptId = parseInt(Astro.url.searchParams.get('id') || '0');
if (!attemptId) return Astro.redirect('/portal/student');

const db = getDb();
const attempt = db.select().from(cbtAttempts).where(eq(cbtAttempts.id, attemptId)).get();
if (!attempt) return Astro.redirect('/portal/student');

const exam = db.select().from(cbtExams).where(eq(cbtExams.id, attempt.examId)).get();
const candidate = db.select().from(cbtCandidates).where(eq(cbtCandidates.id, attempt.candidateId)).get();

// Verify ownership
if (candidate?.userId !== user.id) return Astro.redirect('/portal/student');

// Get proctoring flags
const logs = db.select().from(cbtProctoringLogs).where(eq(cbtProctoringLogs.attemptId, attemptId)).all();

const percentage = attempt.totalMarks && attempt.score !== null ? Math.round((attempt.score / attempt.totalMarks) * 100) : null;
const passed = percentage !== null && percentage >= 50;
const timeTaken = attempt.timeTaken ? `${Math.floor(attempt.timeTaken / 60)}m ${attempt.timeTaken % 60}s` : '—';
const flagCount = logs.length;
---

<StudentPortalLayout title="Exam Results">
  <div class="max-w-2xl mx-auto space-y-6">
    {/* Result Summary Card */}
    <div class="rounded-2xl p-8 text-center" style="background: var(--surface); border: 1px solid var(--border);">
      <div class="w-20 h-20 mx-auto rounded-full flex items-center justify-center mb-4" style={`background: ${passed ? 'linear-gradient(135deg, #05B34D 0%, #049940 100%)' : 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)'};`}>
        <span class="text-4xl">{passed ? '✓' : '✗'}</span>
      </div>
      <h1 class="text-2xl font-bold mb-2" style="color: var(--text);">{passed ? 'Passed!' : 'Did Not Pass'}</h1>
      <p class="text-sm mb-6" style="color: var(--text-muted);">{exam?.title}</p>
      
      <div class="grid grid-cols-3 gap-4">
        <div class="p-4 rounded-xl" style="background: var(--bg-subtle);">
          <div class="text-3xl font-bold" style="color: var(--primary);">{attempt.score ?? '—'}</div>
          <div class="text-xs mt-1" style="color: var(--text-muted);">Score</div>
        </div>
        <div class="p-4 rounded-xl" style="background: var(--bg-subtle);">
          <div class="text-3xl font-bold" style="color: var(--text);">{attempt.totalMarks || '—'}</div>
          <div class="text-xs mt-1" style="color: var(--text-muted);">Total Marks</div>
        </div>
        <div class="p-4 rounded-xl" style="background: var(--bg-subtle);">
          <div class="text-3xl font-bold" style={`color: ${passed ? 'var(--primary)' : '#ef4444'};`}>{percentage !== null ? percentage + '%' : '—'}</div>
          <div class="text-xs mt-1" style="color: var(--text-muted);">Percentage</div>
        </div>
      </div>
    </div>

    {/* Exam Details */}
    <div class="rounded-2xl p-6" style="background: var(--surface); border: 1px solid var(--border);">
      <h3 class="text-sm font-semibold mb-4" style="color: var(--text);">Exam Details</h3>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between py-2" style="border-bottom: 1px solid var(--border);">
          <span style="color: var(--text-muted);">Exam Type</span>
          <span class="font-medium capitalize" style="color: var(--text);">{exam?.type}</span>
        </div>
        <div class="flex justify-between py-2" style="border-bottom: 1px solid var(--border);">
          <span style="color: var(--text-muted);">Duration</span>
          <span class="font-medium" style="color: var(--text);">{exam?.duration} min</span>
        </div>
        <div class="flex justify-between py-2" style="border-bottom: 1px solid var(--border);">
          <span style="color: var(--text-muted);">Time Taken</span>
          <span class="font-medium" style="color: var(--text);">{timeTaken}</span>
        </div>
        <div class="flex justify-between py-2" style="border-bottom: 1px solid var(--border);">
          <span style="color: var(--text-muted);">Submitted</span>
          <span class="font-medium" style="color: var(--text);">{attempt.submittedAt ? new Date(attempt.submittedAt).toLocaleString() : '—'}</span>
        </div>
        <div class="flex justify-between py-2">
          <span style="color: var(--text-muted);">Status</span>
          <span class="font-medium capitalize" style="color: var(--text);">{attempt.status}</span>
        </div>
      </div>
    </div>

    {/* Integrity Report */}
    {flagCount > 0 && (
      <div class="rounded-2xl p-6" style="background: var(--surface); border: 1px solid var(--border);">
        <h3 class="text-sm font-semibold mb-4" style="color: var(--text);">⚠ Integrity Flags ({flagCount})</h3>
        <div class="space-y-2">
          {logs.slice(0, 10).map(log => (
            <div class="flex items-center justify-between p-3 rounded-xl" style="background: var(--bg-subtle);">
              <span class="text-sm capitalize" style="color: var(--text);">{log.eventType.replace(/_/g, ' ')}</span>
              <span class="text-xs px-2 py-0.5 rounded" style={`background: ${log.severity === 'critical' ? '#fee2e2' : log.severity === 'warning' ? '#fef3c7' : '#dbeafe'}; color: ${log.severity === 'critical' ? '#dc2626' : log.severity === 'warning' ? '#d97706' : '#2563eb'};`}>{log.severity}</span>
            </div>
          ))}
        </div>
        {flagCount > 10 && <p class="text-xs mt-2" style="color: var(--text-muted);">+ {flagCount - 10} more flags</p>}
      </div>
    )}

    {/* Actions */}
    <div class="flex justify-center">
      <a href="/portal/student" class="px-6 py-3 rounded-xl text-white font-semibold" style="background: linear-gradient(135deg, #05B34D 0%, #049940 100%);">
        Back to Dashboard
      </a>
    </div>
  </div>
</StudentPortalLayout>
