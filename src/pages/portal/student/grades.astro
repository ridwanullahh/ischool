---
/**
 * Student Portal - Grades
 *
 * Shows all grades for the student with subject breakdown and trend analysis.
 */
import StudentPortalLayout from '../../../layouts/StudentPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { grades, courses } from '../../../lib/db/schema.js';
import { eq, desc } from 'drizzle-orm';
import { getStudentForUser, getUserSchoolId } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/student/grades');

const student = await getStudentForUser(user.id);
if (!student) return Astro.redirect('/portal/no-profile');
const schoolId = (user as any).schoolId ?? null;
const db = getDb();

const allGrades = await db.select().from(grades)
  .where(eq(grades.studentId, student.id))
  .orderBy(desc(grades.createdAt)).all();

// Group by course
const byCourse: Record<string, any[]> = {};
for (const g of allGrades) {
  const course = g.courseId ? await db.select().from(courses).where(eq(courses.id, g.courseId)).get() : null;
  const key = course?.title || 'General';
  if (!byCourse[key]) byCourse[key] = [];
  byCourse[key].push({ ...g, courseName: key });
}

// Compute averages per course
const courseStats = Object.entries(byCourse).map(([course, grades]) => {
  const scored = grades.filter(g => g.score != null && g.maxScore);
  const avg = scored.length > 0
    ? Math.round((scored.reduce((s, g) => s + (g.score / g.maxScore) * 100, 0) / scored.length))
    : 0;
  return { course, count: grades.length, avg };
});

const formatDate = (d: string | Date | null) => {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); } catch { return ''; }
};

const getGradeColor = (score: number | null, max: number | null) => {
  if (score == null || !max) return 'text-gray-400';
  const pct = (score / max) * 100;
  if (pct >= 80) return 'text-green-600';
  if (pct >= 60) return 'text-blue-600';
  if (pct >= 40) return 'text-amber-600';
  return 'text-red-600';
};
---

<StudentPortalLayout title="Grades - Student Portal">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">My Grades</h1>
      <p class="text-sm text-gray-500 mt-1">View your assessment scores and performance trends</p>
    </div>

    {/* Course averages summary */}
    {courseStats.length > 0 && (
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {courseStats.slice(0, 4).map(cs => (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider truncate">{cs.course}</p>
            <p class:list={["text-2xl font-bold mt-2", cs.avg >= 80 ? 'text-green-600' : cs.avg >= 60 ? 'text-blue-600' : cs.avg >= 40 ? 'text-amber-600' : 'text-red-600']}>{cs.avg}%</p>
            <p class="text-xs text-gray-500 mt-1">{cs.count} assessment{cs.count !== 1 ? 's' : ''}</p>
          </div>
        ))}
      </div>
    )}

    {allGrades.length > 0 ? (
      <div class="space-y-6">
        {Object.entries(byCourse).map(([course, grades]) => (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class="text-base font-semibold text-gray-900 mb-4">{course}</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b">
                  <tr>
                    <th class="text-left py-2 px-3 font-medium text-gray-700">Assessment</th>
                    <th class="text-left py-2 px-3 font-medium text-gray-700">Date</th>
                    <th class="text-center py-2 px-3 font-medium text-gray-700">Score</th>
                    <th class="text-center py-2 px-3 font-medium text-gray-700">Grade</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  {grades.map(g => (
                    <tr class="hover:bg-gray-50">
                      <td class="py-2.5 px-3 text-gray-900">{g.assignmentTitle || g.examTitle || g.assessmentTitle || 'Assessment'}</td>
                      <td class="py-2.5 px-3 text-gray-500 text-xs">{formatDate(g.createdAt)}</td>
                      <td class="py-2.5 px-3 text-center">
                        <span class:list={["font-bold", getGradeColor(g.score, g.maxScore)]}>
                          {g.score != null ? g.score : '-'}{g.maxScore ? `/${g.maxScore}` : ''}
                        </span>
                      </td>
                      <td class="py-2.5 px-3 text-center">
                        {g.grade && <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-bold bg-primary-100 text-primary-700">{g.grade}</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <p class="text-sm text-gray-500 mt-2">No grades published yet.</p>
      </div>
    )}
  </div>
</StudentPortalLayout>
