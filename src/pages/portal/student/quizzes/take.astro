---
/**
 * CBT / Quiz Taking Interface
 *
 * Full-screen exam delivery with:
 * - Distraction-free full-screen mode
 * - Tab/window switch detection with auto-flagging
 * - Answer auto-save
 * - Question navigation panel + flag for review
 * - Countdown timer with warnings
 * - Auto-submission on timer expiry
 * - Connection status indicator
 */
import StudentPortalLayout from '../../../../layouts/StudentPortalLayout.astro';
import { getDb } from '../../../../lib/db/index.js';
import { quizzes, questions, quizAttempts, courses } from '../../../../lib/db/schema.js';
import { eq, and } from 'drizzle-orm';
import { getStudentForUser, getUserSchoolId } from '../../../../lib/portal.js';
import { pageGuard } from '../../../../lib/rbac.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

if (!pageGuard(user, 'quizzes.take')) {
  return Astro.redirect('/portal/student/quizzes');
}

const quizId = parseInt(Astro.url.searchParams.get('id') || '0');
if (!quizId) return Astro.redirect('/portal/student/quizzes');

const student = getStudentForUser(user.id);
if (!student) return Astro.redirect('/portal/no-profile');
const schoolId = getUserSchoolId(user.id) ?? student.schoolId;
const db = getDb();

const quiz = db.select().from(quizzes).where(and(eq(quizzes.id, quizId), eq(quizzes.schoolId, schoolId))).get();
if (!quiz) return Astro.redirect('/portal/student/quizzes');

// Get quiz questions
const quizQuestions = db.select().from(questions).where(eq(questions.quizId, quizId)).orderBy(questions.sortOrder).all();
if (quizQuestions.length === 0) {
  return Astro.redirect('/portal/student/quizzes?error=no_questions');
}

// Check for in-progress attempt
const inProgress = db.select().from(quizAttempts)
  .where(and(eq(quizAttempts.quizId, quizId), eq(quizAttempts.studentId, student.id)))
  .orderBy(quizAttempts.startedAt).all().reverse().find(a => !a.completedAt);

let attemptId: number;
let existingAnswers: Record<number, any> = {};

if (inProgress) {
  attemptId = inProgress.id;
  existingAnswers = (inProgress.answers as Record<number, any>) || {};
} else {
  // Check attempt limit
  const allAttempts = db.select().from(quizAttempts)
    .where(and(eq(quizAttempts.quizId, quizId), eq(quizAttempts.studentId, student.id)))
    .all();
  if (quiz.maxAttempts && allAttempts.length >= quiz.maxAttempts) {
    return Astro.redirect('/portal/student/quizzes?error=max_attempts');
  }

  // Create new attempt
  const newAttempt = db.insert(quizAttempts).values({
    quizId,
    studentId: student.id,
    schoolId,
    answers: '{}',
    startedAt: new Date(),
  }).returning().get();
  attemptId = newAttempt.id;
}

const course = quiz.courseId ? db.select().from(courses).where(eq(courses.id, quiz.courseId)).get() : null;
const durationMinutes = quiz.duration || 30;
const startTime = inProgress?.startedAt || new Date();
---

<StudentPortalLayout title={quiz.title + ' - Take Quiz'}>
  <div class="space-y-4" id="quizContainer">
    {/* Instructions / start screen */}
    <div id="startScreen" class="bg-white rounded-xl border border-gray-200 p-8 max-w-3xl mx-auto">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{quiz.title}</h1>
        {course && <p class="text-sm text-gray-500 mt-1">{course.title}</p>}
      </div>
      {quiz.description && <p class="text-sm text-gray-600 mb-6 text-center">{quiz.description}</p>}

      <div class="bg-gray-50 rounded-lg p-5 mb-6">
        <h2 class="text-sm font-semibold text-gray-900 mb-3">Instructions</h2>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>You have <strong>{durationMinutes} minutes</strong> to complete this quiz.</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>There are <strong>{quizQuestions.length} questions</strong> in this quiz.</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Your answers are <strong>auto-saved</strong> as you progress.</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>Switching tabs or leaving full-screen will be <strong>flagged</strong>.</li>
          <li class="flex items-start gap-2"><svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>The quiz will <strong>auto-submit</strong> when time expires.</li>
        </ul>
      </div>

      <div class="flex items-center justify-center gap-3">
        <button onclick="startQuiz()" class="px-6 py-3 text-sm font-bold text-white bg-primary-600 rounded-lg hover:bg-primary-700">Start Quiz</button>
        <a href="/portal/student/quizzes" class="px-6 py-3 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
      </div>
    </div>

    {/* Quiz interface (hidden until start) */}
    <div id="quizScreen" class="hidden">
      {/* Top bar: timer + connection + flags */}
      <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center justify-between sticky top-0 z-10">
        <div class="flex items-center gap-4">
          <div id="timerDisplay" class="text-lg font-bold text-gray-900">--:--</div>
          <div id="connectionStatus" class="flex items-center gap-1.5 text-xs text-green-600">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>Connected
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs text-gray-500"><span id="answeredCount">0</span>/{quizQuestions.length} answered</span>
          <span id="flagCount" class="text-xs text-amber-600 hidden"><span id="flagNum">0</span> flagged</span>
          <button onclick="confirmSubmit()" class="px-4 py-1.5 text-xs font-bold text-white bg-green-600 rounded-lg hover:bg-green-700">Submit Quiz</button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mt-4">
        {/* Question area */}
        <div class="lg:col-span-3 bg-white rounded-xl border border-gray-200 p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm font-medium text-gray-500">Question <span id="currentQNum">1</span> of {quizQuestions.length}</span>
            <button id="flagBtn" onclick="toggleFlag()" class="text-xs font-medium text-amber-600 hover:text-amber-700 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>
              <span id="flagText">Flag for review</span>
            </button>
          </div>
          <div id="questionContent">
            {/* Questions rendered by JS */}
          </div>
          <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-200">
            <button id="prevBtn" onclick="prevQuestion()" class="px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50" disabled>Previous</button>
            <button id="nextBtn" onclick="nextQuestion()" class="px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Next</button>
          </div>
        </div>

        {/* Navigation panel */}
        <div class="bg-white rounded-xl border border-gray-200 p-4">
          <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-3">Questions</h3>
          <div id="navGrid" class="grid grid-cols-5 gap-2">
            {/* Navigation buttons rendered by JS */}
          </div>
          <div class="mt-4 space-y-1 text-xs">
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-green-500"></span><span class="text-gray-600">Answered</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-amber-400"></span><span class="text-gray-600">Flagged</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded bg-gray-200"></span><span class="text-gray-600">Unanswered</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Flag warning modal */}
  <div id="flagWarningModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-start gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-gray-900">Tab Switch Detected</h3>
          <p class="text-sm text-gray-600 mt-1">You switched away from the quiz tab. This action has been flagged and recorded. Repeated violations may result in disqualification.</p>
        </div>
      </div>
      <button onclick="document.getElementById('flagWarningModal').classList.add('hidden')" class="w-full px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700">I understand</button>
    </div>
  </div>

  {/* Submit confirmation */}
  <div id="submitModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-2">Submit Quiz?</h3>
      <p class="text-sm text-gray-600 mb-4">You have answered <span id="submitAnsweredCount">0</span> of {quizQuestions.length} questions. Are you sure you want to submit?</p>
      <div class="flex items-center justify-end gap-2">
        <button onclick="document.getElementById('submitModal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
        <button onclick="submitQuiz()" class="px-4 py-2 text-sm font-bold text-white bg-green-600 rounded-lg hover:bg-green-700">Submit</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{
    attemptId, durationMinutes,
    startTimeIso: startTime.toISOString(),
    questionsData: quizQuestions.map(q => ({
      id: q.id, type: q.type, question: q.question,
      options: q.options, points: q.points,
    })),
    existingAnswers,
  }}>
    var currentQ = 0;
    var answers = Object.assign({}, existingAnswers);
    var flags = {};
    var flagsCount = 0;
    var tabSwitchCount = 0;
    var quizStartTime = new Date(startTimeIso);
    var endTime = new Date(quizStartTime.getTime() + durationMinutes * 60000);
    var timerInterval, autoSaveInterval;

    function startQuiz() {
      document.getElementById('startScreen').classList.add('hidden');
      document.getElementById('quizScreen').classList.remove('hidden');
      // Try to enter full screen
      if (document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen().catch(function() {});
      }
      renderQuestion();
      renderNav();
      startTimer();
      startAutoSave();
      setupAntiCheat();
    }

    function renderQuestion() {
      var q = questionsData[currentQ];
      if (!q) return;
      var html = '<div class="text-base font-medium text-gray-900 mb-4">' + (currentQ + 1) + '. ' + q.question + '</div>';
      if (q.type === 'multiple_choice' && q.options) {
        var opts = typeof q.options === 'string' ? JSON.parse(q.options) : q.options;
        for (var i = 0; i < opts.length; i++) {
          var selected = answers[q.id] === i ? 'border-primary-500 bg-primary-50' : 'border-gray-200';
          html += '<label class="block p-3 border-2 rounded-lg mb-2 cursor-pointer hover:border-primary-300 ' + selected + '" onclick="selectAnswer(' + q.id + ', ' + i + ')">';
          html += '<div class="flex items-center gap-3"><input type="radio" name="q' + q.id + '" ' + (answers[q.id] === i ? 'checked' : '') + ' class="text-primary-600" />';
          html += '<span class="text-sm text-gray-900">' + opts[i] + '</span></div></label>';
        }
      } else if (q.type === 'true_false') {
        ['True', 'False'].forEach(function(opt, i) {
          var selected = answers[q.id] === opt ? 'border-primary-500 bg-primary-50' : 'border-gray-200';
          html += '<label class="block p-3 border-2 rounded-lg mb-2 cursor-pointer hover:border-primary-300 ' + selected + '" onclick="selectAnswer(' + q.id + ', \'' + opt + '\')">';
          html += '<div class="flex items-center gap-3"><input type="radio" name="q' + q.id + '" ' + (answers[q.id] === opt ? 'checked' : '') + ' class="text-primary-600" />';
          html += '<span class="text-sm text-gray-900">' + opt + '</span></div></label>';
        });
      } else {
        var val = answers[q.id] || '';
        html += '<textarea class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" rows="6" placeholder="Type your answer..." oninput="setTextAnswer(' + q.id + ', this.value)">' + val + '</textarea>';
      }
      document.getElementById('questionContent').innerHTML = html;
      document.getElementById('currentQNum').textContent = currentQ + 1;
      document.getElementById('prevBtn').disabled = currentQ === 0;
      document.getElementById('nextBtn').textContent = currentQ === questionsData.length - 1 ? 'Finish' : 'Next';
      updateFlagBtn();
    }

    function selectAnswer(qId, value) {
      answers[qId] = value;
      renderQuestion();
      renderNav();
      updateAnsweredCount();
    }

    function setTextAnswer(qId, value) {
      answers[qId] = value;
      updateAnsweredCount();
    }

    function renderNav() {
      var html = '';
      for (var i = 0; i < questionsData.length; i++) {
        var answered = answers[questionsData[i].id] !== undefined && answers[questionsData[i].id] !== '';
        var flagged = flags[questionsData[i].id];
        var bg = flagged ? 'bg-amber-400 text-white' : answered ? 'bg-green-500 text-white' : 'bg-gray-200 text-gray-600';
        var current = i === currentQ ? 'ring-2 ring-primary-500 ring-offset-1' : '';
        html += '<button onclick="goToQuestion(' + i + ')" class="w-8 h-8 rounded text-xs font-bold ' + bg + ' ' + current + '">' + (i + 1) + '</button>';
      }
      document.getElementById('navGrid').innerHTML = html;
    }

    function goToQuestion(idx) { currentQ = idx; renderQuestion(); renderNav(); }
    function nextQuestion() { if (currentQ < questionsData.length - 1) { currentQ++; renderQuestion(); renderNav(); } else { confirmSubmit(); } }
    function prevQuestion() { if (currentQ > 0) { currentQ--; renderQuestion(); renderNav(); } }

    function toggleFlag() {
      var qId = questionsData[currentQ].id;
      if (flags[qId]) { delete flags[qId]; } else { flags[qId] = true; }
      flagsCount = Object.keys(flags).length;
      document.getElementById('flagCount').classList.toggle('hidden', flagsCount === 0);
      document.getElementById('flagNum').textContent = flagsCount;
      renderNav();
      updateFlagBtn();
    }

    function updateFlagBtn() {
      var qId = questionsData[currentQ].id;
      var isFlagged = !!flags[qId];
      document.getElementById('flagText').textContent = isFlagged ? 'Flagged' : 'Flag for review';
      document.getElementById('flagBtn').classList.toggle('text-amber-700', isFlagged);
    }

    function updateAnsweredCount() {
      var count = 0;
      for (var i = 0; i < questionsData.length; i++) {
        var a = answers[questionsData[i].id];
        if (a !== undefined && a !== '') count++;
      }
      document.getElementById('answeredCount').textContent = count;
    }

    function startTimer() {
      timerInterval = setInterval(function() {
        var now = new Date();
        var remaining = Math.max(0, endTime - now);
        var mins = Math.floor(remaining / 60000);
        var secs = Math.floor((remaining % 60000) / 1000);
        var display = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
        var timerEl = document.getElementById('timerDisplay');
        timerEl.textContent = display;
        if (remaining < 60000) { timerEl.className = 'text-lg font-bold text-red-600'; }
        else if (remaining < 300000) { timerEl.className = 'text-lg font-bold text-amber-600'; }
        else { timerEl.className = 'text-lg font-bold text-gray-900'; }
        if (remaining <= 0) { clearInterval(timerInterval); submitQuiz(); }
      }, 1000);
    }

    function startAutoSave() {
      autoSaveInterval = setInterval(function() {
        fetch('/api/portal/student/quiz-save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attemptId, answers, flags })
        }).catch(function() {});
      }, 10000);
    }

    function setupAntiCheat() {
      // Tab visibility detection
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          tabSwitchCount++;
          document.getElementById('flagWarningModal').classList.remove('hidden');
          // Log the flag
          fetch('/api/portal/student/quiz-flag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attemptId, type: 'tab_switch', count: tabSwitchCount })
          }).catch(function() {});
        }
      });
      // Full screen exit detection
      document.addEventListener('fullscreenchange', function() {
        if (!document.fullscreenElement) {
          tabSwitchCount++;
          document.getElementById('flagWarningModal').classList.remove('hidden');
          fetch('/api/portal/student/quiz-flag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attemptId, type: 'fullscreen_exit', count: tabSwitchCount })
          }).catch(function() {});
        }
      });
      // Connection status
      window.addEventListener('online', function() {
        document.getElementById('connectionStatus').innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500"></span>Connected';
        document.getElementById('connectionStatus').className = 'flex items-center gap-1.5 text-xs text-green-600';
      });
      window.addEventListener('offline', function() {
        document.getElementById('connectionStatus').innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span>Offline';
        document.getElementById('connectionStatus').className = 'flex items-center gap-1.5 text-xs text-red-600';
      });
    }

    function confirmSubmit() {
      var count = 0;
      for (var i = 0; i < questionsData.length; i++) {
        var a = answers[questionsData[i].id];
        if (a !== undefined && a !== '') count++;
      }
      document.getElementById('submitAnsweredCount').textContent = count;
      document.getElementById('submitModal').classList.remove('hidden');
    }

    async function submitQuiz() {
      clearInterval(timerInterval);
      clearInterval(autoSaveInterval);
      try {
        const res = await fetch('/api/portal/student/quiz-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attemptId, answers, flags, tabSwitchCount })
        });
        const data = await res.json();
        if (res.ok) {
          window.location.href = '/portal/student/quizzes?submitted=' + attemptId;
        } else {
          alert(data.error || 'Failed to submit quiz');
        }
      } catch (e) {
        alert('Network error during submission. Your answers have been auto-saved.');
      }
    }
  </script>
</StudentPortalLayout>
