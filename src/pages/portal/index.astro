---
/**
 * Portal Index - Role-based redirect
 *
 * Redirects users to their role-specific portal:
 * - student  -> /portal/student
 * - parent   -> /portal/parent
 * - teacher  -> /portal/teacher
 * - school_admin -> /dashboard
 * - other    -> /dashboard
 */
const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal');

if (user.role === 'student') return Astro.redirect('/portal/student');
if (user.role === 'parent') return Astro.redirect('/portal/parent');
if (user.role === 'teacher') return Astro.redirect('/portal/teacher');

// school_admin and other roles go to the main dashboard
return Astro.redirect('/dashboard');
