---
/**
 * Teacher Portal - Dashboard
 *
 * Shows the teacher's overview: today's schedule, their classes,
 * pending grading, and recent submissions.
 */
import TeacherPortalLayout from '../../../layouts/TeacherPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { classes, timetableEntries, assignments, submissions, enrollments, students, courses } from '../../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';
import { getStaffForUser, getUserSchoolId } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/teacher');

const todayString = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

const staff = getStaffForUser(user.id);
const schoolId = getUserSchoolId(user.id);
const db = getDb();

// Today's schedule
const todayDow = new Date().getDay();
const scheduleQuery = schoolId
  ? db.select().from(timetableEntries)
    .where(and(eq(timetableEntries.schoolId, schoolId), eq(timetableEntries.dayOfWeek, todayDow)))
    .orderBy(timetableEntries.startTime).all()
  : [];
// If teacher has a staff record, filter to their entries
const todaysSchedule = staff?.id
  ? scheduleQuery.filter(e => !e.teacherId || e.teacherId === staff.id)
  : scheduleQuery;

// Teacher's classes (classes where they are the homeroom teacher)
const myClasses = staff
  ? db.select().from(classes).where(eq(classes.homeroomTeacherId, staff.id)).all()
  : [];

// All classes in the school (for assignment/grade entry)
const allClasses = schoolId
  ? db.select().from(classes).where(eq(classes.schoolId, schoolId)).all()
  : [];

// Pending grading (submissions not yet graded)
const pendingGradingRaw = staff && schoolId
  ? db.select().from(submissions)
    .leftJoin(assignments, eq(submissions.assignmentId, assignments.id))
    .leftJoin(students, eq(submissions.studentId, students.id))
    .where(eq(submissions.schoolId, schoolId))
    .orderBy(desc(submissions.submittedAt)).limit(20).all()
  : [];
// Filter to ungraded only (in JS to avoid SQL template literal parsing issues)
const pendingGrading = pendingGradingRaw
  .filter(r => !r.submissions.gradedAt)
  .slice(0, 10)
  .map(r => ({
    id: r.submissions.id,
    assignmentTitle: r.assignments?.title || 'Assignment',
    studentName: r.students ? `${r.students.firstName} ${r.students.lastName}` : 'Unknown',
    submittedAt: r.submissions.submittedAt,
    content: r.submissions.content,
  }));

// My assignments
const myAssignments = schoolId
  ? db.select().from(assignments).where(eq(assignments.schoolId, schoolId)).orderBy(desc(assignments.createdAt)).limit(5).all()
  : [];

// My classes with student counts (precomputed to avoid template literals in markup)
const myClassesWithCounts = myClasses.map(c => {
  const count = db.select().from(enrollments).where(eq(enrollments.classId, c.id)).all().length;
  return { ...c, studentCount: count, displayName: c.name + (c.section ? ' - ' + c.section : '') };
});

// Student count
const studentCount = schoolId
  ? db.select().from(students).where(eq(students.schoolId, schoolId)).all().length
  : 0;

const formatTime = (t: string | null) => {
  if (!t) return '';
  try { return new Date(`2000-01-01T${t}`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }); } catch { return t; }
};
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
---

<TeacherPortalLayout title="Dashboard - Teacher Portal">
  <div class="space-y-6">
    <div class="bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl p-6 text-white">
      <h1 class="text-2xl font-bold">As-salamu alaykum, {user.name}!</h1>
      <p class="text-primary-100 mt-1 text-sm">Here is your overview for today, {todayString}.</p>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Today's Classes</p>
        <p class="text-2xl font-bold text-gray-900 mt-2">{todaysSchedule.length}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">My Classes</p>
        <p class="text-2xl font-bold text-blue-600 mt-2">{myClasses.length}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Pending Grading</p>
        <p class="text-2xl font-bold text-amber-600 mt-2">{pendingGrading.length}</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Students</p>
        <p class="text-2xl font-bold text-gray-900 mt-2">{studentCount}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {/* Today's schedule */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Today's Schedule</h2>
          <a href="/portal/teacher/attendance" class="text-xs font-medium text-primary-600 hover:underline">Take attendance</a>
        </div>
        {todaysSchedule.length > 0 ? (
          <div class="space-y-3">
            {todaysSchedule.map((entry) => (
              <div class="flex items-center gap-3 p-3 rounded-lg bg-gray-50">
                <div class="text-center" style="min-width:60px">
                  <p class="text-xs font-bold text-gray-900">{formatTime(entry.startTime)}</p>
                  <p class="text-gray-400" style="font-size:10px">{formatTime(entry.endTime)}</p>
                </div>
                <div class="flex-1">
                  <p class="text-sm font-medium text-gray-900">{entry.subject ?? 'Period'}</p>
                  {entry.room ? <p class="text-xs text-gray-500">Room: {entry.room}</p> : null}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No classes scheduled for today.</p>
        )}
      </div>

      {/* Pending grading */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Pending Grading</h2>
          <a href="/portal/teacher/assignments" class="text-xs font-medium text-primary-600 hover:underline">View all</a>
        </div>
        {pendingGrading.length > 0 ? (
          <div class="space-y-2">
            {pendingGrading.map(s => (
              <div class="flex items-center justify-between p-3 rounded-lg border border-gray-100">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">{s.assignmentTitle || 'Assignment'}</p>
                  <p class="text-xs text-gray-500">{s.studentName} - {formatDate(s.submittedAt)}</p>
                </div>
                <a href="/portal/teacher/grades" class="shrink-0 px-3 py-1 text-xs font-medium text-primary-600 border border-primary-200 rounded-lg hover:bg-primary-50">Grade</a>
              </div>
            ))}
          </div>
        ) : (
          <div class="py-8 text-center">
            <svg class="w-12 h-12 mx-auto text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-sm text-gray-500 mt-2">No pending submissions to grade.</p>
          </div>
        )}
      </div>

      {/* My classes */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-base font-semibold text-gray-900 mb-4">My Classes</h2>
        {myClassesWithCounts.length > 0 ? (
          <div class="space-y-2">
            {myClassesWithCounts.map((c) => (
              <a href={'/portal/teacher/attendance?class=' + c.id} class="block p-3 rounded-lg border border-gray-100 hover:border-primary-200 hover:bg-primary-50/30">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-gray-900">{c.displayName}</p>
                    <p class="text-xs text-gray-500">{c.studentCount} student{c.studentCount !== 1 ? 's' : ''}</p>
                  </div>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No homeroom classes assigned.</p>
        )}
      </div>

      {/* Recent assignments */}
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-900">Recent Assignments</h2>
          <a href="/portal/teacher/assignments" class="text-xs font-medium text-primary-600 hover:underline">Manage</a>
        </div>
        {myAssignments.length > 0 ? (
          <div class="space-y-2">
            {myAssignments.map(a => (
              <div class="p-3 rounded-lg border border-gray-100">
                <p class="text-sm font-medium text-gray-900">{a.title}</p>
                <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                  <span>Due: {formatDate(a.dueDate)}</span>
                  {a.maxPoints ? <span>Points: {a.maxPoints}</span> : null}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-gray-500 py-8 text-center">No assignments created yet.</p>
        )}
      </div>
    </div>
  </div>
</TeacherPortalLayout>
