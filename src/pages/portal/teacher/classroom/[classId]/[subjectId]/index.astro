---
/**
 * Teacher Classroom Management — Full teaching workspace
 *
 * Tabs: Overview, Lessons, Assignments, Attendance, Assessments,
 * Live Class, Discussions, Gradebook, Students
 */
import TeacherPortalLayout from '../../../../../../layouts/TeacherPortalLayout.astro';
import { getDb } from '../../../../../../lib/db/index.js';
import {
  classSubjects, classes, staff, enrollments, students, courses,
  courseUnits, lessons, assignments, submissions, attendance, quizzes,
  grades, liveClassRooms, discussionBoards, behaviorLogs
} from '../../../../../../lib/db/schema.js';
import { eq, and, desc } from 'drizzle-orm';
import { getStaffForUser, getUserSchoolId } from '../../../../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');
const myStaff = getStaffForUser(user.id);
const schoolId = getUserSchoolId(user);
const classId = parseInt(Astro.params.classId);
const subjectId = parseInt(Astro.params.subjectId);
const db = getDb();

// Verify this teacher is assigned to this class+subject
const assignment = await db.select().from(classSubjects)
  .where(and(eq(classSubjects.id, subjectId), eq(classSubjects.classId, classId), eq(classSubjects.teacherId, myStaff?.id || 0)))
  .get();
if (!assignment) return Astro.redirect('/portal/teacher/classroom');

const classInfo = await db.select().from(classes).where(eq(classes.id, classId)).get();
const course = assignment.courseId ? await db.select().from(courses).where(eq(courses.id, assignment.courseId)).get() : null;

// Get students in this class
const classEnrollments = await db.select().from(enrollments).where(eq(enrollments.classId, classId)).all();
const classStudents = classEnrollments.map(e => db.select().from(students).where(eq(students.id, e.studentId)).get()).filter(Boolean);

// Get data for each tab
const classAssignments = assignment.courseId
  ? await db.select().from(assignments).where(and(eq(assignments.courseId, assignment.courseId), eq(assignments.classId, classId))).orderBy(desc(assignments.createdAt)).all()
  : [];
const classQuizzes = assignment.courseId
  ? await db.select().from(quizzes).where(and(eq(quizzes.courseId, assignment.courseId))).orderBy(desc(quizzes.createdAt)).all()
  : [];
const courseUnitsList = assignment.courseId
  ? await db.select().from(courseUnits).where(eq(courseUnits.courseId, assignment.courseId)).orderBy(courseUnits.sortOrder).all()
  : [];
const allLessons = assignment.courseId
  ? await db.select().from(lessons).where(eq(lessons.courseId, assignment.courseId)).orderBy(lessons.sortOrder).all()
  : [];
const liveClasses = myStaff
  ? await db.select().from(liveClassRooms)
    .where(and(eq(liveClassRooms.classId, classId), eq(liveClassRooms.teacherId, myStaff.id)))
    .orderBy(desc(liveClassRooms.createdAt)).all()
  : [];
const discussionBoard = assignment.courseId
  ? await db.select().from(discussionBoards).where(and(eq(discussionBoards.courseId, assignment.courseId))).get()
  : null;
const classGrades = assignment.courseId
  ? await db.select().from(grades).where(eq(grades.courseId, assignment.courseId)).all()
  : [];

// Stats
const allSubmissions = await db.select().from(submissions).all();
const pendingSubmissions = classAssignments.reduce((count, a) => {
  const subs = allSubmissions.filter(s => s.assignmentId === a.id);
  return count + subs.filter(s => !s.gradedAt).length;
}, 0);

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
---

<TeacherPortalLayout title={`${assignment.subjectName} - ${classInfo?.name || 'Class'} - Teacher Portal`}>
  <div class="space-y-0">
    {/* Breadcrumb + header */}
    <div class="mb-6">
      <a href="/portal/teacher/classroom" class="text-sm text-gray-500 hover:text-gray-700 mb-2 inline-block">My Classes</a>
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{assignment.subjectName}</h1>
          <p class="text-sm text-gray-500">{classInfo?.name}{classInfo?.section ? ' - ' + classInfo.section : ''} - {classStudents.length} students</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="document.getElementById('liveClassModal').classList.remove('hidden')" class="px-3 py-2 text-xs font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            Start Live Class
          </button>
        </div>
      </div>
    </div>

    {/* Tabs */}
    <div class="bg-white rounded-xl border border-gray-200">
      <div class="border-b border-gray-200 overflow-x-auto">
        <nav class="flex -mb-px">
          <button onclick="switchTab('overview')" id="tab-overview" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-primary-500 text-primary-600 whitespace-nowrap">Overview</button>
          <button onclick="switchTab('lessons')" id="tab-lessons" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Lessons ({allLessons.length})</button>
          <button onclick="switchTab('assignments')" id="tab-assignments" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Assignments ({classAssignments.length})</button>
          <button onclick="switchTab('attendance')" id="tab-attendance" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Attendance</button>
          <button onclick="switchTab('assessments')" id="tab-assessments" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Assessments ({classQuizzes.length})</button>
          <button onclick="switchTab('live')" id="tab-live" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Live Class ({liveClasses.length})</button>
          <button onclick="switchTab('discussions')" id="tab-discussions" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Discussions</button>
          <button onclick="switchTab('gradebook')" id="tab-gradebook" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Gradebook</button>
          <button onclick="switchTab('students')" id="tab-students" class="tab-btn px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">Students ({classStudents.length})</button>
        </nav>
      </div>

      {/* Overview tab */}
      <div id="panel-overview" class="tab-panel p-6">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Students</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{classStudents.length}</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Assignments</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{classAssignments.length}</p>
          </div>
          <div class="bg-amber-50 rounded-lg p-4">
            <p class="text-xs font-medium text-amber-600 uppercase tracking-wider">Pending Grading</p>
            <p class="text-2xl font-bold text-amber-700 mt-1">{pendingSubmissions}</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Quizzes</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{classQuizzes.length}</p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* Recent assignments */}
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-3">Recent Assignments</h3>
            {classAssignments.length > 0 ? (
              <div class="space-y-2">
                {classAssignments.slice(0, 5).map(a => (
                  <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg">
                    <div>
                      <p class="text-sm font-medium text-gray-900">{a.title}</p>
                      <p class="text-xs text-gray-500">Due: {formatDate(a.dueDate)}</p>
                    </div>
                    <a href={`/portal/teacher/assignments?assignment=${a.id}`} class="text-xs text-primary-600 hover:underline">Manage</a>
                  </div>
                ))}
              </div>
            ) : <p class="text-sm text-gray-400">No assignments yet.</p>}
          </div>

          {/* Upcoming live classes */}
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-3">Live Classes</h3>
            {liveClasses.length > 0 ? (
              <div class="space-y-2">
                {liveClasses.slice(0, 5).map(lc => (
                  <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg">
                    <div>
                      <p class="text-sm font-medium text-gray-900">{lc.name}</p>
                      <p class="text-xs text-gray-500">{formatDate(lc.scheduledAt)}</p>
                    </div>
                    <span class:list={["text-[10px] font-bold uppercase px-2 py-0.5 rounded-full", lc.status === 'live' ? 'bg-red-100 text-red-700' : lc.status === 'scheduled' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-500']}>{lc.status}</span>
                  </div>
                ))}
              </div>
            ) : <p class="text-sm text-gray-400">No live classes scheduled.</p>}
          </div>
        </div>
      </div>

      {/* Lessons tab */}
      <div id="panel-lessons" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Lessons & Content</h3>
          <button onclick="document.getElementById('lessonModal').classList.remove('hidden')" class="px-3 py-1.5 text-xs font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Add Lesson</button>
        </div>
        {allLessons.length > 0 ? (
          <div class="space-y-2">
            {allLessons.map(l => (
              <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg">
                <div class="flex items-center gap-3">
                  <span class="text-xs font-bold text-gray-400">#{l.sortOrder || 0}</span>
                  <div>
                    <p class="text-sm font-medium text-gray-900">{l.title}</p>
                    <p class="text-xs text-gray-500 capitalize">{l.type}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  {l.isPublished ? <span class="text-[10px] font-bold uppercase text-green-600">Published</span> : <span class="text-[10px] font-bold uppercase text-gray-400">Draft</span>}
                </div>
              </div>
            ))}
          </div>
        ) : <p class="text-sm text-gray-400 py-8 text-center">No lessons yet. Add your first lesson.</p>}
      </div>

      {/* Assignments tab */}
      <div id="panel-assignments" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Assignments</h3>
          <button onclick="document.getElementById('assignModal').classList.remove('hidden')" class="px-3 py-1.5 text-xs font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create Assignment</button>
        </div>
        {classAssignments.length > 0 ? (
          <div class="space-y-2">
            {classAssignments.map(a => {
              const allSubs = db.select().from(submissions).where(eq(submissions.assignmentId, a.id)).all();
              const subCount = allSubs.length;
              const ungraded = allSubs.filter(s => !s.gradedAt).length;
              return (
                <a href={`/portal/teacher/grades?assignment=${a.id}`} class="flex items-center justify-between p-3 border border-gray-100 rounded-lg hover:bg-gray-50">
                  <div>
                    <p class="text-sm font-medium text-gray-900">{a.title}</p>
                    <p class="text-xs text-gray-500">Due: {formatDate(a.dueDate)} - {subCount} submissions</p>
                  </div>
                  {ungraded > 0 && <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">{ungraded} ungraded</span>}
                </a>
              );
            })}
          </div>
        ) : <p class="text-sm text-gray-400 py-8 text-center">No assignments yet.</p>}
      </div>

      {/* Attendance tab */}
      <div id="panel-attendance" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Take Attendance</h3>
          <a href={`/portal/teacher/attendance?class=${classId}`} class="px-3 py-1.5 text-xs font-medium text-primary-600 border border-primary-200 rounded-lg hover:bg-primary-50">Open Attendance Tool</a>
        </div>
        <p class="text-sm text-gray-500">Use the attendance tool to mark daily attendance for this class.</p>
      </div>

      {/* Assessments tab */}
      <div id="panel-assessments" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Quizzes & Assessments</h3>
          <a href="/dashboard/quizzes" class="px-3 py-1.5 text-xs font-medium text-primary-600 border border-primary-200 rounded-lg hover:bg-primary-50">Manage Quizzes</a>
        </div>
        {classQuizzes.length > 0 ? (
          <div class="space-y-2">
            {classQuizzes.map(q => (
              <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg">
                <div>
                  <p class="text-sm font-medium text-gray-900">{q.title}</p>
                  <p class="text-xs text-gray-500">{q.duration} min - Max: {q.maxScore || 'N/A'}</p>
                </div>
                <span class:list={["text-[10px] font-bold uppercase px-2 py-0.5 rounded-full", q.status === 'published' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500']}>{q.status}</span>
              </div>
            ))}
          </div>
        ) : <p class="text-sm text-gray-400 py-8 text-center">No quizzes yet.</p>}
      </div>

      {/* Live Class tab */}
      <div id="panel-live" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Live Classes</h3>
          <button onclick="document.getElementById('liveClassModal').classList.remove('hidden')" class="px-3 py-1.5 text-xs font-medium text-white bg-red-600 rounded-lg hover:bg-red-700">Schedule Live Class</button>
        </div>
        {liveClasses.length > 0 ? (
          <div class="space-y-2">
            {liveClasses.map(lc => (
              <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg">
                <div>
                  <p class="text-sm font-medium text-gray-900">{lc.name}</p>
                  <p class="text-xs text-gray-500">{formatDate(lc.scheduledAt)} - {lc.duration} min</p>
                </div>
                <div class="flex items-center gap-2">
                  <span class:list={["text-[10px] font-bold uppercase px-2 py-0.5 rounded-full", lc.status === 'live' ? 'bg-red-100 text-red-700' : lc.status === 'scheduled' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-500']}>{lc.status}</span>
                  <a href={`/dashboard/live-classes/${lc.id}`} class="text-xs text-primary-600 hover:underline">Open</a>
                </div>
              </div>
            ))}
          </div>
        ) : <p class="text-sm text-gray-400 py-8 text-center">No live classes scheduled. Click "Start Live Class" to begin.</p>}
      </div>

      {/* Discussions tab */}
      <div id="panel-discussions" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Discussion Board</h3>
          {discussionBoard ? (
            <a href={`/dashboard/discussions/${discussionBoard.id}`} class="px-3 py-1.5 text-xs font-medium text-primary-600 border border-primary-200 rounded-lg hover:bg-primary-50">Open Discussion</a>
          ) : (
            <button onclick="createDiscussion()" class="px-3 py-1.5 text-xs font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create Discussion Board</button>
          )}
        </div>
        {discussionBoard ? (
          <p class="text-sm text-gray-500">Discussion board is active. Students can post questions and reply.</p>
        ) : (
          <p class="text-sm text-gray-400 py-8 text-center">No discussion board yet. Create one to enable student Q&A.</p>
        )}
      </div>

      {/* Gradebook tab */}
      <div id="panel-gradebook" class="tab-panel p-6 hidden">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-gray-900">Gradebook</h3>
          <a href={`/portal/teacher/grades?class=${classId}`} class="px-3 py-1.5 text-xs font-medium text-primary-600 border border-primary-200 rounded-lg hover:bg-primary-50">Open Gradebook</a>
        </div>
        {classStudents.length > 0 && classAssignments.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead class="bg-gray-50 border-b">
                <tr>
                  <th class="text-left py-2 px-3 font-medium text-gray-700 sticky left-0 bg-gray-50">Student</th>
                  {classAssignments.slice(0, 8).map(a => <th class="text-center py-2 px-2 font-medium text-gray-700 min-w-[60px]">{a.title.slice(0, 8)}</th>)}
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {classStudents.map(s => (
                  <tr class="hover:bg-gray-50">
                    <td class="py-2 px-3 text-gray-900 font-medium sticky left-0 bg-white">{s.firstName} {s.lastName}</td>
                    {classAssignments.slice(0, 8).map(a => {
                      const sub = db.select().from(submissions).where(and(eq(submissions.assignmentId, a.id), eq(submissions.studentId, s.id))).get();
                      return <td class="py-2 px-2 text-center">{sub?.score != null ? sub.score : '-'}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="text-sm text-gray-400 py-8 text-center">No gradebook data yet.</p>}
      </div>

      {/* Students tab */}
      <div id="panel-students" class="tab-panel p-6 hidden">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">Students in this class</h3>
        {classStudents.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {classStudents.map(s => (
              <div class="flex items-center gap-3 p-3 border border-gray-100 rounded-lg">
                {s.photoUrl ? <img src={s.photoUrl} alt={s.firstName} class="w-10 h-10 rounded-full object-cover" /> : <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-600">{s.firstName.charAt(0)}</div>}
                <div>
                  <p class="text-sm font-medium text-gray-900">{s.firstName} {s.lastName}</p>
                  <p class="text-xs text-gray-500">{s.studentId}</p>
                </div>
              </div>
            ))}
          </div>
        ) : <p class="text-sm text-gray-400 py-8 text-center">No students enrolled.</p>}
      </div>
    </div>
  </div>

  {/* Live class modal */}
  <div id="liveClassModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Schedule Live Class</h3>
        <button onclick="document.getElementById('liveClassModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="liveClassForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Class Title</label><input name="name" type="text" required placeholder="e.g., Algebra Review Session" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description (optional)</label><textarea name="description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Date & Time</label><input name="scheduledAt" type="datetime-local" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Duration (min)</label><input name="duration" type="number" value="60" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700">Schedule</button>
      </form>
    </div>
  </div>

  {/* Lesson modal */}
  <div id="lessonModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Add Lesson</h3>
        <button onclick="document.getElementById('lessonModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="lessonForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Lesson Title</label><input name="title" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Type</label><select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><option value="text">Text/Reading</option><option value="video">Video</option><option value="document">Document</option><option value="link">External Link</option></select></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Content / URL</label><textarea name="content" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Paste content or URL here..."></textarea></div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Add Lesson</button>
      </form>
    </div>
  </div>

  {/* Assignment modal */}
  <div id="assignModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-gray-900">Create Assignment</h3>
        <button onclick="document.getElementById('assignModal').classList.add('hidden')" class="text-gray-400" aria-label="Close"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      </div>
      <form id="assignForm" class="space-y-3">
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Title</label><input name="title" type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        <div><label class="block text-xs font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Due Date</label><input name="dueDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
          <div><label class="block text-xs font-medium text-gray-700 mb-1">Max Points</label><input name="maxPoints" type="number" value="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" /></div>
        </div>
        <button type="submit" class="w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">Create</button>
      </form>
    </div>
  </div>

  <div id="toast" class="fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg text-sm hidden z-50"></div>

  <script is:inline define:vars={{ classId, subjectId, schoolId, courseId: assignment.courseId, staffId: myStaff?.id }}>
    function switchTab(tab) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(b => { b.classList.remove('border-primary-500', 'text-primary-600'); b.classList.add('border-transparent', 'text-gray-500'); });
      document.getElementById('panel-' + tab)?.classList.remove('hidden');
      const btn = document.getElementById('tab-' + tab);
      btn?.classList.remove('border-transparent', 'text-gray-500');
      btn?.classList.add('border-primary-500', 'text-primary-600');
    }

    function showToast(msg, isError) {
      var t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg text-sm text-white z-50 ' + (isError ? 'bg-red-600' : 'bg-green-600');
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 3000);
    }

    // Live class form
    document.getElementById('liveClassForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var body = { schoolId, classId, teacherId: staffId, name: fd.get('name'), description: fd.get('description'), scheduledAt: fd.get('scheduledAt'), duration: parseInt(fd.get('duration')) };
      var res = await fetch('/api/dashboard/live-classes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) { showToast('Live class scheduled'); setTimeout(() => window.location.reload(), 1000); }
      else showToast('Failed', true);
    });

    // Lesson form
    document.getElementById('lessonForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      if (!courseId) { showToast('No course linked to this subject', true); return; }
      var body = { courseId, title: fd.get('title'), content: fd.get('content'), type: fd.get('type') };
      var res = await fetch('/api/dashboard/courses', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'add_lesson', ...body }) });
      if (res.ok) { showToast('Lesson added'); setTimeout(() => window.location.reload(), 1000); }
      else showToast('Failed', true);
    });

    // Assignment form
    document.getElementById('assignForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var fd = new FormData(this);
      var body = { schoolId, courseId, classId, title: fd.get('title'), description: fd.get('description'), dueDate: fd.get('dueDate'), maxPoints: parseFloat(fd.get('maxPoints')) };
      var res = await fetch('/api/portal/teacher/assignments', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) { showToast('Assignment created'); setTimeout(() => window.location.reload(), 1000); }
      else showToast('Failed', true);
    });

    // Create discussion board
    async function createDiscussion() {
      if (!courseId) { showToast('No course linked', true); return; }
      var res = await fetch('/api/dashboard/discussions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ schoolId, courseId, title: 'Discussion - ' + document.querySelector('h1').textContent, description: 'Q&A and discussions for this class' }) });
      if (res.ok) { showToast('Discussion board created'); setTimeout(() => window.location.reload(), 1000); }
      else showToast('Failed', true);
    }
  </script>
</TeacherPortalLayout>
