---
/**
 * Teacher Classroom — List of assigned classes
 *
 * Shows all classes the teacher is assigned to, with the subjects
 * they teach in each class. Clicking a class shows the subjects.
 */
import TeacherPortalLayout from '../../../../layouts/TeacherPortalLayout.astro';
import { getDb } from '../../../../lib/db/index.js';
import { classSubjects, classes, staff, enrollments, students } from '../../../../lib/db/schema.js';
import { eq, and } from 'drizzle-orm';
import { getStaffForUser, getUserSchoolId } from '../../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/teacher/classroom');

const staff = getStaffForUser(user.id);
const schoolId = getUserSchoolId(user);
const db = getDb();

// Get all class_subjects assigned to this teacher
const myAssignments = staff
  ? await db.select().from(classSubjects)
    .where(and(eq(classSubjects.teacherId, staff.id), eq(classSubjects.schoolId, schoolId || 0)))
    .all()
  : [];

// Group by class
const classMap: Record<number, { classInfo: any; subjects: any[] }> = {};
for (const a of myAssignments) {
  if (!classMap[a.classId]) {
    const cls = await db.select().from(classes).where(eq(classes.id, a.classId)).get();
    const studentCount = await db.select().from(enrollments).where(eq(enrollments.classId, a.classId)).all().length;
    classMap[a.classId] = { classInfo: cls, subjects: [] };
    if (cls) (classMap[a.classId] as any).studentCount = studentCount;
  }
  classMap[a.classId].subjects.push(a);
}

const assignedClasses = Object.values(classMap).filter(c => c.classInfo);
---

<TeacherPortalLayout title="My Classes - Teacher Portal">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">My Classes</h1>
      <p class="text-sm text-gray-500 mt-1">Classes and subjects assigned to you</p>
    </div>

    {assignedClasses.length > 0 ? (
      <div class="space-y-4">
        {assignedClasses.map(({ classInfo, subjects, studentCount }) => (
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="p-5 border-b border-gray-100" style="background:color-mix(in srgb, var(--primary, #2563eb) 5%, transparent)">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-lg font-bold text-gray-900">{classInfo.name}{classInfo.section ? ' - ' + classInfo.section : ''}</h2>
                  {classInfo.description && <p class="text-xs text-gray-500 mt-0.5">{classInfo.description}</p>}
                </div>
                <div class="text-right">
                  <p class="text-2xl font-bold text-gray-900">{studentCount || 0}</p>
                  <p class="text-xs text-gray-500">students</p>
                </div>
              </div>
            </div>
            <div class="p-5">
              <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Subjects you teach</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {subjects.map(s => (
                  <a href={`/portal/teacher/classroom/${s.classId}/${s.id}`} class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-primary-300 hover:shadow-sm transition-all">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background:color-mix(in srgb, var(--primary, #2563eb) 12%, transparent)">
                      <svg class="w-5 h-5" style="color:var(--primary, #2563eb)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-semibold text-gray-900 truncate">{s.subjectName}</p>
                      {s.description && <p class="text-xs text-gray-500 truncate">{s.description}</p>}
                    </div>
                    <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
        <p class="text-sm text-gray-500 mt-2">No classes assigned yet. Please contact your school administrator.</p>
      </div>
    )}
  </div>
</TeacherPortalLayout>
