---
import PortalShell from '../../../layouts/PortalShell.astro';
// Static shell (zero-workers deployment) — data via lightbase client runtime.
---
<PortalShell title="Portal - Teacher - Grades">
  <div id="lb-shell-banner" class="hidden"></div>
  <div id="lb-workspace"></div>
</PortalShell>
<script is:inline define:vars={{ shellMode: "portal", shellCollection: "", shellTitle: "Portal - Teacher - Grades", shellRoles: ["teacher","school_admin","super_admin"] }}>
  window.LB_SHELL = { mode: shellMode, collection: shellCollection, title: shellTitle, roles: shellRoles };
</script>
