---
/**
 * Teacher Portal - Gradebook
 *
 * Teachers can enter and edit grades for students. Shows submissions
 * for grading and a gradebook table view.
 */
import TeacherPortalLayout from '../../../layouts/TeacherPortalLayout.astro';
import { getDb } from '../../../lib/db/index.js';
import { assignments, submissions, students, grades, classes, enrollments } from '../../../lib/db/schema.js';
import { eq, and, desc, sql, inArray } from 'drizzle-orm';
import { getStaffForUser, getUserSchoolId } from '../../../lib/portal.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=/portal/teacher/grades');

const schoolId = getUserSchoolId(user);
const db = getDb();

const selectedAssignmentId = Astro.url.searchParams.get('assignment');
const selectedClassId = Astro.url.searchParams.get('class');

// Get assignments for the dropdown
const myAssignments = schoolId
  ? await db.select().from(assignments).where(eq(assignments.schoolId, schoolId)).orderBy(desc(assignments.createdAt)).all()
  : [];

// Get classes
const allClasses = schoolId ? await db.select().from(classes).where(eq(classes.schoolId, schoolId)).all() : [];

let submissionsToGrade: any[] = [];
let selectedAssignment: any = null;

if (selectedAssignmentId) {
  const aid = parseInt(selectedAssignmentId);
  selectedAssignment = await db.select().from(assignments).where(eq(assignments.id, aid)).get();

  if (selectedAssignment) {
    // Get all submissions for this assignment
    submissionsToGrade = await db.select({
      id: submissions.id,
      content: submissions.content,
      fileUrl: submissions.fileUrl,
      submittedAt: submissions.submittedAt,
      score: submissions.score,
      feedback: submissions.feedback,
      gradedAt: submissions.gradedAt,
      studentId: submissions.studentId,
      studentName: sql<string>`${students.firstName} || ' ' || ${students.lastName}`,
      studentPhoto: students.photoUrl,
      studentNumber: students.studentId,
    }).from(submissions)
      .leftJoin(students, eq(submissions.studentId, students.id))
      .where(eq(submissions.assignmentId, aid))
      .orderBy(desc(submissions.submittedAt)).all();
  }
}

const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
---

<TeacherPortalLayout title="Gradebook - Teacher Portal">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Gradebook</h1>
      <p class="text-sm text-gray-500 mt-1">Grade student submissions and enter scores</p>
    </div>

    {/* Assignment selector */}
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <label class="block text-xs font-medium text-gray-700 mb-1.5">Select Assignment to Grade</label>
      <select id="assignmentSelect" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none" onchange="if(this.value) window.location.href='/portal/teacher/grades?assignment='+this.value">
        <option value="">Choose an assignment...</option>
        {myAssignments.map(a => (
          <option value={a.id} selected={selectedAssignmentId === String(a.id)}>{a.title} (Due: {formatDate(a.dueDate)})</option>
        ))}
      </select>
    </div>

    {/* Submissions list */}
    {selectedAssignment ? (
      <div class="bg-white rounded-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-semibold text-gray-900">{selectedAssignment.title}</h2>
            <p class="text-xs text-gray-500 mt-0.5">{submissionsToGrade.length} submission{submissionsToGrade.length !== 1 ? 's' : ''} - Max points: {selectedAssignment.maxPoints || 'N/A'}</p>
          </div>
        </div>

        {submissionsToGrade.length > 0 ? (
          <div class="space-y-3">
            {submissionsToGrade.map(sub => (
              <div class="border border-gray-200 rounded-lg p-4" data-submission-id={sub.id}>
                <div class="flex items-start gap-3">
                  {sub.studentPhoto ? (
                    <img src={sub.studentPhoto} alt={sub.studentName} class="w-10 h-10 rounded-full object-cover" />
                  ) : (
                    <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-600">{sub.studentName?.charAt(0) || '?'}</div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2">
                      <div>
                        <p class="text-sm font-medium text-gray-900">{sub.studentName}</p>
                        <p class="text-xs text-gray-500">ID: {sub.studentNumber} - Submitted: {formatDate(sub.submittedAt)}</p>
                      </div>
                      {sub.gradedAt ? (
                        <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-700">GRADED</span>
                      ) : (
                        <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700">PENDING</span>
                      )}
                    </div>
                    {sub.content && (
                      <div class="mt-2 p-2 bg-gray-50 rounded text-xs text-gray-700 whitespace-pre-wrap">{sub.content}</div>
                    )}
                    {sub.fileUrl && (
                      <a href={sub.fileUrl} target="_blank" class="inline-flex items-center gap-1 mt-2 text-xs text-primary-600 hover:underline">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        View submission file
                      </a>
                    )}
                    {/* Grade entry */}
                    <div class="mt-3 flex items-center gap-3">
                      <input type="number" step="0.5" min="0" max={selectedAssignment.maxPoints || undefined} placeholder="Score" value={sub.score ?? ''} data-score-input={sub.id} class="w-24 px-2 py-1 border border-gray-300 rounded text-sm" />
                      {selectedAssignment.maxPoints && <span class="text-xs text-gray-500">/ {selectedAssignment.maxPoints}</span>}
                      <input type="text" placeholder="Feedback (optional)" value={sub.feedback || ''} data-feedback-input={sub.id} class="flex-1 px-2 py-1 border border-gray-300 rounded text-sm" />
                      <button onclick={`saveGrade(${sub.id})`} class="px-3 py-1 text-xs font-medium text-white bg-primary-600 rounded hover:bg-primary-700">Save</button>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="py-8 text-center">
            <p class="text-sm text-gray-500">No submissions for this assignment yet.</p>
          </div>
        )}
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <p class="text-sm text-gray-500 mt-2">Select an assignment to grade submissions.</p>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ schoolId }}>
    async function saveGrade(submissionId) {
      const score = document.querySelector(`[data-score-input="${submissionId}"]`)?.value;
      const feedback = document.querySelector(`[data-feedback-input="${submissionId}"]`)?.value || '';
      const res = await fetch('/api/portal/teacher/grades', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ submissionId: parseInt(submissionId), score: score ? parseFloat(score) : null, feedback, schoolId }),
      });
      if (res.ok) {
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg text-sm z-50';
        toast.textContent = 'Grade saved';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2000);
        setTimeout(() => window.location.reload(), 1500);
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Failed to save grade');
      }
    }
  </script>
</TeacherPortalLayout>
