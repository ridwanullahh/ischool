---
/**
 * Student Portal Layout
 *
 * Dedicated layout for the student portal with student-specific navigation,
 * welcome banner, and role-appropriate links. Only users with role 'student'
 * (or school_admin previewing) can access.
 */
import { validateSession, getSessionIdFromCookie } from '../lib/auth.js';
import { getStudentForUser, getUserSchoolId, getStudentClassName } from '../lib/portal.js';

const sessionId = getSessionIdFromCookie(Astro.request);
const result = sessionId ? await validateSession(sessionId) : null;
const user = result?.user;

if (!user) {
  return Astro.redirect('/auth/login?redirect=/portal/student');
}

// Only students and school_admins (previewing) can access the student portal
const allowedRoles = ['student', 'school_admin'];
if (!allowedRoles.includes(user.role)) {
  // Redirect to the appropriate portal for their role
  if (user.role === 'parent') return Astro.redirect('/portal/parent');
  if (user.role === 'teacher') return Astro.redirect('/portal/teacher');
  return Astro.redirect('/dashboard');
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const student = getStudentForUser(user.id);
const schoolId = getUserSchoolId(user.id);
const className = student ? getStudentClassName(student.id) : null;

const navItems = [
  { href: '/portal/student', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/portal/student/classroom', label: 'My Classes', icon: 'M12 14l9-5-9-5-9 5 9 5z' },
  { href: '/portal/student/timetable', label: 'Timetable', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { href: '/portal/student/assignments', label: 'Assignments', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { href: '/portal/student/quizzes', label: 'Quizzes', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
  { href: '/portal/student/grades', label: 'Grades', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { href: '/portal/student/attendance', label: 'Attendance', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { href: '/portal/student/fees', label: 'Fees', icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    (function() {
      if (typeof window !== 'undefined' && !document.querySelector('script[src*="tailwindcss"]')) {
        var s = document.createElement('script');
        s.src = 'https://cdn.tailwindcss.com';
        document.head.appendChild(s);
      }
    })();
  </script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="flex">
    <aside class="hidden lg:flex lg:flex-col lg:w-64 bg-white border-r border-gray-200 min-h-screen fixed">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-lg font-bold text-gray-900">Student Portal</h2>
        <p class="text-sm text-gray-500 mt-1">{user.name}</p>
        {student && (
          <div class="mt-2 text-xs text-gray-400">
            <p>ID: {student.studentId}</p>
            {className && <p>Class: {className}</p>}
          </div>
        )}
      </div>
      <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
        {navItems.map(item => (
          <a href={item.href} class:list={[
            'flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
            currentPath === item.href ? 'bg-primary-50 text-primary-700' : 'text-gray-600 hover:bg-gray-100'
          ]}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} /></svg>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="p-4 border-t border-gray-200">
        <a href="/dashboard" class="flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Back to Dashboard
        </a>
        <form method="POST" action="/api/auth/logout" class="mt-2">
          <button type="submit" class="text-sm text-red-600 hover:text-red-700">Sign Out</button>
        </form>
      </div>
    </aside>

    <main class="flex-1 lg:ml-64">
      <header class="sticky top-0 z-10 bg-white border-b border-gray-200 px-4 py-3 lg:hidden flex items-center justify-between">
        <h1 class="text-lg font-bold">Student Portal</h1>
        <button id="mobile-menu-btn" type="button" class="p-2 rounded-lg hover:bg-gray-100" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </header>

      <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-gray-200 px-4 py-2 space-y-1">
        {navItems.map(item => (
          <a href={item.href} class:list={[
            'block px-3 py-2 rounded-lg text-sm font-medium',
            currentPath === item.href ? 'bg-primary-50 text-primary-700' : 'text-gray-600'
          ]}>
            {item.label}
          </a>
        ))}
      </div>

      <div class="p-4 lg:p-8">
        <slot />
      </div>
    </main>
  </div>

  <script is:inline>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', function() {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
