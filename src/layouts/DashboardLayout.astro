import '../styles/global.css';
import { getDb } from '../lib/db/index.js';
import { schools, schoolMembers } from '../lib/db/schema.js';
import { eq } from 'drizzle-orm';
import CreateSchoolModal from '../components/CreateSchoolModal.astro';
import AIChatWidget from '../components/AIChatWidget.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title?: string;
}

const { title = 'Dashboard - iSchool' } = Astro.props;
const user = Astro.locals.user;
const { pathname } = Astro.url;

// Role-based access control: only admin-level roles can access the dashboard
if (user && (user.role === 'student' || user.role === 'teacher' || user.role === 'parent')) {
  if (user.role === 'student') return Astro.redirect('/portal/student');
  if (user.role === 'teacher') return Astro.redirect('/portal/teacher');
  if (user.role === 'parent') return Astro.redirect('/portal/parent');
}

let school = null;
if (user) {
  // The middleware pre-populates user.school and user.schoolId in both
  // Lightbase and SQLite modes. Use these directly to avoid an extra
  // async query in the layout.
  school = (user as any).school || null;
  if (!school) {
    try {
      const db = getDb();
      const membership = await db.select().from(schoolMembers).where(eq(schoolMembers.userId, user.id)).get();
      if (membership) {
        school = await db.select().from(schools).where(eq(schools.id, membership.schoolId)).get();
      }
    } catch (e) {
      // Lightbase or DB error — continue without school
    }
  }
}

