<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style is:inline>
      :root {
        --mosaic-bg: #F0F4F8;
        --mosaic-surface: #FFFFFF;
        --mosaic-surface-2: #F8FAFC;
        --mosaic-text: #0F172A;
        --mosaic-text-muted: #64748B;
        --mosaic-text-subtle: #94A3B8;
        --mosaic-border: #E2E8F0;
        --mosaic-primary: #05B34D;
        --mosaic-primary-dark: #049940;
        --mosaic-accent: #F2B91C;
        --mosaic-radius: 20px;
        --mosaic-radius-sm: 12px;
      }
      html.dark {
        --mosaic-bg: #0B1120;
        --mosaic-surface: #131C31;
        --mosaic-surface-2: #1A2741;
        --mosaic-text: #F1F5F9;
        --mosaic-text-muted: #94A3B8;
        --mosaic-text-subtle: #64748B;
        --mosaic-border: #1E293B;
      }
      .mosaic-body {
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--mosaic-bg);
        color: var(--mosaic-text);
        background-image: radial-gradient(circle at 1px 1px, rgba(5,179,77,0.06) 1px, transparent 0);
        background-size: 24px 24px;
      }
      html.dark .mosaic-body {
        background-image: radial-gradient(circle at 1px 1px, rgba(5,179,77,0.1) 1px, transparent 0);
      }
      .mosaic-card {
        background: var(--mosaic-surface);
        border: 1px solid var(--mosaic-border);
        border-radius: var(--mosaic-radius);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .mosaic-card:hover {
        border-color: var(--mosaic-primary);
        box-shadow: 0 12px 40px -8px rgba(5,179,77,0.18);
        transform: translateY(-2px);
      }
      .mosaic-gradient-text {
        background: linear-gradient(135deg, #05B34D 0%, #049940 50%, #036B2E 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .mosaic-nav-item {
        position: relative;
        transition: all 0.2s ease;
      }
      .mosaic-nav-item.active {
        background: linear-gradient(135deg, rgba(5,179,77,0.12) 0%, rgba(5,179,77,0.04) 100%);
        color: var(--mosaic-primary);
        font-weight: 600;
      }
      .mosaic-nav-item.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 60%;
        background: linear-gradient(180deg, #05B34D, #049940);
        border-radius: 0 4px 4px 0;
      }
      .mosaic-glow {
        position: relative;
        overflow: hidden;
      }
      .mosaic-glow::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(5,179,77,0.08) 0%, transparent 70%);
        pointer-events: none;
      }
      .mosaic-header {
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        background: color-mix(in srgb, var(--mosaic-surface) 80%, transparent);
        border: 1px solid var(--mosaic-border);
      }
      .mosaic-btn-primary {
        background: linear-gradient(135deg, #05B34D 0%, #049940 100%);
        color: white;
        font-weight: 600;
        border-radius: var(--mosaic-radius-sm);
        box-shadow: 0 4px 14px -2px rgba(5,179,77,0.35);
        transition: all 0.2s ease;
      }
      .mosaic-btn-primary:hover {
        box-shadow: 0 6px 20px -2px rgba(5,179,77,0.45);
        transform: translateY(-1px);
      }
      .mosaic-scroll::-webkit-scrollbar { width: 6px; }
      .mosaic-scroll::-webkit-scrollbar-track { background: transparent; }
      .mosaic-scroll::-webkit-scrollbar-thumb { background: var(--mosaic-border); border-radius: 3px; }
      .mosaic-scroll::-webkit-scrollbar-thumb:hover { background: var(--mosaic-text-subtle); }
      .mosaic-dot-pattern {
        background-image: radial-gradient(circle at 1px 1px, var(--mosaic-border) 1px, transparent 0);
        background-size: 16px 16px;
      }
    </style>
  </head>
  <body class="mosaic-body min-h-screen">
    <div class="flex min-h-screen">
      <!-- Desktop Sidebar - Mosaic Prograde -->
      <aside class="hidden lg:flex lg:flex-col lg:w-[260px] fixed inset-y-0 left-0 z-30" style="background: var(--mosaic-surface); border-right: 1px solid var(--mosaic-border);">
        <!-- Logo Header -->
        <div class="h-[68px] flex items-center gap-3 px-5" style="border-bottom: 1px solid var(--mosaic-border);">
          <div class="w-10 h-10 rounded-2xl flex items-center justify-center relative" style="background: linear-gradient(135deg, #05B34D 0%, #049940 100%); box-shadow: 0 6px 16px -4px rgba(5,179,77,0.4);">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <span class="font-bold text-sm block truncate" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{school?.name || 'iSchool'}</span>
            <span class="text-[11px] font-medium uppercase tracking-wider" style="color: var(--mosaic-text-subtle);">Admin Console</span>
          </div>
        </div>
        <!-- Navigation -->
        <nav class="flex-1 py-3 px-3 space-y-1 overflow-y-auto mosaic-scroll" style="max-height: calc(100vh - 16rem);">
          {menuSections.map((section) => (
            <div class="menu-section">
              <button class="section-toggle w-full flex items-center justify-between px-3 py-2 text-[11px] font-bold uppercase tracking-widest transition-colors" style="color: var(--mosaic-text-subtle);">
                <span>{section.label}</span>
                <svg class="w-3.5 h-3.5 transition-transform section-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="section-items mt-1 space-y-0.5" data-active={isSectionActive(section.items)}>
                {section.items.map(item => (
                  <a href={item.href} class:list={[
                    'mosaic-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-[13px] font-medium transition-all duration-200',
                    isActive(item.href) ? 'active' : '',
                  ]} style={isActive(item.href) ? '' : 'color: var(--mosaic-text-muted);'}>
                    <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} /></svg>
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
        <!-- User Profile -->
        <div class="p-3" style="border-top: 1px solid var(--mosaic-border);">
          {school && (
            <a href={`/${school?.slug || ''}`} target="_blank" class="flex items-center gap-2 text-[13px] font-medium mb-2 px-3 py-2 rounded-xl transition-all hover:bg-gray-50 dark:hover:bg-slate-800" style="color: var(--mosaic-primary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              View Website
            </a>
          )}
          <div class="flex items-center gap-3 p-2 rounded-xl transition-colors hover:bg-gray-50 dark:hover:bg-slate-800">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white relative" style="background: linear-gradient(135deg, #05B34D 0%, #049940 100%);">
              {user?.name?.charAt(0) || 'U'}
              <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-green-400 border-2" style="border-color: var(--mosaic-surface);"></div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[13px] font-semibold truncate" style="color: var(--mosaic-text);">{user?.name}</p>
              <p class="text-[11px] truncate" style="color: var(--mosaic-text-muted);">{user?.email}</p>
            </div>
          </div>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="w-full text-left text-[13px] px-3 py-2 rounded-xl transition-colors hover:bg-gray-50 dark:hover:bg-slate-800" style="color: var(--mosaic-text-muted);">
              Sign out
            </button>
          </form>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 flex flex-col min-w-0 lg:ml-[260px]">
        <!-- Floating Header -->
        <header class="mosaic-header sticky top-0 z-20 flex items-center justify-between px-4 lg:px-8 h-[60px] mx-4 mt-4 rounded-2xl">
          <div class="flex items-center gap-3">
            <button id="sidebar-toggle" class="lg:hidden p-2 rounded-xl hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors" style="color: var(--mosaic-text-muted);">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <h1 class="text-base font-bold" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{title.replace(' - iSchool', '').replace('- iSchool', '')}</h1>
          </div>
          <div class="flex items-center gap-2">
            <button id="darkModeToggle" class="p-2 rounded-xl transition-colors hover:bg-gray-100 dark:hover:bg-slate-700" style="color: var(--mosaic-text-muted);" title="Toggle dark mode">
              <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            </button>
            <select id="langSelector" class="text-xs rounded-xl px-3 py-2 cursor-pointer focus:outline-none font-medium" style="background: var(--mosaic-surface-2); border: 1px solid var(--mosaic-border); color: var(--mosaic-text-muted);">
              <option value="en">EN</option>
              <option value="ar">العربية</option>
              <option value="fr">FR</option>
              <option value="es">ES</option>
              <option value="de">DE</option>
              <option value="ur">اردو</option>
              <option value="tr">TR</option>
              <option value="id">ID</option>
              <option value="ha">HA</option>
            </select>
            <button id="openCreateSchool" class="mosaic-btn-primary text-sm px-4 py-2">
              + New School
            </button>
          </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 p-4 lg:p-6 overflow-auto">
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile Sidebar -->
    <div id="mobile-sidebar" class="fixed inset-0 z-50 hidden lg:hidden">
      <div id="sidebar-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <aside class="absolute left-0 top-0 bottom-0 w-72 overflow-y-auto shadow-2xl" style="background: var(--mosaic-surface);">
        <div class="h-[68px] flex items-center gap-3 px-5" style="border-bottom: 1px solid var(--mosaic-border);">
          <div class="w-10 h-10 rounded-2xl flex items-center justify-center" style="background: linear-gradient(135deg, #05B34D 0%, #049940 100%);">
            <span class="text-white font-bold text-sm" style="font-family: 'Space Grotesk', sans-serif;">iS</span>
          </div>
          <span class="font-bold text-sm" style="font-family: 'Space Grotesk', sans-serif; color: var(--mosaic-text);">{school?.name || 'iSchool'}</span>
        </div>
        <nav class="py-3 px-3 space-y-1">
          {menuSections.map((section) => (
            <div class="menu-section">
              <button class="section-toggle w-full flex items-center justify-between px-3 py-2 text-[11px] font-bold uppercase tracking-widest" style="color: var(--mosaic-text-subtle);">
                <span>{section.label}</span>
                <svg class="w-3.5 h-3.5 transition-transform section-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="section-items mt-1 space-y-0.5" data-active={isSectionActive(section.items)}>
                {section.items.map(item => (
                  <a href={item.href} class:list={[
                    'mosaic-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-[13px] font-medium transition-all',
                    isActive(item.href) ? 'active' : '',
                  ]} style={isActive(item.href) ? '' : 'color: var(--mosaic-text-muted);'}>
                    <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} /></svg>
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
        <div class="p-3" style="border-top: 1px solid var(--mosaic-border);">
          <div class="flex items-center gap-3 p-2">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white" style="background: linear-gradient(135deg, #05B34D 0%, #049940 100%);">
              {user?.name?.charAt(0) || 'U'}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[13px] font-semibold truncate" style="color: var(--mosaic-text);">{user?.name}</p>
              <p class="text-[11px] truncate" style="color: var(--mosaic-text-muted);">{user?.email}</p>
            </div>
          </div>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="w-full text-left text-[13px] px-3 py-2 rounded-xl" style="color: var(--mosaic-text-muted);">Sign out</button>
          </form>
        </div>
      </aside>
    </div>

    <CreateSchoolModal />
    <AIChatWidget />
    <Toast />
    <div id="google_translate_el" style="display:none"></div>
    <style is:inline>
      .goog-te-banner-frame.skiptranslate { display: none !important; }
      body { top: 0 !important; }
      .goog-logo-link, .goog-te-gadget span { display: none !important; }
      .goog-te-gadget { font-size: 0 !important; }
    </style>

    <script is:inline>
      if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
      var lang = localStorage.getItem('lang') || 'en';
      if (['ar','he','fa','ur'].indexOf(lang) !== -1) document.documentElement.setAttribute('dir', 'rtl');
      document.documentElement.setAttribute('lang', lang);
    </script>

    <script>
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('mobile-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      toggle?.addEventListener('click', () => sidebar?.classList.toggle('hidden'));
      overlay?.addEventListener('click', () => sidebar?.classList.add('hidden'));

      const darkToggle = document.getElementById('darkModeToggle');
      darkToggle?.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
      });

      const langSelector = document.getElementById('langSelector') as HTMLSelectElement;
      const savedLang = localStorage.getItem('lang') || 'en';
      if (langSelector) langSelector.value = savedLang;
      const rtlLangs = ['ar', 'he', 'fa', 'ur'];
      if (rtlLangs.includes(savedLang)) document.documentElement.setAttribute('dir', 'rtl');

      function initGoogleTranslate() {
        if ((window as any).google?.translate?.TranslateElement) {
          new (window as any).google.translate.TranslateElement({
            pageLanguage: 'en',
            includedLanguages: 'en,ar,fr,es,de,ur,tr,id,ha,hi,pt,ru,zh,ja,ko',
            autoDisplay: false,
          }, 'google_translate_el');
        }
      }

      function translatePage(lang: string) {
        const combo = document.querySelector('.goog-te-combo') as HTMLSelectElement;
        if (combo) { combo.value = lang; combo.dispatchEvent(new Event('change')); }
      }

      if (savedLang !== 'en') {
        const script = document.createElement('script');
        script.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateInit';
        script.async = true;
        document.head.appendChild(script);
        (window as any).googleTranslateInit = () => { initGoogleTranslate(); setTimeout(() => translatePage(savedLang), 500); };
      }

      langSelector?.addEventListener('change', () => {
        const lang = langSelector.value;
        localStorage.setItem('lang', lang);
        document.documentElement.setAttribute('dir', rtlLangs.includes(lang) ? 'rtl' : 'ltr');
        document.documentElement.setAttribute('lang', lang);
        if (lang === 'en') { location.reload(); return; }
        if (!(window as any).google?.translate) {
          const script = document.createElement('script');
          script.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateInit';
          script.async = true;
          document.head.appendChild(script);
          (window as any).googleTranslateInit = () => { initGoogleTranslate(); setTimeout(() => translatePage(lang), 500); };
        } else { initGoogleTranslate(); setTimeout(() => translatePage(lang), 200); }
      });

      document.querySelectorAll('.section-toggle').forEach(button => {
        const section = button.closest('.menu-section');
        const items = section?.querySelector('.section-items') as HTMLElement;
        const arrow = button.querySelector('.section-arrow') as HTMLElement;
        if (items && items.dataset.active === 'true') { items.style.display = 'block'; if (arrow) arrow.style.transform = 'rotate(0deg)'; }
        else { items.style.display = 'none'; if (arrow) arrow.style.transform = 'rotate(-90deg)'; }
        button.addEventListener('click', () => {
          const isHidden = items.style.display === 'none';
          items.style.display = isHidden ? 'block' : 'none';
          if (arrow) arrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(-90deg)';
        });
      });

      (window as any).exportCsv = async function(endpoint: string, params?: string) {
        try {
          const url = `/api/dashboard/${endpoint}?action=export${params ? '&' + params : ''}`;
          const res = await fetch(url);
          if (!res.ok) { (window as any).toast?.error('Export failed'); return; }
          const blob = await res.blob();
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = `${endpoint}-export-${new Date().toISOString().split('T')[0]}.csv`;
          a.click();
          URL.revokeObjectURL(a.href);
        } catch (e: any) { (window as any).toast?.error('Export error: ' + e.message); }
      };
    </script>
  </body>
</html>
