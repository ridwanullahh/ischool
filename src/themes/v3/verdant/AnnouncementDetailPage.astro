---
import { getSchoolAnnouncements } from '../../../lib/school-safe.ts';
import { getSocialIconPath } from '../_shared/social-icons';
interface Props { school: any; item: any; [key: string]: any; }
const { school, item } = Astro.props;
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const allAnnouncements = getSchoolAnnouncements(school.id);
const relatedAnnouncements = allAnnouncements.filter((a: any) => a.id !== item?.id).slice(0, 3);
const currentUrl = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321').toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(item?.title || '');
const shareLinks = [
  { label: 'Facebook', icon: getSocialIconPath('facebook'), url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: 'Twitter', icon: getSocialIconPath('twitter'), url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
  { label: 'WhatsApp', icon: getSocialIconPath('whatsapp'), url: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
  { label: 'LinkedIn', icon: getSocialIconPath('linkedin'), url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
].filter(s => s.icon);
const contentText = item?.content || '';
const wordCount = contentText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---
<div class="px-4 py-16">
  <article class="max-w-3xl mx-auto">
    <a href={`/${school.slug}/announcements`} class="inline-flex items-center gap-1.5 text-sm mb-6 hover:opacity-70" style="color:var(--muted)">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Announcements
    </a>

    <div class="verdant-surface verdant-organic p-8 sm:p-12">
      <div class="flex items-center gap-3 mb-5">
        {item?.isPinned && <span class="verdant-grad px-2 py-0.5 verdant-mono text-[10px] font-bold uppercase tracking-[0.18em] text-white rounded-full">Pinned</span>}
        <span class="verdant-mono text-[10px] uppercase tracking-[0.18em]" style="color:var(--primary)">{formatDate(item?.publishedAt || item?.createdAt)}</span>
        <span class="verdant-mono text-xs" style="color:var(--muted)">{readingTime} min read</span>
      </div>
      <h1 class="text-4xl sm:text-5xl mb-6 leading-[1.1] tracking-tight" style="color:var(--text)">{item?.title || 'Announcement'}</h1>
      {item?.imageUrl && <img src={item.imageUrl} alt={item.title} class="w-full rounded-[28px] mb-8" />}
      <div class="prose max-w-none whitespace-pre-wrap leading-relaxed text-[1.05rem]" style="color:var(--text)">{item?.content || ''}</div>

      <div class="mt-10 pt-6 border-t" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
        <div class="flex items-center gap-4 flex-wrap">
          <span class="verdant-mono text-[10px] uppercase tracking-[0.18em]" style="color:var(--text)">share this announcement</span>
          <div class="flex items-center gap-2">
            {shareLinks.map(s => (
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.label}`} class="verdant-surface p-2.5 rounded-full hover:scale-110 transition-transform">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path d={s.icon} /></svg>
              </a>
            ))}
            <button type="button" data-copy-url={currentUrl} aria-label="Copy link" class="verdant-surface p-2.5 rounded-full hover:scale-110 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    {relatedAnnouncements.length > 0 && (
      <section class="mt-16">
        <div class="flex items-center gap-3 mb-6"><h2 class="text-3xl tracking-tight" style="color:var(--text)">More announcements</h2><div class="flex-1 h-px" style="background:color-mix(in srgb, var(--border) 60%, transparent)"></div></div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedAnnouncements.map((a: any) => (
            <a href={`/${school.slug}/announcements/${a.slug || a.id}`} class="verdant-surface verdant-organic p-5 hover:-translate-y-1 transition-transform block group">
              {a.isPinned && <span class="verdant-grad px-2 py-0.5 verdant-mono text-[10px] font-bold uppercase tracking-[0.18em] text-white rounded-full mb-2 inline-block">Pinned</span>}
              <h3 class="text-lg mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{a.title}</h3>
              <p class="verdant-mono text-[10px] uppercase tracking-[0.18em]" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</div>

<script is:inline set:html={`(function(){
  document.querySelectorAll('[data-copy-url]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url = btn.getAttribute('data-copy-url');
      navigator.clipboard.writeText(url).then(function() {
        var original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(function() { btn.innerHTML = original; }, 2000);
      });
    });
  });
})();`} />
