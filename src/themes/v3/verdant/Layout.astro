---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const year = new Date().getFullYear();
import PageLoader from '../../../components/PageLoader.astro';
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Bricolage Grotesque', system-ui, sans-serif; color: var(--text); min-height: 100vh; position: relative; overflow-x: hidden; }
    h1, h2, h3, h4 { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; letter-spacing: -0.02em; }
    .verdant-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
    .verdant-leaf-bg { position: absolute; pointer-events: none; opacity: 0.07; z-index: 0; }
    html.dark .verdant-leaf-bg { opacity: 0.05; }
    .verdant-surface { background: var(--surface); border: 1px solid color-mix(in srgb, var(--border) 70%, transparent); }
    .verdant-soft { background: color-mix(in srgb, var(--primary) 6%, var(--surface)); border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); }
    .verdant-grad { background: linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--primary) 60%, #34d399)); }
    .verdant-grad-text { background: linear-gradient(135deg, var(--primary), #34d399); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .verdant-organic { border-radius: 28px 36px 30px 38px; }
    .verdant-organic-2 { border-radius: 38px 28px 40px 30px; }
    .verdant-pill { background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); }
    .verdant-dot::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 9999px; background: var(--primary); margin-right: 8px; vertical-align: middle; }
  `} />
</head>
<body>
    <PageLoader />
  <svg class="verdant-leaf-bg" style="top:40px;right:-40px;width:280px" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M50 5 C20 25 15 60 50 95 C85 60 80 25 50 5 Z M50 15 V90" stroke="var(--primary)" stroke-width="2" fill="var(--primary)"/></svg>
  <svg class="verdant-leaf-bg" style="bottom:120px;left:-60px;width:340px;transform:rotate(35deg)" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M50 5 C20 25 15 60 50 95 C85 60 80 25 50 5 Z M50 15 V90" stroke="var(--primary)" stroke-width="2" fill="var(--primary)"/></svg>

    <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

<header class="relative z-20 px-4 sm:px-6 pt-5">
    <nav class="verdant-organic max-w-6xl mx-auto verdant-surface shadow-sm">
      <div class="flex items-center justify-between h-16 px-5">
        <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
          {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-9 w-auto rounded-xl" /> : <span class="inline-flex h-9 w-9 items-center justify-center rounded-2xl text-white verdant-grad"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C7 6 4 10 4 14a8 8 0 0016 0c0-4-3-8-8-12z"/></svg></span>}
          <span class="text-base font-bold tracking-tight" style="color:var(--text)">{school.name}</span>
        </a>
        <div class="hidden lg:flex items-center gap-1">
          {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class:list={["px-3.5 py-2 text-sm font-medium rounded-full transition-colors", active ? "text-white" : "hover:bg-[color-mix(in_srgb,var(--primary)_8%,transparent)]"]} style={active ? "background:var(--primary);color:#fff" : "color:var(--muted)"}>{item.label}</a>; })}
        </div>
        <div class="flex items-center gap-2">
          <LanguageSelector />
          <button id="theme-toggle" type="button" class="verdant-surface p-2 rounded-full" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
          <a href={`${prefix}/admissions`} class="hidden sm:inline-flex verdant-grad px-4 py-2 text-sm font-semibold text-white rounded-full shadow-md">Apply</a>
          <button id="verdant-menu-toggle" type="button" class="lg:hidden verdant-surface p-2 rounded-full" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        </div>
      </div>
      <div id="verdant-mobile-nav" class="lg:hidden hidden border-t px-4 pb-4 pt-3 space-y-1" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class:list={["block px-4 py-2.5 text-sm font-medium rounded-full", active ? "text-white" : ""]} style={active ? "background:var(--primary);color:#fff" : "color:var(--text)"}>{item.label}</a>; })}
      </div>
    </nav>
  </header>

  <main class="relative z-10"><slot /></main>

  <footer class="relative z-10 mt-24 px-4 pb-10">
    <div class="verdant-organic-2 max-w-6xl mx-auto verdant-soft p-8 sm:p-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-xl" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl text-white verdant-grad"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C7 6 4 10 4 14a8 8 0 0016 0c0-4-3-8-8-12z"/></svg></span>}
            <span class="text-lg font-bold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm max-w-md leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-5">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="verdant-surface p-2.5 rounded-full hover:scale-110 transition-transform"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div><h3 class="verdant-mono text-[11px] font-semibold uppercase tracking-[0.2em] mb-4" style="color:var(--muted)">/ explore</h3><ul class="space-y-2.5">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70 transition-opacity" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><h3 class="verdant-mono text-[11px] font-semibold uppercase tracking-[0.2em] mb-4" style="color:var(--muted)">/ contact</h3><ul class="space-y-2.5">{contacts.slice(0,5).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block verdant-mono text-[10px]" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul></div>
      </div>
      <div class="mt-10 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-3" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
        <p class="verdant-mono text-xs" style="color:var(--muted)">&copy; {year} {school.name} — all rights reserved</p>
        <a href="/" class="verdant-mono text-xs font-medium hover:underline" style="color:var(--primary)">powered by iSchool</a>
      </div>
    </div>
  </footer>
<button id="verdant-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 verdant-grad p-4 rounded-2xl shadow-2xl hover:scale-105 transition-transform" aria-label="Open chat"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="verdant-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] verdant-surface rounded-3xl shadow-2xl hidden flex-col overflow-hidden" style="max-height:70vh">
    <div class="verdant-grad px-5 py-4"><p class="text-sm font-bold text-white">{school.name} Assistant</p><p class="verdant-mono text-[11px] text-white/80">ask us anything</p></div>
    <div id="verdant-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"><div class="verdant-soft rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]" style="color:var(--text)">How can we help you grow today?</div></div>
    <form id="verdant-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
      <input id="verdant-chat-input" type="text" placeholder="Type a message..." class="flex-1 verdant-soft rounded-full px-4 py-2 text-sm outline-none" style="color:var(--text)" aria-label="Message" />
      <button type="submit" class="verdant-grad p-2.5 rounded-full" aria-label="Send"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('verdant-menu-toggle'),d=document.getElementById('verdant-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('verdant-chat-toggle'),cp=document.getElementById('verdant-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('verdant-chat-form'),i=document.getElementById('verdant-chat-input'),m=document.getElementById('verdant-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var v=i.value.trim();if(!v)return;
      var b=document.createElement('div');b.className='verdant-soft rounded-2xl rounded-tr-sm px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=v;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:v})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='verdant-soft rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='verdant-soft rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
