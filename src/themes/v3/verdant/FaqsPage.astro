---
interface Props { school: any; items?: any[]; [key: string]: any; }
const { school, items = [] } = Astro.props;
const faqs = Array.isArray(items) ? items : [];
const byCat: Record<string, any[]> = {};
faqs.forEach(f => { const c = f.category || 'General'; (byCat[c] = byCat[c] || []).push(f); });
const categories = Object.keys(byCat);
---
<div class="px-4 py-16">
  <div class="max-w-3xl mx-auto">
    <p class="verdant-mono text-[11px] uppercase tracking-[0.2em] mb-3" style="color:var(--primary)">/ help center</p>
    <h1 class="text-5xl sm:text-6xl mb-10 leading-[1.05] tracking-tight" style="color:var(--text)">Frequently asked questions</h1>

    {categories.length === 0 && (
      <div class="verdant-surface verdant-organic p-8 text-center">
        <p class="text-sm" style="color:var(--muted)">No FAQs have been published yet.</p>
      </div>
    )}

    <div class="space-y-10">
      {categories.map(cat => (
        <section>
          <div class="flex items-center gap-3 mb-4"><h2 class="text-2xl tracking-tight" style="color:var(--text)">{cat}</h2><div class="flex-1 h-px" style="background:color-mix(in srgb, var(--border) 60%, transparent)"></div></div>
          <div class="space-y-3">
            {byCat[cat].map(faq => (
              <details class="verdant-surface verdant-organic p-5 group">
                <summary class="flex items-center justify-between cursor-pointer list-none font-semibold" style="color:var(--text)">
                  <span>{faq.question}</span>
                  <svg class="w-5 h-5 flex-shrink-0 ml-3 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </summary>
                <p class="mt-4 text-sm leading-relaxed" style="color:var(--muted)">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</div>
