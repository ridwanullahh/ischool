---
import { getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';
interface Props { school: any; [key: string]: any; }
const { school } = Astro.props;
const contacts = getSchoolContacts(school.id);
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
---
<div class="px-4 py-16">
  <div class="max-w-5xl mx-auto">
    <p class="verdant-mono text-[11px] uppercase tracking-[0.2em] mb-3" style="color:var(--primary)">/ get in touch</p>
    <h1 class="text-5xl sm:text-6xl mb-10 leading-[1.05] tracking-tight" style="color:var(--text)">Contact us</h1>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
      <div class="lg:col-span-2 space-y-5">
        <div class="verdant-surface verdant-organic p-7">
          <h3 class="text-xl mb-5 tracking-tight" style="color:var(--text)">Contact information</h3>
          <ul class="space-y-4">
            {contacts.map(c => <li><p class="verdant-mono text-[10px] uppercase tracking-[0.18em] mb-1" style="color:var(--primary)">{c.label || 'Contact'}</p><p class="text-sm" style="color:var(--text)">{c.value}</p></li>)}
            {contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info available.</li>}
          </ul>
          {socialEntries.length > 0 && (
            <div class="mt-6 pt-6 border-t" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
              <p class="verdant-mono text-[10px] uppercase tracking-[0.18em] mb-3" style="color:var(--muted)">/ follow us</p>
              <div class="flex items-center gap-2">
                {socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="verdant-surface p-2.5 rounded-full hover:scale-110 transition-transform"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)" aria-hidden="true"><path d={path} /></svg></a>; })}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="lg:col-span-3">
        <div class="verdant-surface verdant-organic-2 p-7">
          <h3 class="text-xl mb-5 tracking-tight" style="color:var(--text)">Send a message</h3>
          <form id="contactForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block verdant-mono text-[10px] uppercase tracking-[0.18em] mb-2" style="color:var(--muted)">Name</label>
                <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-2xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
              </div>
              <div>
                <label class="block verdant-mono text-[10px] uppercase tracking-[0.18em] mb-2" style="color:var(--muted)">Email</label>
                <input type="email" name="email" required class="w-full px-4 py-2.5 rounded-2xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block verdant-mono text-[10px] uppercase tracking-[0.18em] mb-2" style="color:var(--muted)">Phone</label>
                <input type="tel" name="phone" class="w-full px-4 py-2.5 rounded-2xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
              </div>
              <div>
                <label class="block verdant-mono text-[10px] uppercase tracking-[0.18em] mb-2" style="color:var(--muted)">Subject</label>
                <input type="text" name="subject" required class="w-full px-4 py-2.5 rounded-2xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
              </div>
            </div>
            <div>
              <label class="block verdant-mono text-[10px] uppercase tracking-[0.18em] mb-2" style="color:var(--muted)">Message</label>
              <textarea name="message" rows="5" required class="w-full px-4 py-2.5 rounded-2xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)"></textarea>
            </div>
            <div id="contactFormMessage" class="hidden"></div>
            <button type="submit" class="verdant-grad px-7 py-3 text-sm font-semibold text-white rounded-full">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ schoolSlug: school.slug }}>
  document.getElementById('contactForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    var msgEl = document.getElementById('contactFormMessage');
    var formData = new FormData(this); var data = {};
    formData.forEach(function(val, key) { data[key] = val; });
    data.action = 'create_ticket';
    msgEl.className = 'p-3 rounded-2xl text-sm'; msgEl.style.background = 'color-mix(in srgb, var(--primary) 10%, transparent)'; msgEl.style.color = 'var(--muted)'; msgEl.textContent = 'Sending...'; msgEl.classList.remove('hidden');
    try {
      var res = await fetch('/api/' + schoolSlug + '/support', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      var result = await res.json();
      if (res.ok) { msgEl.style.color = 'var(--text)'; msgEl.innerHTML = '<strong>Message sent successfully!</strong> We will get back to you soon.'; this.reset(); }
      else { throw new Error(result.error || 'Failed'); }
    } catch(err) {
      msgEl.style.background = 'rgba(239,68,68,0.1)'; msgEl.style.color = '#dc2626'; msgEl.textContent = 'Failed to send: ' + (err.message || 'Unknown error');
    }
  });
</script>
