---
import { getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';
interface Props { school: any; [key: string]: any; }
const { school } = Astro.props;
const contacts = getSchoolContacts(school.id);
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
---
<div class="ma-feed space-y-4">
  <section class="ma-glass ma-glow rounded-[28px] p-6">
    <span class="ma-chip inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] rounded-full"><span class="w-1.5 h-1.5 rounded-full ma-grad"></span> Get in touch</span>
    <h1 class="text-2xl font-bold mt-3 leading-tight" style="color:var(--text)">Contact us</h1>
  </section>

  {contacts.length > 0 && (
    <section class="ma-glass p-5">
      <h2 class="text-sm font-semibold mb-3" style="color:var(--text)">Contact info</h2>
      <ul class="space-y-3">
        {contacts.map(c => <li><p class="text-[10px] font-semibold uppercase tracking-wider" style="color:var(--primary)">{c.label || 'Contact'}</p><p class="text-sm" style="color:var(--text)">{c.value}</p></li>)}
      </ul>
      {socialEntries.length > 0 && (
        <div class="flex items-center gap-2 mt-4 pt-4 border-t" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
          {socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="ma-glass p-2.5 rounded-xl ma-tap"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path d={path} /></svg></a>; })}
        </div>
      )}
    </section>
  )}

  <section class="ma-glass p-5">
    <h2 class="text-sm font-semibold mb-3" style="color:var(--text)">Send a message</h2>
    <form id="contactForm" class="space-y-3">
      <input type="text" name="name" required placeholder="Name" class="w-full px-4 py-3 rounded-xl text-sm outline-none border ma-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
      <input type="email" name="email" required placeholder="Email" class="w-full px-4 py-3 rounded-xl text-sm outline-none border ma-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
      <input type="tel" name="phone" placeholder="Phone" class="w-full px-4 py-3 rounded-xl text-sm outline-none border ma-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
      <input type="text" name="subject" required placeholder="Subject" class="w-full px-4 py-3 rounded-xl text-sm outline-none border ma-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
      <textarea name="message" rows="4" required placeholder="Message" class="w-full px-4 py-3 rounded-xl text-sm outline-none border ma-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)"></textarea>
      <div id="contactFormMessage" class="hidden"></div>
      <button type="submit" class="ma-grad text-white w-full py-3.5 rounded-xl text-sm font-semibold ma-tap">Send Message</button>
    </form>
  </section>
</div>

<script is:inline define:vars={{ schoolSlug: school.slug }}>
  document.getElementById('contactForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    var msgEl = document.getElementById('contactFormMessage');
    var formData = new FormData(this); var data = {};
    formData.forEach(function(val, key) { data[key] = val; });
    data.action = 'create_ticket';
    msgEl.className = 'p-3 rounded-xl text-sm'; msgEl.style.background = 'color-mix(in srgb, var(--primary) 12%, transparent)'; msgEl.style.color = 'var(--muted)'; msgEl.textContent = 'Sending...'; msgEl.classList.remove('hidden');
    try {
      var res = await fetch('/api/' + schoolSlug + '/support', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      var result = await res.json();
      if (res.ok) { msgEl.style.color = 'var(--text)'; msgEl.innerHTML = '<strong>Sent!</strong> We will reply soon.'; this.reset(); }
      else { throw new Error(result.error || 'Failed'); }
    } catch(err) { msgEl.style.background = 'rgba(239,68,68,0.1)'; msgEl.style.color = '#dc2626'; msgEl.textContent = 'Failed: ' + (err.message || 'Unknown error'); }
  });
</script>
