---
import { getSchoolNav } from '../../../lib/school.ts';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div class="space-y-4">
  <!-- Welcome Card -->
  <div class="mobile-auralis-card p-5">
    <div class="flex items-center gap-3 mb-3">
      {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="w-12 h-12 rounded-xl" /> : <div class="w-12 h-12 rounded-xl mobile-auralis-grad flex items-center justify-center text-white font-bold text-lg">{school.name.charAt(0)}</div>}
      <div>
        <h1 class="text-lg font-bold" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="text-xs" style="color:var(--muted)">{school.tagline}</p>}
      </div>
    </div>
    <a href={`${prefix}/admissions`} class="mobile-auralis-btn mobile-auralis-btn-primary w-full">Apply for Admission</a>
  </div>

  <!-- Stats -->
  {stats.length > 0 && (
    <div class="flex gap-3 overflow-x-auto pb-2" style="scrollbar-width:none">
      {stats.slice(0, 4).map(s => (
        <div class="mobile-auralis-card p-4 flex-shrink-0" style="min-width:120px">
          <div class="text-2xl font-bold" style="color:var(--primary)">{s.value}</div>
          <div class="text-xs" style="color:var(--muted)">{s.label}</div>
        </div>
      ))}
    </div>
  )}

  <!-- Value Proposition -->
  {about.valueProposition && (
    <div class="mobile-auralis-card p-5">
      <p class="text-sm font-medium leading-relaxed" style="color:var(--text)">{about.valueProposition}</p>
    </div>
  )}

  <!-- Features -->
  {features.length > 0 && (
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider mb-3 px-1" style="color:var(--muted)">Highlights</h2>
      <div class="flex gap-3 overflow-x-auto pb-2" style="scrollbar-width:none">
        {features.map(f => (
          <div class="mobile-auralis-card p-4 flex-shrink-0" style="min-width:200px">
            <div class="w-10 h-10 rounded-lg mobile-auralis-grad mb-3"></div>
            <h3 class="font-bold text-sm mb-1" style="color:var(--text)">{f.title}</h3>
            <p class="text-xs leading-relaxed" style="color:var(--muted)">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Programs -->
  {programs.length > 0 && (
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider mb-3 px-1" style="color:var(--muted)">Programs</h2>
      <div class="space-y-3">
        {programs.slice(0, 3).map(p2 => (
          <a href={`${prefix}/programs/${p2.slug || p2.id}`} class="mobile-auralis-card p-4 flex items-center gap-3 block">
            {p2.imageUrl && <img src={p2.imageUrl} alt={p2.name} class="w-16 h-16 rounded-lg object-cover flex-shrink-0" />}
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-sm" style="color:var(--text)">{p2.name}</h3>
              {p2.description && <p class="text-xs line-clamp-2" style="color:var(--muted)">{p2.description}</p>}
            </div>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Latest News -->
  {announcements.length > 0 && (
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider mb-3 px-1" style="color:var(--muted)">Latest News</h2>
      <div class="space-y-3">
        {announcements.map(a => (
          <a href={`${prefix}/announcements/${a.slug || a.id}`} class="mobile-auralis-card p-4 block">
            <div class="flex items-center gap-2 mb-1">
              {a.isPinned && <span class="mobile-auralis-pill" style="padding:2px 6px;font-size:9px">PINNED</span>}
              <span class="text-xs" style="color:var(--muted)">{formatDate(a.publishedAt || a.createdAt)}</span>
            </div>
            <h3 class="font-bold text-sm" style="color:var(--text)">{a.title}</h3>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- CTA -->
  <div class="mobile-auralis-card p-6 text-center" style="background:var(--primary)">
    <h2 class="text-base font-bold text-white mb-2">Ready to Apply?</h2>
    <p class="text-xs text-white/80 mb-4">Join our community of learners today.</p>
    <a href={`${prefix}/admissions`} class="mobile-auralis-btn bg-white w-full" style="color:var(--primary)">Apply Now</a>
  </div>
</div>
