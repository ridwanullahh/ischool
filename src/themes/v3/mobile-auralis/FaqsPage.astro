---
interface Props { school: any; items?: any[]; [key: string]: any; }
const { school, items = [] } = Astro.props;
const faqs = Array.isArray(items) ? items : [];
const byCat: Record<string, any[]> = {};
faqs.forEach(f => { const c = f.category || 'General'; (byCat[c] = byCat[c] || []).push(f); });
const categories = Object.keys(byCat);
---
<div class="ma-feed space-y-4">
  <section class="ma-glass ma-glow rounded-[28px] p-6">
    <span class="ma-chip inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] rounded-full"><span class="w-1.5 h-1.5 rounded-full ma-grad"></span> Help Center</span>
    <h1 class="text-2xl font-bold mt-3 leading-tight" style="color:var(--text)">FAQs</h1>
  </section>

  {categories.length === 0 && <div class="ma-glass p-5 text-center"><p class="text-sm" style="color:var(--muted)">No FAQs published yet.</p></div>}

  {categories.map(cat => (
    <section>
      <h2 class="text-sm font-semibold mb-2 px-1" style="color:var(--primary)">{cat}</h2>
      <div class="space-y-2.5">
        {byCat[cat].map(faq => (
          <details class="ma-glass p-4 group">
            <summary class="flex items-center justify-between cursor-pointer list-none text-sm font-semibold" style="color:var(--text)">
              <span class="pr-2">{faq.question}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </summary>
            <p class="mt-3 text-xs leading-relaxed" style="color:var(--muted)">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>
