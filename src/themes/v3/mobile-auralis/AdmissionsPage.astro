---
import { getSchoolAdmissionPeriods } from '../../../lib/school-safe.ts';
interface Props { school: any; [key: string]: any; }
const { school, ...rest } = Astro.props;
const prefix = '/' + school.slug;
const periods = Array.isArray(rest.items) ? rest.items : (Array.isArray((rest as any).admissionPeriods) ? (rest as any).admissionPeriods : getSchoolAdmissionPeriods(school.id));
const today = new Date().toISOString().split('T')[0];
const statusOf = (p: any) => {
  const open = p.openDate || p.open_date;
  const close = p.closeDate || p.close_date;
  if (close && close < today) return 'closed';
  if (open && open > today) return 'upcoming';
  return 'open';
};
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const open = periods.filter((p: any) => statusOf(p) === 'open');
const upcoming = periods.filter((p: any) => statusOf(p) === 'upcoming');
const closed = periods.filter((p: any) => statusOf(p) === 'closed');
const sections = [{ key: 'open', label: 'Open Now', items: open }, { key: 'upcoming', label: 'Upcoming', items: upcoming }, { key: 'closed', label: 'Closed', items: closed }].filter(s => s.items.length > 0);
---
<div class="ma-feed space-y-4">
  <section class="ma-glass ma-glow rounded-[28px] p-6">
    <span class="ma-chip inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] rounded-full"><span class="w-1.5 h-1.5 rounded-full ma-grad"></span> Admissions</span>
    <h1 class="text-2xl font-bold mt-3 leading-tight" style="color:var(--text)">Begin your journey</h1>
    <p class="text-sm mt-2" style="color:var(--muted)">We welcome families who share our commitment to excellence.</p>
  </section>

  {sections.length === 0 && <div class="ma-glass p-5 text-center"><p class="text-sm" style="color:var(--muted)">No admission periods configured. Contact us to learn more.</p></div>}

  {sections.map(sec => (
    <section>
      <h2 class="text-sm font-semibold mb-2 px-1" style="color:var(--primary)">{sec.label}</h2>
      <div class="space-y-3">
        {sec.items.map((p: any) => (
          <div class="ma-glass p-4">
            <h3 class="text-sm font-semibold" style="color:var(--text)">{p.name || p.title || 'Admission Period'}</h3>
            {(p.openDate || p.open_date) && <p class="text-xs mt-1" style="color:var(--muted)">Opens: {formatDate(p.openDate || p.open_date)}</p>}
            {(p.closeDate || p.close_date) && <p class="text-xs" style="color:var(--muted)">Closes: {formatDate(p.closeDate || p.close_date)}</p>}
            {p.description && <p class="text-xs line-clamp-3 mt-2" style="color:var(--muted)">{p.description}</p>}
            <div class="flex gap-2 mt-3">
              <a href={`/${school.slug}/admissions/${p.slug || p.id}`} class="ma-grad text-white px-4 py-2 rounded-xl text-xs font-semibold ma-tap">Details</a>
              {sec.key === 'open' && <a href={`/${school.slug}/admissions/${p.slug || p.id}/apply`} class="ma-chip px-4 py-2 rounded-xl text-xs font-semibold ma-tap">Apply</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="ma-glass p-5">
    <h2 class="text-sm font-semibold mb-3" style="color:var(--text)">How to apply</h2>
    <ol class="space-y-2 text-xs" style="color:var(--muted)">
      <li class="flex gap-2"><span class="ma-grad text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold flex-shrink-0">1</span><span>Complete the online application form.</span></li>
      <li class="flex gap-2"><span class="ma-grad text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold flex-shrink-0">2</span><span>Submit required documents.</span></li>
      <li class="flex gap-2"><span class="ma-grad text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold flex-shrink-0">3</span><span>Attend an assessment interview.</span></li>
      <li class="flex gap-2"><span class="ma-grad text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] font-bold flex-shrink-0">4</span><span>Receive your admission decision.</span></li>
    </ol>
    <a href={`/${school.slug}/contact`} class="ma-grad text-white block text-center mt-4 py-3 rounded-xl text-sm font-semibold ma-tap">Contact Admissions</a>
  </section>
</div>
