---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { getSchoolClasses } from '../../../lib/school-safe.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; item: any; [key: string]: any; }
const { school, item, ...rest } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';

// Related classes (same school, excluding current)
const allClasses = getSchoolClasses(school.id);
const relatedClasses = allClasses.filter((c: any) => c.id !== item?.id).slice(0, 3);

// Social share URLs
const currentUrl = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321').toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(item?.name || '');
const shareLinks = [
  { label: 'Facebook', icon: getSocialIconPath('facebook'), url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: 'Twitter', icon: getSocialIconPath('twitter'), url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
  { label: 'WhatsApp', icon: getSocialIconPath('whatsapp'), url: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
  { label: 'LinkedIn', icon: getSocialIconPath('linkedin'), url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
].filter(s => s.icon);

// Reading time estimate from content
const contentText = item?.content || item?.description || '';
const wordCount = contentText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---
<div class="px-4 py-16">
  <article class="max-w-4xl mx-auto">
    <a href={`${prefix}/classes`} class="inline-flex items-center gap-1.5 text-sm mb-6 hover:opacity-70" style="color:var(--muted)">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Classes
    </a>

    <div class="mobile-auralis-card rounded-3xl overflow-hidden">
      {item?.imageUrl && (
        <img src={item.imageUrl} alt={item.name} class="w-full h-64 sm:h-80 object-cover" />
      )}
      <div class="p-8 sm:p-12">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {item?.gradeLevel && <span class="mobile-auralis-grad px-3 py-1 text-xs font-bold uppercase tracking-wider text-white rounded-full">{item.gradeLevel}</span>}
          {item?.teacherName && <span class="text-sm" style="color:var(--muted)">Teacher: {item.teacherName}</span>}
          {item?.capacity && <span class="text-sm" style="color:var(--muted)">Capacity: {item.capacity}</span>}
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold mb-4" style="color:var(--text)">{item?.name || 'Class'}</h1>

        {item?.description && <p class="text-lg leading-relaxed mb-6" style="color:var(--muted)">{item.description}</p>}

        {contentText && (
          <>
            <div class="flex items-center gap-4 text-xs mb-6 pb-6 border-b" style="color:var(--muted);border-color:var(--border)">
              <span>{readingTime} min read</span>
            </div>
            <div class="prose max-w-none whitespace-pre-wrap leading-relaxed" style="color:var(--text)">{item.content}</div>
          </>
        )}

        <div class="mt-8 pt-6 border-t" style="border-color:var(--border)">
          <div class="flex items-center gap-4 flex-wrap">
            <span class="text-sm font-semibold" style="color:var(--text)">Share this class:</span>
            <div class="flex items-center gap-2">
              {shareLinks.map(s => (
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.label}`} class="mobile-auralis-card p-2.5 rounded-lg hover:scale-110 transition-transform">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path d={s.icon} /></svg>
                </a>
              ))}
              <button type="button" data-copy-url={currentUrl} aria-label="Copy link" class="mobile-auralis-card p-2.5 rounded-lg hover:scale-110 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {relatedClasses.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Explore Other Classes</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedClasses.map((c: any) => (
            <a href={`${prefix}/classes/${c.slug || c.id}`} class="mobile-auralis-card rounded-2xl p-6 hover:scale-105 transition-transform block group">
              <h3 class="font-bold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{c.name}</h3>
              {c.description && <p class="text-sm line-clamp-2" style="color:var(--muted)">{c.description}</p>}
              {c.gradeLevel && <span class="inline-block mt-3 text-xs font-semibold px-3 py-1 rounded-full" style="background:color-mix(in srgb, var(--primary) 10%, transparent);color:var(--primary)">{c.gradeLevel}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</div>

<script is:inline set:html={`(function(){
  document.querySelectorAll('[data-copy-url]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url = btn.getAttribute('data-copy-url');
      navigator.clipboard.writeText(url).then(function() {
        var original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(function() { btn.innerHTML = original; }, 2000);
      });
    });
  });
})();`} />
