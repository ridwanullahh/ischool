---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} - ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
import PageLoader from '../../../components/PageLoader.astro';
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Outfit', system-ui, sans-serif; color: var(--text); min-height: 100vh; overflow-x: hidden; }
    .auralis-serif { font-family: 'Instrument Serif', Georgia, serif; }
    .auralis-ribbon { position: fixed; top: 0; left: 0; right: 0; height: 400px; pointer-events: none; z-index: 0; overflow: hidden; }
    .auralis-ribbon svg { width: 100%; height: 100%; }
    .auralis-ribbon-1 { animation: auralis-flow 12s ease-in-out infinite alternate; }
    .auralis-ribbon-2 { animation: auralis-flow 16s ease-in-out infinite alternate-reverse; }
    @keyframes auralis-flow { 0% { transform: translateX(-50px) scaleY(1); } 100% { transform: translateX(50px) scaleY(1.1); } }
    .auralis-glass { background: color-mix(in srgb, var(--surface) 70%, transparent); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); border: 1px solid color-mix(in srgb, var(--border) 50%, transparent); border-radius: 20px; transition: all 0.3s ease; }
    .auralis-glass:hover { border-color: color-mix(in srgb, var(--primary) 30%, transparent); box-shadow: 0 0 30px color-mix(in srgb, var(--primary) 15%, transparent); }
    .auralis-glass-strong { background: color-mix(in srgb, var(--surface) 85%, transparent); backdrop-filter: blur(24px) saturate(200%); -webkit-backdrop-filter: blur(24px) saturate(200%); border: 1px solid color-mix(in srgb, var(--border) 40%, transparent); border-radius: 24px; }
    .auralis-grad { background: linear-gradient(135deg, var(--primary), var(--accent)); }
    .auralis-grad-text { background: linear-gradient(135deg, var(--primary), var(--accent)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .auralis-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 600; background: color-mix(in srgb, var(--primary) 10%, transparent); color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); }
    .auralis-nav-link { position: relative; font-size: 14px; font-weight: 500; padding: 8px 0; transition: color 0.2s; }
    .auralis-nav-link::after { content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 2px; background: var(--primary); border-radius: 2px; transition: width 0.3s ease; }
    .auralis-nav-link:hover::after, .auralis-nav-link[data-active="true"]::after { width: 100%; }
    @media (prefers-reduced-motion: reduce) { .auralis-ribbon { display: none; } .auralis-ribbon-1, .auralis-ribbon-2 { animation: none; } }
  `} />
</head>
<body>
    <PageLoader />
  <div class="auralis-ribbon" aria-hidden="true">
    <svg class="auralis-ribbon-1" viewBox="0 0 1440 400" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,200 C360,100 720,300 1080,200 C1260,150 1440,250 1440,200 L1440,0 L0,0 Z" fill="var(--primary)" opacity="0.06" />
      <path d="M0,250 C360,150 720,350 1080,250 C1260,200 1440,300 1440,250 L1440,0 L0,0 Z" fill="var(--accent)" opacity="0.04" />
    </svg>
    <svg class="auralis-ribbon-2" viewBox="0 0 1440 400" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,180 C480,80 960,280 1440,180 L1440,0 L0,0 Z" fill="var(--primary)" opacity="0.03" />
    </svg>
  </div>

    <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

<header class="relative z-50 px-4 sm:px-6 pt-6">
    <nav class="auralis-glass-strong max-w-6xl mx-auto rounded-2xl shadow-xl px-6 py-3 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-lg" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white font-bold auralis-grad">{school.name.charAt(0)}</span>}
        <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
      </a>
      <div class="hidden lg:flex items-center gap-7">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class="auralis-nav-link" data-active={active} style={active ? "color:var(--primary)" : "color:var(--muted)"}>{item.label}</a>; })}
      </div>
      <div class="flex items-center gap-2">
        <LanguageSelector />
        <button id="theme-toggle" type="button" class="auralis-glass p-2 rounded-lg" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
        <a href={`${prefix}/admissions`} class="hidden sm:inline-flex auralis-grad px-5 py-2 text-sm font-semibold text-white rounded-full shadow-md">Apply</a>
        <button id="auralis-menu-toggle" type="button" class="lg:hidden auralis-glass p-2 rounded-lg" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
    </nav>
    <div id="auralis-mobile-nav" class="lg:hidden hidden mt-2 auralis-glass-strong rounded-2xl p-4 space-y-1">
      {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class="block px-4 py-2.5 rounded-lg text-sm font-medium" style={active ? "background:var(--primary);color:#fff" : "color:var(--text)"}>{item.label}</a>; })}
    </div>
  </header>

  <main class="relative z-10"><slot /></main>

  <footer class="relative z-10 mt-20 px-4 pb-8">
    <div class="auralis-glass max-w-6xl mx-auto rounded-3xl p-8 sm:p-10">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-lg" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white font-bold auralis-grad">{school.name.charAt(0)}</span>}
            <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm max-w-md leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-5">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="auralis-glass p-2.5 rounded-lg hover:scale-110 transition-transform"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-4" style="color:var(--muted)">Explore</h3><ul class="space-y-2.5">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-4" style="color:var(--muted)">Contact</h3><ul class="space-y-2.5">{contacts.slice(0,5).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul></div>
      </div>
      <div class="mt-8 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-3" style="border-color:var(--border)">
        <p class="text-xs" style="color:var(--muted)">&copy; {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="text-xs font-medium hover:underline" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>
<button id="auralis-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 auralis-grad p-4 rounded-2xl shadow-2xl hover:scale-105 transition-transform" aria-label="Open chat"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="auralis-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] auralis-glass-strong rounded-2xl shadow-2xl hidden flex-col overflow-hidden" style="max-height:70vh">
    <div class="auralis-grad px-5 py-4"><p class="text-sm font-bold text-white">{school.name} Assistant</p><p class="text-[11px] text-white/80">Ask us anything</p></div>
    <div id="auralis-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"><div class="auralis-glass rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]" style="color:var(--text)">How can we help?</div></div>
    <form id="auralis-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)">
      <input id="auralis-chat-input" type="text" placeholder="Type..." class="flex-1 auralis-glass rounded-full px-4 py-2 text-sm outline-none" style="color:var(--text)" aria-label="Message" />
      <button type="submit" class="auralis-grad p-2.5 rounded-full" aria-label="Send"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('auralis-menu-toggle'),d=document.getElementById('auralis-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('auralis-chat-toggle'),cp=document.getElementById('auralis-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('auralis-chat-form'),i=document.getElementById('auralis-chat-input'),m=document.getElementById('auralis-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='auralis-glass rounded-xl rounded-tr-sm px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='auralis-glass rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='auralis-glass rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
