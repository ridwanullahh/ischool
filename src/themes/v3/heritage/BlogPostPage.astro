---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="py-16">
  <article class="max-w-3xl mx-auto px-4">
    <a href={`/${school.slug}/blog`} class="text-sm hover:opacity-70 mb-4 inline-block" style="color:var(--muted)">Back to Blog</a>
    <div class="border-t-2 border-b py-8" style="border-color:var(--text)">
      <h1 class="heritage-serif text-4xl font-bold mb-4" style="color:var(--text)">{data.item?.title || 'Post'}</h1>
      <p class="text-sm mb-6" style="color:var(--muted)">{formatDate(data.item?.publishedAt || data.item?.createdAt)}</p>
      {data.item?.coverImageUrl && <img src={data.item.coverImageUrl} alt={data.item.title} class="w-full mb-6" />}
      <div class="prose max-w-none whitespace-pre-wrap heritage-serif text-lg leading-relaxed" style="color:var(--text)">{data.item?.content || ''}</div>
    </div>
  </article>
</div>
