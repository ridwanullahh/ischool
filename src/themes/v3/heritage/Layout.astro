---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const primaryContact = contacts[0];
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Source Sans 3', Georgia, serif; color: var(--text); min-height: 100vh; }
    .heritage-serif { font-family: 'Playfair Display', Georgia, serif; }
    .heritage-rule { border-color: var(--text); }
    .heritage-nav-link { position: relative; padding-bottom: 0.25rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
    .heritage-nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--primary); transform: scaleX(0); transition: transform 0.25s; }
    .heritage-nav-link:hover::after, .heritage-nav-link[data-active="true"]::after { transform: scaleX(1); }
  `} />
</head>
<body>
  <!-- Utility bar -->
  <div class="border-b" style="background:var(--surface);border-color:var(--border)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-10 flex items-center justify-between text-xs">
      <div class="flex items-center gap-4" style="color:var(--muted)">
        {primaryContact && <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{primaryContact.value}</span>}
      </div>
      <div class="flex items-center gap-3">
        {socialEntries.slice(0,5).map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--muted)" class="hover:opacity-70"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}
        <span class="w-px h-3" style="background:var(--border)"></span>
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
      </div>
    </div>
  </div>
  <!-- Masthead -->
  <header class="border-b-2 heritage-rule" style="background:var(--bg)">
    <div class="max-w-7xl mx-auto px-4 py-8 text-center">
      <a href={`${prefix}/`} class="inline-flex flex-col items-center gap-2" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-12 w-auto" /> : <span class="heritage-serif text-3xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <h1 class="heritage-serif text-3xl sm:text-4xl font-bold tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="text-xs uppercase tracking-[0.2em]" style="color:var(--muted)">{school.tagline}</p>}
      </a>
    </div>
  </header>
  <!-- Nav -->
  <nav class="sticky top-0 z-40 border-y heritage-rule" style="background:var(--surface)" aria-label="Primary">
    <div class="max-w-7xl mx-auto px-4">
      <div class="hidden lg:flex items-center justify-center h-12 gap-8">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="heritage-nav-link" style="color:var(--text)">{item.label}</a>; })}
        <a href={`${prefix}/admissions`} class="heritage-nav-link" style="color:var(--primary)">Apply</a>
      </div>
      <div class="lg:hidden flex items-center justify-between h-12">
        <span class="heritage-serif text-lg font-bold" style="color:var(--text)">{school.name}</span>
        <button id="heritage-menu-toggle" type="button" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
      <div id="heritage-mobile-nav" class="lg:hidden hidden pb-4 flex flex-col items-center gap-3">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="heritage-nav-link" style="color:var(--text)">{item.label}</a>; })}</div>
    </div>
  </nav>
  <main><slot /></main>
  <!-- Footer -->
  <footer class="border-t-2 heritage-rule mt-20" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="text-center mb-8 pb-6 border-b heritage-rule"><p class="heritage-serif text-2xl font-bold" style="color:var(--text)">{school.name}</p>{school.tagline && <p class="heritage-serif italic text-xs mt-1" style="color:var(--muted)">— {school.tagline} —</p>}</div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5">
          <div class="flex items-center gap-3 mb-4">{school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto" /> : <span class="heritage-serif text-xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}<span class="heritage-serif text-xl font-bold" style="color:var(--text)">{school.name}</span></div>
          {school.tagline && <p class="text-sm italic heritage-serif" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-3 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--primary)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div class="md:col-span-1 hidden md:flex justify-center"><div class="w-px h-full" style="background:var(--border)"></div></div>
        <div class="md:col-span-3"><h3 class="heritage-serif text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b heritage-rule" style="color:var(--text)">Navigate</h3><ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--muted)">{item.label}</a></li>)}</ul></div>
        <div class="md:col-span-3"><h3 class="heritage-serif text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b heritage-rule" style="color:var(--text)">Contact</h3><ul class="space-y-3">{contacts.slice(0,4).map(c => <li class="text-sm" style="color:var(--muted)">{c.label && <span class="block text-xs uppercase tracking-wider mb-0.5" style="color:var(--primary)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul></div>
      </div>
      <div class="mt-10 pt-6 border-t heritage-rule flex flex-col sm:flex-row items-center justify-between gap-2"><p class="text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p><a href="/" class="text-xs uppercase tracking-widest hover:opacity-70" style="color:var(--primary)">Powered by iSchool</a></div>
    </div>
  </footer>
  <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />
  <button id="heritage-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 px-5 py-3 border-2 shadow-lg" style="background:var(--surface);border-color:var(--primary);color:var(--primary)" aria-label="Open chat"><span class="heritage-serif text-sm font-semibold">Inquire</span></button>
  <div id="heritage-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col shadow-2xl border-2" style="background:var(--surface);border-color:var(--primary);max-height:70vh">
    <div class="px-5 py-4 border-b text-center" style="border-color:color-mix(in srgb, var(--primary) 25%, var(--border))"><p class="heritage-serif text-lg font-bold" style="color:var(--text)">Inquiry Desk</p><p class="text-[9px] uppercase tracking-[0.3em]" style="color:var(--muted)">How may we assist?</p></div>
    <div id="heritage-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)"><div class="border-l-2 pl-3 text-sm italic heritage-serif" style="border-color:var(--primary);color:var(--muted)">Welcome. Please leave your question below.</div></div>
    <form id="heritage-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--primary) 20%, var(--border))"><input id="heritage-chat-input" type="text" placeholder="Your question..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none heritage-serif" style="border-color:var(--border);color:var(--text)" aria-label="Question" /><button type="submit" class="heritage-serif text-sm font-semibold px-3 py-1" style="color:var(--primary)">Send</button></form>
  </div>
  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('heritage-menu-toggle'),d=document.getElementById('heritage-mobile-nav');if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('heritage-chat-toggle'),cp=document.getElementById('heritage-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('heritage-chat-form'),i=document.getElementById('heritage-chat-input'),m=document.getElementById('heritage-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='text-sm text-right heritage-serif';b.style.color='var(--primary)';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='border-l-2 pl-3 text-sm italic heritage-serif';r.style.borderColor='var(--primary)';r.style.color='var(--muted)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='border-l-2 pl-3 text-sm italic heritage-serif';r.style.borderColor='var(--primary)';r.style.color='var(--muted)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
