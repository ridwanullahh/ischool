---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="py-16">
  <div class="max-w-4xl mx-auto px-4">
    <h1 class="heritage-serif text-4xl font-bold mb-8" style="color:var(--text)">Contact Us</h1>
    <div class="border-t-2 pt-8" style="border-color:var(--text)">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="heritage-serif text-xl font-bold mb-4" style="color:var(--text)">Contact Information</h3>
          <ul class="space-y-3">{contacts.map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs uppercase tracking-wider mb-0.5" style="color:var(--primary)">{c.label}</span>}{c.value}</li>)}
          {contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info available.</li>}</ul>
          {socialEntries.length > 0 && <div class="flex items-center gap-3 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--primary)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div>
          <h3 class="heritage-serif text-xl font-bold mb-4" style="color:var(--text)">Send a Message</h3>
          <form method="POST" action={`/api/${school.slug}/support`} class="space-y-3">
            <input type="text" name="name" placeholder="Your Name" required class="w-full border-b px-2 py-2 text-sm outline-none heritage-serif" style="border-color:var(--border);color:var(--text)" />
            <input type="email" name="email" placeholder="Your Email" required class="w-full border-b px-2 py-2 text-sm outline-none heritage-serif" style="border-color:var(--border);color:var(--text)" />
            <textarea name="message" rows="4" placeholder="Your Message" required class="w-full border-b px-2 py-2 text-sm outline-none heritage-serif" style="border-color:var(--border);color:var(--text)"></textarea>
            <button type="submit" class="px-6 py-2 text-sm font-bold uppercase tracking-wider text-white" style="background:var(--primary)">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
