---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="py-16">
  <div class="max-w-4xl mx-auto px-4">
    <h1 class="heritage-serif text-4xl font-bold mb-8" style="color:var(--text)">Announcements</h1>
    <div class="border-t-2" style="border-color:var(--text)"></div>
    <div class="divide-y" style="border-color:var(--border)">
      {(data.items || []).map(a => (
        <a href={`/${school.slug}/announcements/${a.slug}`} class="block py-6 hover:opacity-70">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <p class="text-xs uppercase tracking-wider mb-1" style="color:var(--muted)">{formatDate(a.publishedAt || a.createdAt)}</p>
              <h3 class="heritage-serif text-xl font-bold mb-1" style="color:var(--text)">{a.title}</h3>
              <p class="text-sm line-clamp-2" style="color:var(--muted)">{a.excerpt || a.content}</p>
            </div>
            {a.isPinned && <span class="text-[10px] font-bold uppercase px-2 py-0.5 text-white shrink-0" style="background:var(--primary)">Pinned</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</div>
