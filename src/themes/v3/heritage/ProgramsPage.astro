---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="py-16">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="heritage-serif text-4xl font-bold mb-8" style="color:var(--text)">Our Programs</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0">
      {(data.items || data.schoolPrograms || []).map((p, i) => (
        <a href={`/${school.slug}/programs/${p.slug}`} class="block p-8 border hover:bg-gray-50" style="border-color:var(--border)">
          <span class="heritage-serif text-4xl font-bold" style="color:var(--primary)">{String(i+1).padStart(2,'0')}</span>
          <h3 class="heritage-serif text-xl font-bold mt-2 mb-2" style="color:var(--text)">{p.name}</h3>
          {p.level && <p class="text-sm font-medium mb-2" style="color:var(--primary)">{p.level}</p>}
          {p.description && <p class="text-sm line-clamp-3" style="color:var(--muted)">{p.description}</p>}
        </a>
      ))}
    </div>
  </div>
</div>
