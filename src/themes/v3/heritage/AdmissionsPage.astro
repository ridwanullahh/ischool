---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="py-16">
  <div class="max-w-4xl mx-auto px-4">
    <h1 class="heritage-serif text-4xl font-bold mb-6" style="color:var(--text)">Admissions</h1>
    <div class="border-t-2 border-b py-8 mb-8" style="border-color:var(--text)">
      <p class="heritage-serif text-lg leading-relaxed mb-8" style="color:var(--muted)">Begin your journey with {school.name}. We welcome families who share our commitment to excellence in education and character development.</p>
      <div class="space-y-6">
        <div><h3 class="heritage-serif text-xl font-bold mb-3" style="color:var(--text)">Application Process</h3><ol class="space-y-2 text-sm" style="color:var(--muted)"><li>1. Complete the online application form</li><li>2. Submit required documents</li><li>3. Attend an assessment interview</li><li>4. Receive admission decision</li><li>5. Complete enrollment and fee payment</li></ol></div>
        <div><h3 class="heritage-serif text-xl font-bold mb-3" style="color:var(--text)">Required Documents</h3><ul class="space-y-1 text-sm" style="color:var(--muted)"><li>Birth certificate</li><li>Previous school records (if applicable)</li><li>Immunization records</li><li>Passport-size photographs</li></ul></div>
        <a href={`/${school.slug}/contact`} class="inline-flex px-6 py-3 text-sm font-bold uppercase tracking-wider text-white" style="background:var(--primary)">Contact Admissions</a>
      </div>
    </div>
  </div>
</div>
