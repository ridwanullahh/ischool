---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';

interface Props { school: any; items?: any[]; albums?: any[]; virtualTours?: any[]; categories?: string[]; [key: string]: any; }
const { school, items = [], albums = [], virtualTours = [], categories = [], ...rest } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const gallery = Array.isArray(items) ? items : [];
const albumList = Array.isArray(albums) ? albums : [];
const tourList = Array.isArray(virtualTours) ? virtualTours : [];
const categoryList = Array.isArray(categories) ? categories : [];
const getVal = (obj: any, camel: string, snake: string) => obj?.[camel] ?? obj?.[snake] ?? null;
---
<div class="px-4 py-16">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-extrabold mb-4" style="color:var(--text)">Gallery</h1>
    <p class="text-sm mb-8" style="color:var(--muted)">Explore moments from our school community.</p>

    {albumList.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Albums</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {albumList.map(album => {
            const cover = getVal(album, 'coverImageUrl', 'cover_image_url');
            const itemCount = gallery.filter(g => getVal(g, 'albumId', 'album_id') === album.id).length;
            return (
              <div class="tide-card rounded-2xl overflow-hidden cursor-pointer group" data-album-filter={album.id}>
                <div class="relative h-40 overflow-hidden">
                  {cover ? (
                    <img src={cover} alt={album.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform" loading="lazy" />
                  ) : (
                    <div class="w-full h-full tide-grad flex items-center justify-center">
                      <svg class="w-12 h-12 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-3">
                    <div>
                      <h3 class="text-white font-bold text-sm">{album.name}</h3>
                      <p class="text-white/80 text-xs">{itemCount} photo{itemCount !== 1 ? 's' : ''}</p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {categoryList.length > 1 && (
      <div class="flex flex-wrap gap-2 mb-8">
        <button type="button" class="gallery-filter-btn tide-grad px-4 py-2 text-sm font-semibold text-white rounded-full" data-category="all">All</button>
        {categoryList.map(cat => (
          <button type="button" class="gallery-filter-btn tide-card px-4 py-2 text-sm font-medium rounded-full" style="color:var(--text)" data-category={cat}>{cat}</button>
        ))}
      </div>
    )}

    {gallery.length > 0 ? (
      <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {gallery.map((item, i) => {
          const imageUrl = getVal(item, 'imageUrl', 'image_url');
          const title = item.title || item.caption || '';
          const caption = getVal(item, 'caption', 'caption');
          const category = item.category || 'General';
          const albumId = getVal(item, 'albumId', 'album_id');
          return (
            <div class="gallery-item tide-card rounded-2xl overflow-hidden cursor-pointer group" data-category={category} data-album={albumId || ''} data-index={i}>
              <div class="relative h-48 overflow-hidden">
                <img src={imageUrl} alt={title} class="w-full h-full object-cover group-hover:scale-110 transition-transform" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                  <div>
                    {title && <p class="text-white text-sm font-semibold">{title}</p>}
                    {caption && <p class="text-white/80 text-xs line-clamp-2">{caption}</p>}
                  </div>
                </div>
                <div class="absolute top-2 right-2 tide-grad rounded-full p-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="tide-card rounded-2xl p-12 text-center">
        <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <p class="text-lg font-semibold mb-2" style="color:var(--text)">No photos yet</p>
        <p class="text-sm" style="color:var(--muted)">Gallery images will appear here once added.</p>
      </div>
    )}

    {tourList.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Virtual Tours</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {tourList.map(tour => {
            const thumb = getVal(tour, 'thumbnailUrl', 'thumbnail_url');
            const embed = getVal(tour, 'embedUrl', 'embed_url');
            return (
              <div class="tide-card rounded-2xl overflow-hidden">
                <div class="relative h-56 overflow-hidden cursor-pointer" data-tour-embed={embed}>
                  {thumb && <img src={thumb} alt={tour.title} class="w-full h-full object-cover" loading="lazy" />}
                  <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                    <div class="tide-grad rounded-full p-5 shadow-2xl">
                      <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                </div>
                <div class="p-5">
                  <h3 class="font-bold mb-2" style="color:var(--text)">{tour.title}</h3>
                  {tour.description && <p class="text-sm line-clamp-2" style="color:var(--muted)">{tour.description}</p>}
                  {tour.location && <p class="text-xs mt-2" style="color:var(--muted)">Location: {tour.location}</p>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}
  </div>
</div>

<div id="gallery-lightbox" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4" style="background:rgba(0,0,0,0.9);backdrop-filter:blur(8px)">
  <button type="button" id="lightbox-close" class="absolute top-4 right-4 text-white p-2 rounded-full hover:bg-white/10" aria-label="Close">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <button type="button" id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white p-3 rounded-full hover:bg-white/10" aria-label="Previous">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button type="button" id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white p-3 rounded-full hover:bg-white/10" aria-label="Next">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="max-w-5xl max-h-[85vh] flex flex-col items-center">
    <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[75vh] rounded-lg" />
    <div id="lightbox-caption" class="text-white text-center mt-4 px-4"></div>
  </div>
</div>

<script is:inline set:html={`(function(){
  var galleryItems = document.querySelectorAll('.gallery-item');
  var lightbox = document.getElementById('gallery-lightbox');
  var lightboxImg = document.getElementById('lightbox-image');
  var lightboxCaption = document.getElementById('lightbox-caption');
  var currentIdx = 0;
  var visibleItems = [];

  function updateVisibleItems() {
    visibleItems = Array.from(galleryItems).filter(function(el) {
      return el.style.display !== 'none';
    });
  }

  function showImage(idx) {
    if (idx < 0) idx = visibleItems.length - 1;
    if (idx >= visibleItems.length) idx = 0;
    currentIdx = idx;
    var item = visibleItems[idx];
    if (!item) return;
    var img = item.querySelector('img');
    if (img) {
      lightboxImg.src = img.src;
      var titleEl = item.querySelector('p');
      lightboxCaption.textContent = titleEl ? titleEl.textContent : '';
    }
  }

  galleryItems.forEach(function(el, idx) {
    el.addEventListener('click', function() {
      updateVisibleItems();
      var itemIdx = visibleItems.indexOf(el);
      if (itemIdx >= 0) {
        showImage(itemIdx);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', function() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  });

  document.getElementById('lightbox-prev')?.addEventListener('click', function() {
    showImage(currentIdx - 1);
  });

  document.getElementById('lightbox-next')?.addEventListener('click', function() {
    showImage(currentIdx + 1);
  });

  lightbox?.addEventListener('click', function(e) {
    if (e.target === lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', function(e) {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') { lightbox.classList.add('hidden'); lightbox.classList.remove('flex'); document.body.style.overflow = ''; }
    else if (e.key === 'ArrowLeft') showImage(currentIdx - 1);
    else if (e.key === 'ArrowRight') showImage(currentIdx + 1);
  });

  // Category filter
  var filterBtns = document.querySelectorAll('.gallery-filter-btn');
  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var cat = btn.getAttribute('data-category');
      filterBtns.forEach(function(b) {
        b.classList.remove('tide-grad');
        b.classList.add('tide-card');
        b.style.color = 'var(--text)';
        b.classList.remove('text-white');
      });
      btn.classList.add('tide-grad');
      btn.classList.remove('tide-card');
      btn.classList.add('text-white');
      btn.style.color = '';

      galleryItems.forEach(function(el) {
        var elCat = el.getAttribute('data-category');
        if (cat === 'all' || elCat === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // Album filter
  document.querySelectorAll('[data-album-filter]')?.forEach(function(el) {
    el.addEventListener('click', function() {
      var albumId = el.getAttribute('data-album-filter');
      galleryItems.forEach(function(item) {
        var itemAlbum = item.getAttribute('data-album');
        if (!albumId || !itemAlbum || itemAlbum === albumId) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Virtual tour embed
  document.querySelectorAll('[data-tour-embed]')?.forEach(function(el) {
    el.addEventListener('click', function() {
      var embedUrl = el.getAttribute('data-tour-embed');
      var tourSection = el.closest('.tide-card');
      if (tourSection && embedUrl) {
        var imgContainer = el;
        imgContainer.innerHTML = '<iframe src="' + embedUrl + '" class="w-full h-full" frameborder="0" allowfullscreen></iframe>';
      }
    });
  });
})();`} />
