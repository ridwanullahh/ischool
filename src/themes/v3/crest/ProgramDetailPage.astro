---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { getSchoolPrograms } from '../../../lib/school-safe.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; item: any; [key: string]: any; }
const { school, item, ...rest } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';

// Related programs
const allPrograms = getSchoolPrograms(school.id);
const relatedPrograms = allPrograms.filter((p: any) => p.id !== item?.id).slice(0, 3);

// Social share URLs
const currentUrl = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321').toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(item?.name || '');
const shareLinks = [
  { label: 'Facebook', icon: getSocialIconPath('facebook'), url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: 'Twitter', icon: getSocialIconPath('twitter'), url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
  { label: 'WhatsApp', icon: getSocialIconPath('whatsapp'), url: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
  { label: 'LinkedIn', icon: getSocialIconPath('linkedin'), url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
].filter(s => s.icon);

// Reading time
const contentText = item?.content || item?.description || '';
const wordCount = contentText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---
<div class="px-4 py-16">
  <article class="max-w-4xl mx-auto">
    <a href={`/${school.slug}/programs`} class="inline-flex items-center gap-1.5 text-sm mb-6 hover:opacity-70" style="color:var(--muted)">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Programs
    </a>

    <div class="crest-card rounded-3xl overflow-hidden">
      {item?.imageUrl && <img src={item.imageUrl} alt={item.name} class="w-full h-64 sm:h-80 object-cover" />}
      <div class="p-8 sm:p-12">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {item?.level && <span class="crest-grad px-3 py-1 text-xs font-bold uppercase tracking-wider text-white rounded-full">{item.level}</span>}
          {item?.duration && <span class="text-sm" style="color:var(--muted)">Duration: {item.duration}</span>}
          <span class="text-xs" style="color:var(--muted)">{readingTime} min read</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold mb-4" style="color:var(--text)">{item?.name || 'Program'}</h1>

        {item?.description && <p class="text-lg leading-relaxed mb-6" style="color:var(--muted)">{item.description}</p>}

        {item?.content && (
          <div class="prose max-w-none whitespace-pre-wrap leading-relaxed mb-6" style="color:var(--text)">{item.content}</div>
        )}

        <a href={`/${school.slug}/admissions`} class="crest-grad inline-flex px-6 py-3 text-sm font-semibold text-white rounded-xl shadow-lg hover:scale-105 transition-transform">Apply Now</a>

        <!-- Social Share -->
        <div class="mt-8 pt-6 border-t" style="border-color:var(--border)">
          <div class="flex items-center gap-4 flex-wrap">
            <span class="text-sm font-semibold" style="color:var(--text)">Share this program:</span>
            <div class="flex items-center gap-2">
              {shareLinks.map(s => (
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.label}`} class="crest-card p-2.5 rounded-lg hover:scale-110 transition-transform">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path d={s.icon} /></svg>
                </a>
              ))}
              <button type="button" data-copy-url={currentUrl} aria-label="Copy link" class="crest-card p-2.5 rounded-lg hover:scale-110 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Programs -->
    {relatedPrograms.length > 0 && (
      <section class="mt-16">
        <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Explore More Programs</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPrograms.map((p: any) => (
            <a href={`/${school.slug}/programs/${p.slug || p.id}`} class="crest-card rounded-2xl overflow-hidden hover:scale-105 transition-transform block group">
              {p.imageUrl && <img src={p.imageUrl} alt={p.name} class="w-full h-32 object-cover" loading="lazy" />}
              <div class="p-5">
                <h3 class="font-bold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{p.name}</h3>
                {p.description && <p class="text-sm line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                {p.duration && <span class="inline-block mt-3 text-xs font-semibold px-3 py-1 rounded-full" style="background:color-mix(in srgb, var(--primary) 10%, transparent);color:var(--primary)">{p.duration}</span>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</div>

<script is:inline set:html={`(function(){
  document.querySelectorAll('[data-copy-url]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url = btn.getAttribute('data-copy-url');
      navigator.clipboard.writeText(url).then(function() {
        var original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(function() { btn.innerHTML = original; }, 2000);
      });
    });
  });
})();`} />
