---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div class="space-y-0">
  <!-- Hero: heraldic banner -->
  <section class="border-b" style="background:var(--bg);border-color:var(--border)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
      <div class="crest-divider max-w-xs mx-auto mb-6"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg></div>
      <span class="crest-pill">Anno Domini · Est. {new Date().getFullYear() - 50}</span>
      <h1 class="crest-display text-4xl sm:text-5xl lg:text-6xl font-bold mt-6 leading-tight" style="color:var(--text)">{school.name}</h1>
      {school.tagline && <p class="crest-body italic text-lg sm:text-xl mt-5 max-w-2xl mx-auto leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${prefix}/admissions`} class="crest-display inline-flex items-center justify-center px-7 py-3 text-xs font-bold uppercase tracking-[0.2em] text-white crest-grad">Apply for Admission</a>
        <a href={`${prefix}/about`} class="crest-display inline-flex items-center justify-center px-7 py-3 text-xs font-bold uppercase tracking-[0.2em] border-2" style="border-color:var(--primary);color:var(--primary)">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Latest announcement bar -->
  {announcements.length > 0 && (
    <a href={`${prefix}/announcements/${announcements[0].slug || announcements[0].id}`} class="block border-b hover:opacity-90" style="background:var(--primary);border-color:var(--border)">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-center gap-3">
        <span class="crest-display text-[10px] font-bold uppercase tracking-[0.2em] text-white border border-white/40 px-2 py-0.5">Herald</span>
        <span class="text-sm font-medium text-white">{announcements[0].title}</span>
      </div>
    </a>
  )}

  <!-- Value proposition -->
  {about.valueProposition && (
    <section class="py-16" style="background:var(--surface)">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <span class="crest-pill mb-4">Our Charter</span>
        <p class="crest-body text-xl sm:text-2xl italic leading-relaxed mt-4" style="color:var(--text)">{about.valueProposition}</p>
      </div>
    </section>
  )}

  <!-- Features: heraldic shield cards -->
  {features.length > 0 && (
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <div class="crest-divider max-w-xs mx-auto mb-4"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg></div>
          <h2 class="crest-display text-2xl sm:text-3xl font-bold" style="color:var(--text)">Hallmarks of Distinction</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <div class="crest-card p-7">
              <div class="flex items-center gap-3 mb-4">
                <span class="crest-seal crest-display text-sm font-bold">{String(i + 1).padStart(2, '0')}</span>
                <span class="crest-display text-[10px] uppercase tracking-[0.2em]" style="color:var(--primary)">Hallmark {String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="crest-display text-lg font-bold mb-2" style="color:var(--text)">{f.title}</h3>
              <p class="crest-body text-sm leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Programs: shield-numbered cards -->
  {programs.length > 0 && (
    <section class="py-20" style="background:var(--surface)">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <div class="crest-divider max-w-xs mx-auto mb-4"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg></div>
          <h2 class="crest-display text-2xl sm:text-3xl font-bold" style="color:var(--text)">Faculties of Learning</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {programs.slice(0, 4).map((p, i) => (
            <a href={`${prefix}/programs/${p.slug || p.id}`} class="crest-card p-6 block">
              <span class="crest-display text-3xl font-bold" style="color:var(--primary)">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="crest-display text-base font-bold mt-3 mb-2" style="color:var(--text)">{p.name}</h3>
              {p.description && <p class="crest-body text-sm line-clamp-3" style="color:var(--muted)">{p.description}</p>}
              {p.duration && <p class="crest-display text-[10px] uppercase tracking-[0.2em] mt-3 pt-3 border-t" style="color:var(--primary);border-color:var(--border)">{p.duration}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Stats: full-width bar -->
  {stats.length > 0 && (
    <section class="py-14 crest-grad">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {stats.slice(0, 4).map(s => (
            <div class="text-center text-white">
              <p class="crest-display text-3xl sm:text-4xl font-bold">{s.value}</p>
              <p class="crest-display text-[10px] uppercase tracking-[0.2em] opacity-80 mt-2">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest news + announcements -->
  {(announcements.length > 0 || posts.length > 0) && (
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-2 gap-10">
        {announcements.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6 pb-3 border-b" style="border-color:var(--border)">
              <h2 class="crest-display text-xl font-bold" style="color:var(--text)">Heralds & Notices</h2>
              <a href={`${prefix}/announcements`} class="crest-display text-[10px] uppercase tracking-[0.2em] hover:opacity-70" style="color:var(--primary)">All Notices</a>
            </div>
            <div class="space-y-4">
              {announcements.slice(0, 3).map(a => (
                <a href={`${prefix}/announcements/${a.slug || a.id}`} class="crest-card p-5 block">
                  <span class="crest-display text-[10px] uppercase tracking-[0.2em]" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</span>
                  <h3 class="crest-display font-bold mt-2" style="color:var(--text)">{a.title}</h3>
                  {a.excerpt && <p class="crest-body text-sm mt-1 line-clamp-2" style="color:var(--muted)">{a.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
        {posts.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6 pb-3 border-b" style="border-color:var(--border)">
              <h2 class="crest-display text-xl font-bold" style="color:var(--text)">Chronicles</h2>
              <a href={`${prefix}/blog`} class="crest-display text-[10px] uppercase tracking-[0.2em] hover:opacity-70" style="color:var(--primary)">All Chronicles</a>
            </div>
            <div class="space-y-4">
              {posts.slice(0, 3).map(p => (
                <a href={`${prefix}/blog/${p.slug || p.id}`} class="crest-card p-5 block">
                  <span class="crest-display text-[10px] uppercase tracking-[0.2em]" style="color:var(--primary)">{formatDate(p.publishedAt || p.createdAt)}</span>
                  <h3 class="crest-display font-bold mt-2" style="color:var(--text)">{p.title}</h3>
                  {p.excerpt && <p class="crest-body text-sm mt-1 line-clamp-2" style="color:var(--muted)">{p.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20" style="background:var(--surface)">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="crest-divider max-w-xs mx-auto mb-4"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg></div>
      <h2 class="crest-display text-2xl sm:text-3xl font-bold mb-4" style="color:var(--text)">Petition for Admission</h2>
      <p class="crest-body italic mb-8 max-w-2xl mx-auto" style="color:var(--muted)">We invite families of character to join our distinguished community. The application portal awaits your inquiry.</p>
      <a href={`${prefix}/admissions`} class="crest-display inline-flex px-8 py-3.5 text-xs font-bold uppercase tracking-[0.2em] text-white crest-grad">Submit Application</a>
    </div>
  </section>
</div>
