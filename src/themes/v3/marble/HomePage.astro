---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div class="space-y-0">
  <!-- Hero: elegant editorial -->
  <section class="marble-texture border-b marble-rule" style="background:var(--bg)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
      <span class="marble-pill">A Refined Education</span>
      <h1 class="marble-serif mt-6 text-5xl sm:text-6xl lg:text-7xl font-semibold leading-tight tracking-tight" style="color:var(--text)">{school.name}</h1>
      {school.tagline && <p class="marble-serif italic mt-6 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${prefix}/admissions`} class="marble-serif inline-flex items-center justify-center px-8 py-3 text-sm font-medium text-white marble-grad" style="border-radius:4px;letter-spacing:0.05em">Apply for Admission</a>
        <a href={`${prefix}/about`} class="marble-serif inline-flex items-center justify-center px-8 py-3 text-sm font-medium border" style="border-color:var(--primary);color:var(--primary);border-radius:4px;letter-spacing:0.05em">Learn More</a>
      </div>
    </div>
  </section>

  <!-- Stats: refined with thin separators -->
  {stats.length > 0 && (
    <section class="border-b marble-rule" style="background:var(--surface)">
      <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x marble-rule" style="border-color:var(--border)">
          {stats.slice(0, 4).map(s => (
            <div class="text-center px-4">
              <div class="marble-serif text-3xl sm:text-4xl font-semibold" style="color:var(--primary)">{s.value}</div>
              <div class="marble-serif italic text-xs mt-2 uppercase tracking-wider" style="color:var(--muted)">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Value proposition -->
  {about.valueProposition && (
    <section class="py-20" style="background:var(--bg)">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <span class="marble-pill">Our Ethos</span>
        <p class="marble-serif italic mt-6 text-2xl sm:text-3xl leading-relaxed" style="color:var(--text)">{about.valueProposition}</p>
      </div>
    </section>
  )}

  <!-- Features: elegant numbered cards -->
  {features.length > 0 && (
    <section class="py-20" style="background:var(--surface)">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="marble-pill">Our Highlights</span>
          <h2 class="marble-serif mt-4 text-3xl sm:text-4xl font-semibold" style="color:var(--text)">Crafted with intention</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <div class="marble-card p-7">
              <div class="flex items-baseline gap-3 mb-4 pb-4 border-b marble-rule">
                <span class="marble-serif text-4xl font-semibold" style="color:var(--primary)">{String(i + 1).padStart(2, '0')}</span>
                <span class="marble-serif italic text-xs uppercase tracking-wider" style="color:var(--muted)">Highlight</span>
              </div>
              <h3 class="marble-serif text-lg font-semibold mb-2" style="color:var(--text)">{f.title}</h3>
              <p class="marble-body text-sm leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Programs: refined cards -->
  {programs.length > 0 && (
    <section class="py-20" style="background:var(--bg)">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <span class="marble-pill">Academics</span>
          <h2 class="marble-serif mt-4 text-3xl sm:text-4xl font-semibold" style="color:var(--text)">Our Programs</h2>
          <p class="marble-serif italic text-sm mt-3 max-w-2xl mx-auto" style="color:var(--muted)">Thoughtfully composed pathways for every learner.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {programs.slice(0, 3).map(p => (
            <a href={`${prefix}/programs/${p.slug || p.id}`} class="marble-card overflow-hidden block">
              {p.imageUrl && <img src={p.imageUrl} alt={p.name} class="w-full h-44 object-cover" loading="lazy" />}
              <div class="p-6">
                <h3 class="marble-serif text-lg font-semibold mb-2" style="color:var(--text)">{p.name}</h3>
                {p.description && <p class="marble-body text-sm leading-relaxed line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                {p.duration && <span class="inline-block mt-3 marble-serif italic text-xs px-3 py-1 border" style="border-color:color-mix(in srgb, var(--primary) 30%, transparent);color:var(--primary)">{p.duration}</span>}
              </div>
            </a>
          ))}
        </div>
        <div class="text-center mt-10">
          <a href={`${prefix}/programs`} class="marble-serif text-sm font-medium hover:opacity-70" style="color:var(--primary)">View all programs</a>
        </div>
      </div>
    </section>
  )}

  <!-- Latest announcements + blog -->
  {(announcements.length > 0 || posts.length > 0) && (
    <section class="py-20" style="background:var(--surface)">
      <div class="max-w-7xl mx-auto px-4 grid lg:grid-cols-2 gap-12">
        {announcements.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-8 pb-4 border-b marble-rule">
              <h2 class="marble-serif text-2xl font-semibold" style="color:var(--text)">Latest News</h2>
              <a href={`${prefix}/announcements`} class="marble-serif text-sm italic hover:opacity-70" style="color:var(--primary)">All news</a>
            </div>
            <div class="space-y-6">
              {announcements.slice(0, 3).map(a => (
                <a href={`${prefix}/announcements/${a.slug || a.id}`} class="block group">
                  <span class="marble-serif italic text-xs uppercase tracking-wider" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</span>
                  <h3 class="marble-serif text-lg font-semibold mt-1 group-hover:opacity-70 transition-opacity" style="color:var(--text)">{a.title}</h3>
                  {a.excerpt && <p class="marble-body text-sm mt-2 line-clamp-2" style="color:var(--muted)">{a.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
        {posts.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-8 pb-4 border-b marble-rule">
              <h2 class="marble-serif text-2xl font-semibold" style="color:var(--text)">From the Blog</h2>
              <a href={`${prefix}/blog`} class="marble-serif text-sm italic hover:opacity-70" style="color:var(--primary)">All posts</a>
            </div>
            <div class="space-y-6">
              {posts.slice(0, 3).map(p => (
                <a href={`${prefix}/blog/${p.slug || p.id}`} class="block group">
                  <span class="marble-serif italic text-xs uppercase tracking-wider" style="color:var(--accent)">{formatDate(p.publishedAt || p.createdAt)}</span>
                  <h3 class="marble-serif text-lg font-semibold mt-1 group-hover:opacity-70 transition-opacity" style="color:var(--text)">{p.title}</h3>
                  {p.excerpt && <p class="marble-body text-sm mt-2 line-clamp-2" style="color:var(--muted)">{p.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20" style="background:var(--bg)">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <span class="marble-pill">Admissions Open</span>
      <h2 class="marble-serif mt-6 text-3xl sm:text-4xl font-semibold mb-4" style="color:var(--text)">An invitation to belong</h2>
      <p class="marble-serif italic mb-8 max-w-2xl mx-auto leading-relaxed" style="color:var(--muted)">We warmly welcome families seeking an education of substance. Begin your application today.</p>
      <a href={`${prefix}/admissions`} class="marble-serif inline-flex px-8 py-3.5 text-sm font-medium text-white marble-grad" style="border-radius:4px;letter-spacing:0.05em">Submit Application</a>
    </div>
  </section>
</div>
