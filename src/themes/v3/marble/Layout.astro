---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const primaryContact = contacts[0];
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Inter', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .marble-serif { font-family: 'Spectral', Georgia, serif; }
    .marble-body { font-family: 'Inter', system-ui, sans-serif; }
    .marble-texture { background-image: radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--text) 4%, transparent) 1px, transparent 1px), radial-gradient(circle at 70% 60%, color-mix(in srgb, var(--text) 3%, transparent) 1px, transparent 1px), radial-gradient(circle at 40% 80%, color-mix(in srgb, var(--text) 4%, transparent) 1px, transparent 1px); background-size: 40px 40px, 60px 60px, 50px 50px; }
    .marble-card { background: var(--surface); border: 1px solid color-mix(in srgb, var(--primary) 20%, var(--border)); border-radius: 8px; transition: all 0.3s ease; position: relative; overflow: hidden; }
    .marble-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--primary), transparent); opacity: 0; transition: opacity 0.3s ease; }
    .marble-card:hover { border-color: color-mix(in srgb, var(--primary) 50%, var(--border)); transform: translateY(-3px); box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--primary) 25%, transparent); }
    .marble-card:hover::before { opacity: 1; }
    .marble-grad { background: linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--primary) 70%, var(--accent))); }
    .marble-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 4px; font-family: 'Spectral', serif; font-size: 11px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent); background: color-mix(in srgb, var(--primary) 5%, transparent); }
    .marble-nav-link { position: relative; font-family: 'Spectral', serif; font-size: 14px; font-weight: 500; padding: 6px 0; transition: color 0.2s; }
    .marble-nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--primary); transform: scaleX(0); transition: transform 0.3s ease; }
    .marble-nav-link:hover::after, .marble-nav-link[data-active="true"]::after { transform: scaleX(1); }
    .marble-rule { border-color: color-mix(in srgb, var(--primary) 25%, var(--border)); }
  `} />
</head>
<body>
  <div class="border-b marble-rule" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-10 flex items-center justify-between text-xs">
      <div class="flex items-center gap-4" style="color:var(--muted)">
        {primaryContact && <span class="marble-body flex items-center gap-1.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{primaryContact.value}</span>}
      </div>
      <div class="flex items-center gap-3">
        {socialEntries.slice(0,5).map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--muted)" class="hover:opacity-70"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}
        <span class="w-px h-3" style="background:var(--border)"></span>
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
      </div>
    </div>
  </div>

    <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

<header class="border-b marble-rule marble-texture" style="background:var(--bg)">
    <div class="max-w-7xl mx-auto px-4 py-8 text-center">
      <a href={`${prefix}/`} class="inline-flex flex-col items-center gap-2" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-12 w-auto" /> : <span class="marble-serif text-3xl font-semibold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <h1 class="marble-serif text-3xl sm:text-4xl font-semibold tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="marble-serif italic text-sm" style="color:var(--muted)">{school.tagline}</p>}
      </a>
    </div>
  </header>

  <nav class="sticky top-0 z-40 border-b marble-rule" style="background:var(--surface)" aria-label="Primary">
    <div class="max-w-7xl mx-auto px-4">
      <div class="hidden lg:flex items-center justify-center h-14 gap-10">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="marble-nav-link" style={active ? "color:var(--primary)" : "color:var(--text)"}>{item.label}</a>; })}
        <a href={`${prefix}/admissions`} class="marble-serif text-sm font-medium px-5 py-1.5 border" style="border-color:var(--primary);color:var(--primary)">Apply</a>
      </div>
      <div class="lg:hidden flex items-center justify-between h-14">
        <span class="marble-serif text-lg font-semibold" style="color:var(--text)">{school.name}</span>
        <button id="marble-menu-toggle" type="button" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
      <div id="marble-mobile-nav" class="lg:hidden hidden pb-4 flex flex-col items-center gap-3">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="marble-nav-link" style={active ? "color:var(--primary)" : "color:var(--text)"}>{item.label}</a>; })}<a href={`${prefix}/admissions`} class="marble-nav-link" style="color:var(--primary)">Apply</a></div>
    </div>
  </nav>

  <main><slot /></main>

  <footer class="border-t marble-rule mt-20" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 py-14">
      <div class="text-center mb-10 pb-8 border-b marble-rule">
        <p class="marble-serif text-2xl font-semibold" style="color:var(--text)">{school.name}</p>
        {school.tagline && <p class="marble-serif italic text-sm mt-2" style="color:var(--muted)">{school.tagline}</p>}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto" /> : <span class="marble-serif text-xl font-semibold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
            <span class="marble-serif text-xl font-semibold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="marble-serif italic text-sm leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-3 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--primary)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div class="md:col-span-1 hidden md:flex justify-center"><div class="w-px h-full" style="background:var(--border)"></div></div>
        <div class="md:col-span-3">
          <h3 class="marble-serif text-sm font-semibold uppercase tracking-wider mb-4 pb-2 border-b marble-rule" style="color:var(--text)">Navigate</h3>
          <ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="marble-body text-sm hover:opacity-70" style="color:var(--muted)">{item.label}</a></li>)}</ul>
        </div>
        <div class="md:col-span-3">
          <h3 class="marble-serif text-sm font-semibold uppercase tracking-wider mb-4 pb-2 border-b marble-rule" style="color:var(--text)">Contact</h3>
          <ul class="space-y-2.5">{contacts.slice(0,4).map(c => <li class="marble-body text-sm" style="color:var(--muted)">{c.label && <span class="block text-[10px] uppercase tracking-wider mb-0.5 marble-serif" style="color:var(--primary)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul>
        </div>
      </div>
      <div class="mt-10 pt-6 border-t marble-rule flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="marble-body text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="marble-serif text-xs uppercase tracking-widest hover:opacity-70" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>
<button id="marble-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 marble-grad px-5 py-3 shadow-lg" style="border-radius:6px" aria-label="Open chat"><span class="marble-serif text-sm font-medium text-white">Inquire</span></button>
  <div id="marble-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col shadow-2xl border" style="background:var(--surface);border-color:var(--primary);border-radius:8px;max-height:70vh">
    <div class="marble-grad px-5 py-4 text-center"><p class="marble-serif text-lg font-semibold text-white">Concierge</p><p class="marble-serif italic text-xs text-white/85 mt-0.5">How may we assist?</p></div>
    <div id="marble-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)"><div class="border-l-2 pl-3 text-sm marble-serif italic" style="border-color:var(--primary);color:var(--muted)">Welcome. Please leave your question below.</div></div>
    <form id="marble-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)"><input id="marble-chat-input" type="text" placeholder="Your question..." class="marble-body flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none" style="border-color:var(--border);color:var(--text)" aria-label="Question" /><button type="submit" class="marble-serif text-sm font-medium px-4 py-1.5" style="background:var(--primary);color:#fff;border-radius:4px">Send</button></form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('marble-menu-toggle'),d=document.getElementById('marble-mobile-nav');if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('marble-chat-toggle'),cp=document.getElementById('marble-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('marble-chat-form'),i=document.getElementById('marble-chat-input'),m=document.getElementById('marble-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='text-sm text-right marble-serif';b.style.color='var(--primary)';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='border-l-2 pl-3 text-sm marble-serif italic';r.style.borderColor='var(--primary)';r.style.color='var(--muted)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='border-l-2 pl-3 text-sm marble-serif italic';r.style.borderColor='var(--primary)';r.style.color='var(--muted)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
