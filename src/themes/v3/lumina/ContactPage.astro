---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8" style="color:var(--text)">Contact Us</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="lumina-card rounded-2xl p-6">
        <h3 class="font-bold mb-4" style="color:var(--text)">Contact Information</h3>
        <ul class="space-y-3">
          {contacts.map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs font-medium" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}
          {contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info available.</li>}
        </ul>
        {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="lumina-card p-2 rounded-lg"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
      </div>
      <div class="lumina-card rounded-2xl p-6">
        <h3 class="font-bold mb-4" style="color:var(--text)">Send a Message</h3>
        <form id="contactForm" class="space-y-3">
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--text)">Name *</label>
            <input type="text" name="name" required class="w-full px-3 py-2 rounded-lg text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--text)">Email *</label>
            <input type="email" name="email" required class="w-full px-3 py-2 rounded-lg text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--text)">Phone</label>
            <input type="tel" name="phone" class="w-full px-3 py-2 rounded-lg text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--text)">Subject *</label>
            <input type="text" name="subject" required class="w-full px-3 py-2 rounded-lg text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1" style="color:var(--text)">Message *</label>
            <textarea name="message" rows="4" required class="w-full px-3 py-2 rounded-lg text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)"></textarea>
          </div>
          <div id="contactFormMessage" class="hidden"></div>
          <button type="submit" class="lumina-grad px-6 py-2.5 text-sm font-semibold text-white rounded-lg">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ schoolSlug: school.slug }}>
  document.getElementById('contactForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    var msgEl = document.getElementById('contactFormMessage');
    var formData = new FormData(this);
    var data = {};
    formData.forEach(function(val, key) { data[key] = val; });
    data.action = 'create_ticket';

    msgEl.className = 'p-3 rounded-lg text-sm';
    msgEl.style.background = 'color-mix(in srgb, var(--primary) 10%, transparent)';
    msgEl.style.color = 'var(--muted)';
    msgEl.textContent = 'Sending...';
    msgEl.classList.remove('hidden');

    try {
      var res = await fetch('/api/' + schoolSlug + '/support', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      var result = await res.json();
      if (res.ok) {
        msgEl.className = 'p-3 rounded-lg text-sm';
        msgEl.style.background = 'color-mix(in srgb, var(--primary) 10%, transparent)';
        msgEl.style.color = 'var(--text)';
        msgEl.innerHTML = '<strong>Message sent successfully!</strong> We will get back to you soon.';
        this.reset();
      } else {
        throw new Error(result.error || 'Failed');
      }
    } catch(err) {
      msgEl.className = 'p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700';
      msgEl.textContent = 'Failed to send: ' + (err.message || 'Unknown error');
    }
  });
</script>
