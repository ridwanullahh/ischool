---
import { getSchoolPrograms } from '../../../lib/school-safe.ts';
import { getSocialIconPath } from '../_shared/social-icons';
interface Props { school: any; item: any; [key: string]: any; }
const { school, item } = Astro.props;
const prefix = '/' + school.slug;
const allPrograms = getSchoolPrograms(school.id);
const relatedPrograms = allPrograms.filter((p: any) => p.id !== item?.id).slice(0, 3);
const currentUrl = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321').toString();
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(item?.name || '');
const shareLinks = [
  { label: 'Facebook', icon: getSocialIconPath('facebook'), url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: 'WhatsApp', icon: getSocialIconPath('whatsapp'), url: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
  { label: 'Twitter', icon: getSocialIconPath('twitter'), url: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
].filter(s => s.icon);
const contentText = item?.content || item?.description || '';
const wordCount = contentText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---
<div class="mv-feed space-y-4">
  <a href={`/${school.slug}/programs`} class="inline-flex items-center gap-1.5 text-sm mv-tap" style="color:var(--primary)">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg> Back
  </a>

  <article class="mv-card overflow-hidden">
    {item?.imageUrl && <img src={item.imageUrl} alt={item.name} class="w-full h-52 object-cover" />}
    <div class="p-5">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        {item?.level && <span class="mv-grad px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white rounded-full">{item.level}</span>}
        {item?.duration && <span class="mv-pill px-2.5 py-0.5 text-[10px] font-semibold rounded-full">{item.duration}</span>}
        <span class="text-[11px]" style="color:var(--muted)">{readingTime} min</span>
      </div>
      <h1 class="text-xl font-extrabold leading-tight mb-3" style="color:var(--text)">{item?.name || 'Program'}</h1>
      {item?.description && <p class="text-sm leading-relaxed mb-4" style="color:var(--muted)">{item.description}</p>}
      {item?.content && <div class="prose max-w-none whitespace-pre-wrap leading-relaxed text-sm mb-5" style="color:var(--text)">{item.content}</div>}
      <a href={`/${school.slug}/admissions`} class="mv-grad text-white block text-center py-3 rounded-full text-sm font-bold mv-tap">Apply Now</a>

      <div class="mt-5 pt-4 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
        <span class="text-xs font-semibold mr-1" style="color:var(--text)">Share</span>
        {shareLinks.map(s => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.label}`} class="mv-soft p-2.5 rounded-full mv-tap"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path d={s.icon} /></svg></a>
        ))}
        <button type="button" data-copy-url={currentUrl} aria-label="Copy link" class="mv-soft p-2.5 rounded-full mv-tap"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg></button>
      </div>
    </div>
  </article>

  {relatedPrograms.length > 0 && (
    <section>
      <h2 class="text-sm font-bold mb-2 px-1" style="color:var(--text)">More programs</h2>
      <div class="space-y-3">
        {relatedPrograms.map((p: any) => (
          <a href={`/${school.slug}/programs/${p.slug || p.id}`} class="mv-card p-4 block">
            <h3 class="text-sm font-bold leading-snug" style="color:var(--text)">{p.name}</h3>
            {p.duration && <span class="mv-pill inline-block mt-2 px-2 py-0.5 text-[10px] font-semibold rounded-full">{p.duration}</span>}
          </a>
        ))}
      </div>
    </section>
  )}
</div>

<script is:inline set:html={`(function(){
  document.querySelectorAll('[data-copy-url]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url = btn.getAttribute('data-copy-url');
      navigator.clipboard.writeText(url).then(function() {
        var original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(function() { btn.innerHTML = original; }, 2000);
      });
    });
  });
})();`} />
