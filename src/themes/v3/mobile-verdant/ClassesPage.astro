---
interface Props { school: any; items?: any[]; search?: string; sort?: string; total?: number; [key: string]: any; }
const { school, items = [], search = '', sort = 'newest', total = 0 } = Astro.props;
const prefix = '/' + school.slug;
const classes = Array.isArray(items) ? items : [];
const getVal = (obj: any, camel: string, snake: string) => obj?.[camel] ?? obj?.[snake] ?? null;
---
<div class="mv-feed space-y-4">
  <section class="mv-grad rounded-[28px] p-6">
    <p class="text-white/80 text-xs font-semibold uppercase tracking-[0.16em]">Classrooms</p>
    <h1 class="text-white text-2xl font-extrabold mt-1 leading-tight">Classes</h1>
  </section>

  <div class="mv-card p-3 flex gap-2 items-center">
    <div class="relative flex-1">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text" id="live-search-input" value={search} placeholder="Search classes... (/)" class="w-full pl-9 pr-4 py-2.5 rounded-full text-sm outline-none border mv-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)" autocomplete="off" />
      <div id="live-search-spinner" class="hidden absolute right-3 top-1/2 -translate-y-1/2"><svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24" style="color:var(--muted)"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>
    </div>
    <select id="sort-select" class="px-3 py-2.5 rounded-full text-xs outline-none border mv-tap" style="background:var(--bg);border-color:var(--border);color:var(--text)">
      <option value="newest" selected={sort === 'newest'}>New</option>
      <option value="title" selected={sort === 'title'}>A-Z</option>
      <option value="grade" selected={sort === 'grade'}>Grade</option>
    </select>
  </div>

  <div id="results-count" class="text-xs px-1" style="color:var(--muted)">
    {search ? <span>Found <strong style="color:var(--text)">{total}</strong> for "<em style="color:var(--primary)">{search}</em>"</span> : <span><strong style="color:var(--text)">{total}</strong> classes</span>}
  </div>

  <div id="results-grid">
    {classes.length > 0 ? (
      <div id="results-inner" class="space-y-3">
        {classes.map(c => {
          const gradeLevel = getVal(c, 'gradeLevel', 'grade_level');
          const teacherName = getVal(c, 'teacherName', 'teacher_name');
          const imageUrl = getVal(c, 'imageUrl', 'image_url');
          return (
            <a href={`/${school.slug}/classes/${c.slug || c.id}`} class="mv-card overflow-hidden block">
              {imageUrl && <img src={imageUrl} alt={c.name} class="w-full h-36 object-cover" loading="lazy" />}
              <div class="p-4">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-sm font-bold" style="color:var(--text)">{c.name}{c.section ? ' - ' + c.section : ''}</h3>
                  {gradeLevel && <span class="mv-pill px-2 py-0.5 text-[10px] font-semibold rounded-full flex-shrink-0">{gradeLevel}</span>}
                </div>
                {c.description && <p class="text-xs line-clamp-3 mt-1.5" style="color:var(--muted)">{c.description}</p>}
                {teacherName && <p class="text-[10px] mt-2 font-semibold uppercase tracking-wider" style="color:var(--primary)">{teacherName}</p>}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div id="results-inner" class="mv-card p-8 text-center">
        <svg class="w-10 h-10 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-sm font-bold" style="color:var(--text)">No classes found</p>
        <p class="text-xs mt-1" style="color:var(--muted)">{search ? 'Try another search.' : 'Classes will appear here once added.'}</p>
      </div>
    )}
  </div>
</div>

<script is:inline define:vars={{ schoolSlug: school.slug }}>
  (function() {
    var searchInput = document.getElementById('live-search-input');
    var sortSelect = document.getElementById('sort-select');
    var spinner = document.getElementById('live-search-spinner');
    var resultsGrid = document.getElementById('results-grid');
    var resultsCount = document.getElementById('results-count');
    var debounceTimer = null; var currentRequest = null;
    function escapeHtml(t) { var d=document.createElement('div'); d.textContent=t||''; return d.innerHTML; }
    function getVal(o,c,s){ return o && (o[c]||o[s]) || null; }
    function renderResults(data) {
      var items = data.items || []; var q = data.q || ''; var total = data.total || 0;
      resultsCount.innerHTML = q ? '<span>Found <strong style="color:var(--text)">' + total + '</strong> for "<em style="color:var(--primary)">' + escapeHtml(q) + '</em>"</span>' : '<span><strong style="color:var(--text)">' + total + '</strong> classes</span>';
      if (items.length > 0) {
        var html = '<div id="results-inner" class="space-y-3">';
        items.forEach(function(c) {
          var gradeLevel = getVal(c,'gradeLevel','grade_level');
          var teacherName = getVal(c,'teacherName','teacher_name');
          var imageUrl = getVal(c,'imageUrl','image_url');
          html += '<a href="/' + schoolSlug + '/classes/' + (c.slug||c.id) + '" class="mv-card overflow-hidden block">';
          if (imageUrl) html += '<img src="' + escapeHtml(imageUrl) + '" alt="' + escapeHtml(c.name) + '" class="w-full h-36 object-cover" loading="lazy" />';
          html += '<div class="p-4"><div class="flex items-center justify-between gap-2"><h3 class="text-sm font-bold" style="color:var(--text)">' + escapeHtml(c.name) + (c.section?' - '+escapeHtml(c.section):'') + '</h3>';
          if (gradeLevel) html += '<span class="mv-pill px-2 py-0.5 text-[10px] font-semibold rounded-full flex-shrink-0">' + escapeHtml(gradeLevel) + '</span>';
          html += '</div>';
          if (c.description) html += '<p class="text-xs line-clamp-3 mt-1.5" style="color:var(--muted)">' + escapeHtml(c.description) + '</p>';
          if (teacherName) html += '<p class="text-[10px] mt-2 font-semibold uppercase tracking-wider" style="color:var(--primary)">' + escapeHtml(teacherName) + '</p>';
          html += '</div></a>';
        });
        html += '</div>'; resultsGrid.innerHTML = html;
      } else {
        resultsGrid.innerHTML = '<div id="results-inner" class="mv-card p-8 text-center"><svg class="w-10 h-10 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><p class="text-sm font-bold" style="color:var(--text)">No classes found</p><p class="text-xs mt-1" style="color:var(--muted)">' + (q?'Try another search.':'Classes will appear here once added.') + '</p></div>';
      }
    }
    function performSearch() {
      var q = searchInput.value.trim(); var sort = sortSelect.value;
      var url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
      url.searchParams.set('sort', sort); window.history.replaceState({}, '', url.toString());
      spinner.classList.remove('hidden'); if (currentRequest) currentRequest.abort();
      var xhr = new XMLHttpRequest(); currentRequest = xhr;
      xhr.open('GET', '/api/' + schoolSlug + '/search?type=classes&q=' + encodeURIComponent(q) + '&sort=' + encodeURIComponent(sort));
      xhr.onload = function() { if (xhr.status===200) { try { renderResults(JSON.parse(xhr.responseText)); } catch(e){} } spinner.classList.add('hidden'); };
      xhr.onerror = function() { spinner.classList.add('hidden'); }; xhr.send();
    }
    searchInput.addEventListener('input', function() { clearTimeout(debounceTimer); debounceTimer = setTimeout(performSearch, 300); });
    sortSelect.addEventListener('change', performSearch);
    document.addEventListener('keydown', function(e) { if (e.key==='/' && document.activeElement!==searchInput) { e.preventDefault(); searchInput.focus(); } });
  })();
</script>
