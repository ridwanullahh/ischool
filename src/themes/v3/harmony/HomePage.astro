---
import { getSchoolNav } from '../../../lib/school.ts';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div class="space-y-0">
  <!-- Hero: floating glass stacked -->
  <section class="relative px-4 py-20 sm:py-28">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <span class="harmony-pill">In balance, in harmony</span>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.05] tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="mt-5 text-lg sm:text-xl leading-relaxed max-w-xl" style="color:var(--muted)">{school.tagline}</p>}
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href={`${prefix}/admissions`} class="harmony-grad px-7 py-3.5 text-base font-semibold text-white rounded-2xl shadow-lg hover:scale-105 transition-transform">Apply for Admission</a>
          <a href={`${prefix}/about`} class="harmony-glass px-7 py-3.5 text-base font-semibold rounded-2xl hover:scale-105 transition-transform" style="color:var(--text)">Learn More</a>
        </div>
      </div>
      <div class="lg:col-span-5 relative">
        <!-- Floating stacked glass -->
        <div class="harmony-glass p-6 shadow-2xl" style="transform: rotate(-2deg)">
          {stats.length > 0 ? (
            <div class="grid grid-cols-2 gap-5">
              {stats.slice(0, 4).map(s => (
                <div>
                  <div class="text-2xl font-extrabold" style="color:var(--primary)">{s.value}</div>
                  <div class="text-xs font-medium mt-1 uppercase tracking-wider" style="color:var(--muted)">{s.label}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-6">
              <div class="text-5xl font-extrabold" style="color:var(--primary)">{school.name.charAt(0)}</div>
              <p class="text-sm mt-3" style="color:var(--muted)">A balanced education</p>
            </div>
          )}
        </div>
        <div class="harmony-glass-flat absolute -bottom-4 -left-4 px-4 py-3 hidden sm:block" style="transform: rotate(3deg)">
          <p class="text-xs font-semibold" style="color:var(--primary)">Trusted by families</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Value proposition -->
  {about.valueProposition && (
    <section class="px-4 py-12">
      <div class="max-w-4xl mx-auto harmony-glass p-8 text-center">
        <p class="text-xl sm:text-2xl font-medium leading-relaxed" style="color:var(--text)">{about.valueProposition}</p>
      </div>
    </section>
  )}

  <!-- Features: floating glass cards -->
  {features.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <span class="harmony-pill">Our Highlights</span>
          <h2 class="mt-4 text-3xl sm:text-4xl font-bold" style="color:var(--text)">What brings us together</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <div class="harmony-glass p-7">
              <div class="w-12 h-12 harmony-grad flex items-center justify-center rounded-2xl mb-5 shadow-lg">
                <span class="text-white font-bold text-lg">{i + 1}</span>
              </div>
              <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{f.title}</h3>
              <p class="text-sm leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Programs: floating glass -->
  {programs.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
          <div>
            <span class="harmony-pill">Academics</span>
            <h2 class="mt-4 text-3xl font-bold" style="color:var(--text)">Our Programs</h2>
          </div>
          <a href={`${prefix}/programs`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">View all programs</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {programs.slice(0, 3).map(p => (
            <a href={`${prefix}/programs/${p.slug || p.id}`} class="harmony-glass overflow-hidden block">
              {p.imageUrl && <img src={p.imageUrl} alt={p.name} class="w-full h-44 object-cover" loading="lazy" />}
              <div class="p-6">
                <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.name}</h3>
                {p.description && <p class="text-sm leading-relaxed line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                {p.duration && <span class="inline-block mt-3 text-xs font-semibold px-3 py-1 rounded-full" style="background:color-mix(in srgb, var(--primary) 12%, transparent);color:var(--primary)">{p.duration}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest announcements + blog -->
  {(announcements.length > 0 || posts.length > 0) && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8">
        {announcements.length > 0 && (
          <div class="harmony-glass p-7">
            <div class="flex items-end justify-between mb-6">
              <h2 class="text-2xl font-bold" style="color:var(--text)">Latest News</h2>
              <a href={`${prefix}/announcements`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">All news</a>
            </div>
            <div class="space-y-3">
              {announcements.slice(0, 3).map(a => (
                <a href={`${prefix}/announcements/${a.slug || a.id}`} class="block p-4 harmony-glass-flat hover:bg-black/5 transition-colors">
                  <span class="text-xs font-medium" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</span>
                  <h3 class="font-bold mt-1" style="color:var(--text)">{a.title}</h3>
                  {a.excerpt && <p class="text-sm mt-1 line-clamp-2" style="color:var(--muted)">{a.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
        {posts.length > 0 && (
          <div class="harmony-glass p-7">
            <div class="flex items-end justify-between mb-6">
              <h2 class="text-2xl font-bold" style="color:var(--text)">From the Blog</h2>
              <a href={`${prefix}/blog`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">All posts</a>
            </div>
            <div class="space-y-3">
              {posts.slice(0, 3).map(p => (
                <a href={`${prefix}/blog/${p.slug || p.id}`} class="block p-4 harmony-glass-flat hover:bg-black/5 transition-colors">
                  <span class="text-xs font-medium" style="color:var(--accent)">{formatDate(p.publishedAt || p.createdAt)}</span>
                  <h3 class="font-bold mt-1" style="color:var(--text)">{p.title}</h3>
                  {p.excerpt && <p class="text-sm mt-1 line-clamp-2" style="color:var(--muted)">{p.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="px-4 py-20">
    <div class="max-w-5xl mx-auto harmony-grad rounded-3xl p-10 sm:p-16 text-center text-white shadow-2xl">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Find your place in our community</h2>
      <p class="text-lg opacity-95 mb-8 max-w-2xl mx-auto">Admissions are open for the upcoming academic year. Join us and discover harmony in learning.</p>
      <a href={`${prefix}/admissions`} class="inline-block bg-white px-8 py-3.5 rounded-2xl font-semibold hover:scale-105 transition-transform" style="color:var(--primary)">Apply Now</a>
    </div>
  </section>
</div>
