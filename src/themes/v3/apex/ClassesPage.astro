---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16"><div class="max-w-7xl mx-auto"><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// classes</p><h1 class="text-4xl font-bold mb-8" style="color:var(--text)">Classes</h1><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0">{(data.items || []).map(c => <a href={`/${school.slug}/classes/${c.slug || c.id}`} class="border p-6 hover:bg-[color-mix(in_srgb,var(--primary)_5%,transparent)] block" style="border-color:var(--border)"><h3 class="text-lg font-bold mb-2" style="color:var(--text)">{c.name}{c.section ? ' - ' + c.section : ''}</h3>{c.description && <p class="text-sm line-clamp-3" style="color:var(--muted)">{c.description}</p>}</a>)}</div></div></div>
