---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16">
  <div class="max-w-5xl mx-auto">
    <p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// page</p>
    <h1 class="text-4xl font-bold mb-8" style="color:var(--text)">Admissions</h1>
    <div class="border-l-4 pl-6" style="border-color:var(--primary)">
      
<p class="text-lg mb-8" style="color:var(--muted)">Begin your journey with {school.name}.</p>
<div class="space-y-6">
  <div><p class="apex-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">// process</p><ol class="space-y-2 text-sm" style="color:var(--muted)"><li>1. Complete the online application</li><li>2. Submit required documents</li><li>3. Attend assessment interview</li><li>4. Receive admission decision</li><li>5. Complete enrollment</li></ol></div>
  <div><p class="apex-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">// documents</p><ul class="space-y-1 text-sm" style="color:var(--muted)"><li>- Birth certificate</li><li>- Previous school records</li><li>- Immunization records</li><li>- Passport photos</li></ul></div>
  <a href={`/${school.slug}/contact`} class="apex-hard inline-flex px-6 py-3 text-sm font-bold uppercase tracking-wider text-white" style="background:var(--primary)">Contact Admissions</a>
</div>

    </div>
  </div>
</div>