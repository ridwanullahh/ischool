---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16"><div class="max-w-7xl mx-auto"><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// blog</p><h1 class="text-4xl font-bold mb-8" style="color:var(--text)">Blog & News</h1><div class="grid grid-cols-1 md:grid-cols-3 gap-0">{(data.items || []).map(post => <a href={`/${school.slug}/blog/${post.slug}`} class="border group block" style="border-color:var(--border)">{post.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />}<div class="p-6"><p class="apex-mono text-xs mb-2" style="color:var(--muted)">{formatDate(post.publishedAt || post.createdAt)}</p><h3 class="font-bold mb-2 group-hover:text-[var(--primary)]" style="color:var(--text)">{post.title}</h3><p class="text-sm line-clamp-2" style="color:var(--muted)">{post.excerpt || post.content}</p></div></a>)}</div></div></div>
