---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="space-y-0">
  <section class="grid grid-cols-1 lg:grid-cols-2 min-h-[60vh]">
    <div class="flex items-center px-8 py-16" style="background:var(--primary)">
      <div class="text-white">
        <p class="apex-mono text-xs uppercase tracking-[0.3em] mb-4 opacity-80">// welcome</p>
        <h1 class="text-5xl sm:text-6xl font-bold leading-tight">{school.name}</h1>
        {school.tagline && <p class="mt-4 text-lg opacity-90">{school.tagline}</p>}
        <div class="mt-8 flex gap-4">
          <a href={`${prefix}/admissions`} class="apex-hard bg-white px-6 py-3 text-sm font-bold uppercase tracking-wider" style="color:var(--primary)">Apply Now</a>
          <a href={`${prefix}/about`} class="apex-hard border-2 border-white px-6 py-3 text-sm font-bold uppercase tracking-wider text-white">Learn More</a>
        </div>
      </div>
    </div>
    <div class="flex items-center justify-center px-8 py-16" style="background:var(--surface)">
      <div class="max-w-md">
        {data.about?.valueProposition && <p class="text-2xl font-bold leading-relaxed" style="color:var(--text)">{data.about.valueProposition}</p>}
        {data.stats?.length > 0 && <div class="mt-8 grid grid-cols-2 gap-4">{data.stats.slice(0,4).map(s => <div><p class="text-3xl font-bold" style="color:var(--primary)">{s.value}</p><p class="text-xs uppercase tracking-wider mt-1" style="color:var(--muted)">{s.label}</p></div>)}</div>}
      </div>
    </div>
  </section>
  {data.recentAnnouncements?.length > 0 && (
    <a href={`/${school.slug}/announcements/${data.recentAnnouncements[0].slug}`} class="block border-b" style="border-color:var(--border);background:color-mix(in srgb, var(--primary) 5%, var(--bg))"><div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-3"><span class="apex-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 text-white" style="background:var(--primary)">LATEST</span><span class="text-sm font-medium" style="color:var(--text)">{data.recentAnnouncements[0].title}</span></div></a>
  )}
  {data.features?.length > 0 && <section class="py-20"><div class="max-w-7xl mx-auto px-4"><div class="flex items-end justify-between mb-12"><div><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// features</p><h2 class="text-4xl font-bold" style="color:var(--text)">Our Highlights</h2></div></div><div class="grid grid-cols-1 md:grid-cols-3 gap-0">{data.features.map((f, i) => <div class="border p-8" style="border-color:var(--border)"><span class="apex-mono text-4xl font-bold" style="color:var(--primary)">{String(i+1).padStart(2,'0')}</span><h3 class="text-lg font-bold mt-3 mb-2" style="color:var(--text)">{f.title}</h3><p class="text-sm" style="color:var(--muted)">{f.description}</p></div>)}</div></div></section>}
  {data.schoolPrograms?.length > 0 && <section class="py-20" style="background:var(--surface)"><div class="max-w-7xl mx-auto px-4"><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// programs</p><h2 class="text-4xl font-bold mb-12" style="color:var(--text)">Our Programs</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0">{data.schoolPrograms.map(p => <a href={`/${school.slug}/programs/${p.slug}`} class="border p-6 hover:bg-[color-mix(in_srgb,var(--primary)_5%,transparent)] block" style="border-color:var(--border)"><h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.name}</h3>{p.level && <p class="apex-mono text-sm mb-2" style="color:var(--primary)">{p.level}</p>}{p.description && <p class="text-sm line-clamp-3" style="color:var(--muted)">{p.description}</p>}</a>)}</div></div></section>}
  {data.recentPosts?.length > 0 && <section class="py-20"><div class="max-w-7xl mx-auto px-4"><div class="flex items-end justify-between mb-12"><div><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// news</p><h2 class="text-4xl font-bold" style="color:var(--text)">Latest News</h2></div><a href={`/${school.slug}/blog`} class="apex-mono text-sm hover:opacity-70" style="color:var(--primary)">view all &gt;&gt;</a></div><div class="grid grid-cols-1 md:grid-cols-3 gap-0">{data.recentPosts.map(post => <a href={`/${school.slug}/blog/${post.slug}`} class="border group block" style="border-color:var(--border)">{post.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />}<div class="p-6"><p class="apex-mono text-xs mb-2" style="color:var(--muted)">{formatDate(post.publishedAt || post.createdAt)}</p><h3 class="font-bold mb-2 group-hover:text-[var(--primary)]" style="color:var(--text)">{post.title}</h3><p class="text-sm line-clamp-2" style="color:var(--muted)">{post.excerpt || post.content}</p></div></a>)}</div></div></section>}
  <section class="py-20" style="background:var(--primary)"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-4xl font-bold mb-4 text-white">Ready to Join?</h2><p class="mb-8 max-w-2xl mx-auto text-white/80">We would love to welcome your family to our community.</p><a href={`/${school.slug}/admissions`} class="apex-hard inline-flex bg-white px-8 py-3.5 text-sm font-bold uppercase tracking-wider" style="color:var(--primary)">Start Application</a></div></section>
</div>
