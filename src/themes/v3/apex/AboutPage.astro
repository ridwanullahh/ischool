---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16">
  <div class="max-w-5xl mx-auto">
    <p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// page</p>
    <h1 class="text-4xl font-bold mb-8" style="color:var(--text)">About {school.name}</h1>
    <div class="border-l-4 pl-6" style="border-color:var(--primary)">
      
{data.about?.valueProposition && <p class="text-xl font-bold leading-relaxed mb-6" style="color:var(--text)">{data.about.valueProposition}</p>}
{data.about?.mission && <div class="mb-6"><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// mission</p><p style="color:var(--muted)">{data.about.mission}</p></div>}
{data.about?.vision && <div><p class="apex-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// vision</p><p style="color:var(--muted)">{data.about.vision}</p></div>}
{data.features?.length > 0 && <div class="mt-8"><p class="apex-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// highlights</p><div class="grid grid-cols-1 md:grid-cols-2 gap-0">{data.features.map((f, i) => <div class="border p-6" style="border-color:var(--border)"><span class="apex-mono text-2xl font-bold" style="color:var(--primary)">{String(i+1).padStart(2,'0')}</span><h4 class="font-bold mt-2 mb-1" style="color:var(--text)">{f.title}</h4><p class="text-sm" style="color:var(--muted)">{f.description}</p></div>)}</div></div>}

    </div>
  </div>
</div>