---
import { getSchoolPalette, getSchoolFontPreset } from '../../../lib/school.ts';
interface Props { school: any; }
const { school } = Astro.props;
const palette = getSchoolPalette(school);
const fontPreset = getSchoolFontPreset(school);
---
{fontPreset && (
  <link rel="preconnect" href="https://fonts.googleapis.com" />
)}
{fontPreset && (
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
)}
{fontPreset && fontPreset.headingUrl === fontPreset.bodyUrl ? (
  <link href={fontPreset.headingUrl} rel="stylesheet" />
) : (
  <>
    {fontPreset && <link href={fontPreset.headingUrl} rel="stylesheet" />}
    {fontPreset && <link href={fontPreset.bodyUrl} rel="stylesheet" />}
  </>
)}
<style is:inline>{`
  html.light {
    --bg: ${palette.backgroundLight}; --surface: ${palette.surfaceLight};
    --text: ${palette.textLight}; --muted: ${palette.mutedLight};
    --border: ${palette.borderLight}; --accent: ${palette.accent}; --primary: ${palette.primary};
  }
  html.dark {
    --bg: ${palette.backgroundDark}; --surface: ${palette.surfaceDark};
    --text: ${palette.textDark}; --muted: ${palette.mutedDark};
    --border: ${palette.borderDark}; --accent: ${palette.accent}; --primary: ${palette.primary};
  }
  :root { --tp: ${palette.primary}; }
  .tp { color: var(--tp); } .tbg { background: var(--primary); } .tbd { border-color: var(--primary); }
  ${fontPreset ? `
    body, .font-body { font-family: '${fontPreset.bodyFont}', system-ui, sans-serif !important; }
    h1, h2, h3, h4, h5, h6, .font-heading { font-family: '${fontPreset.headingFont}', system-ui, sans-serif !important; }
  ` : ''}
`}</style>
