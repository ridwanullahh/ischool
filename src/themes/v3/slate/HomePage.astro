---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="space-y-0">
  <!-- Hero: full-screen gradient mesh with centered glass text -->
  <section class="relative overflow-hidden min-h-[70vh] flex items-center justify-center px-4 py-20">
    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="aurora-glass-strong rounded-3xl p-8 sm:p-12 shadow-2xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="mt-4 text-lg sm:text-xl leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`${prefix}/admissions`} class="aurora-grad px-6 py-3 text-base font-semibold text-white rounded-xl shadow-lg hover:scale-105 transition-transform">Apply for Admission</a>
          <a href={`${prefix}/about`} class="aurora-glass px-6 py-3 text-base font-semibold rounded-xl border hover:scale-105 transition-transform" style="color:var(--text);border-color:var(--border)">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest announcement bar -->
  {data.recentAnnouncements?.length > 0 && (
    <a href={`/${school.slug}/announcements/${data.recentAnnouncements[0].slug}`} class="block aurora-glass mx-4 max-w-6xl mb-8 rounded-2xl p-4 hover:scale-[1.01] transition-transform">
      <div class="max-w-6xl mx-auto flex items-center gap-3">
        <span class="aurora-grad px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white rounded-full">Latest</span>
        <span class="text-sm font-medium" style="color:var(--text)">{data.recentAnnouncements[0].title}</span>
      </div>
    </a>
  )}

  <!-- Value proposition -->
  {data.about?.valueProposition && (
    <section class="px-4 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-2xl sm:text-3xl font-bold leading-relaxed" style="color:var(--text)">{data.about.valueProposition}</p>
      </div>
    </section>
  )}

  <!-- Features: floating glass cards -->
  {data.features?.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12" style="color:var(--text)">Our Highlights</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.features.map(f => (
            <div class="aurora-glass rounded-2xl p-6 hover:scale-105 transition-transform">
              <div class="w-12 h-12 aurora-grad rounded-xl mb-4"></div>
              <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{f.title}</h3>
              <p class="leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Programs: glass cards with gradient accent -->
  {data.schoolPrograms?.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12" style="color:var(--text)">Our Programs</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {data.schoolPrograms.map(p => (
            <a href={`/${school.slug}/programs/${p.slug}`} class="aurora-glass rounded-2xl p-6 hover:scale-105 transition-transform block">
              <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.name}</h3>
              {p.level && <p class="text-sm font-medium mb-2" style="color:var(--primary)">{p.level}</p>}
              {p.description && <p class="text-sm line-clamp-3" style="color:var(--muted)">{p.description}</p>}
              {p.duration && <p class="text-xs mt-3" style="color:var(--muted)">{p.duration}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Stats: gradient bar -->
  {data.stats?.length > 0 && (
    <section class="aurora-grad py-16 mx-4 rounded-3xl mb-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {data.stats.map(s => (
            <div class="text-center text-white">
              <p class="text-3xl sm:text-4xl font-bold">{s.value}</p>
              <p class="text-sm opacity-80 mt-1">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest news: glass cards -->
  {data.recentPosts?.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-12">
          <h2 class="text-3xl font-bold" style="color:var(--text)">Latest News</h2>
          <a href={`/${school.slug}/blog`} class="text-sm font-medium hover:underline" style="color:var(--primary)">View all</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {data.recentPosts.map(post => (
            <a href={`/${school.slug}/blog/${post.slug}`} class="aurora-glass rounded-2xl overflow-hidden hover:scale-105 transition-transform block group">
              {post.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />}
              <div class="p-6">
                <h3 class="font-bold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{post.title}</h3>
                <p class="text-sm line-clamp-2" style="color:var(--muted)">{post.excerpt || post.content}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="px-4 py-20">
    <div class="aurora-glass-strong max-w-4xl mx-auto rounded-3xl p-8 sm:p-12 text-center shadow-2xl">
      <h2 class="text-3xl font-bold mb-4" style="color:var(--text)">Ready to Join {school.name}?</h2>
      <p class="mb-8 max-w-2xl mx-auto" style="color:var(--muted)">We would love to welcome your family to our community. Start the admissions process today.</p>
      <a href={`/${school.slug}/admissions`} class="aurora-grad inline-flex px-8 py-3.5 text-base font-semibold text-white rounded-xl shadow-lg hover:scale-105 transition-transform">Start Application</a>
    </div>
  </section>
</div>
