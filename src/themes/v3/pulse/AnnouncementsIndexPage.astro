---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16"><div class="max-w-4xl mx-auto"><p class="pulse-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// announcements</p><h1 class="text-4xl font-bold mb-8 pulse-glow-text" style="color:var(--text)">Announcements</h1><div class="space-y-4">{(data.items || []).map(a => <a href={`/${school.slug}/announcements/${a.slug}`} class="pulse-border rounded-lg p-5 hover:pulse-glow block"><div class="flex items-start justify-between gap-4"><div class="flex-1"><p class="pulse-mono text-xs mb-1" style="color:var(--muted)">{formatDate(a.publishedAt || a.createdAt)}</p><h3 class="font-bold mb-1" style="color:var(--text)">{a.title}</h3><p class="text-sm line-clamp-2" style="color:var(--muted)">{a.excerpt || a.content}</p></div>{a.isPinned && <span class="pulse-mono text-[10px] font-bold uppercase px-2 py-0.5" style="background:var(--primary);color:var(--bg)">PINNED</span>}</div></a>)}</div></div></div>
