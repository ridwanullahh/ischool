---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16"><div class="max-w-4xl mx-auto"><p class="pulse-mono text-[10px] uppercase tracking-widest mb-2" style="color:var(--primary)">// contact</p><h1 class="text-4xl font-bold mb-8 pulse-glow-text" style="color:var(--text)">Contact Us</h1><div class="grid grid-cols-1 md:grid-cols-2 gap-6"><div class="pulse-border rounded-lg p-6"><p class="pulse-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// info</p><ul class="space-y-3">{contacts.map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="pulse-mono block text-[10px] uppercase" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No data.</li>}</ul></div><div class="pulse-border rounded-lg p-6"><p class="pulse-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// send message</p><form method="POST" action={`/api/${school.slug}/support`} class="space-y-3"><input type="text" name="name" placeholder="name" required class="w-full pulse-border rounded px-3 py-2 text-sm outline-none pulse-mono" style="background:var(--bg);color:var(--text)" /><input type="email" name="email" placeholder="email" required class="w-full pulse-border rounded px-3 py-2 text-sm outline-none pulse-mono" style="background:var(--bg);color:var(--text)" /><textarea name="message" rows="4" placeholder="message" required class="w-full pulse-border rounded px-3 py-2 text-sm outline-none pulse-mono" style="background:var(--bg);color:var(--text)"></textarea><button type="submit" class="pulse-btn pulse-glow w-full px-4 py-2.5 pulse-mono text-sm font-bold uppercase tracking-wider">Send</button></form></div></div></div></div>
