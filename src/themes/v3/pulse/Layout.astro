---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
import PageLoader from '../../../components/PageLoader.astro';
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="dark" /><PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Outfit', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .pulse-mono { font-family: 'Space Mono', ui-monospace, monospace; }
    .pulse-glow { box-shadow: 0 0 20px color-mix(in srgb, var(--primary) 40%, transparent), 0 0 40px color-mix(in srgb, var(--primary) 20%, transparent); }
    .pulse-glow-text { text-shadow: 0 0 12px color-mix(in srgb, var(--primary) 60%, transparent); }
    .pulse-grid-top { background-image: linear-gradient(to right, color-mix(in srgb, var(--primary) 25%, transparent) 1px, transparent 1px); background-size: 24px 24px; height: 2px; }
    .pulse-border { border: 1px solid color-mix(in srgb, var(--primary) 25%, var(--border)); }
    .pulse-btn { border: 1px solid var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); color: var(--primary); transition: all 0.2s; }
    .pulse-btn:hover { background: var(--primary); color: var(--bg); box-shadow: 0 0 24px color-mix(in srgb, var(--primary) 60%, transparent); }
  `} />
</head>
<body>
    <PageLoader />
  <div class="pulse-grid-top"></div>
    <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

<header class="sticky top-0 z-40 border-b pulse-border" style="background:color-mix(in srgb, var(--bg) 85%, transparent);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        <span class="inline-block w-2 h-2 rounded-full pulse-glow" style="background:var(--primary)"></span>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="pulse-mono text-xl font-bold pulse-glow-text" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <span class="text-base font-bold tracking-tight" style="color:var(--text)">{school.name}</span>
      </a>
      <div class="hidden lg:flex items-center gap-6">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class:list={["pulse-mono text-sm font-medium transition-colors", active ? "pulse-glow-text" : ""]} style={active ? "color:var(--primary)" : "color:var(--text)"}>{item.label}</a>; })}</div>
      <div class="flex items-center gap-3">
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-5 h-5 hidden light:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
        <a href={`${prefix}/admissions`} class="hidden sm:inline-flex pulse-btn px-4 py-2 pulse-mono text-xs font-bold uppercase tracking-wider">Apply</a>
        <button id="pulse-menu-toggle" type="button" class="lg:hidden p-2" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
    </div>
    <div id="pulse-mobile-nav" class="lg:hidden hidden border-t pulse-border px-4 py-3 space-y-1">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class:list={["pulse-mono text-sm block py-2", active ? "pulse-glow-text" : ""]} style={active ? "color:var(--primary)" : "color:var(--text)"}>{item.label}</a>; })}</div>
  </header>
  <main><slot /></main>
  <footer class="mt-20 border-t pulse-border" style="background:var(--surface)"><div class="pulse-grid-top"></div>
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2"><div class="flex items-center gap-2 mb-4"><span class="inline-block w-2 h-2 rounded-full pulse-glow" style="background:var(--primary)"></span>{school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="pulse-mono text-xl font-bold pulse-glow-text" style="color:var(--primary)">{school.name.charAt(0)}</span>}<span class="text-base font-bold" style="color:var(--text)">{school.name}</span></div>{school.tagline && <p class="text-sm" style="color:var(--muted)">{school.tagline}</p>}{socialEntries.length > 0 && <div class="flex items-center gap-2 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="pulse-border p-2 hover:pulse-glow" style="color:var(--primary)"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}</div>
        <div><p class="pulse-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// links</p><ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><p class="pulse-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// contact</p><ul class="space-y-2">{contacts.slice(0,4).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="pulse-mono block text-[10px] uppercase" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No data.</li>}</ul></div>
      </div>
      <div class="mt-8 pt-5 border-t pulse-border flex items-center justify-between"><p class="pulse-mono text-[11px]" style="color:var(--muted)">© {new Date().getFullYear()} {school.name} // all rights reserved</p><a href="/" class="pulse-mono text-[11px] uppercase tracking-widest" style="color:var(--primary)">[ iSchool ]</a></div>
    </div>
  </footer>
<button id="pulse-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 pulse-btn pulse-glow px-4 py-3 flex items-center gap-2" aria-label="Open chat"><span class="pulse-mono text-xs font-bold" style="color:var(--primary)">&gt;_</span><span class="pulse-mono text-xs font-bold uppercase tracking-wider" style="color:var(--primary)">AI</span></button>
  <div id="pulse-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(420px,calc(100vw-3rem))] hidden flex-col pulse-border pulse-glow" style="background:var(--surface);max-height:70vh">
    <div class="px-4 py-3 border-b pulse-border flex items-center gap-2"><span class="inline-block w-2 h-2 rounded-full pulse-glow" style="background:var(--primary)"></span><p class="pulse-mono text-xs uppercase tracking-widest" style="color:var(--primary)">assistant.exe</p></div>
    <div id="pulse-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-2 pulse-mono text-xs" style="color:var(--text)"><div style="color:var(--muted)"><span style="color:var(--primary)">&gt;</span> system ready</div><div style="color:var(--muted)">awaiting input...</div></div>
    <form id="pulse-chat-form" class="p-3 border-t pulse-border flex items-center gap-2"><span class="pulse-mono text-xs" style="color:var(--primary)">&gt;_</span><input id="pulse-chat-input" type="text" placeholder="enter query" class="flex-1 bg-transparent border-0 px-1 py-1 text-xs outline-none pulse-mono" style="color:var(--text)" aria-label="Query" /><button type="submit" class="pulse-btn px-3 py-1.5 pulse-mono text-[10px] font-bold uppercase tracking-widest">Run</button></form>
  </div>
  <ThemeToggleScript defaultMode="dark" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('pulse-menu-toggle'),d=document.getElementById('pulse-mobile-nav');if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('pulse-chat-toggle'),cp=document.getElementById('pulse-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('pulse-chat-form'),i=document.getElementById('pulse-chat-input'),m=document.getElementById('pulse-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='pulse-mono text-xs';b.style.color='var(--text)';b.innerHTML='<span style="color:var(--primary)">&gt;</span> '+t.replace(/</g,'&lt;');m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'ERR: unreachable.'};}).then(function(data){var r=document.createElement('div');r.className='pulse-mono text-xs';r.style.color='var(--muted)';r.textContent='> '+(data.reply||data.message||'no response.');m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='pulse-mono text-xs';r.style.color='var(--muted)';r.textContent='> ERR: connection failed.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
