---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="space-y-0">
  <section class="relative overflow-hidden py-24">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <p class="pulse-mono text-xs uppercase tracking-[0.3em] mb-4" style="color:var(--primary)">// welcome to</p>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold pulse-glow-text" style="color:var(--text)">{school.name}</h1>
      {school.tagline && <p class="mt-4 text-lg pulse-mono" style="color:var(--muted)">{school.tagline}</p>}
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${prefix}/admissions`} class="pulse-btn pulse-glow px-6 py-3 pulse-mono text-sm font-bold uppercase tracking-wider">Apply for Admission</a>
        <a href={`${prefix}/about`} class="pulse-border px-6 py-3 pulse-mono text-sm font-bold uppercase tracking-wider hover:pulse-glow" style="color:var(--text)">Learn More</a>
      </div>
    </div>
  </section>
  {data.recentAnnouncements?.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 mb-8">
      <a href={`/${school.slug}/announcements/${data.recentAnnouncements[0].slug}`} class="block pulse-border rounded-lg p-4 hover:pulse-glow">
        <div class="flex items-center gap-3"><span class="pulse-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5" style="background:var(--primary);color:var(--bg)">ALERT</span><span class="text-sm pulse-mono" style="color:var(--text)">{data.recentAnnouncements[0].title}</span></div>
      </a>
    </div>
  )}
  {data.about?.valueProposition && (
    <section class="py-16"><div class="max-w-3xl mx-auto px-4 text-center"><p class="pulse-mono text-xs uppercase tracking-widest mb-4" style="color:var(--primary)">// mission</p><p class="text-2xl font-bold leading-relaxed" style="color:var(--text)">{data.about.valueProposition}</p></div></section>
  )}
  {data.features?.length > 0 && (
    <section class="py-16"><div class="max-w-7xl mx-auto px-4"><p class="pulse-mono text-xs uppercase tracking-widest mb-2" style="color:var(--primary)">// features</p><h2 class="text-3xl font-bold mb-12 pulse-glow-text" style="color:var(--text)">Our Highlights</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{data.features.map(f => <div class="pulse-border rounded-lg p-6 hover:pulse-glow"><div class="w-10 h-10 rounded mb-4 pulse-glow" style="background:var(--primary)"></div><h3 class="text-lg font-bold mb-2" style="color:var(--text)">{f.title}</h3><p class="text-sm" style="color:var(--muted)">{f.description}</p></div>)}</div></div></section>
  )}
  {data.schoolPrograms?.length > 0 && (
    <section class="py-16"><div class="max-w-7xl mx-auto px-4"><p class="pulse-mono text-xs uppercase tracking-widest mb-2" style="color:var(--primary)">// programs</p><h2 class="text-3xl font-bold mb-12 pulse-glow-text" style="color:var(--text)">Our Programs</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">{data.schoolPrograms.map(p => <a href={`/${school.slug}/programs/${p.slug}`} class="pulse-border rounded-lg p-6 hover:pulse-glow block"><h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.name}</h3>{p.level && <p class="pulse-mono text-sm mb-2" style="color:var(--primary)">{p.level}</p>}{p.description && <p class="text-sm line-clamp-3" style="color:var(--muted)">{p.description}</p>}</a>)}</div></div></section>
  )}
  {data.stats?.length > 0 && (
    <section class="py-16" style="background:var(--primary)"><div class="max-w-7xl mx-auto px-4"><div class="grid grid-cols-2 md:grid-cols-4 gap-8">{data.stats.map(s => <div class="text-center"><p class="text-3xl sm:text-4xl font-bold pulse-glow-text" style="color:var(--bg)">{s.value}</p><p class="text-sm pulse-mono mt-1" style="color:color-mix(in srgb, var(--bg) 80%, transparent)">{s.label}</p></div>)}</div></div></section>
  )}
  {data.recentPosts?.length > 0 && (
    <section class="py-16"><div class="max-w-7xl mx-auto px-4"><div class="flex items-center justify-between mb-12"><div><p class="pulse-mono text-xs uppercase tracking-widest mb-2" style="color:var(--primary)">// news</p><h2 class="text-3xl font-bold pulse-glow-text" style="color:var(--text)">Latest News</h2></div><a href={`/${school.slug}/blog`} class="pulse-mono text-sm hover:opacity-70" style="color:var(--primary)">view all &gt;&gt;</a></div><div class="grid grid-cols-1 md:grid-cols-3 gap-8">{data.recentPosts.map(post => <a href={`/${school.slug}/blog/${post.slug}`} class="pulse-border rounded-lg overflow-hidden hover:pulse-glow block group">{post.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />}<div class="p-6"><h3 class="font-bold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{post.title}</h3><p class="text-sm line-clamp-2" style="color:var(--muted)">{post.excerpt || post.content}</p></div></a>)}</div></div></section>
  )}
  <section class="py-20"><div class="max-w-4xl mx-auto px-4 text-center"><h2 class="text-3xl font-bold mb-4 pulse-glow-text" style="color:var(--text)">Ready to Join?</h2><p class="mb-8 max-w-2xl mx-auto text-sm" style="color:var(--muted)">We would love to welcome your family to our community.</p><a href={`/${school.slug}/admissions`} class="pulse-btn pulse-glow inline-flex px-8 py-3.5 pulse-mono text-sm font-bold uppercase tracking-wider">Start Application</a></div></section>
</div>
