---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-12"><div class="max-w-4xl mx-auto"><h1 class="text-4xl font-extrabold mb-8" style="color:var(--text)">Contact Us</h1><div class="grid grid-cols-1 md:grid-cols-2 gap-6"><div class="bloom-card p-6" style="background:var(--surface);border:1px solid var(--border)"><h3 class="font-extrabold mb-4" style="color:var(--text)">Contact Info</h3><ul class="space-y-3">{contacts.map(c => <li class="text-sm font-semibold" style="color:var(--text)">{c.label && <span class="block text-xs font-bold" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No info available.</li>}</ul></div><div class="bloom-card p-6" style="background:var(--surface);border:1px solid var(--border)"><h3 class="font-extrabold mb-4" style="color:var(--text)">Send a Message</h3><form method="POST" action={`/api/${school.slug}/support`} class="space-y-3"><input type="text" name="name" placeholder="Your Name" required class="w-full bloom-pill px-4 py-2 text-sm font-semibold outline-none" style="background:color-mix(in srgb, var(--primary) 6%, var(--bg));color:var(--text)" /><input type="email" name="email" placeholder="Your Email" required class="w-full bloom-pill px-4 py-2 text-sm font-semibold outline-none" style="background:color-mix(in srgb, var(--primary) 6%, var(--bg));color:var(--text)" /><textarea name="message" rows="4" placeholder="Your Message" required class="w-full bloom-pill px-4 py-2 text-sm font-semibold outline-none" style="background:color-mix(in srgb, var(--primary) 6%, var(--bg));color:var(--text)"></textarea><button type="submit" class="bloom-btn w-full px-4 py-2.5 text-sm font-bold text-white" style="background:var(--primary)">Send</button></form></div></div></div></div>
