---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-12">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-extrabold mb-8" style="color:var(--text)">Admissions</h1>
    <div class="bloom-card p-8" style="background:var(--surface);border:1px solid var(--border)">
      
<p class="text-lg font-medium mb-8" style="color:var(--muted)">Begin your journey with {school.name}.</p>
<div class="space-y-6">
  <div class="bloom-card p-6" style="background:color-mix(in srgb, var(--primary) 4%, var(--bg))"><h3 class="font-extrabold mb-3" style="color:var(--text)">Application Process</h3><ol class="space-y-2 font-medium" style="color:var(--muted)"><li>1. Complete the online application</li><li>2. Submit required documents</li><li>3. Attend assessment interview</li><li>4. Receive admission decision</li><li>5. Complete enrollment</li></ol></div>
  <div class="bloom-card p-6" style="background:color-mix(in srgb, var(--primary) 4%, var(--bg))"><h3 class="font-extrabold mb-3" style="color:var(--text)">Required Documents</h3><ul class="space-y-1 font-medium" style="color:var(--muted)"><li>- Birth certificate</li><li>- Previous school records</li><li>- Immunization records</li><li>- Passport photos</li></ul></div>
  <a href={`/${school.slug}/contact`} class="bloom-btn inline-flex px-6 py-3 text-sm font-bold text-white" style="background:var(--primary)">Contact Admissions</a>
</div>

    </div>
  </div>
</div>