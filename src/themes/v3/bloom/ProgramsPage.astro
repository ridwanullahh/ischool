---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-12"><div class="max-w-5xl mx-auto"><h1 class="text-4xl font-extrabold mb-8" style="color:var(--text)">Our Programs</h1><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{(data.items || data.schoolPrograms || []).map(p => <a href={`/${school.slug}/programs/${p.slug}`} class="bloom-card p-6 hover:scale-105 transition-transform block" style="background:color-mix(in srgb, var(--primary) 4%, var(--surface));border:1px solid var(--border)"><h3 class="text-lg font-extrabold mb-2" style="color:var(--text)">{p.name}</h3>{p.level && <p class="text-sm font-bold mb-2" style="color:var(--primary)">{p.level}</p>}{p.description && <p class="text-sm line-clamp-3 font-medium" style="color:var(--muted)">{p.description}</p>}</a>)}</div></div></div>
