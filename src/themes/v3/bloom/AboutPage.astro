---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-12">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-extrabold mb-8" style="color:var(--text)">About {school.name}</h1>
    <div class="bloom-card p-8" style="background:var(--surface);border:1px solid var(--border)">
      
{data.about?.valueProposition && <p class="text-xl font-bold leading-relaxed mb-6" style="color:var(--text)">{data.about.valueProposition}</p>}
{data.about?.mission && <div class="mb-6"><h3 class="text-xs font-extrabold uppercase tracking-wider mb-2" style="color:var(--primary)">Mission</h3><p class="font-medium" style="color:var(--muted)">{data.about.mission}</p></div>}
{data.about?.vision && <div><h3 class="text-xs font-extrabold uppercase tracking-wider mb-2" style="color:var(--primary)">Vision</h3><p class="font-medium" style="color:var(--muted)">{data.about.vision}</p></div>}
{data.features?.length > 0 && <div class="mt-8"><h3 class="text-xs font-extrabold uppercase tracking-wider mb-4" style="color:var(--primary)">Highlights</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4">{data.features.map(f => <div class="bloom-card p-4" style="background:color-mix(in srgb, var(--primary) 4%, var(--bg))"><h4 class="font-extrabold mb-1" style="color:var(--text)">{f.title}</h4><p class="text-sm font-medium" style="color:var(--muted)">{f.description}</p></div>)}</div></div>}

    </div>
  </div>
</div>