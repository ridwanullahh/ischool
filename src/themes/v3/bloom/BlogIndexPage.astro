---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-12"><div class="max-w-5xl mx-auto"><h1 class="text-4xl font-extrabold mb-8" style="color:var(--text)">Blog & News</h1><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{(data.items || []).map(post => <a href={`/${school.slug}/blog/${post.slug}`} class="bloom-card overflow-hidden hover:scale-105 transition-transform block group" style="background:var(--surface);border:1px solid var(--border)">{post.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />}<div class="p-6"><h3 class="font-extrabold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{post.title}</h3><p class="text-sm line-clamp-2 font-medium" style="color:var(--muted)">{post.excerpt || post.content}</p></div></a>)}</div></div></div>
