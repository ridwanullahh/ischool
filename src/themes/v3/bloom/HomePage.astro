---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="space-y-0">
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="max-w-4xl mx-auto px-4 text-center">
      {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-16 w-auto mx-auto mb-6 rounded-2xl" /> : <div class="bloom-blob inline-flex h-20 w-20 items-center justify-center text-white font-black text-3xl mb-6" style="background:linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--accent) 70%, var(--primary)))">{school.name.charAt(0)}</div>}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight" style="color:var(--text)">{school.name}</h1>
      {school.tagline && <p class="mt-4 text-xl font-semibold" style="color:var(--muted)">{school.tagline}</p>}
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${prefix}/admissions`} class="bloom-btn px-6 py-3 text-base font-bold text-white" style="background:var(--primary)">Apply for Admission</a>
        <a href={`${prefix}/about`} class="bloom-btn px-6 py-3 text-base font-bold bloom-card" style="background:var(--surface);border:1px solid var(--border);color:var(--text)">Learn More</a>
      </div>
    </div>
  </section>
  {data.recentAnnouncements?.length > 0 && (
    <div class="px-4 mb-8"><a href={`/${school.slug}/announcements/${data.recentAnnouncements[0].slug}`} class="block max-w-5xl mx-auto bloom-card p-4 hover:scale-[1.01] transition-transform" style="background:color-mix(in srgb, var(--primary) 8%, var(--bg))"><div class="flex items-center gap-3"><span class="bloom-pill px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white" style="background:var(--primary)">Latest</span><span class="text-sm font-bold" style="color:var(--text)">{data.recentAnnouncements[0].title}</span></div></a></div>
  )}
  {data.about?.valueProposition && <section class="py-16"><div class="max-w-3xl mx-auto px-4 text-center"><p class="text-2xl font-bold leading-relaxed" style="color:var(--text)">{data.about.valueProposition}</p></div></section>}
  {data.features?.length > 0 && <section class="py-16"><div class="max-w-5xl mx-auto px-4"><h2 class="text-3xl font-extrabold text-center mb-12" style="color:var(--text)">Our Highlights</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{data.features.map(f => <div class="bloom-card p-6 hover:scale-105 transition-transform" style="background:color-mix(in srgb, var(--primary) 4%, var(--surface));border:1px solid var(--border)"><div class="bloom-blob w-12 h-12 flex items-center justify-center mb-4" style="background:var(--primary)"></div><h3 class="text-lg font-extrabold mb-2" style="color:var(--text)">{f.title}</h3><p class="text-sm font-medium" style="color:var(--muted)">{f.description}</p></div>)}</div></div></section>}
  {data.schoolPrograms?.length > 0 && <section class="py-16"><div class="max-w-5xl mx-auto px-4"><h2 class="text-3xl font-extrabold text-center mb-12" style="color:var(--text)">Our Programs</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">{data.schoolPrograms.map(p => <a href={`/${school.slug}/programs/${p.slug}`} class="bloom-card p-6 hover:scale-105 transition-transform block" style="background:color-mix(in srgb, var(--primary) 4%, var(--surface));border:1px solid var(--border)"><h3 class="text-lg font-extrabold mb-2" style="color:var(--text)">{p.name}</h3>{p.level && <p class="text-sm font-bold mb-2" style="color:var(--primary)">{p.level}</p>}{p.description && <p class="text-sm line-clamp-3 font-medium" style="color:var(--muted)">{p.description}</p>}</a>)}</div></div></section>}
  {data.stats?.length > 0 && <section class="py-16 mx-4"><div class="bloom-card py-12" style="background:var(--primary)"><div class="max-w-5xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">{data.stats.map(s => <div class="text-center text-white"><p class="text-3xl sm:text-4xl font-extrabold">{s.value}</p><p class="text-sm opacity-80 mt-1 font-semibold">{s.label}</p></div>)}</div></div></section>}
  {data.recentPosts?.length > 0 && <section class="py-16"><div class="max-w-5xl mx-auto px-4"><div class="flex items-center justify-between mb-12"><h2 class="text-3xl font-extrabold" style="color:var(--text)">Latest News</h2><a href={`/${school.slug}/blog`} class="text-sm font-bold hover:underline" style="color:var(--primary)">View all</a></div><div class="grid grid-cols-1 md:grid-cols-3 gap-8">{data.recentPosts.map(post => <a href={`/${school.slug}/blog/${post.slug}`} class="bloom-card overflow-hidden hover:scale-105 transition-transform block group" style="background:var(--surface);border:1px solid var(--border)">{post.coverImageUrl && <img src={post.coverImageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />}<div class="p-6"><h3 class="font-extrabold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{post.title}</h3><p class="text-sm line-clamp-2 font-medium" style="color:var(--muted)">{post.excerpt || post.content}</p></div></a>)}</div></div></section>}
  <section class="py-20"><div class="max-w-4xl mx-auto px-4 text-center"><div class="bloom-card p-8 sm:p-12" style="background:color-mix(in srgb, var(--primary) 4%, var(--surface));border:1px solid var(--border)"><h2 class="text-3xl font-extrabold mb-4" style="color:var(--text)">Ready to Join?</h2><p class="mb-8 max-w-2xl mx-auto font-medium" style="color:var(--muted)">We would love to welcome your family to our community.</p><a href={`/${school.slug}/admissions`} class="bloom-btn inline-flex px-8 py-3.5 text-base font-bold text-white" style="background:var(--primary)">Start Application</a></div></div></section>
</div>
