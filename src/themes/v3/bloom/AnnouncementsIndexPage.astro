---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-12"><div class="max-w-4xl mx-auto"><h1 class="text-4xl font-extrabold mb-8" style="color:var(--text)">Announcements</h1><div class="space-y-4">{(data.items || []).map(a => <a href={`/${school.slug}/announcements/${a.slug}`} class="bloom-card p-6 hover:scale-[1.01] transition-transform block" style="background:var(--surface);border:1px solid var(--border)"><div class="flex items-start justify-between gap-4"><div class="flex-1"><h3 class="font-extrabold mb-1" style="color:var(--text)">{a.title}</h3><p class="text-sm line-clamp-2 font-medium" style="color:var(--muted)">{a.excerpt || a.content}</p><p class="text-xs mt-2 font-medium" style="color:var(--muted)">{formatDate(a.publishedAt || a.createdAt)}</p></div>{a.isPinned && <span class="bloom-pill px-2 py-0.5 text-[10px] font-bold text-white shrink-0" style="background:var(--primary)">PINNED</span>}</div></a>)}</div></div></div>
