---
import { getSchoolNav } from '../../../lib/school.ts';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div class="space-y-0">
  <!-- Hero: industrial blueprint -->
  <section class="forge-grid-bg border-b-2 px-4 py-16 sm:py-24" style="background:var(--bg);border-color:var(--text)">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <span class="forge-pill">Forging Futures · Since {new Date().getFullYear() - 30}</span>
        <h1 class="forge-cond mt-6 text-5xl sm:text-6xl lg:text-7xl font-black uppercase leading-[0.95] tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="forge-cond mt-5 text-base sm:text-lg uppercase tracking-wider font-medium" style="color:var(--muted)">{school.tagline}</p>}
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href={`${prefix}/admissions`} class="forge-grad forge-cond px-8 py-3.5 text-sm font-bold uppercase tracking-[0.2em] text-white border-2" style="border-color:var(--text)">Apply for Admission</a>
          <a href={`${prefix}/about`} class="forge-cond px-8 py-3.5 text-sm font-bold uppercase tracking-[0.2em] border-2 hover:bg-black/5" style="border-color:var(--text);color:var(--text)">Learn More</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="forge-card p-7">
          <div class="flex items-center gap-3 mb-5 pb-4 border-b-2" style="border-color:var(--text)">
            <span class="forge-pill">Spec Sheet</span>
          </div>
          {stats.length > 0 ? (
            <div class="grid grid-cols-2 gap-5">
              {stats.slice(0, 4).map(s => (
                <div class="border-l-4 pl-3" style="border-color:var(--primary)">
                  <div class="forge-cond text-3xl font-black" style="color:var(--text)">{s.value}</div>
                  <div class="forge-cond text-[10px] font-bold uppercase tracking-wider mt-1" style="color:var(--muted)">{s.label}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-6">
              <div class="forge-cond text-5xl font-black" style="color:var(--primary)">{school.name.charAt(0)}</div>
              <p class="forge-cond text-xs mt-3 uppercase tracking-wider" style="color:var(--muted)">Built for excellence</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Value proposition -->
  {about.valueProposition && (
    <section class="py-16" style="background:var(--surface)">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <span class="forge-pill">Our Mission</span>
        <p class="forge-cond mt-5 text-2xl sm:text-3xl font-bold uppercase leading-tight" style="color:var(--text)">{about.valueProposition}</p>
      </div>
    </section>
  )}

  <!-- Features: numbered industrial cards -->
  {features.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-4 mb-12">
          <span class="forge-pill">01</span>
          <h2 class="forge-cond text-3xl sm:text-4xl font-black uppercase tracking-tight" style="color:var(--text)">Why Choose Us</h2>
          <div class="flex-1 h-1" style="background:var(--text)"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <div class="forge-card p-7">
              <div class="flex items-center justify-between mb-4">
                <span class="forge-cond text-5xl font-black" style="color:var(--primary)">{String(i + 1).padStart(2, '0')}</span>
                <span class="forge-pill">Asset</span>
              </div>
              <h3 class="forge-cond text-xl font-black uppercase tracking-tight mb-3" style="color:var(--text)">{f.title}</h3>
              <p class="text-sm leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Programs: industrial cards -->
  {programs.length > 0 && (
    <section class="px-4 py-16" style="background:var(--surface)">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-4 mb-12">
          <span class="forge-pill">02</span>
          <h2 class="forge-cond text-3xl sm:text-4xl font-black uppercase tracking-tight" style="color:var(--text)">Our Programs</h2>
          <div class="flex-1 h-1" style="background:var(--text)"></div>
          <a href={`${prefix}/programs`} class="forge-cond text-xs font-bold uppercase tracking-[0.2em] hover:opacity-70" style="color:var(--primary)">View all</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {programs.slice(0, 3).map(p => (
            <a href={`${prefix}/programs/${p.slug || p.id}`} class="forge-card overflow-hidden block">
              {p.imageUrl && <img src={p.imageUrl} alt={p.name} class="w-full h-44 object-cover" loading="lazy" />}
              <div class="p-6">
                <h3 class="forge-cond text-lg font-black uppercase tracking-tight mb-2" style="color:var(--text)">{p.name}</h3>
                {p.description && <p class="text-sm leading-relaxed line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                {p.duration && <span class="inline-block mt-3 forge-cond text-[10px] font-bold uppercase tracking-[0.15em] px-3 py-1.5 border-2" style="border-color:var(--primary);color:var(--primary)">{p.duration}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Latest announcements + blog -->
  {(announcements.length > 0 || posts.length > 0) && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8">
        {announcements.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6 pb-3 border-b-2" style="border-color:var(--text)">
              <h2 class="forge-cond text-2xl font-black uppercase tracking-tight" style="color:var(--text)">Latest News</h2>
              <a href={`${prefix}/announcements`} class="forge-cond text-xs font-bold uppercase tracking-[0.2em] hover:opacity-70" style="color:var(--primary)">All news</a>
            </div>
            <div class="space-y-4">
              {announcements.slice(0, 3).map(a => (
                <a href={`${prefix}/announcements/${a.slug || a.id}`} class="forge-card p-5 block">
                  <span class="forge-cond text-[10px] font-bold uppercase tracking-[0.2em]" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</span>
                  <h3 class="forge-cond font-black uppercase tracking-tight mt-1" style="color:var(--text)">{a.title}</h3>
                  {a.excerpt && <p class="text-sm mt-1 line-clamp-2" style="color:var(--muted)">{a.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
        {posts.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6 pb-3 border-b-2" style="border-color:var(--text)">
              <h2 class="forge-cond text-2xl font-black uppercase tracking-tight" style="color:var(--text)">From the Blog</h2>
              <a href={`${prefix}/blog`} class="forge-cond text-xs font-bold uppercase tracking-[0.2em] hover:opacity-70" style="color:var(--primary)">All posts</a>
            </div>
            <div class="space-y-4">
              {posts.slice(0, 3).map(p => (
                <a href={`${prefix}/blog/${p.slug || p.id}`} class="forge-card p-5 block">
                  <span class="forge-cond text-[10px] font-bold uppercase tracking-[0.2em]" style="color:var(--accent)">{formatDate(p.publishedAt || p.createdAt)}</span>
                  <h3 class="forge-cond font-black uppercase tracking-tight mt-1" style="color:var(--text)">{p.title}</h3>
                  {p.excerpt && <p class="text-sm mt-1 line-clamp-2" style="color:var(--muted)">{p.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="px-4 py-20" style="background:var(--surface)">
    <div class="max-w-5xl mx-auto forge-card p-10 sm:p-16 text-center" style="background:var(--bg)">
      <span class="forge-pill">Get Started</span>
      <h2 class="forge-cond mt-5 text-3xl sm:text-4xl font-black uppercase tracking-tight mb-4" style="color:var(--text)">Build your future with us</h2>
      <p class="forge-cond text-base uppercase tracking-wider mb-8 max-w-2xl mx-auto" style="color:var(--muted)">Admissions are open for the upcoming academic year. Submit your application today.</p>
      <a href={`${prefix}/admissions`} class="forge-grad forge-cond inline-block px-8 py-3.5 text-sm font-bold uppercase tracking-[0.2em] text-white border-2" style="border-color:var(--text)">Submit Application</a>
    </div>
  </section>
</div>
