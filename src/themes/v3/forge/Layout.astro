---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const primaryContact = contacts[0];
import PageLoader from '../../../components/PageLoader.astro';
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Archivo+Narrow:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Archivo', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .forge-cond { font-family: 'Archivo Narrow', 'Archivo', sans-serif; }
    .forge-grid-bg { background-image: linear-gradient(color-mix(in srgb, var(--primary) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--primary) 6%, transparent) 1px, transparent 1px); background-size: 32px 32px; }
    .forge-card { background: var(--surface); border: 2px solid var(--text); border-radius: 0; position: relative; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .forge-card:hover { transform: translate(4px, -4px); box-shadow: -8px 8px 0 0 var(--primary); }
    .forge-card-flat { background: var(--surface); border: 1px solid var(--border); border-radius: 0; }
    .forge-grad { background: var(--primary); }
    .forge-stripe { background: repeating-linear-gradient(45deg, var(--primary), var(--primary) 6px, color-mix(in srgb, var(--primary) 70%, #000) 6px, color-mix(in srgb, var(--primary) 70%, #000) 12px); }
    .forge-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; font-family: 'Archivo Narrow', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; background: var(--text); color: var(--bg); }
    .forge-nav-link { position: relative; font-family: 'Archivo Narrow', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; padding: 8px 14px; transition: all 0.2s; border: 2px solid transparent; }
    .forge-nav-link:hover, .forge-nav-link[data-active="true"] { background: var(--primary); color: #fff; border-color: var(--text); }
    .forge-corner { position: absolute; width: 12px; height: 12px; border: 2px solid var(--primary); }
  `} />
</head>
<body>
    <PageLoader />
  <div class="forge-stripe h-2" aria-hidden="true"></div>

  <div class="border-b-2" style="background:var(--surface);border-color:var(--text)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-9 flex items-center justify-between text-xs">
      <div class="flex items-center gap-4 forge-cond font-semibold uppercase tracking-wider" style="color:var(--muted)">
        {primaryContact && <span class="flex items-center gap-1.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{primaryContact.value}</span>}
      </div>
      <div class="flex items-center gap-3">
        {socialEntries.slice(0,5).map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--muted)" class="hover:opacity-70"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}
        <span class="w-px h-3" style="background:var(--border)"></span>
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
      </div>
    </div>
  </div>

    <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

<header class="border-b-2 forge-grid-bg" style="background:var(--bg);border-color:var(--text)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex items-center justify-between gap-4">
      <a href={`${prefix}/`} class="flex items-center gap-4" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-12 w-auto" /> : <span class="inline-flex h-12 w-12 items-center justify-center text-white font-black text-xl forge-grad border-2" style="border-color:var(--text)">{school.name.charAt(0)}</span>}
        <div>
          <span class="forge-cond block text-2xl font-black uppercase tracking-tight leading-none" style="color:var(--text)">{school.name}</span>
          {school.tagline && <span class="forge-cond block text-[10px] uppercase tracking-[0.25em] mt-1.5" style="color:var(--primary)">{school.tagline.slice(0, 50)}</span>}
        </div>
      </a>
      <div class="hidden lg:flex items-center gap-1">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="forge-nav-link" style={active ? "" : "color:var(--text)"}>{item.label}</a>; })}
        <a href={`${prefix}/admissions`} class="forge-grad forge-nav-link text-white" style="border-color:var(--text)">Apply</a>
      </div>
      <button id="forge-menu-toggle" type="button" class="lg:hidden p-2 border-2" style="color:var(--text);border-color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    </div>
    <div id="forge-mobile-nav" class="lg:hidden hidden border-t-2 px-4 py-3" style="border-color:var(--text);background:var(--surface)">
      <div class="flex flex-col gap-1">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="forge-nav-link block" style={active ? "" : "color:var(--text)"}>{item.label}</a>; })}
        <a href={`${prefix}/admissions`} class="forge-grad forge-nav-link block text-white" style="border-color:var(--text)">Apply</a>
      </div>
    </div>
  </header>

  <main><slot /></main>

  <footer class="border-t-2 mt-20" style="background:var(--surface);border-color:var(--text)">
    <div class="forge-stripe h-2" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 py-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto" /> : <span class="inline-flex h-10 w-10 items-center justify-center text-white font-black forge-grad border-2" style="border-color:var(--text)">{school.name.charAt(0)}</span>}
            <span class="forge-cond text-xl font-black uppercase tracking-tight" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm max-w-md leading-relaxed forge-cond" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-5">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="p-2.5 border-2 hover:bg-black/5 transition-colors" style="border-color:var(--text);color:var(--text)"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div class="md:col-span-3">
          <h3 class="forge-cond text-xs font-black uppercase tracking-[0.2em] mb-4 pb-2 border-b-2" style="color:var(--text);border-color:var(--text)">Navigate</h3>
          <ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="forge-cond text-sm font-semibold uppercase tracking-wider hover:opacity-70" style="color:var(--muted)">{item.label}</a></li>)}</ul>
        </div>
        <div class="md:col-span-4">
          <h3 class="forge-cond text-xs font-black uppercase tracking-[0.2em] mb-4 pb-2 border-b-2" style="color:var(--text);border-color:var(--text)">Contact</h3>
          <ul class="space-y-3">{contacts.slice(0,4).map(c => <li class="text-sm" style="color:var(--muted)">{c.label && <span class="block text-[10px] uppercase tracking-wider mb-0.5 forge-cond font-bold" style="color:var(--primary)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul>
        </div>
      </div>
      <div class="mt-10 pt-6 border-t-2 flex flex-col sm:flex-row items-center justify-between gap-2" style="border-color:var(--text)">
        <p class="forge-cond text-[11px] uppercase tracking-[0.2em] font-semibold" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="forge-cond text-[11px] uppercase tracking-[0.2em] font-bold hover:opacity-70" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>
<button id="forge-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 forge-grad px-5 py-4 shadow-lg border-2" style="border-color:var(--text)" aria-label="Open chat"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="forge-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] forge-card hidden flex-col overflow-hidden shadow-2xl" style="max-height:70vh">
    <div class="forge-grad px-5 py-4 border-b-2" style="border-color:var(--text)"><p class="forge-cond text-base font-black uppercase tracking-wider text-white">{school.name} Help Desk</p><p class="forge-cond text-[10px] uppercase tracking-[0.2em] text-white/80 mt-1">Request assistance</p></div>
    <div id="forge-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="background:var(--bg)"><div class="forge-card-flat px-4 py-2.5 text-sm max-w-[85%]" style="color:var(--text)">State your request.</div></div>
    <form id="forge-chat-form" class="p-3 border-t-2 flex items-center gap-2" style="border-color:var(--text);background:var(--surface)">
      <input id="forge-chat-input" type="text" placeholder="Type your message..." class="flex-1 forge-cond px-3 py-2 text-sm outline-none border-2" style="border-color:var(--text);background:var(--bg);color:var(--text)" aria-label="Message" />
      <button type="submit" class="forge-grad p-2.5 border-2" style="border-color:var(--text)" aria-label="Send"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('forge-menu-toggle'),d=document.getElementById('forge-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('forge-chat-toggle'),cp=document.getElementById('forge-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('forge-chat-form'),i=document.getElementById('forge-chat-input'),m=document.getElementById('forge-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='forge-card-flat px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='forge-card-flat px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='forge-card-flat px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
