---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import { getSocialIconPath } from '../_shared/social-icons';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const prefix = '/' + school.slug;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<div class="px-4 py-16">
  <div class="max-w-4xl mx-auto">
    <div class="halo-card rounded-3xl p-8 sm:p-12">
      <h1 class="text-4xl font-bold mb-6" style="color:var(--text)">Admissions</h1>
      <p class="text-lg mb-8" style="color:var(--muted)">Begin your journey with {school.name}. We welcome families who share our commitment to excellence.</p>
      <div class="space-y-6">
        <div class="halo-card rounded-xl p-6"><h3 class="font-bold mb-2" style="color:var(--text)">Application Process</h3><ol class="space-y-2" style="color:var(--muted)"><li>1. Complete the online application form</li><li>2. Submit required documents</li><li>3. Attend an assessment interview</li><li>4. Receive admission decision</li><li>5. Complete enrollment and fee payment</li></ol></div>
        <div class="halo-card rounded-xl p-6"><h3 class="font-bold mb-2" style="color:var(--text)">Required Documents</h3><ul class="space-y-1" style="color:var(--muted)"><li>Birth certificate</li><li>Previous school records (if applicable)</li><li>Immunization records</li><li>Passport-size photographs</li></ul></div>
        <a href={`/${school.slug}/contact`} class="halo-grad inline-flex px-8 py-3.5 text-base font-semibold text-white rounded-xl shadow-lg hover:scale-105 transition-transform">Contact Admissions</a>
      </div>
    </div>
  </div>
</div>
