---
import { getSchoolNav } from '../../../lib/school.ts';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div class="space-y-0">
  <section class="ember-texture px-4 py-16 sm:py-24" style="background:var(--bg)">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="ember-pill">A warm welcome awaits</span>
        <h1 class="ember-serif mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="ember-serif italic mt-5 text-lg sm:text-xl leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href={`${prefix}/admissions`} class="ember-grad px-7 py-3.5 text-base font-semibold text-white rounded-full shadow-lg hover:scale-105 transition-transform">Apply for Admission</a>
          <a href={`${prefix}/about`} class="px-7 py-3.5 text-base font-semibold rounded-full border-2 hover:bg-black/5 transition-colors" style="border-color:var(--primary);color:var(--primary)">Learn More</a>
        </div>
      </div>
      <div class="relative">
        <div class="ember-card p-8 shadow-xl">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b" style="border-color:var(--border)">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--primary)" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <h3 class="ember-serif text-lg font-bold" style="color:var(--text)">Our Community at a Glance</h3>
          </div>
          {stats.length > 0 ? (
            <div class="grid grid-cols-2 gap-6">
              {stats.slice(0, 4).map(s => (
                <div>
                  <div class="ember-serif text-3xl font-bold" style="color:var(--primary)">{s.value}</div>
                  <div class="text-xs font-medium mt-1 uppercase tracking-wider" style="color:var(--muted)">{s.label}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-6">
              <div class="ember-serif text-5xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</div>
              <p class="ember-serif text-sm italic mt-3" style="color:var(--muted)">A place to belong</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {about.valueProposition && (
    <section class="px-4 py-16" style="background:var(--surface)">
      <div class="max-w-4xl mx-auto text-center">
        <span class="ember-pill">Our Promise</span>
        <p class="ember-serif italic text-xl sm:text-2xl leading-relaxed mt-4" style="color:var(--text)">{about.valueProposition}</p>
      </div>
    </section>
  )}

  {features.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <span class="ember-pill">Our Highlights</span>
          <h2 class="ember-serif mt-4 text-3xl sm:text-4xl font-bold" style="color:var(--text)">What makes us feel like home</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <div class="ember-card p-7">
              <div class="w-12 h-12 ember-grad flex items-center justify-center rounded-xl mb-5">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <h3 class="ember-serif text-lg font-bold mb-2" style="color:var(--text)">{f.title}</h3>
              <p class="text-sm leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {programs.length > 0 && (
    <section class="px-4 py-16" style="background:var(--surface)">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
          <div>
            <span class="ember-pill">Academics</span>
            <h2 class="ember-serif mt-4 text-3xl font-bold" style="color:var(--text)">Our Programs</h2>
          </div>
          <a href={`${prefix}/programs`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">View all programs</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {programs.slice(0, 3).map(p => (
            <a href={`${prefix}/programs/${p.slug || p.id}`} class="ember-card overflow-hidden block">
              {p.imageUrl && <img src={p.imageUrl} alt={p.name} class="w-full h-44 object-cover" loading="lazy" />}
              <div class="p-6">
                <h3 class="ember-serif text-lg font-bold mb-2" style="color:var(--text)">{p.name}</h3>
                {p.description && <p class="ember-serif italic text-sm leading-relaxed line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                {p.duration && <span class="inline-block mt-3 text-xs font-semibold px-3 py-1 rounded-full" style="background:color-mix(in srgb, var(--primary) 10%, transparent);color:var(--primary)">{p.duration}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {(announcements.length > 0 || posts.length > 0) && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8">
        {announcements.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6 pb-3 border-b" style="border-color:var(--border)">
              <h2 class="ember-serif text-2xl font-bold" style="color:var(--text)">Latest News</h2>
              <a href={`${prefix}/announcements`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">All news</a>
            </div>
            <div class="space-y-4">
              {announcements.slice(0, 3).map(a => (
                <a href={`${prefix}/announcements/${a.slug || a.id}`} class="ember-card p-5 block">
                  <span class="ember-serif text-xs italic font-medium" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</span>
                  <h3 class="ember-serif font-bold mt-1" style="color:var(--text)">{a.title}</h3>
                  {a.excerpt && <p class="ember-serif text-sm mt-1 line-clamp-2 italic" style="color:var(--muted)">{a.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
        {posts.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6 pb-3 border-b" style="border-color:var(--border)">
              <h2 class="ember-serif text-2xl font-bold" style="color:var(--text)">From the Blog</h2>
              <a href={`${prefix}/blog`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">All posts</a>
            </div>
            <div class="space-y-4">
              {posts.slice(0, 3).map(p => (
                <a href={`${prefix}/blog/${p.slug || p.id}`} class="ember-card p-5 block">
                  <span class="ember-serif text-xs italic font-medium" style="color:var(--accent)">{formatDate(p.publishedAt || p.createdAt)}</span>
                  <h3 class="ember-serif font-bold mt-1" style="color:var(--text)">{p.title}</h3>
                  {p.excerpt && <p class="ember-serif text-sm mt-1 line-clamp-2 italic" style="color:var(--muted)">{p.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="px-4 py-20">
    <div class="max-w-5xl mx-auto ember-grad rounded-3xl p-10 sm:p-16 text-center text-white shadow-xl">
      <h2 class="ember-serif text-3xl sm:text-4xl font-bold mb-4">Come join our family</h2>
      <p class="ember-serif italic text-lg opacity-95 mb-8 max-w-2xl mx-auto">Admissions are open for the upcoming academic year. We can't wait to welcome you into our warm community.</p>
      <a href={`${prefix}/admissions`} class="inline-block bg-white px-8 py-3.5 rounded-full font-semibold hover:scale-105 transition-transform" style="color:var(--primary)">Apply Now</a>
    </div>
  </section>
</div>
