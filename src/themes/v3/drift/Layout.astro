---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Figtree', system-ui, sans-serif; color: var(--text); min-height: 100vh; overflow-x: hidden; }
    .drift-blob { position: fixed; border-radius: 50% 60% 70% 40% / 50% 60% 40% 50%; filter: blur(60px); opacity: 0.18; pointer-events: none; z-index: 0; animation: drift-morph 20s ease-in-out infinite; }
    .drift-blob-1 { width: 460px; height: 460px; top: -120px; right: -100px; background: var(--primary); }
    .drift-blob-2 { width: 380px; height: 380px; bottom: -100px; left: -120px; background: var(--accent); opacity: 0.14; animation-delay: -8s; }
    @keyframes drift-morph { 0%, 100% { border-radius: 50% 60% 70% 40% / 50% 60% 40% 50%; } 50% { border-radius: 70% 40% 50% 60% / 40% 70% 50% 60%; } }
    html.dark .drift-blob { opacity: 0.1; }
    @media (prefers-reduced-motion: reduce) { .drift-blob { animation: none; } }
    .drift-card { background: var(--surface); border: 1px solid color-mix(in srgb, var(--border) 60%, transparent); border-radius: 28px 36px 28px 36px; transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), box-shadow 0.4s ease; }
    .drift-card:hover { transform: translateY(-6px) rotate(-0.5deg); box-shadow: 0 24px 48px -16px color-mix(in srgb, var(--primary) 25%, transparent); }
    .drift-grad { background: linear-gradient(120deg, var(--primary), var(--accent)); }
    .drift-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 999px; font-size: 12px; font-weight: 600; background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent); }
    .drift-nav-link { position: relative; font-size: 14px; font-weight: 500; padding: 8px 16px; border-radius: 999px; transition: all 0.3s ease; }
    .drift-nav-link:hover { background: color-mix(in srgb, var(--primary) 8%, transparent); color: var(--primary); }
    .drift-nav-link[data-active="true"] { background: var(--primary); color: #fff; }
    .drift-wave-divider { position: relative; height: 60px; }
  `} />
</head>
<body>
  <div class="drift-blob drift-blob-1" aria-hidden="true"></div>
  <div class="drift-blob drift-blob-2" aria-hidden="true"></div>

  <!-- Asymmetric floating header -->
  <header class="relative z-50 px-4 sm:px-6 pt-6">
    <nav class="max-w-7xl mx-auto drift-card shadow-lg px-5 py-3 flex items-center justify-between" style="border-radius: 32px 18px 32px 18px">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-full" /> : <span class="inline-flex h-11 w-11 items-center justify-center rounded-full text-white font-bold drift-grad">{school.name.charAt(0)}</span>}
        <div>
          <span class="block text-base font-bold leading-tight" style="color:var(--text)">{school.name}</span>
          {school.tagline && <span class="block text-xs italic leading-tight" style="color:var(--muted)">{school.tagline.slice(0, 40)}</span>}
        </div>
      </a>
      <div class="hidden lg:flex items-center gap-1">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="drift-nav-link" style={active ? "" : "color:var(--muted)"}>{item.label}</a>; })}
      </div>
      <div class="flex items-center gap-2">
        <LanguageSelector />
        <button id="theme-toggle" type="button" class="p-2 rounded-full hover:bg-black/5" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
        <a href={`${prefix}/admissions`} class="hidden sm:inline-flex drift-grad px-5 py-2 text-sm font-semibold text-white rounded-full shadow-md">Apply</a>
        <button id="drift-menu-toggle" type="button" class="lg:hidden p-2 rounded-full hover:bg-black/5" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
    </nav>
    <div id="drift-mobile-nav" class="lg:hidden hidden mt-2 drift-card p-3 space-y-1" style="border-radius: 28px 20px 28px 20px">
      {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="block px-4 py-2.5 rounded-full text-sm font-medium" style={active ? "background:var(--primary);color:#fff" : "color:var(--text)"}>{item.label}</a>; })}
    </div>
  </header>

  <main class="relative z-10"><slot /></main>

  <!-- Footer with wave divider -->
  <div class="drift-wave-divider relative z-10" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full"><path d="M0,30 C240,60 480,0 720,30 C960,60 1200,0 1440,30 L1440,60 L0,60 Z" fill="var(--surface)" /></svg>
  </div>
  <footer class="relative z-10 px-4 pb-8" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto pt-8 pb-10">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-full" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-full text-white font-bold drift-grad">{school.name.charAt(0)}</span>}
            <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm max-w-md leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-5">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="p-2.5 rounded-full border transition-all hover:scale-110" style="border-color:var(--border);color:var(--text)"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-4" style="color:var(--muted)">Explore</h3><ul class="space-y-2.5">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-4" style="color:var(--muted)">Contact</h3><ul class="space-y-2.5">{contacts.slice(0,5).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul></div>
      </div>
      <div class="mt-8 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-3" style="border-color:var(--border)">
        <p class="text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="text-xs font-medium hover:underline" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

  <button id="drift-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 drift-grad p-4 rounded-full shadow-2xl hover:scale-110 transition-transform" aria-label="Open chat"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="drift-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] drift-card shadow-2xl hidden flex-col overflow-hidden" style="max-height:70vh;border-radius:32px 24px 32px 24px">
    <div class="drift-grad px-5 py-4"><p class="text-sm font-bold text-white">{school.name} Assistant</p><p class="text-[11px] text-white/80">Flowing conversations, here for you</p></div>
    <div id="drift-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"><div class="drift-card rounded-3xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]" style="color:var(--text);border-radius:24px 8px 24px 8px">How can we help today?</div></div>
    <form id="drift-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)">
      <input id="drift-chat-input" type="text" placeholder="Type your message..." class="flex-1 rounded-full px-4 py-2 text-sm outline-none border" style="border-color:var(--border);background:var(--bg);color:var(--text)" aria-label="Message" />
      <button type="submit" class="drift-grad p-2.5 rounded-full" aria-label="Send"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('drift-menu-toggle'),d=document.getElementById('drift-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('drift-chat-toggle'),cp=document.getElementById('drift-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('drift-chat-form'),i=document.getElementById('drift-chat-input'),m=document.getElementById('drift-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='drift-card rounded-3xl rounded-tr-sm px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.style.borderRadius='8px 24px 8px 24px';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='drift-card rounded-3xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.style.borderRadius='24px 8px 24px 8px';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='drift-card rounded-3xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.style.borderRadius='24px 8px 24px 8px';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
