---
import '../../../styles/global.css';
import PaletteStyles from '../_shared/PaletteStyles.astro';
import FoucScript from '../_shared/FoucScript.astro';
import ThemeToggleScript from '../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../lib/social.ts';
import LanguageSelector from '../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline set:html={`
    html, body { background: var(--bg); }
    body { font-family: 'Figtree', system-ui, sans-serif; color: var(--text); min-height: 100vh; overflow-x: hidden; }
    .cascade-wave { position: fixed; top: 0; left: 0; right: 0; height: 300px; pointer-events: none; z-index: 0; opacity: 0.4; }
    .cascade-wave svg { width: 100%; height: 100%; }
    .cascade-card { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .cascade-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -12px rgba(0,0,0,0.12); }
    .cascade-grad { background: linear-gradient(135deg, var(--primary), var(--accent)); }
    .cascade-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 600; background: color-mix(in srgb, var(--primary) 10%, transparent); color: var(--primary); }
    .cascade-nav-link { position: relative; font-size: 14px; font-weight: 500; padding: 8px 0; transition: color 0.2s; }
    .cascade-nav-link::after { content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 2px; background: var(--primary); border-radius: 2px; transition: width 0.3s ease; }
    .cascade-nav-link:hover::after, .cascade-nav-link[data-active="true"]::after { width: 100%; }
    @media (prefers-reduced-motion: reduce) { .cascade-wave { display: none; } .cascade-card { transition: none; } }
  `} />
</head>
<body>
  <div class="cascade-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,160 C320,260 480,60 720,140 C960,220 1120,80 1440,180 L1440,0 L0,0 Z" fill="var(--primary)" opacity="0.08" />
      <path d="M0,200 C320,300 480,100 720,180 C960,260 1120,120 1440,220 L1440,0 L0,0 Z" fill="var(--accent)" opacity="0.06" />
      <path d="M0,240 C320,340 480,140 720,220 C960,300 1120,160 1440,260 L1440,0 L0,0 Z" fill="var(--primary)" opacity="0.04" />
    </svg>
  </div>

  <header class="relative z-50 px-4 sm:px-6 pt-6">
    <nav class="max-w-7xl mx-auto cascade-card rounded-2xl shadow-sm px-6 py-3 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-lg" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white font-bold cascade-grad">{school.name.charAt(0)}</span>}
        <div>
          <span class="block text-base font-bold leading-tight" style="color:var(--text)">{school.name}</span>
          {school.tagline && <span class="block text-xs leading-tight" style="color:var(--muted)">{school.tagline.slice(0, 50)}</span>}
        </div>
      </a>
      <div class="hidden lg:flex items-center gap-7">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class="cascade-nav-link" data-active={active} style={active ? "color:var(--primary)" : "color:var(--muted)"}>{item.label}</a>; })}
      </div>
      <div class="flex items-center gap-2">
        <LanguageSelector />
        <button id="theme-toggle" type="button" class="p-2 rounded-lg hover:bg-black/5" style="color:var(--muted)" aria-label="Toggle theme"><svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
        <a href={`${prefix}/admissions`} class="hidden sm:inline-flex cascade-grad px-5 py-2 text-sm font-semibold text-white rounded-full shadow-md">Apply</a>
        <button id="cascade-menu-toggle" type="button" class="lg:hidden p-2 rounded-lg hover:bg-black/5" style="color:var(--text)" aria-label="Menu"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
    </nav>
    <div id="cascade-mobile-nav" class="lg:hidden hidden mt-2 cascade-card rounded-2xl p-4 space-y-1">
      {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class="block px-4 py-2.5 rounded-lg text-sm font-medium" style={active ? "background:var(--primary);color:#fff" : "color:var(--text)"}>{item.label}</a>; })}
    </div>
  </header>

  <main class="relative z-10"><slot /></main>

  <footer class="relative z-10 mt-20 px-4 pb-8">
    <div class="max-w-7xl mx-auto cascade-card rounded-3xl p-8 sm:p-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-lg" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white font-bold cascade-grad">{school.name.charAt(0)}</span>}
            <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm max-w-md leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-5">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="p-2.5 rounded-lg border transition-colors hover:bg-black/5" style="border-color:var(--border);color:var(--text)"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-4" style="color:var(--muted)">Explore</h3><ul class="space-y-2.5">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-4" style="color:var(--muted)">Contact</h3><ul class="space-y-2.5">{contacts.slice(0,5).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No contact info yet.</li>}</ul></div>
      </div>
      <div class="mt-8 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-3" style="border-color:var(--border)">
        <p class="text-xs" style="color:var(--muted)">(c) {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="text-xs font-medium hover:underline" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} currentPage={Astro.url.pathname} />

  <button id="cascade-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 cascade-grad p-4 rounded-2xl shadow-2xl hover:scale-105 transition-transform" aria-label="Open chat"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="cascade-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] cascade-card rounded-2xl shadow-2xl hidden flex-col overflow-hidden" style="max-height:70vh">
    <div class="cascade-grad px-5 py-4"><p class="text-sm font-bold text-white">{school.name} Assistant</p><p class="text-[11px] text-white/80">Ask us anything</p></div>
    <div id="cascade-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"><div class="cascade-card rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]" style="color:var(--text)">How can we help?</div></div>
    <form id="cascade-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)">
      <input id="cascade-chat-input" type="text" placeholder="Type..." class="flex-1 rounded-full px-4 py-2 text-sm outline-none border" style="border-color:var(--border);background:var(--bg);color:var(--text)" aria-label="Message" />
      <button type="submit" class="cascade-grad p-2.5 rounded-full" aria-label="Send"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('cascade-menu-toggle'),d=document.getElementById('cascade-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');});}
    var ct=document.getElementById('cascade-chat-toggle'),cp=document.getElementById('cascade-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');}function c(){cp.classList.add('hidden');cp.classList.remove('flex');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('cascade-chat-form'),i=document.getElementById('cascade-chat-input'),m=document.getElementById('cascade-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='cascade-card rounded-xl rounded-tr-sm px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='cascade-card rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='cascade-card rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
