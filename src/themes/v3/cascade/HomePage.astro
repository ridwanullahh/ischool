---
import { getSchoolNav } from '../../../lib/school.ts';

interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
const announcements = Array.isArray(data.recentAnnouncements) ? data.recentAnnouncements : [];
const posts = Array.isArray(data.recentPosts) ? data.recentPosts : [];
const programs = Array.isArray(data.schoolPrograms) ? data.schoolPrograms : [];
---
<div>
  <section class="relative overflow-hidden px-4 py-20 sm:py-28">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="cascade-pill">Welcome</span>
        <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="mt-5 text-lg sm:text-xl leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href={`${prefix}/admissions`} class="cascade-grad px-7 py-3.5 text-base font-semibold text-white rounded-full shadow-lg hover:scale-105 transition-transform">Apply for Admission</a>
          <a href={`${prefix}/about`} class="px-7 py-3.5 text-base font-semibold rounded-full border-2 hover:bg-black/5 transition-colors" style="border-color:var(--border);color:var(--text)">Learn More</a>
        </div>
      </div>
      <div class="relative">
        <div class="cascade-card rounded-3xl p-8 shadow-xl">
          {stats.length > 0 ? (
            <div class="grid grid-cols-2 gap-6">
              {stats.slice(0, 4).map(s => (
                <div class="text-center">
                  <div class="text-3xl font-extrabold cascade-grad bg-clip-text text-transparent">{s.value}</div>
                  <div class="text-xs font-medium mt-1 uppercase tracking-wider" style="color:var(--muted)">{s.label}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-8">
              <div class="text-4xl font-extrabold" style="color:var(--primary)">{school.name.charAt(0)}</div>
              <p class="text-sm mt-2" style="color:var(--muted)">Excellence in Education</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {about.valueProposition && (
    <section class="px-4 py-12">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-xl sm:text-2xl font-semibold leading-relaxed" style="color:var(--text)">{about.valueProposition}</p>
      </div>
    </section>
  )}

  {features.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <span class="cascade-pill">Our Highlights</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold" style="color:var(--text)">Why Choose Us</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f, i) => (
            <div class="cascade-card rounded-2xl p-7" style={`animation-delay: ${i * 0.1}s`}>
              <div class="w-12 h-12 rounded-2xl cascade-grad flex items-center justify-center mb-5">
                <span class="text-white font-bold text-lg">{i + 1}</span>
              </div>
              <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{f.title}</h3>
              <p class="text-sm leading-relaxed" style="color:var(--muted)">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {programs.length > 0 && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="cascade-pill">Academics</span>
            <h2 class="mt-3 text-3xl font-bold" style="color:var(--text)">Our Programs</h2>
          </div>
          <a href={`${prefix}/programs`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">View all</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {programs.slice(0, 3).map(p => (
            <a href={`${prefix}/programs/${p.slug || p.id}`} class="cascade-card rounded-2xl overflow-hidden block">
              {p.imageUrl && <img src={p.imageUrl} alt={p.name} class="w-full h-40 object-cover" />}
              <div class="p-6">
                <h3 class="text-lg font-bold mb-2" style="color:var(--text)">{p.name}</h3>
                {p.description && <p class="text-sm leading-relaxed line-clamp-2" style="color:var(--muted)">{p.description}</p>}
                {p.duration && <span class="inline-block mt-3 text-xs font-semibold px-3 py-1 rounded-full" style="background:color-mix(in srgb, var(--primary) 10%, transparent);color:var(--primary)">{p.duration}</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {(announcements.length > 0 || posts.length > 0) && (
    <section class="px-4 py-16">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-8">
        {announcements.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6">
              <h2 class="text-2xl font-bold" style="color:var(--text)">Latest News</h2>
              <a href={`${prefix}/announcements`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">All news</a>
            </div>
            <div class="space-y-4">
              {announcements.map(a => (
                <a href={`${prefix}/announcements/${a.slug || a.id}`} class="cascade-card rounded-xl p-5 block">
                  <span class="text-xs font-medium" style="color:var(--primary)">{formatDate(a.publishedAt || a.createdAt)}</span>
                  <h3 class="font-bold mt-1" style="color:var(--text)">{a.title}</h3>
                  {a.excerpt && <p class="text-sm mt-1 line-clamp-2" style="color:var(--muted)">{a.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
        {posts.length > 0 && (
          <div>
            <div class="flex items-end justify-between mb-6">
              <h2 class="text-2xl font-bold" style="color:var(--text)">From the Blog</h2>
              <a href={`${prefix}/blog`} class="text-sm font-semibold hover:underline" style="color:var(--primary)">All posts</a>
            </div>
            <div class="space-y-4">
              {posts.map(p => (
                <a href={`${prefix}/blog/${p.slug || p.id}`} class="cascade-card rounded-xl p-5 block">
                  <span class="text-xs font-medium" style="color:var(--accent)">{formatDate(p.publishedAt || p.createdAt)}</span>
                  <h3 class="font-bold mt-1" style="color:var(--text)">{p.title}</h3>
                  {p.excerpt && <p class="text-sm mt-1 line-clamp-2" style="color:var(--muted)">{p.excerpt}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="px-4 py-20">
    <div class="max-w-5xl mx-auto cascade-grad rounded-3xl p-10 sm:p-16 text-center text-white">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Begin Your Journey With Us</h2>
      <p class="text-lg opacity-90 mb-8 max-w-2xl mx-auto">Join our community of learners. Admissions are open for the upcoming academic year.</p>
      <a href={`${prefix}/admissions`} class="inline-block bg-white px-8 py-3.5 rounded-full font-semibold hover:scale-105 transition-transform" style="color:var(--primary)">Apply Now</a>
    </div>
  </section>
</div>
