---
import { getSchoolNav, getSchoolContacts } from '../../../lib/school.ts';

interface Props { school: any; items?: any[]; search?: string; sort?: string; filter?: string; total?: number; [key: string]: any; }
const { school, items = [], search = '', sort = 'newest', filter = 'all', total = 0, ...rest } = Astro.props;
const nav = getSchoolNav(school.id);
const prefix = '/' + school.slug;
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const announcements = Array.isArray(items) ? items : [];
---
<div class="px-4 py-16">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-extrabold mb-4" style="color:var(--text)">Announcements</h1>
    <p class="text-sm mb-8" style="color:var(--muted)">Stay updated with the latest news and notices from our school.</p>

    <!-- Search & Sort Bar -->
    <div class="cascade-card rounded-2xl p-4 mb-8 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
      <form method="GET" action="" class="flex-1 flex gap-2">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" name="q" value={search} placeholder="Search announcements..." class="w-full pl-10 pr-4 py-2.5 rounded-xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)" />
        </div>
        <input type="hidden" name="filter" value={filter} />
        <input type="hidden" name="sort" value={sort} />
        <button type="submit" class="cascade-grad px-5 py-2.5 text-sm font-semibold text-white rounded-xl">Search</button>
      </form>
      <div class="flex items-center gap-2">
        <label for="filter" class="text-xs font-medium" style="color:var(--muted)">Filter:</label>
        <select id="filter" onchange="window.location.href=this.value" class="px-3 py-2 rounded-xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)">
          <option value={prefix + '/announcements?filter=all&sort=' + sort + (search ? '&q=' + encodeURIComponent(search) : '')} selected={filter === 'all'}>All</option>
          <option value={prefix + '/announcements?filter=pinned&sort=' + sort + (search ? '&q=' + encodeURIComponent(search) : '')} selected={filter === 'pinned'}>Pinned</option>
        </select>
        <select id="sort" onchange="window.location.href=this.value" class="px-3 py-2 rounded-xl text-sm outline-none border" style="background:var(--bg);border-color:var(--border);color:var(--text)">
          <option value={prefix + '/announcements?sort=newest&filter=' + filter + (search ? '&q=' + encodeURIComponent(search) : '')} selected={sort === 'newest'}>Newest</option>
          <option value={prefix + '/announcements?sort=oldest&filter=' + filter + (search ? '&q=' + encodeURIComponent(search) : '')} selected={sort === 'oldest'}>Oldest</option>
          <option value={prefix + '/announcements?sort=title&filter=' + filter + (search ? '&q=' + encodeURIComponent(search) : '')} selected={sort === 'title'}>Title A-Z</option>
        </select>
      </div>
    </div>

    <!-- Results count -->
    <div class="mb-6 text-sm" style="color:var(--muted)">
      {search ? (
        <span>Found <strong style="color:var(--text)">{total}</strong> announcement{total !== 1 ? 's' : ''} matching "<em style="color:var(--primary)">{search}</em>"</span>
      ) : (
        <span><strong style="color:var(--text)">{total}</strong> announcement{total !== 1 ? 's' : ''}{filter === 'pinned' ? ' (pinned only)' : ''}</span>
      )}
    </div>

    {announcements.length > 0 ? (
      <div class="space-y-4">
        {announcements.map(a => (
          <a href={`/${school.slug}/announcements/${a.slug}`} class="cascade-card rounded-2xl p-6 hover:scale-[1.01] transition-transform block group">
            <div class="flex items-start gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                  {a.isPinned && <span class="cascade-grad px-2 py-0.5 text-[10px] font-bold text-white rounded-full">PINNED</span>}
                  <span class="text-xs" style="color:var(--muted)">{formatDate(a.publishedAt || a.createdAt)}</span>
                </div>
                <h3 class="text-lg font-bold mb-2 group-hover:text-[var(--primary)] transition-colors" style="color:var(--text)">{a.title}</h3>
                {a.excerpt && <p class="text-sm line-clamp-2" style="color:var(--muted)">{a.excerpt}</p>}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="cascade-card rounded-2xl p-12 text-center">
        <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--muted)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <p class="text-lg font-semibold mb-2" style="color:var(--text)">No announcements found</p>
        <p class="text-sm mb-4" style="color:var(--muted)">{search ? 'Try a different search term.' : 'Announcements will appear here once published.'}</p>
        {search && <a href={`${prefix}/announcements`} class="inline-block cascade-grad px-5 py-2 text-sm font-semibold text-white rounded-xl">Clear search</a>}
      </div>
    )}
  </div>
</div>
