---
interface Props { school: any; [key: string]: any; }
const { school, ...data } = Astro.props;
const prefix = '/' + school.slug;
const features = Array.isArray(data.features) ? data.features : [];
const stats = Array.isArray(data.stats) ? data.stats : [];
const about = data.about || {};
---
<div class="mp-feed space-y-5">
  <section class="mp-card-gold p-6 relative overflow-hidden">
    <div class="mp-shine"></div>
    <p class="mp-kicker relative">About</p>
    <h1 class="mp-serif text-3xl mt-2 leading-tight" style="color:var(--text)">{school.name}</h1>
    {about.valueProposition && <p class="text-sm mt-2 leading-relaxed relative" style="color:var(--muted)">{about.valueProposition}</p>}
  </section>

  <section class="mp-card p-5">
    <p class="mp-kicker mb-2">Mission</p>
    <div class="mp-rule mb-3 max-w-[40px]"></div>
    <p class="text-sm leading-relaxed" style="color:var(--text)">{about.mission || 'Our mission shapes every decision we make.'}</p>
  </section>

  <section class="mp-card p-5">
    <p class="mp-kicker mb-2">Vision</p>
    <div class="mp-rule mb-3 max-w-[40px]"></div>
    <p class="text-sm leading-relaxed" style="color:var(--text)">{about.vision || 'A future where every learner finds their light.'}</p>
  </section>

  {stats.length > 0 && (
    <section class="mp-card-gold p-5 grid grid-cols-2 gap-4">
      {stats.slice(0,4).map(s => <div class="text-center"><p class="mp-serif mp-gold text-3xl">{s.value}</p><p class="text-[10px] uppercase tracking-[0.18em] mt-1" style="color:var(--muted)">{s.label}</p></div>)}
    </section>
  )}

  {features.length > 0 && (
    <section>
      <p class="mp-kicker mb-3 px-1">Highlights</p>
      <div class="space-y-3">
        {features.map(f => (
          <div class="mp-card p-4">
            <h3 class="mp-serif text-lg" style="color:var(--text)">{f.title}</h3>
            <div class="mp-rule my-2 max-w-[40px]"></div>
            <p class="text-xs leading-relaxed" style="color:var(--muted)">{f.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}
</div>
