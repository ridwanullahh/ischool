---
import { getSchoolAdmissionPeriods } from '../../../lib/school-safe.ts';
interface Props { school: any; [key: string]: any; }
const { school, ...rest } = Astro.props;
const prefix = '/' + school.slug;
const periods = Array.isArray(rest.items) ? rest.items : (Array.isArray((rest as any).admissionPeriods) ? (rest as any).admissionPeriods : getSchoolAdmissionPeriods(school.id));
const today = new Date().toISOString().split('T')[0];
const statusOf = (p: any) => {
  const open = p.openDate || p.open_date;
  const close = p.closeDate || p.close_date;
  if (close && close < today) return 'closed';
  if (open && open > today) return 'upcoming';
  return 'open';
};
const formatDate = (d: string | Date | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const open = periods.filter((p: any) => statusOf(p) === 'open');
const upcoming = periods.filter((p: any) => statusOf(p) === 'upcoming');
const closed = periods.filter((p: any) => statusOf(p) === 'closed');
const sections = [{ key: 'open', label: 'Open Now', items: open }, { key: 'upcoming', label: 'Upcoming', items: upcoming }, { key: 'closed', label: 'Closed', items: closed }].filter(s => s.items.length > 0);
---
<div class="mp-feed space-y-5">
  <section class="mp-card-gold p-6 relative overflow-hidden">
    <div class="mp-shine"></div>
    <p class="mp-kicker relative">Admissions</p>
    <h1 class="mp-serif text-3xl mt-2 leading-tight" style="color:var(--text)">Begin your journey</h1>
    <p class="text-sm mt-2 relative" style="color:var(--muted)">We welcome families who share our commitment to excellence.</p>
  </section>

  {sections.length === 0 && <div class="mp-card p-5 text-center"><p class="text-sm" style="color:var(--muted)">No admission periods configured. Contact us to learn more.</p></div>}

  {sections.map(sec => (
    <section>
      <div class="flex items-center gap-3 mb-3 px-1"><p class="mp-kicker">{sec.label}</p><div class="mp-rule flex-1"></div></div>
      <div class="space-y-3">
        {sec.items.map((p: any) => (
          <div class="mp-card p-4">
            <h3 class="mp-serif text-lg" style="color:var(--text)">{p.name || p.title || 'Admission Period'}</h3>
            {(p.openDate || p.open_date) && <p class="text-xs mt-1" style="color:var(--muted)">Opens: {formatDate(p.openDate || p.open_date)}</p>}
            {(p.closeDate || p.close_date) && <p class="text-xs" style="color:var(--muted)">Closes: {formatDate(p.closeDate || p.close_date)}</p>}
            {p.description && <p class="text-xs line-clamp-3 mt-2" style="color:var(--muted)">{p.description}</p>}
            <div class="flex gap-2 mt-3">
              <a href={`/${school.slug}/admissions/${p.slug || p.id}`} class="mp-gold-bg px-4 py-2 text-[11px] font-semibold tracking-widest uppercase mp-tap" style="border-radius:2px">Details</a>
              {sec.key === 'open' && <a href={`/${school.slug}/admissions/${p.slug || p.id}/apply`} class="border px-4 py-2 text-[11px] font-semibold tracking-widest uppercase mp-gold mp-tap" style="border-color:color-mix(in srgb, var(--primary) 50%, transparent);border-radius:2px">Apply</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="mp-card p-5">
    <p class="mp-kicker mb-3">How to apply</p>
    <ol class="space-y-2 text-xs" style="color:var(--muted)">
      <li class="flex gap-2"><span class="mp-gold-bg flex items-center justify-center w-5 h-5 text-[10px] font-bold flex-shrink-0" style="color:#1a1410;border-radius:2px">1</span><span>Complete the online application form.</span></li>
      <li class="flex gap-2"><span class="mp-gold-bg flex items-center justify-center w-5 h-5 text-[10px] font-bold flex-shrink-0" style="color:#1a1410;border-radius:2px">2</span><span>Submit required documents.</span></li>
      <li class="flex gap-2"><span class="mp-gold-bg flex items-center justify-center w-5 h-5 text-[10px] font-bold flex-shrink-0" style="color:#1a1410;border-radius:2px">3</span><span>Attend an assessment interview.</span></li>
      <li class="flex gap-2"><span class="mp-gold-bg flex items-center justify-center w-5 h-5 text-[10px] font-bold flex-shrink-0" style="color:#1a1410;border-radius:2px">4</span><span>Receive your admission decision.</span></li>
    </ol>
    <a href={`/${school.slug}/contact`} class="mp-gold-bg block text-center mt-4 py-3 text-[11px] font-semibold tracking-widest uppercase mp-tap" style="color:#1a1410;border-radius:2px">Contact Admissions</a>
  </section>
</div>
