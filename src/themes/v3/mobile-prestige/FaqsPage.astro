---
interface Props { school: any; items?: any[]; [key: string]: any; }
const { school, items = [] } = Astro.props;
const faqs = Array.isArray(items) ? items : [];
const byCat: Record<string, any[]> = {};
faqs.forEach(f => { const c = f.category || 'General'; (byCat[c] = byCat[c] || []).push(f); });
const categories = Object.keys(byCat);
---
<div class="mp-feed space-y-5">
  <section class="mp-card-gold p-6 relative overflow-hidden">
    <div class="mp-shine"></div>
    <p class="mp-kicker relative">Help Center</p>
    <h1 class="mp-serif text-3xl mt-2 leading-tight" style="color:var(--text)">FAQs</h1>
  </section>

  {categories.length === 0 && <div class="mp-card p-5 text-center"><p class="text-sm" style="color:var(--muted)">No FAQs published yet.</p></div>}

  {categories.map(cat => (
    <section>
      <div class="flex items-center gap-3 mb-3 px-1"><p class="mp-kicker">{cat}</p><div class="mp-rule flex-1"></div></div>
      <div class="space-y-3">
        {byCat[cat].map(faq => (
          <details class="mp-card p-4 group">
            <summary class="flex items-center justify-between cursor-pointer list-none mp-serif text-lg" style="color:var(--text)">
              <span class="pr-2">{faq.question}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform group-open:rotate-45 mp-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/></svg>
            </summary>
            <div class="mp-rule my-3"></div>
            <p class="text-xs leading-relaxed" style="color:var(--muted)">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>
