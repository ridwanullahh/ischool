---
/**
 * Luxe — Elegant Luxury theme with refined typography and thin gold lines
 *
 * Layout autonomy: centered minimal header with thin gold lines flanking
 * the logo, nav as spaced uppercase text links below, a footer with a
 * large serif tagline statement, and a chat widget as an elegant small
 * circle that expands to a thin-bordered refined panel.
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';

interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Jost', system-ui, sans-serif; color: var(--text); min-height: 100vh; font-weight: 300; }
    .luxe-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .luxe-line { height: 1px; background: linear-gradient(to right, transparent, color-mix(in srgb, var(--primary) 50%, transparent), transparent); }
    .luxe-nav-link { font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; font-weight: 400; transition: color 0.3s; position: relative; padding: 0.5rem 0; }
    .luxe-nav-link[data-active="true"] { color: var(--primary); }
    .luxe-nav-link:hover { color: var(--primary); }
    .luxe-circle { border-radius: 9999px; }
  `}</style>
</head>
<body>
  <header class="px-4 pt-12 pb-4">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="luxe-line flex-1"></div>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto" /> : <span class="luxe-serif text-2xl font-medium" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <div class="luxe-line flex-1"></div>
      </div>
      <a href={`${prefix}/`} aria-label={`${school.name} home`}>
        <h1 class="luxe-serif text-3xl sm:text-4xl font-medium tracking-wide" style="color:var(--text)">{school.name}</h1>
      </a>
      {school.tagline && <p class="luxe-serif italic text-sm mt-2" style="color:var(--muted)">{school.tagline}</p>}
    </div>
  </header>
  <nav class="border-y" style="border-color:color-mix(in srgb, var(--primary) 20%, var(--border))" aria-label="Primary">
    <div class="max-w-4xl mx-auto px-4">
      <div class="hidden lg:flex items-center justify-center h-12 gap-8">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="luxe-nav-link" style="color:var(--text)">{item.label}</a>; })}
      </div>
      <div class="lg:hidden flex items-center justify-between h-12">
        <div class="flex items-center gap-3"><LanguageSelector /><button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button></div>
        <button id="luxe-menu-toggle" type="button" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="luxe-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
      <div id="luxe-mobile-nav" class="lg:hidden hidden pb-4 flex flex-col items-center gap-3">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="luxe-nav-link" style="color:var(--text)">{item.label}</a>; })}
        <a href={`${prefix}/admissions`} class="luxe-nav-link" style="color:var(--primary)">Apply</a>
      </div>
    </div>
  </nav>

  <main><slot /></main>

  <footer class="px-4 mt-24 pb-12">
    <div class="max-w-4xl mx-auto text-center">
      <div class="luxe-line mb-10"></div>
      <p class="luxe-serif text-2xl sm:text-3xl font-light italic mb-2" style="color:var(--text)">{school.tagline || school.name}</p>
      <p class="text-[10px] uppercase tracking-[0.3em] mb-8" style="color:var(--primary)">{school.name}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
        <div><p class="luxe-nav-link mb-3" style="color:var(--primary)">Contact</p><ul class="space-y-1.5">{contacts.slice(0,3).map(c => <li class="text-xs" style="color:var(--text)">{c.value}</li>)}{contacts.length===0 && <li class="text-xs italic" style="color:var(--muted)">—</li>}</ul></div>
        <div><p class="luxe-nav-link mb-3" style="color:var(--primary)">Navigate</p><ul class="space-y-1.5">{nav.slice(0,5).map(item => <li><a href={`${prefix}${item.url}`} class="text-xs transition-opacity hover:opacity-60" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><p class="luxe-nav-link mb-3" style="color:var(--primary)">Elsewhere</p><div class="flex items-center gap-3">{socialEntries.map(([platform, handle]) => { const path = getSocialIconPath(platform); if (!path) return null; return <a href={normalizeSocialUrl(handle, platform)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${platform} page`} style="color:var(--primary)" class="opacity-70 hover:opacity-100"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}{socialEntries.length===0 && <span class="text-xs italic" style="color:var(--muted)">—</span>}</div></div>
      </div>
      <div class="luxe-line mt-10 mb-5"></div>
      <div class="flex items-center justify-between">
        <p class="text-[10px] uppercase tracking-[0.3em]" style="color:var(--muted)">© {new Date().getFullYear()}</p>
        <a href="/" class="text-[10px] uppercase tracking-[0.3em]" style="color:var(--primary)">iSchool</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} />

  <button id="luxe-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 luxe-circle p-5 shadow-lg transition-transform hover:scale-110" style="background:var(--primary);color:#fff" aria-label="Open chat" aria-expanded="false" aria-controls="luxe-chat-panel">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
  </button>
  <div id="luxe-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(360px,calc(100vw-3rem))] hidden flex-col shadow-2xl" style="background:var(--surface);border:1px solid color-mix(in srgb, var(--primary) 30%, var(--border));max-height:70vh">
    <div class="px-5 py-4 text-center border-b" style="border-color:color-mix(in srgb, var(--primary) 20%, var(--border))">
      <p class="luxe-serif text-xl font-medium" style="color:var(--text)">Concierge</p>
      <p class="text-[9px] uppercase tracking-[0.3em] mt-1" style="color:var(--muted)">At your service</p>
    </div>
    <div id="luxe-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)">
      <p class="luxe-serif italic text-sm" style="color:var(--muted)">How may we assist?</p>
    </div>
    <form id="luxe-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--primary) 20%, var(--border))">
      <input id="luxe-chat-input" type="text" placeholder="Your inquiry..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none luxe-serif" style="border-color:color-mix(in srgb, var(--primary) 25%, var(--border));color:var(--text)" aria-label="Type your inquiry" />
      <button type="submit" class="luxe-nav-link px-3 py-1" style="color:var(--primary)" aria-label="Send">Send</button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('luxe-menu-toggle'),d=document.getElementById('luxe-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('luxe-chat-toggle'),cp=document.getElementById('luxe-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('luxe-chat-form'),i=document.getElementById('luxe-chat-input'),m=document.getElementById('luxe-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('p');b.className='luxe-serif text-sm text-right';b.style.color='var(--primary)';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('p');r.className='luxe-serif italic text-sm';r.style.color='var(--muted)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('p');r.className='luxe-serif italic text-sm';r.style.color='var(--muted)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
