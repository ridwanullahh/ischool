---
/**
 * Campus — Collegiate Bold theme with VERTICAL SIDEBAR navigation
 *
 * Layout autonomy: desktop uses a fixed left sidebar (logo + vertical nav
 * + social at bottom); main content is shifted right. Mobile collapses
 * to a top bar with a slide-in drawer. Footer is a full-width CTA strip
 * + compact info row. Chat widget is a floating action button expanding
 * to a full-width bottom dock bar.
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';

interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Archivo', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .campus-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
    .campus-sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 16rem; z-index: 40; display: none; flex-direction: column; border-right: 1px solid var(--border); background: var(--surface); }
    @media (min-width: 1024px) { .campus-sidebar { display: flex; } .campus-main { margin-left: 16rem; } }
    .campus-nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 1rem; font-size: 0.85rem; font-weight: 600; border-left: 3px solid transparent; transition: all 0.15s; }
    .campus-nav-item:hover { background: color-mix(in srgb, var(--primary) 6%, transparent); }
    .campus-nav-item[data-active="true"] { border-left-color: var(--primary); color: var(--primary); background: color-mix(in srgb, var(--primary) 8%, transparent); }
    .campus-cta-strip { background: var(--primary); color: #fff; }
  `}</style>
</head>
<body>
  <header class="lg:hidden sticky top-0 z-40 border-b px-4 h-14 flex items-center justify-between" style="background:var(--surface);border-color:var(--border)">
    <a href={`${prefix}/`} class="flex items-center gap-2" aria-label={`${school.name} home`}>
      {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-7 w-auto" /> : <span class="campus-mono text-xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
      <span class="text-sm font-bold" style="color:var(--text)">{school.name}</span>
    </a>
    <button id="campus-menu-toggle" type="button" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="campus-mobile-nav">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </header>
  <div id="campus-mobile-nav" class="lg:hidden hidden fixed inset-0 z-50 bg-black/40">
    <div class="absolute left-0 top-0 bottom-0 w-72 overflow-y-auto p-4" style="background:var(--surface)" id="campus-drawer">
      <div class="flex items-center justify-between mb-6">
        <span class="font-bold" style="color:var(--text)">{school.name}</span>
        <button id="campus-drawer-close" type="button" style="color:var(--text)" aria-label="Close menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      {nav.map(item => {
        const active = pathname === `${prefix}${item.url}`;
        return <a href={`${prefix}${item.url}`} data-active={active} class="campus-nav-item" style="color:var(--text)">{item.label}</a>;
      })}
      <a href={`${prefix}/admissions`} class="campus-nav-item" style="color:var(--primary)">Apply for Admission</a>
      <div class="mt-4 pt-4 border-t flex items-center gap-3" style="border-color:var(--border)">
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode">
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>
    </div>
  </div>

  <aside class="campus-sidebar" aria-label="Primary">
    <div class="p-5 border-b" style="border-color:var(--border)">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto" /> : <span class="campus-mono text-2xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <span class="text-sm font-bold leading-tight" style="color:var(--text)">{school.name}</span>
      </a>
      {school.tagline && <p class="campus-mono text-[10px] uppercase tracking-wider mt-2" style="color:var(--muted)">{school.tagline}</p>}
    </div>
    <nav class="flex-1 py-4 overflow-y-auto">
      {nav.map(item => {
        const active = pathname === `${prefix}${item.url}`;
        return <a href={`${prefix}${item.url}`} data-active={active} class="campus-nav-item" style="color:var(--text)">{item.label}</a>;
      })}
      <a href={`${prefix}/admissions`} class="campus-nav-item mt-2" style="color:var(--primary)"><span class="campus-mono text-xs uppercase tracking-wider">{'>'} Apply</span></a>
    </nav>
    <div class="p-4 border-t" style="border-color:var(--border)">
      <div class="flex items-center justify-between mb-3">
        <LanguageSelector />
        <button id="theme-toggle-desktop" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode">
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>
      {socialEntries.length > 0 && (
        <div class="flex items-center gap-2">
          {socialEntries.slice(0, 5).map(([platform, handle]) => {
            const path = getSocialIconPath(platform);
            if (!path) return null;
            return <a href={normalizeSocialUrl(handle, platform)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${platform} page`} style="color:var(--muted)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>;
          })}
        </div>
      )}
      {contacts[0] && <p class="campus-mono text-[10px] mt-3" style="color:var(--muted)">{contacts[0].value}</p>}
    </div>
  </aside>

  <div class="campus-main">
    <main>
      <slot />
    </main>

    
    <footer>
      <div class="campus-cta-strip px-4 py-10 text-center">
        <p class="text-2xl sm:text-3xl font-extrabold mb-2">Join {school.name}</p>
        <p class="text-sm opacity-90 mb-5">Take the next step in your educational journey.</p>
        <a href={`${prefix}/admissions`} class="inline-block bg-white px-6 py-2.5 text-sm font-bold uppercase tracking-wider" style="color:var(--primary)">Begin Application</a>
      </div>
      <div class="px-4 py-6 border-t" style="background:var(--surface);border-color:var(--border)">
        <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="campus-mono text-[11px] uppercase tracking-wider" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}</p>
          <div class="flex items-center gap-4">
            {contacts.slice(0, 2).map(c => <span class="campus-mono text-[11px]" style="color:var(--muted)">{c.value}</span>)}
            <a href="/" class="campus-mono text-[11px] uppercase tracking-wider" style="color:var(--primary)">iSchool</a>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <SchoolBannerPopup school={school} />

  
  <button id="campus-chat-toggle" type="button" class="fixed bottom-0 left-0 right-0 z-50 lg:left-64 px-4 py-3 border-t flex items-center justify-center gap-2 transition-all" style="background:var(--surface);border-color:var(--border);color:var(--primary)" aria-label="Open chat" aria-expanded="false" aria-controls="campus-chat-panel">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    <span class="campus-mono text-xs font-bold uppercase tracking-wider">Ask a question</span>
  </button>
  <div id="campus-chat-panel" class="fixed bottom-14 left-0 right-0 z-50 lg:left-64 lg:right-0 mx-4 mb-2 hidden flex-col border shadow-2xl" style="background:var(--surface);border-color:var(--border);max-height:60vh">
    <div class="px-4 py-3 border-b flex items-center justify-between" style="border-color:var(--border)">
      <p class="font-bold" style="color:var(--text)">{school.name} — Ask</p>
      <button id="campus-chat-close" type="button" style="color:var(--muted)" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="campus-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-2 text-sm" style="color:var(--text)">
      <p style="color:var(--muted)">What would you like to know about {school.name}?</p>
    </div>
    <form id="campus-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)">
      <input id="campus-chat-input" type="text" placeholder="Type your question..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none" style="border-color:var(--border);color:var(--text)" aria-label="Type your question" />
      <button type="submit" class="px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white" style="background:var(--primary)" aria-label="Send">Send</button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle, #theme-toggle-desktop" />
  <script is:inline set:html={`(function(){
    var mt=document.getElementById('campus-menu-toggle'),mn=document.getElementById('campus-mobile-nav'),dc=document.getElementById('campus-drawer-close');
    function openD(){mn.classList.remove('hidden');mt.setAttribute('aria-expanded','true');}
    function closeD(){mn.classList.add('hidden');mt.setAttribute('aria-expanded','false');}
    if(mt&&mn){mt.addEventListener('click',openD);}
    if(dc){dc.addEventListener('click',closeD);}
    if(mn){mn.addEventListener('click',function(e){if(e.target===mn)closeD();});}
    var ct=document.getElementById('campus-chat-toggle'),cp=document.getElementById('campus-chat-panel'),cc=document.getElementById('campus-chat-close');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    if(cc){cc.addEventListener('click',c);}
    var f=document.getElementById('campus-chat-form'),i=document.getElementById('campus-chat-input'),m=document.getElementById('campus-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('p');b.style.color='var(--text)';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('p');r.style.color='var(--muted)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('p');r.style.color='var(--muted)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
