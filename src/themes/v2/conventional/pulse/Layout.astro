---
/** Pulse — Neon Tech-Forward dark theme with pulsing glow accents */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id); const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`; const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en'; const rtl = ['ar','he','fa','ur'].includes(locale);
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="dark" /><PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Chakra Petch', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .pulse-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
    .pulse-dot { display: inline-block; width: 8px; height: 8px; border-radius: 9999px; background: var(--primary); box-shadow: 0 0 10px var(--primary); animation: pulse-pulse 1.5s ease-in-out infinite; }
    @keyframes pulse-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } }
    @media (prefers-reduced-motion: reduce) { .pulse-dot { animation: none; } }
    .pulse-nav-link { font-size: 0.8rem; font-weight: 500; padding: 0.5rem 0.75rem; transition: all 0.15s; letter-spacing: 0.03em; position: relative; }
    .pulse-nav-link[data-active="true"] { color: var(--primary); }
    .pulse-nav-link[data-active="true"]::before { content: '>'; margin-right: 0.3rem; color: var(--primary); }
    .pulse-nav-link:hover { color: var(--primary); text-shadow: 0 0 8px color-mix(in srgb, var(--primary) 50%, transparent); }
    .pulse-border { border: 1px solid color-mix(in srgb, var(--primary) 25%, var(--border)); }
    .pulse-glow { box-shadow: 0 0 20px color-mix(in srgb, var(--primary) 30%, transparent); }
    .pulse-eq { display: flex; align-items: end; gap: 2px; height: 16px; }
    .pulse-eq span { width: 3px; background: var(--primary); animation: pulse-eq 1s ease-in-out infinite; }
    .pulse-eq span:nth-child(1) { height: 60%; animation-delay: 0s; }
    .pulse-eq span:nth-child(2) { height: 100%; animation-delay: 0.2s; }
    .pulse-eq span:nth-child(3) { height: 40%; animation-delay: 0.4s; }
    .pulse-eq span:nth-child(4) { height: 80%; animation-delay: 0.1s; }
    @keyframes pulse-eq { 0%,100% { transform: scaleY(0.4); } 50% { transform: scaleY(1); } }
    @media (prefers-reduced-motion: reduce) { .pulse-eq span { animation: none; } }
  `}</style>
</head>
<body>
  <header class="sticky top-0 z-40 border-b pulse-border" style="background:color-mix(in srgb, var(--bg) 90%, transparent);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        <span class="pulse-dot"></span>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="pulse-mono text-xl font-bold" style="color:var(--primary);text-shadow:0 0 12px color-mix(in srgb, var(--primary) 50%, transparent)">{school.name.charAt(0)}</span>}
        <span class="text-base font-bold tracking-tight" style="color:var(--text)">{school.name}</span>
      </a>
      <div class="hidden lg:flex items-center gap-1">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="pulse-nav-link" style="color:var(--text)">{item.label}</a>; })}
      </div>
      <div class="flex items-center gap-3">
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-5 h-5 hidden light:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
        <a href={`${prefix}/admissions`} class="hidden sm:inline-flex pulse-border pulse-glow px-4 py-2 pulse-mono text-xs font-bold uppercase tracking-wider" style="color:var(--primary)">Apply</a>
        <button id="pulse-menu-toggle" type="button" class="lg:hidden p-2" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="pulse-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
    </div>
    <div id="pulse-mobile-nav" class="lg:hidden hidden border-t pulse-border px-4 py-3 space-y-1">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="pulse-nav-link block" style="color:var(--text)">{item.label}</a>; })}<a href={`${prefix}/admissions`} class="pulse-nav-link block" style="color:var(--primary)">Apply for Admission</a></div>
  </header>
  <main><slot /></main>
  <footer class="mt-20 border-t pulse-border" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex items-center gap-3 mb-8"><div class="pulse-eq" aria-hidden="true"><span></span><span></span><span></span><span></span></div><span class="pulse-mono text-[10px] uppercase tracking-widest" style="color:var(--primary)">{school.name} // system online</span></div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2"><div class="flex items-center gap-3 mb-4"><span class="pulse-dot"></span>{school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="pulse-mono text-xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}<span class="text-base font-bold" style="color:var(--text)">{school.name}</span></div>{school.tagline && <p class="text-sm" style="color:var(--muted)">{school.tagline}</p>}{socialEntries.length > 0 && <div class="flex items-center gap-2 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="pulse-border p-2 transition-all hover:pulse-glow" style="color:var(--primary)"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}</div>
        <div><p class="pulse-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">// links</p><ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><p class="pulse-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">// contact</p><ul class="space-y-2">{contacts.slice(0,4).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="pulse-mono block text-[10px] uppercase" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length===0 && <li class="text-sm" style="color:var(--muted)">No data.</li>}</ul></div>
      </div>
      <div class="mt-8 pt-5 border-t pulse-border flex items-center justify-between"><p class="pulse-mono text-[11px]" style="color:var(--muted)">© {new Date().getFullYear()} {school.name} // all rights reserved</p><a href="/" class="pulse-mono text-[11px] uppercase tracking-widest" style="color:var(--primary)">[ iSchool ]</a></div>
    </div>
  </footer>
  <SchoolBannerPopup school={school} />
  <button id="pulse-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 pulse-border pulse-glow p-4 flex items-center gap-2" style="background:var(--surface);color:var(--primary)" aria-label="Open chat" aria-expanded="false" aria-controls="pulse-chat-panel"><span class="pulse-dot"></span><span class="pulse-mono text-xs font-bold uppercase tracking-wider">Live</span></button>
  <div id="pulse-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(400px,calc(100vw-3rem))] hidden flex-col pulse-border pulse-glow" style="background:var(--surface);max-height:70vh">
    <div class="px-4 py-3 border-b pulse-border flex items-center justify-between"><div class="flex items-center gap-2"><span class="pulse-dot"></span><p class="pulse-mono text-xs uppercase tracking-widest" style="color:var(--primary)">assistant.live</p></div><button id="pulse-chat-close" type="button" class="pulse-mono text-xs" style="color:var(--muted)" aria-label="Close">[x]</button></div>
    <div id="pulse-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-2 pulse-mono text-xs" style="color:var(--text)"><div style="color:var(--muted)"><span style="color:var(--primary)">{'> '}</span>system ready</div><div style="color:var(--muted)">awaiting input...</div></div>
    <form id="pulse-chat-form" class="p-3 border-t pulse-border flex items-center gap-2"><span class="pulse-mono text-xs" style="color:var(--primary)">{'>_'}</span><input id="pulse-chat-input" type="text" placeholder="enter query" class="flex-1 bg-transparent border-0 px-1 py-1 text-xs outline-none pulse-mono" style="color:var(--text)" aria-label="Type your query" /><button type="submit" class="pulse-border pulse-glow px-3 py-1.5 pulse-mono text-[10px] font-bold uppercase tracking-widest" style="color:var(--primary)" aria-label="Send">Run</button></form>
  </div>
  <ThemeToggleScript defaultMode="dark" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('pulse-menu-toggle'),d=document.getElementById('pulse-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('pulse-chat-toggle'),cp=document.getElementById('pulse-chat-panel'),cc=document.getElementById('pulse-chat-close');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    if(cc){cc.addEventListener('click',c);}
    var f=document.getElementById('pulse-chat-form'),i=document.getElementById('pulse-chat-input'),m=document.getElementById('pulse-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='pulse-mono text-xs';b.style.color='var(--text)';b.innerHTML='<span style="color:var(--primary)">></span> '+t.replace(/</g,'&lt;');m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'ERR: unreachable.'};}).then(function(data){var r=document.createElement('div');r.className='pulse-mono text-xs';r.style.color='var(--muted)';r.textContent='> '+(data.reply||data.message||'no response.');m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='pulse-mono text-xs';r.style.color='var(--muted)';r.textContent='> ERR: connection failed.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
