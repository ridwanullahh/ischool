---
/**
 * Nova — Futuristic Tech theme
 *
 * Layout autonomy: dark-by-default with neon glow effects, a header
 * with a grid-line top border and a glowing logo, nav items with
 * neon underline on hover, a footer with a circuit-pattern top border,
 * and a chat widget styled as a "terminal" with a glowing border.
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';

interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
import PageLoader from '../../../../components/PageLoader.astro';
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="dark" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body {
      font-family: 'Outfit', system-ui, sans-serif;
      color: var(--text);
      min-height: 100vh;
    }
    .nova-mono { font-family: 'Space Mono', ui-monospace, monospace; }
    .nova-glow {
      box-shadow: 0 0 20px color-mix(in srgb, var(--primary) 40%, transparent),
                  0 0 40px color-mix(in srgb, var(--primary) 20%, transparent);
    }
    .nova-glow-text { text-shadow: 0 0 12px color-mix(in srgb, var(--primary) 60%, transparent); }
    .nova-grid-top {
      background-image: linear-gradient(to right, color-mix(in srgb, var(--primary) 25%, transparent) 1px, transparent 1px);
      background-size: 24px 24px;
      height: 2px;
    }
    .nova-nav-link {
      position: relative; padding: 0.5rem 0.25rem;
      font-size: 0.8rem; font-weight: 500; letter-spacing: 0.02em;
    }
    .nova-nav-link::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: -4px;
      height: 2px; background: var(--primary);
      box-shadow: 0 0 8px var(--primary);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.2s ease;
    }
    .nova-nav-link:hover::after,
    .nova-nav-link[data-active="true"]::after { transform: scaleX(1); }
    .nova-nav-link[data-active="true"] { color: var(--primary); }
    .nova-border { border: 1px solid color-mix(in srgb, var(--primary) 30%, var(--border)); }
    .nova-btn {
      border: 1px solid var(--primary);
      background: color-mix(in srgb, var(--primary) 10%, transparent);
      color: var(--primary);
      transition: all 0.2s ease;
    }
    .nova-btn:hover {
      background: var(--primary); color: var(--bg);
      box-shadow: 0 0 24px color-mix(in srgb, var(--primary) 60%, transparent);
    }
  `}</style>
</head>
<body>
    <PageLoader />
  <div class="nova-grid-top"></div>
  <header class="sticky top-0 z-40 border-b nova-border" style="background:color-mix(in srgb, var(--bg) 85%, transparent);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? (
          <img src={school.logoUrl} alt={school.name} class="h-9 w-auto" />
        ) : (
          <span class="nova-mono text-2xl font-bold nova-glow-text" style="color:var(--primary)">{school.name.charAt(0)}</span>
        )}
        <span class="text-base font-bold tracking-tight" style="color:var(--text)">{school.name}</span>
      </a>
      <div class="hidden lg:flex items-center gap-6">
        {nav.map(item => {
          const active = pathname === `${prefix}${item.url}`;
          return (
            <a href={`${prefix}${item.url}`} data-active={active} class="nova-nav-link" style="color:var(--text)">{item.label}</a>
          );
        })}
      </div>
      <div class="flex items-center gap-3">
        <LanguageSelector />
        <button id="theme-toggle" type="button" class="p-2 transition-colors" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode">
          <svg class="w-5 h-5 hidden light:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <a href={`${prefix}/admissions`} class="nova-btn hidden sm:inline-flex px-4 py-2 text-xs font-bold uppercase tracking-wider">Apply</a>
        <button id="nova-menu-toggle" type="button" class="lg:hidden p-2" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="nova-mobile-nav">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="nova-mobile-nav" class="lg:hidden hidden border-t nova-border px-4 py-3 space-y-1">
      {nav.map(item => {
        const active = pathname === `${prefix}${item.url}`;
        return (
          <a href={`${prefix}${item.url}`} data-active={active} class="nova-nav-link block" style="color:var(--text)">{item.label}</a>
        );
      })}
      <a href={`${prefix}/admissions`} class="nova-btn block px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-center">Apply for Admission</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="mt-20 border-t nova-border" style="background:var(--surface)">
    <div class="nova-grid-top"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? (
              <img src={school.logoUrl} alt={school.name} class="h-9 w-auto" />
            ) : (
              <span class="nova-mono text-2xl font-bold nova-glow-text" style="color:var(--primary)">{school.name.charAt(0)}</span>
            )}
            <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm max-w-md" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && (
            <div class="flex items-center gap-2 mt-4">
              {socialEntries.map(([platform, handle]) => {
                const path = getSocialIconPath(platform);
                if (!path) return null;
                return (
                  <a href={normalizeSocialUrl(handle, platform)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${platform} page`} class="nova-border p-2 transition-all hover:nova-glow" style="color:var(--primary)">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg>
                  </a>
                );
              })}
            </div>
          )}
        </div>
        <div>
          <p class="nova-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// links</p>
          <ul class="space-y-2">
            {nav.slice(0, 6).map(item => (
              <li><a href={`${prefix}${item.url}`} class="text-sm transition-colors hover:opacity-70" style="color:var(--text)">{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="nova-mono text-[10px] uppercase tracking-widest mb-4" style="color:var(--primary)">// contact</p>
          <ul class="space-y-2">
            {contacts.slice(0, 4).map(c => (
              <li class="text-sm" style="color:var(--text)">
                {c.label && <span class="nova-mono block text-[10px] uppercase tracking-wider" style="color:var(--muted)">{c.label}</span>}
                {c.value}
              </li>
            ))}
            {contacts.length === 0 && <li class="text-sm" style="color:var(--muted)">No data.</li>}
          </ul>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t nova-border flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="nova-mono text-[11px]" style="color:var(--muted)">© {new Date().getFullYear()} {school.name} // all rights reserved</p>
        <a href="/" class="nova-mono text-[11px] uppercase tracking-widest" style="color:var(--primary)">[ iSchool ]</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} />

  <button id="nova-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 nova-btn nova-glow px-4 py-3 flex items-center gap-2" aria-label="Open terminal" aria-expanded="false" aria-controls="nova-chat-panel">
    <span class="nova-mono text-sm font-bold" style="color:var(--primary)">{'>_'}</span>
    <span class="nova-mono text-xs font-bold uppercase tracking-wider" style="color:var(--primary)">AI</span>
  </button>
  <div id="nova-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(420px,calc(100vw-3rem))] hidden flex-col nova-border nova-glow" style="background:var(--surface);max-height:70vh">
    <div class="px-4 py-3 border-b nova-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full nova-glow" style="background:var(--primary)"></span>
        <p class="nova-mono text-xs uppercase tracking-widest" style="color:var(--primary)">assistant.exe</p>
      </div>
      <button id="nova-chat-close" type="button" class="nova-mono text-xs" style="color:var(--muted)" aria-label="Close">[x]</button>
    </div>
    <div id="nova-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-2 nova-mono text-xs" style="color:var(--text)">
      <div style="color:var(--muted)"><span style="color:var(--primary)">{'>'}</span> system ready</div>
      <div style="color:var(--muted)">awaiting input...</div>
    </div>
    <form id="nova-chat-form" class="p-3 border-t nova-border flex items-center gap-2">
      <span class="nova-mono text-xs" style="color:var(--primary)">{'>_'}</span>
      <input id="nova-chat-input" type="text" placeholder="enter query" class="flex-1 bg-transparent border-0 px-1 py-1 text-xs outline-none nova-mono" style="color:var(--text)" aria-label="Type your query" />
      <button type="submit" class="nova-btn px-3 py-1.5 nova-mono text-[10px] font-bold uppercase tracking-widest" aria-label="Send">Run</button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="dark" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('nova-menu-toggle'),d=document.getElementById('nova-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('nova-chat-toggle'),cp=document.getElementById('nova-chat-panel'),cc=document.getElementById('nova-chat-close');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    if(cc){cc.addEventListener('click',c);}
    var f=document.getElementById('nova-chat-form'),i=document.getElementById('nova-chat-input'),m=document.getElementById('nova-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='nova-mono text-xs';b.style.color='var(--text)';b.innerHTML='<span style="color:var(--primary)">></span> '+t.replace(/</g,'&lt;');m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'ERR: unreachable.'};}).then(function(data){var r=document.createElement('div');r.className='nova-mono text-xs';r.style.color='var(--muted)';r.textContent='> '+(data.reply||data.message||'no response.');m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='nova-mono text-xs';r.style.color='var(--muted)';r.textContent='> ERR: connection failed.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
