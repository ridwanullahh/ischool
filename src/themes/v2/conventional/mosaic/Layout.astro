---
/** Mosaic — Cultural Vibrant theme with ornate borders and tile patterns */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id); const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`; const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en'; const rtl = ['ar','he','fa','ur'].includes(locale);
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Karla:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" /><PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Karla', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .mosaic-serif { font-family: 'Marcellus', Georgia, serif; }
    .mosaic-ornate { border: 1px solid var(--primary); box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px color-mix(in srgb, var(--primary) 40%, transparent); }
    .mosaic-tile { background-image: repeating-linear-gradient(45deg, color-mix(in srgb, var(--primary) 4%, transparent) 0, color-mix(in srgb, var(--primary) 4%, transparent) 8px, transparent 8px, transparent 16px); }
    .mosaic-nav-link { font-size: 0.85rem; font-weight: 500; padding: 0.5rem 1rem; transition: all 0.2s; border-bottom: 2px solid transparent; }
    .mosaic-nav-link[data-active="true"], .mosaic-nav-link:hover { border-bottom-color: var(--primary); color: var(--primary); }
  `}</style>
</head>
<body>
  <header class="border-b-2 mosaic-tile" style="background:var(--surface);border-color:var(--primary)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
      <a href={`${prefix}/`} aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-14 w-auto mx-auto mb-3" /> : <span class="mosaic-serif text-4xl" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <h1 class="mosaic-serif text-3xl sm:text-4xl" style="color:var(--text)">{school.name}</h1>
      </a>
      {school.tagline && <p class="mosaic-serif italic text-sm mt-2" style="color:var(--muted)">{school.tagline}</p>}
    </div>
  </header>
  <nav class="sticky top-0 z-40 border-y mosaic-ornate" style="background:var(--surface)" aria-label="Primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hidden lg:flex items-center justify-center h-12 gap-6">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="mosaic-nav-link" style="color:var(--text)">{item.label}</a>; })}
        <div class="flex items-center gap-3 ml-4"><LanguageSelector /><button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button></div>
      </div>
      <div class="lg:hidden flex items-center justify-between h-12"><span class="mosaic-serif text-lg" style="color:var(--text)">{school.name}</span><button id="mosaic-menu-toggle" type="button" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="mosaic-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button></div>
      <div id="mosaic-mobile-nav" class="lg:hidden hidden pb-4 flex flex-col items-center gap-3">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="mosaic-nav-link" style="color:var(--text)">{item.label}</a>; })}<a href={`${prefix}/admissions`} class="mosaic-nav-link" style="color:var(--primary)">Apply</a></div>
    </div>
  </nav>
  <main><slot /></main>
  <footer class="mt-20 border-t-2 mosaic-tile" style="background:var(--surface);border-color:var(--primary)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-8"><p class="mosaic-serif text-2xl" style="color:var(--primary)">{school.name}</p><div class="flex items-center justify-center gap-2 mt-2"><span class="w-12 h-px" style="background:var(--primary)"></span><span class="mosaic-serif text-xs" style="color:var(--muted)">EST</span><span class="w-12 h-px" style="background:var(--primary)"></span></div></div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="mosaic-ornate p-4"><p class="mosaic-serif text-sm mb-3" style="color:var(--primary)">About</p><ul class="space-y-2">{nav.slice(0,4).map(item => <li><a href={`${prefix}${item.url}`} class="text-xs hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div class="mosaic-ornate p-4"><p class="mosaic-serif text-sm mb-3" style="color:var(--primary)">Admissions</p><ul class="space-y-2"><li><a href={`${prefix}/admissions`} class="text-xs hover:opacity-70" style="color:var(--text)">Apply</a></li><li><a href={`${prefix}/programs`} class="text-xs hover:opacity-70" style="color:var(--text)">Programs</a></li><li><a href={`${prefix}/classes`} class="text-xs hover:opacity-70" style="color:var(--text)">Classes</a></li></ul></div>
        <div class="mosaic-ornate p-4"><p class="mosaic-serif text-sm mb-3" style="color:var(--primary)">Contact</p><ul class="space-y-2">{contacts.slice(0,3).map(c => <li class="text-xs" style="color:var(--text)">{c.value}</li>)}{contacts.length===0 && <li class="text-xs" style="color:var(--muted)">—</li>}</ul></div>
        <div class="mosaic-ornate p-4"><p class="mosaic-serif text-sm mb-3" style="color:var(--primary)">Follow</p><div class="flex items-center gap-2">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--primary)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}{socialEntries.length===0 && <span class="text-xs" style="color:var(--muted)">—</span>}</div></div>
      </div>
      <div class="mt-8 pt-5 border-t flex items-center justify-between" style="border-color:color-mix(in srgb, var(--primary) 30%, var(--border))"><p class="text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}</p><a href="/" class="mosaic-serif text-xs hover:opacity-70" style="color:var(--primary)">Powered by iSchool</a></div>
    </div>
  </footer>
  <SchoolBannerPopup school={school} />
  <button id="mosaic-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 mosaic-ornate p-4 shadow-lg" style="background:var(--surface);color:var(--primary)" aria-label="Open chat" aria-expanded="false" aria-controls="mosaic-chat-panel"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="mosaic-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col mosaic-ornate shadow-2xl" style="background:var(--surface);max-height:70vh">
    <div class="px-5 py-4 text-center border-b" style="border-color:color-mix(in srgb, var(--primary) 30%, var(--border))"><p class="mosaic-serif text-lg" style="color:var(--text)">Greetings</p><p class="mosaic-serif italic text-xs" style="color:var(--muted)">How may we assist?</p></div>
    <div id="mosaic-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)"><div class="mosaic-ornate px-4 py-2.5 text-sm max-w-[85%]" style="background:color-mix(in srgb, var(--primary) 6%, var(--bg))">Welcome! Ask us anything.</div></div>
    <form id="mosaic-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--primary) 25%, var(--border))"><input id="mosaic-chat-input" type="text" placeholder="Your message..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none mosaic-serif" style="border-color:var(--border);color:var(--text)" aria-label="Type your message" /><button type="submit" class="mosaic-ornate px-4 py-1.5 mosaic-serif text-sm" style="color:var(--primary)" aria-label="Send">Send</button></form>
  </div>
  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('mosaic-menu-toggle'),d=document.getElementById('mosaic-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('mosaic-chat-toggle'),cp=document.getElementById('mosaic-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('mosaic-chat-form'),i=document.getElementById('mosaic-chat-input'),m=document.getElementById('mosaic-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='mosaic-ornate px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='mosaic-ornate px-4 py-2.5 text-sm max-w-[85%]';r.style.background='color-mix(in srgb, var(--primary) 6%, var(--bg))';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='mosaic-ornate px-4 py-2.5 text-sm max-w-[85%]';r.style.background='color-mix(in srgb, var(--primary) 6%, var(--bg))';r.style.color='var(--text)';r.textContent='Error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
