---
/**
 * Aurora — Gradient Mesh theme with flowing ethereal background
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Sora', system-ui, sans-serif; color: var(--text); min-height: 100vh; position: relative; overflow-x: hidden; }
    .aurora-mesh { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .aurora-blob { position: absolute; border-radius: 9999px; filter: blur(100px); opacity: 0.4; animation: aurora-float 12s ease-in-out infinite; }
    .aurora-b1 { width: 600px; height: 600px; top: -200px; left: -100px; background: var(--primary); }
    .aurora-b2 { width: 500px; height: 500px; top: 30%; right: -150px; background: var(--accent); opacity: 0.3; animation-delay: -4s; }
    .aurora-b3 { width: 400px; height: 400px; bottom: -100px; left: 30%; background: color-mix(in srgb, var(--primary) 50%, var(--accent)); opacity: 0.25; animation-delay: -8s; }
    html.dark .aurora-blob { opacity: 0.2; }
    @keyframes aurora-float { 0%,100% { transform: translate(0,0) scale(1); } 33% { transform: translate(60px,-40px) scale(1.1); } 66% { transform: translate(-40px,60px) scale(0.95); } }
    @media (prefers-reduced-motion: reduce) { .aurora-blob { animation: none; } }
    .aurora-glass { background: color-mix(in srgb, var(--surface) 70%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid color-mix(in srgb, var(--border) 50%, transparent); }
    .aurora-grad-btn { background: linear-gradient(135deg, var(--primary), var(--accent)); color: #fff; }
  `}</style>
</head>
<body>
  <div class="aurora-mesh" aria-hidden="true"><div class="aurora-blob aurora-b1"></div><div class="aurora-blob aurora-b2"></div><div class="aurora-blob aurora-b3"></div></div>
  <header class="relative z-40 sticky top-4 px-4">
    <nav class="aurora-glass max-w-6xl mx-auto rounded-2xl shadow-xl">
      <div class="flex items-center justify-between h-16 px-5">
        <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
          {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-9 w-auto rounded-lg" /> : <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl text-white font-bold aurora-grad-btn">{school.name.charAt(0)}</span>}
          <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
        </a>
        <div class="hidden lg:flex items-center gap-1">
          {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class:list={["px-3.5 py-2 text-sm font-medium rounded-lg transition-all", active ? "text-white" : "hover:bg-[color-mix(in_srgb,var(--primary)_10%,transparent)]"]} style={active ? "background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff" : "color:var(--muted)"}>{item.label}</a>; })}
        </div>
        <div class="flex items-center gap-2">
          <LanguageSelector />
          <button id="theme-toggle" type="button" class="aurora-glass p-2 rounded-lg" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button>
          <a href={`${prefix}/admissions`} class="hidden sm:inline-flex aurora-grad-btn px-4 py-2 text-sm font-semibold rounded-lg shadow-md">Apply</a>
          <button id="aurora-menu-toggle" type="button" class="lg:hidden aurora-glass p-2 rounded-lg" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="aurora-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        </div>
      </div>
      <div id="aurora-mobile-nav" class="lg:hidden hidden border-t px-5 pb-4 space-y-1" style="border-color:color-mix(in srgb, var(--border) 40%, transparent)">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} class:list={["block px-3 py-2.5 text-sm font-medium rounded-lg", active ? "text-white" : ""]} style={active ? "background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff" : "color:var(--text)"}>{item.label}</a>; })}
        <a href={`${prefix}/admissions`} class="block aurora-grad-btn px-3 py-2.5 text-sm font-semibold rounded-lg text-center">Apply for Admission</a>
      </div>
    </nav>
  </header>
  <main class="relative z-10"><slot /></main>
  <footer class="relative z-10 mt-20 px-4 pb-8">
    <div class="aurora-glass max-w-6xl mx-auto rounded-2xl p-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-3">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto rounded-lg" /> : <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white font-bold aurora-grad-btn">{school.name.charAt(0)}</span>}
            <span class="text-base font-bold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-sm" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && <div class="flex items-center gap-2 mt-4">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="aurora-glass p-2 rounded-lg hover:scale-110 transition-transform"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" style="color:var(--text)" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}
        </div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-3" style="color:var(--muted)">Explore</h3><ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><h3 class="text-xs font-bold uppercase tracking-wider mb-3" style="color:var(--muted)">Contact</h3><ul class="space-y-2">{contacts.slice(0,4).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length===0 && <li class="text-sm" style="color:var(--muted)">—</li>}</ul></div>
      </div>
      <div class="mt-6 pt-5 border-t flex flex-col sm:flex-row items-center justify-between gap-2" style="border-color:color-mix(in srgb, var(--border) 40%, transparent)">
        <p class="text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}</p>
        <a href="/" class="text-xs font-medium hover:underline" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>
  <SchoolBannerPopup school={school} />
  <button id="aurora-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 aurora-grad-btn p-4 rounded-2xl shadow-2xl hover:scale-105 transition-transform" aria-label="Open chat" aria-expanded="false" aria-controls="aurora-chat-panel"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="aurora-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col aurora-glass rounded-2xl shadow-2xl overflow-hidden" style="max-height:70vh">
    <div class="px-5 py-4 border-b aurora-grad-btn" style="border-color:color-mix(in srgb, var(--border) 50%, transparent)">
      <p class="text-sm font-bold text-white">{school.name} Assistant</p>
      <p class="text-[11px] text-white/80">Ask us anything</p>
    </div>
    <div id="aurora-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)"><div class="aurora-glass rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]">How can we help?</div></div>
    <form id="aurora-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--border) 40%, transparent)">
      <input id="aurora-chat-input" type="text" placeholder="Type your message..." class="flex-1 aurora-glass rounded-full px-4 py-2 text-sm outline-none" style="color:var(--text)" aria-label="Type your message" />
      <button type="submit" class="aurora-grad-btn p-2.5 rounded-full" aria-label="Send"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>
  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('aurora-menu-toggle'),d=document.getElementById('aurora-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('aurora-chat-toggle'),cp=document.getElementById('aurora-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('aurora-chat-form'),i=document.getElementById('aurora-chat-input'),m=document.getElementById('aurora-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='aurora-glass rounded-xl rounded-tr-sm px-4 py-2.5 text-sm max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='aurora-glass rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='aurora-glass rounded-xl rounded-tl-sm px-4 py-2.5 text-sm max-w-[85%]';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
