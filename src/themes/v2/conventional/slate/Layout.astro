---
/**
 * Slate — Corporate Clean theme with structured grid
 *
 * Layout autonomy: professional top bar with a utility row (contact +
 * language) above the main nav bar, a footer with a 4-column sitemap
 * grid + legal row, and a chat widget as a clean professional side
 * panel that slides in from the right.
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';

interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const primaryNav = nav.slice(0, 6);
const moreNav = nav.slice(6);
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'IBM Plex Sans', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .slate-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }
    .slate-nav-link { font-size: 0.85rem; font-weight: 500; padding: 0.5rem 0.75rem; transition: color 0.15s; border-bottom: 2px solid transparent; }
    .slate-nav-link[data-active="true"] { color: var(--primary); border-bottom-color: var(--primary); }
    .slate-nav-link:hover:not([data-active="true"]) { color: var(--primary); }
  `}</style>
</head>
<body>
  <!-- Utility row -->
  <div class="border-b" style="background:var(--surface);border-color:var(--border)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center justify-between text-xs">
      <div class="flex items-center gap-4" style="color:var(--muted)">
        {contacts[0] && <span class="flex items-center gap-1.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{contacts[0].value}</span>}
        {contacts[1] && <span class="hidden sm:flex items-center gap-1.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>{contacts[1].value}</span>}
      </div>
      <div class="flex items-center gap-3">
        <LanguageSelector />
        <button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode">
          <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>
    </div>
  </div>
  <!-- Main nav bar -->
  <header class="sticky top-0 z-40 border-b shadow-sm" style="background:var(--surface);border-color:var(--border)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="slate-mono text-xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <span class="text-base font-semibold" style="color:var(--text)">{school.name}</span>
      </a>
      <div class="hidden lg:flex items-center gap-1">
        {primaryNav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="slate-nav-link" style="color:var(--text)">{item.label}</a>; })}
        {moreNav.length > 0 && (
          <div class="relative group">
            <button class="slate-nav-link flex items-center gap-1" style="color:var(--text)">More<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button>
            <div class="absolute right-0 top-full mt-1 w-48 border shadow-lg hidden group-hover:block z-50" style="background:var(--surface);border-color:var(--border)">
              {moreNav.map(item => <a href={`${prefix}${item.url}`} class="block px-4 py-2 text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a>)}
            </div>
          </div>
        )}
        <a href={`${prefix}/admissions`} class="ml-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white" style="background:var(--primary)">Apply</a>
      </div>
      <button id="slate-menu-toggle" type="button" class="lg:hidden p-2" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="slate-mobile-nav">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="slate-mobile-nav" class="lg:hidden hidden border-t px-4 py-3 space-y-1" style="border-color:var(--border)">
      {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="slate-nav-link block" style="color:var(--text)">{item.label}</a>; })}
      <a href={`${prefix}/admissions`} class="slate-nav-link block" style="color:var(--primary)">Apply for Admission</a>
    </div>
  </header>

  <main><slot /></main>

  <!-- 4-column sitemap footer -->
  <footer class="border-t mt-20" style="background:var(--surface);border-color:var(--border)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="col-span-2 md:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="slate-mono text-xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>}
            <span class="text-sm font-semibold" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="text-xs leading-relaxed" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && (
            <div class="flex items-center gap-2 mt-4">
              {socialEntries.map(([platform, handle]) => { const path = getSocialIconPath(platform); if (!path) return null; return <a href={normalizeSocialUrl(handle, platform)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${platform} page`} style="color:var(--muted)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}
            </div>
          )}
        </div>
        <div>
          <p class="slate-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">About</p>
          <ul class="space-y-2">{nav.slice(0, 5).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="slate-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">Admissions</p>
          <ul class="space-y-2">
            <li><a href={`${prefix}/admissions`} class="text-sm hover:opacity-70" style="color:var(--text)">Apply</a></li>
            <li><a href={`${prefix}/programs`} class="text-sm hover:opacity-70" style="color:var(--text)">Programs</a></li>
            <li><a href={`${prefix}/classes`} class="text-sm hover:opacity-70" style="color:var(--text)">Classes</a></li>
            <li><a href={`${prefix}/faqs`} class="text-sm hover:opacity-70" style="color:var(--text)">FAQs</a></li>
          </ul>
        </div>
        <div>
          <p class="slate-mono text-[10px] uppercase tracking-widest mb-3" style="color:var(--primary)">Contact</p>
          <ul class="space-y-2">{contacts.slice(0, 4).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="slate-mono block text-[10px] uppercase tracking-wider" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length===0 && <li class="text-sm" style="color:var(--muted)">No data.</li>}</ul>
        </div>
      </div>
      <div class="mt-10 pt-5 border-t flex flex-col sm:flex-row items-center justify-between gap-2" style="border-color:var(--border)">
        <p class="slate-mono text-[11px]" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="slate-mono text-[11px] uppercase tracking-widest" style="color:var(--primary)">iSchool</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} />

  <!-- Side-sliding professional chat panel -->
  <button id="slate-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 px-5 py-3 shadow-lg flex items-center gap-2 transition-all hover:-translate-y-0.5" style="background:var(--primary);color:#fff" aria-label="Open chat" aria-expanded="false" aria-controls="slate-chat-panel">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    <span class="text-sm font-semibold">Support</span>
  </button>
  <div id="slate-chat-panel" class="fixed top-0 right-0 bottom-0 z-50 w-full sm:w-96 hidden flex-col shadow-2xl border-l" style="background:var(--surface);border-color:var(--border)">
    <div class="px-5 py-4 border-b flex items-center justify-between" style="border-color:var(--border)">
      <div>
        <p class="font-semibold" style="color:var(--text)">Support Chat</p>
        <p class="slate-mono text-[10px] uppercase tracking-wider" style="color:var(--muted)">{school.name}</p>
      </div>
      <button id="slate-chat-close" type="button" style="color:var(--muted)" aria-label="Close chat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="slate-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3 text-sm" style="color:var(--text)">
      <div class="max-w-[85%] px-4 py-2.5" style="background:color-mix(in srgb, var(--primary) 8%, var(--bg));color:var(--text)">How can we help you today?</div>
    </div>
    <form id="slate-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)">
      <input id="slate-chat-input" type="text" placeholder="Type your message..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none" style="border-color:var(--border);color:var(--text)" aria-label="Type your message" />
      <button type="submit" class="px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white" style="background:var(--primary)" aria-label="Send">Send</button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('slate-menu-toggle'),d=document.getElementById('slate-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('slate-chat-toggle'),cp=document.getElementById('slate-chat-panel'),cc=document.getElementById('slate-chat-close');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    if(cc){cc.addEventListener('click',c);}
    var f=document.getElementById('slate-chat-form'),i=document.getElementById('slate-chat-input'),m=document.getElementById('slate-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='max-w-[85%] ml-auto px-4 py-2.5';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='max-w-[85%] px-4 py-2.5';r.style.background='color-mix(in srgb, var(--primary) 8%, var(--bg))';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='max-w-[85%] px-4 py-2.5';r.style.background='color-mix(in srgb, var(--primary) 8%, var(--bg))';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
