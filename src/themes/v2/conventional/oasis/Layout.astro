---
/**
 * Oasis — Nature-Fresh theme with botanical accents
 *
 * Layout autonomy: organic top bar with centered logo + nav below in
 * a rounded container, an SVG botanical leaf divider, a footer with
 * a nature-inspired wave SVG top border, and a chat widget that grows
 * from a leaf-shaped button into a rounded organic panel.
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';

interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'DM Sans', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .oasis-serif { font-family: 'Fraunces', Georgia, serif; }
    .oasis-nav-pill { border-radius: 9999px; }
    .oasis-nav-link { padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 500; border-radius: 9999px; transition: all 0.2s; }
    .oasis-nav-link[data-active="true"] { background: var(--primary); color: #fff; }
    .oasis-nav-link:hover:not([data-active="true"]) { background: color-mix(in srgb, var(--primary) 10%, transparent); }
    .oasis-card { border-radius: 1.5rem; }
  `}</style>
</head>
<body>
  <!-- Centered masthead + nav pill -->
  <header class="px-4 pt-8 pb-4">
    <div class="max-w-6xl mx-auto text-center">
      <a href={`${prefix}/`} class="inline-flex flex-col items-center gap-2" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-12 w-auto" /> : <span class="oasis-serif text-3xl font-medium" style="color:var(--primary)">{school.name.charAt(0)}</span>}
        <h1 class="oasis-serif text-3xl sm:text-4xl font-medium" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="text-xs italic oasis-serif" style="color:var(--muted)">{school.tagline}</p>}
      </a>
    </div>
  </header>
  <nav class="sticky top-0 z-40 px-4 py-3" aria-label="Primary">
    <div class="max-w-6xl mx-auto flex items-center justify-center">
      <div class="oasis-nav-pill hidden lg:flex items-center gap-1 p-1.5 shadow-md" style="background:var(--surface);border:1px solid var(--border)">
        {nav.map(item => {
          const active = pathname === `${prefix}${item.url}`;
          return <a href={`${prefix}${item.url}`} data-active={active} class="oasis-nav-link" style="color:var(--text)">{item.label}</a>;
        })}
        <a href={`${prefix}/admissions`} class="oasis-nav-link" style="background:color-mix(in srgb, var(--primary) 15%, transparent);color:var(--primary)">Apply</a>
      </div>
      <div class="lg:hidden flex items-center justify-between w-full">
        <div class="oasis-nav-pill p-1.5 flex items-center gap-2" style="background:var(--surface);border:1px solid var(--border)">
          <LanguageSelector />
          <button id="theme-toggle" type="button" class="p-1.5" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode">
            <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </button>
        </div>
        <button id="oasis-menu-toggle" type="button" class="oasis-nav-pill p-2.5" style="background:var(--surface);border:1px solid var(--border);color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="oasis-mobile-nav">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="oasis-mobile-nav" class="lg:hidden hidden mt-3 max-w-6xl mx-auto oasis-card p-3 space-y-1" style="background:var(--surface);border:1px solid var(--border)">
      {nav.map(item => {
        const active = pathname === `${prefix}${item.url}`;
        return <a href={`${prefix}${item.url}`} data-active={active} class="oasis-nav-link block" style="color:var(--text)">{item.label}</a>;
      })}
      <a href={`${prefix}/admissions`} class="oasis-nav-link block" style="background:var(--primary);color:#fff">Apply for Admission</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <!-- Nature-wave footer -->
  <footer class="mt-20" style="background:var(--surface)">
    <svg viewBox="0 0 1440 80" class="w-full h-12" preserveAspectRatio="none" aria-hidden="true"><path d="M0,40 C240,80 480,0 720,30 C960,60 1200,10 1440,40 L1440,80 L0,80 Z" fill="var(--surface)" /></svg>
    <div class="max-w-6xl mx-auto px-4 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-10 w-auto" /> : <span class="oasis-serif text-2xl font-medium" style="color:var(--primary)">{school.name.charAt(0)}</span>}
            <span class="oasis-serif text-xl font-medium" style="color:var(--text)">{school.name}</span>
          </div>
          {school.tagline && <p class="oasis-serif italic text-sm" style="color:var(--muted)">{school.tagline}</p>}
          {socialEntries.length > 0 && (
            <div class="flex items-center gap-2 mt-4">
              {socialEntries.map(([platform, handle]) => {
                const path = getSocialIconPath(platform);
                if (!path) return null;
                return <a href={normalizeSocialUrl(handle, platform)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${platform} page`} class="oasis-nav-pill p-2 transition-transform hover:scale-110" style="background:color-mix(in srgb, var(--primary) 12%, transparent);color:var(--primary)"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>;
              })}
            </div>
          )}
        </div>
        <div>
          <p class="oasis-serif text-sm font-medium mb-3" style="color:var(--primary)">Explore</p>
          <ul class="space-y-2">{nav.slice(0, 6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm transition-colors hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="oasis-serif text-sm font-medium mb-3" style="color:var(--primary)">Contact</p>
          <ul class="space-y-2">{contacts.slice(0, 4).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs italic" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length === 0 && <li class="text-sm italic" style="color:var(--muted)">No contact info yet.</li>}</ul>
        </div>
      </div>
      <div class="mt-8 pt-5 border-t flex flex-col sm:flex-row items-center justify-between gap-2" style="border-color:var(--border)">
        <p class="text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="text-xs oasis-serif italic" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} />

  <!-- Growing leaf-bubble chat -->
  <button id="oasis-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 oasis-nav-pill p-4 shadow-lg transition-transform hover:scale-110" style="background:var(--primary);color:#fff" aria-label="Open chat" aria-expanded="false" aria-controls="oasis-chat-panel">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
  </button>
  <div id="oasis-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col oasis-card shadow-2xl overflow-hidden" style="background:var(--surface);border:1px solid var(--border);max-height:70vh">
    <div class="px-5 py-4" style="background:color-mix(in srgb, var(--primary) 8%, var(--surface))">
      <p class="oasis-serif text-lg font-medium" style="color:var(--text)">Hello there</p>
      <p class="text-xs italic oasis-serif" style="color:var(--muted)">How can we help you grow today?</p>
    </div>
    <div id="oasis-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-2 text-sm" style="color:var(--text)">
      <div class="oasis-card px-4 py-2.5 max-w-[85%]" style="background:color-mix(in srgb, var(--primary) 10%, var(--bg));color:var(--text)">Welcome! Ask us anything.</div>
    </div>
    <form id="oasis-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)">
      <input id="oasis-chat-input" type="text" placeholder="Your message..." class="flex-1 oasis-nav-pill px-4 py-2 text-sm outline-none" style="background:color-mix(in srgb, var(--primary) 6%, var(--bg));color:var(--text)" aria-label="Type your message" />
      <button type="submit" class="oasis-nav-pill p-3 text-white" style="background:var(--primary)" aria-label="Send"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('oasis-menu-toggle'),d=document.getElementById('oasis-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('oasis-chat-toggle'),cp=document.getElementById('oasis-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('oasis-chat-form'),i=document.getElementById('oasis-chat-input'),m=document.getElementById('oasis-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='oasis-card px-4 py-2.5 max-w-[85%] ml-auto';b.style.background='var(--primary)';b.style.color='#fff';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='oasis-card px-4 py-2.5 max-w-[85%]';r.style.background='color-mix(in srgb, var(--primary) 10%, var(--bg))';r.style.color='var(--text)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='oasis-card px-4 py-2.5 max-w-[85%]';r.style.background='color-mix(in srgb, var(--primary) 10%, var(--bg))';r.style.color='var(--text)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
