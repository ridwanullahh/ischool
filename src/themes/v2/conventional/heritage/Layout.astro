---
/**
 * Heritage — Editorial Newspaper theme with dense multi-column structure
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const today = new Date().toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
import PageLoader from '../../../../components/PageLoader.astro';
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'IBM Plex Sans', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .heritage-serif { font-family: 'Libre Caslon Text', Georgia, serif; }
    .heritage-rule { border-color: var(--text); }
    .heritage-nav-link { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.5rem 0; border-bottom: 2px solid transparent; transition: border-color 0.2s; }
    .heritage-nav-link[data-active="true"], .heritage-nav-link:hover { border-bottom-color: var(--primary); color: var(--primary); }
  `}</style>
</head>
<body>
    <PageLoader />
  <header class="border-b-2 heritage-rule" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center">
      <div class="flex items-center justify-between text-[10px] uppercase tracking-widest mb-3" style="color:var(--muted)">
        <span>Vol. I</span><span>{today}</span><span>No. 1</span>
      </div>
      <div class="border-t border-b py-4" style="border-color:var(--text)">
        <a href={`${prefix}/`} aria-label={`${school.name} home`}>
          {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-12 w-auto mx-auto mb-2" /> : null}
          <h1 class="heritage-serif text-4xl sm:text-5xl font-bold" style="color:var(--text)">{school.name}</h1>
        </a>
        {school.tagline && <p class="heritage-serif italic text-sm mt-1" style="color:var(--muted)">{school.tagline}</p>}
      </div>
    </div>
  </header>
  <nav class="sticky top-0 z-40 border-b heritage-rule shadow-sm" style="background:var(--surface)" aria-label="Primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hidden lg:flex items-center justify-center h-12 gap-8">
        {nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="heritage-nav-link" style="color:var(--text)">{item.label}</a>; })}
        <div class="flex items-center gap-3 ml-4"><LanguageSelector /><button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button></div>
      </div>
      <div class="lg:hidden flex items-center justify-between h-12">
        <span class="heritage-serif text-lg font-bold" style="color:var(--text)">{school.name}</span>
        <button id="heritage-menu-toggle" type="button" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="heritage-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      </div>
      <div id="heritage-mobile-nav" class="lg:hidden hidden pb-4 flex flex-col items-center gap-2">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="heritage-nav-link" style="color:var(--text)">{item.label}</a>; })}<a href={`${prefix}/admissions`} class="heritage-nav-link" style="color:var(--primary)">Apply</a></div>
    </div>
  </nav>
  <main><slot /></main>
  
  <footer class="border-t-2 heritage-rule mt-20" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-8 pb-6 border-b heritage-rule">
        <p class="heritage-serif text-3xl font-bold" style="color:var(--text)">{school.name}</p>
        <p class="heritage-serif italic text-xs mt-1" style="color:var(--muted)">— {school.tagline || 'Established for excellence'} —</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-0 divide-x" style="border-color:var(--border)">
        <div class="px-4"><p class="heritage-serif text-sm font-bold mb-3" style="color:var(--primary)">About</p><ul class="space-y-1.5">{nav.slice(0,4).map(item => <li><a href={`${prefix}${item.url}`} class="text-xs hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div class="px-4"><p class="heritage-serif text-sm font-bold mb-3" style="color:var(--primary)">Admissions</p><ul class="space-y-1.5"><li><a href={`${prefix}/admissions`} class="text-xs hover:opacity-70" style="color:var(--text)">Apply</a></li><li><a href={`${prefix}/programs`} class="text-xs hover:opacity-70" style="color:var(--text)">Programs</a></li><li><a href={`${prefix}/classes`} class="text-xs hover:opacity-70" style="color:var(--text)">Classes</a></li><li><a href={`${prefix}/faqs`} class="text-xs hover:opacity-70" style="color:var(--text)">FAQs</a></li></ul></div>
        <div class="px-4"><p class="heritage-serif text-sm font-bold mb-3" style="color:var(--primary)">Contact</p><ul class="space-y-1.5">{contacts.slice(0,3).map(c => <li class="text-xs" style="color:var(--text)">{c.value}</li>)}{contacts.length===0 && <li class="text-xs" style="color:var(--muted)">—</li>}</ul></div>
        <div class="px-4"><p class="heritage-serif text-sm font-bold mb-3" style="color:var(--primary)">Follow</p><div class="flex items-center gap-2">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--primary)" class="hover:opacity-70"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}{socialEntries.length===0 && <span class="text-xs" style="color:var(--muted)">—</span>}</div></div>
      </div>
      <div class="mt-8 pt-5 border-t heritage-rule flex items-center justify-between">
        <p class="text-[10px] uppercase tracking-widest" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}</p>
        <a href="/" class="text-[10px] uppercase tracking-widest hover:opacity-70" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>
  <SchoolBannerPopup school={school} />
  <button id="heritage-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 px-4 py-3 border-2 shadow-lg" style="background:var(--surface);border-color:var(--text);color:var(--text)" aria-label="Open chat" aria-expanded="false" aria-controls="heritage-chat-panel"><span class="flex items-center gap-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg><span class="heritage-serif text-sm font-bold">Inquire</span></span></button>
  <div id="heritage-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(360px,calc(100vw-3rem))] hidden flex-col shadow-2xl border-2" style="background:var(--surface);border-color:var(--text);max-height:70vh">
    <div class="px-4 py-3 border-b text-center" style="border-color:var(--text)"><p class="heritage-serif text-lg font-bold" style="color:var(--text)">Letters to the Editor</p><p class="text-[10px] uppercase tracking-widest" style="color:var(--muted)">We welcome your inquiries</p></div>
    <div id="heritage-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)"><p class="heritage-serif italic text-sm" style="color:var(--muted)">What is your question?</p></div>
    <form id="heritage-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--text)"><input id="heritage-chat-input" type="text" placeholder="Your inquiry..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none heritage-serif" style="border-color:var(--border);color:var(--text)" aria-label="Type your inquiry" /><button type="submit" class="heritage-serif text-sm font-bold px-3 py-1" style="color:var(--primary)" aria-label="Send">Send</button></form>
  </div>
  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('heritage-menu-toggle'),d=document.getElementById('heritage-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('heritage-chat-toggle'),cp=document.getElementById('heritage-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('heritage-chat-form'),i=document.getElementById('heritage-chat-input'),m=document.getElementById('heritage-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('p');b.className='heritage-serif text-sm text-right';b.style.color='var(--primary)';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('p');r.className='heritage-serif italic text-sm';r.style.color='var(--muted)';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('p');r.className='heritage-serif italic text-sm';r.style.color='var(--muted)';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
