---
/**
 * Ember — Warm Earth magazine-style theme
 *
 * Layout autonomy: a top utility strip with date + contact, a masthead
 * with a thick warm bottom border, a two-row nav (primary + secondary
 * utility links), a footer with a magazine-style masthead repeat and
 * three dense columns, and a chat widget styled as a handwritten
 * "note" card with warm tones.
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';

interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id);
const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`;
const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en';
const rtl = ['ar','he','fa','ur'].includes(locale);
const primaryNav = nav.slice(0, 6);
const secondaryNav = nav.slice(6);
const today = new Date().toLocaleDateString(locale === 'en' ? 'en-US' : locale, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" />
  <PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body {
      font-family: 'Source Sans 3', system-ui, sans-serif;
      color: var(--text);
      min-height: 100vh;
      font-weight: 400;
    }
    .ember-serif { font-family: 'Lora', Georgia, serif; }
    .ember-warm-bg { background: color-mix(in srgb, var(--primary) 6%, var(--surface)); }
    .ember-border-warm { border-color: color-mix(in srgb, var(--primary) 30%, var(--border)); }
    .ember-nav-link {
      font-size: 0.85rem; font-weight: 500; letter-spacing: 0.01em;
      padding: 0.5rem 0.75rem; transition: color 0.2s;
    }
    .ember-nav-link[data-active="true"] { color: var(--primary); font-weight: 600; }
    .ember-nav-link:hover { color: var(--primary); }
    .ember-tag {
      font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--primary);
    }
    .ember-btn {
      background: var(--primary); color: #fff;
      transition: all 0.2s ease;
    }
    .ember-btn:hover { background: color-mix(in srgb, var(--primary) 85%, #000); }
  `}</style>
</head>
<body>
  <div class="ember-warm-bg border-b ember-border-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center justify-between text-xs">
      <span class="ember-serif italic" style="color:var(--muted)">{today}</span>
      <div class="flex items-center gap-4">
        {contacts[0] && <span class="hidden sm:flex items-center gap-1.5" style="color:var(--muted)">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {contacts[0].value}
        </span>}
        <div class="flex items-center gap-2">
          <LanguageSelector />
          <button id="theme-toggle" type="button" class="transition-opacity hover:opacity-70" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode">
            <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <header class="border-b-2 ember-border-warm" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
      <a href={`${prefix}/`} class="inline-flex flex-col items-center gap-2" aria-label={`${school.name} home`}>
        {school.logoUrl ? (
          <img src={school.logoUrl} alt={school.name} class="h-12 w-auto" />
        ) : (
          <span class="ember-serif text-3xl font-bold" style="color:var(--primary)">{school.name.charAt(0)}</span>
        )}
        <h1 class="ember-serif text-3xl sm:text-4xl font-bold tracking-tight" style="color:var(--text)">{school.name}</h1>
        {school.tagline && <p class="ember-tag mt-1">{school.tagline}</p>}
      </a>
    </div>
  </header>

  
  <nav class="sticky top-0 z-40 border-b ember-border-warm shadow-sm" style="background:var(--surface)" aria-label="Primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hidden lg:flex items-center justify-between h-12">
        <div class="flex items-center gap-1">
          {primaryNav.map(item => {
            const active = pathname === `${prefix}${item.url}`;
            return (
              <a href={`${prefix}${item.url}`} data-active={active} class="ember-nav-link" style="color:var(--text)">{item.label}</a>
            );
          })}
        </div>
        <div class="flex items-center gap-3">
          {secondaryNav.slice(0, 4).map(item => (
            <a href={`${prefix}${item.url}`} class="ember-nav-link text-xs uppercase tracking-wider" style="color:var(--muted)">{item.label}</a>
          ))}
          <a href={`${prefix}/admissions`} class="ember-btn px-4 py-1.5 text-xs font-bold uppercase tracking-wider">Apply</a>
        </div>
      </div>
      <div class="lg:hidden flex items-center justify-between h-12">
        <span class="ember-serif text-lg font-bold" style="color:var(--primary)">{school.name}</span>
        <button id="ember-menu-toggle" type="button" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="ember-mobile-nav">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
      <div id="ember-mobile-nav" class="lg:hidden hidden pb-3 space-y-1">
        {nav.map(item => {
          const active = pathname === `${prefix}${item.url}`;
          return (
            <a href={`${prefix}${item.url}`} data-active={active} class="ember-nav-link block" style="color:var(--text)">{item.label}</a>
          );
        })}
        <a href={`${prefix}/admissions`} class="ember-btn block px-4 py-2 text-xs font-bold uppercase tracking-wider text-center">Apply for Admission</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  
  <footer class="border-t-2 ember-border-warm" style="background:var(--surface)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-10 pb-8 border-b ember-border-warm">
        <p class="ember-serif text-2xl font-bold" style="color:var(--text)">{school.name}</p>
        {school.tagline && <p class="ember-tag mt-1">{school.tagline}</p>}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5">
          <p class="ember-tag mb-3">About</p>
          <p class="ember-serif text-base leading-relaxed" style="color:var(--text)">{school.tagline || school.name}</p>
          {socialEntries.length > 0 && (
            <div class="flex items-center gap-3 mt-4">
              {socialEntries.map(([platform, handle]) => {
                const path = getSocialIconPath(platform);
                if (!path) return null;
                return (
                  <a href={normalizeSocialUrl(handle, platform)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${platform} page`} class="transition-colors hover:opacity-70" style="color:var(--primary)">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg>
                  </a>
                );
              })}
            </div>
          )}
        </div>
        <div class="md:col-span-3">
          <p class="ember-tag mb-3">Sections</p>
          <ul class="space-y-2">
            {nav.slice(0, 7).map(item => (
              <li><a href={`${prefix}${item.url}`} class="text-sm ember-serif transition-colors hover:opacity-70" style="color:var(--text)">{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="md:col-span-4">
          <p class="ember-tag mb-3">Contact</p>
          <ul class="space-y-2.5">
            {contacts.slice(0, 4).map(c => (
              <li class="text-sm" style="color:var(--text)">
                {c.label && <span class="ember-serif block text-xs italic" style="color:var(--muted)">{c.label}</span>}
                {c.value}
              </li>
            ))}
            {contacts.length === 0 && <li class="text-sm ember-serif italic" style="color:var(--muted)">No contact info yet.</li>}
          </ul>
        </div>
      </div>
      <div class="mt-10 pt-5 border-t ember-border-warm flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="text-xs ember-serif italic" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <a href="/" class="text-xs ember-serif italic hover:opacity-70" style="color:var(--primary)">Powered by iSchool</a>
      </div>
    </div>
  </footer>

  <SchoolBannerPopup school={school} />

  
  <button id="ember-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 ember-btn px-5 py-3 shadow-lg flex items-center gap-2" aria-label="Open chat" aria-expanded="false" aria-controls="ember-chat-panel">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    <span class="ember-serif text-sm font-semibold">Leave a note</span>
  </button>
  <div id="ember-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col shadow-2xl border-2 rounded-sm" style="background:var(--surface);border-color:color-mix(in srgb, var(--primary) 35%, var(--border));max-height:70vh">
    <div class="px-5 py-4 border-b ember-border-warm" style="background:color-mix(in srgb, var(--primary) 6%, var(--surface))">
      <p class="ember-serif text-lg font-bold" style="color:var(--text)">Drop us a line</p>
      <p class="ember-tag mt-0.5">We would love to hear from you</p>
    </div>
    <div id="ember-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3" style="color:var(--text)">
      <div class="border-l-2 pl-3 ember-serif italic text-sm" style="border-color:var(--primary);color:var(--muted)">
        Hello! What brings you here today?
      </div>
    </div>
    <form id="ember-chat-form" class="p-3 border-t ember-border-warm flex items-center gap-2">
      <input id="ember-chat-input" type="text" placeholder="Write your message..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none ember-serif" style="border-color:var(--border);color:var(--text)" aria-label="Type your message" />
      <button type="submit" class="ember-btn px-4 py-1.5 text-xs font-bold uppercase tracking-wider" aria-label="Send">Send</button>
    </form>
  </div>

  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('ember-menu-toggle'),d=document.getElementById('ember-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('ember-chat-toggle'),cp=document.getElementById('ember-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('ember-chat-form'),i=document.getElementById('ember-chat-input'),m=document.getElementById('ember-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='text-sm text-right ember-serif';b.style.color='var(--primary)';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Sorry, we cannot reach the assistant right now.'};}).then(function(data){var r=document.createElement('div');r.className='border-l-2 pl-3 ember-serif italic text-sm';r.style.borderColor='var(--primary)';r.style.color='var(--muted)';r.textContent=data.reply||data.message||'We will get back to you shortly.';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='border-l-2 pl-3 ember-serif italic text-sm';r.style.borderColor='var(--primary)';r.style.color='var(--muted)';r.textContent='Connection error. Please try again.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
