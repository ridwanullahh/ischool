---
/**
 * Crest — v2 conventional theme
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id); const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`; const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en'; const rtl = ['ar','he','fa','ur'].includes(locale);
import PageLoader from '../../../../components/PageLoader.astro';
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" /><PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Cinzel', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .crest-serif { font-family: 'Cormorant Garamond', Georgia, serif; }
    .crest-nav-link { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; padding: 0.5rem 0; transition: color 0.2s; }
    .crest-nav-link[data-active="true"], .crest-nav-link:hover { color: var(--primary); }
    .crest-bubble-u { color: var(--primary); padding: 0.5rem 0; font-size: 0.85rem; max-width: 85%; margin-left: auto; text-align: right; font-family: 'Cormorant Garamond', serif; }
    .crest-bubble-a { color: var(--muted); padding: 0.5rem 0; font-size: 0.85rem; max-width: 85%; font-family: 'Cormorant Garamond', serif; font-style: italic; }
  `}</style>
</head>
<body>
    <PageLoader />
  <header class="border-b-2" style="background:var(--surface);border-color:var(--primary)">
    <div class="max-w-5xl mx-auto px-4 pt-10 pb-6 text-center">
      <a href={`${prefix}/`} class="inline-flex flex-col items-center gap-3" aria-label={`${school.name} home`}>
        {school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-14 w-auto" /> : <svg class="w-12 h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--primary)" stroke-width="1.5"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg>}
        <h1 class="text-2xl sm:text-3xl font-bold tracking-wide" style="color:var(--text)">{school.name}</h1>
      </a>
      {school.tagline && <p class="crest-serif italic text-sm mt-1" style="color:var(--muted)">{school.tagline}</p>}
    </div>
  </header>
  <nav class="sticky top-0 z-40 border-y" style="background:var(--surface);border-color:color-mix(in srgb, var(--primary) 25%, var(--border))" aria-label="Primary">
    <div class="max-w-5xl mx-auto px-4">
      <div class="hidden lg:flex items-center justify-center h-12 gap-8">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="crest-nav-link" style="color:var(--text)">{item.label}</a>; })}<div class="flex items-center gap-3 ml-4"><LanguageSelector /><button id="theme-toggle" type="button" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button></div></div>
      <div class="lg:hidden flex items-center justify-between h-12"><span class="crest-serif text-lg" style="color:var(--text)">{school.name}</span><button id="crest-menu-toggle" type="button" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="crest-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg></button></div>
      <div id="crest-mobile-nav" class="lg:hidden hidden pb-4 flex flex-col items-center gap-3">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="crest-nav-link" style="color:var(--text)">{item.label}</a>; })}<a href={`${prefix}/admissions`} class="crest-nav-link" style="color:var(--primary)">Apply</a></div>
    </div>
  </nav>
  <main><slot /></main>
  <footer class="mt-24 px-4 pb-10">
    <div class="max-w-5xl mx-auto text-center">
      <div class="flex items-center justify-center gap-4 mb-8"><div class="h-px w-20" style="background:var(--primary)"></div><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--primary)" stroke-width="1.5"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg><div class="h-px w-20" style="background:var(--primary)"></div></div>
      <p class="crest-serif text-2xl mb-2" style="color:var(--text)">{school.name}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8 text-left">
        <div><p class="crest-nav-link mb-3" style="color:var(--primary)">Contact</p><ul class="space-y-1.5">{contacts.slice(0,3).map(c => <li class="text-xs crest-serif" style="color:var(--text)">{c.value}</li>)}{contacts.length===0 && <li class="text-xs crest-serif italic" style="color:var(--muted)">—</li>}</ul></div>
        <div><p class="crest-nav-link mb-3" style="color:var(--primary)">Navigate</p><ul class="space-y-1.5">{nav.slice(0,5).map(item => <li><a href={`${prefix}${item.url}`} class="text-xs crest-serif hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><p class="crest-nav-link mb-3" style="color:var(--primary)">Follow</p><div class="flex items-center gap-3">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} style="color:var(--primary)" class="opacity-70 hover:opacity-100"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}{socialEntries.length===0 && <span class="text-xs crest-serif italic" style="color:var(--muted)">—</span>}</div></div>
      </div>
      <div class="h-px w-full mt-8 mb-4" style="background:var(--primary)"></div>
      <p class="text-[10px] uppercase tracking-[0.3em]" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}</p>
    </div>
  </footer>
  <SchoolBannerPopup school={school} />
  <button id="crest-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 px-5 py-3 border-2" style="background:var(--surface);border-color:var(--primary);color:var(--primary)" aria-label="Open chat" aria-expanded="false" aria-controls="crest-chat-panel"><span class="crest-serif text-sm font-semibold">Inquire</span></button>
  <div id="crest-chat-panel" class="fixed bottom-20 right-6 z-50 w-[min(360px,calc(100vw-3rem))] hidden flex-col shadow-2xl border-2" style="background:var(--surface);border-color:var(--primary);max-height:70vh">
    <div class="px-5 py-4 text-center border-b" style="border-color:color-mix(in srgb, var(--primary) 25%, var(--border))"><p class="crest-serif text-lg" style="color:var(--text)">Inquiries</p><p class="text-[9px] uppercase tracking-[0.3em]" style="color:var(--muted)">Formal reception</p></div>
    <div id="crest-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
    <form id="crest-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:color-mix(in srgb, var(--primary) 20%, var(--border))"><input id="crest-chat-input" type="text" placeholder="Your inquiry..." class="flex-1 bg-transparent border-b px-2 py-1.5 text-sm outline-none crest-serif" style="border-color:var(--border);color:var(--text)" aria-label="Type your inquiry" /><button type="submit" class="crest-serif text-sm font-semibold px-3 py-1" style="color:var(--primary)" aria-label="Send">Send</button></form>
  </div>
  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('crest-menu-toggle'),d=document.getElementById('crest-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('crest-chat-toggle'),cp=document.getElementById('crest-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('crest-chat-form'),i=document.getElementById('crest-chat-input'),m=document.getElementById('crest-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='crest-bubble-u';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='crest-bubble-a';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='crest-bubble-a';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
