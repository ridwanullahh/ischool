---
/**
 * Radiance — v2 conventional theme
 */
import '../../../../styles/global.css';
import PaletteStyles from '../../_shared/PaletteStyles.astro';
import FoucScript from '../../_shared/FoucScript.astro';
import ThemeToggleScript from '../../_shared/ThemeToggleScript.astro';
import { getSocialIconPath } from '../../_shared/social-icons';
import { getSchoolNav, getSchoolContacts } from '../../../../lib/school.ts';
import { normalizeSocialUrl } from '../../../../lib/social.ts';
import LanguageSelector from '../../../../components/LanguageSelector.astro';
import SchoolBannerPopup from '../../../../components/SchoolBannerPopup.astro';
interface Props { school: any; title?: string; }
const { school, title } = Astro.props;
const nav = getSchoolNav(school.id); const contacts = getSchoolContacts(school.id);
const pageTitle = title ? `${title} — ${school.name}` : school.name;
const prefix = `/${school.slug}`; const { pathname } = Astro.url;
const social = (school.socialHandles as Record<string, string>) || {};
const socialEntries = Object.entries(social).filter(([, v]) => v && v !== '#');
const locale = school.locale || 'en'; const rtl = ['ar','he','fa','ur'].includes(locale);
---
<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'} class="light scroll-smooth">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={school.tagline || school.name} />
  {school.faviconUrl && <link rel="icon" href={school.faviconUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
  <FoucScript defaultMode="light" /><PaletteStyles school={school} />
  <style is:inline>{`
    html, body { background: var(--bg); }
    body { font-family: 'Hanken Grotesk', system-ui, sans-serif; color: var(--text); min-height: 100vh; }
    .radiance-glow-bg { background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 70%); }
    .radiance-nav-link { font-size: 0.85rem; font-weight: 500; padding: 0.5rem 1rem; border-radius: 9999px; transition: all 0.2s; }
    .radiance-nav-link[data-active="true"] { background: var(--primary); color: #fff; box-shadow: 0 4px 16px color-mix(in srgb, var(--primary) 40%, transparent); }
    .radiance-nav-link:hover:not([data-active="true"]) { background: color-mix(in srgb, var(--primary) 10%, transparent); }
    .radiance-bubble-u { background: var(--primary); color: #fff; padding: 0.5rem 1rem; font-size: 0.85rem; max-width: 85%; margin-left: auto; border-radius: 1rem 1rem 0 1rem; box-shadow: 0 4px 16px color-mix(in srgb, var(--primary) 30%, transparent); }
    .radiance-bubble-a { background: color-mix(in srgb, var(--primary) 10%, var(--bg)); color: var(--text); padding: 0.5rem 1rem; font-size: 0.85rem; max-width: 85%; border-radius: 1rem 1rem 1rem 0; }
  `}</style>
</head>
<body>
  <header class="sticky top-0 z-40 border-b radiance-glow-bg" style="background:color-mix(in srgb, var(--surface) 90%, transparent);backdrop-filter:blur(12px);border-color:var(--border)">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href={`${prefix}/`} class="flex items-center gap-3" aria-label={`${school.name} home`}>{school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-8 w-auto" /> : <span class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white font-bold" style="background:radial-gradient(circle, var(--primary), color-mix(in srgb, var(--primary) 70%, #000))">{school.name.charAt(0)}</span>}<span class="text-base font-bold" style="color:var(--text)">{school.name}</span></a>
      <div class="hidden lg:flex items-center gap-1">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="radiance-nav-link" style="color:var(--text)">{item.label}</a>; })}</div>
      <div class="flex items-center gap-2"><LanguageSelector /><button id="theme-toggle" type="button" class="p-2 rounded-full" style="color:var(--muted)" aria-label="Toggle light, dark, or system mode"><svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg><svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg></button><a href={`${prefix}/admissions`} class="hidden sm:inline-flex px-4 py-2 text-sm font-semibold text-white rounded-full" style="background:radial-gradient(circle, var(--primary), color-mix(in srgb, var(--primary) 70%, #000));box-shadow:0 4px 16px color-mix(in srgb, var(--primary) 40%, transparent)">Apply</a><button id="radiance-menu-toggle" type="button" class="lg:hidden p-2 rounded-full" style="color:var(--text)" aria-label="Open menu" aria-expanded="false" aria-controls="radiance-mobile-nav"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button></div>
    </div>
    <div id="radiance-mobile-nav" class="lg:hidden hidden px-4 pb-4 space-y-1">{nav.map(item => { const active = pathname === `${prefix}${item.url}`; return <a href={`${prefix}${item.url}`} data-active={active} class="radiance-nav-link block" style="color:var(--text)">{item.label}</a>; })}<a href={`${prefix}/admissions`} class="radiance-nav-link block text-center" style="background:var(--primary);color:#fff">Apply for Admission</a></div>
  </header>
  <main><slot /></main>
  <footer class="mt-20 radiance-glow-bg" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div><div class="flex items-center gap-3 mb-3">{school.logoUrl ? <img src={school.logoUrl} alt={school.name} class="h-9 w-auto" /> : <span class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white font-bold" style="background:radial-gradient(circle, var(--primary), color-mix(in srgb, var(--primary) 70%, #000))">{school.name.charAt(0)}</span>}<span class="text-base font-bold" style="color:var(--text)">{school.name}</span></div>{school.tagline && <p class="text-sm" style="color:var(--muted)">{school.tagline}</p>}{socialEntries.length > 0 && <div class="flex items-center gap-2 mt-3">{socialEntries.map(([p,h]) => { const path = getSocialIconPath(p); if (!path) return null; return <a href={normalizeSocialUrl(h,p)} target="_blank" rel="noopener noreferrer" aria-label={`Visit our ${p} page`} class="p-2 rounded-full" style="background:var(--primary);color:#fff"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={path} /></svg></a>; })}</div>}</div>
        <div><p class="text-xs font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Explore</p><ul class="space-y-2">{nav.slice(0,6).map(item => <li><a href={`${prefix}${item.url}`} class="text-sm hover:opacity-70" style="color:var(--text)">{item.label}</a></li>)}</ul></div>
        <div><p class="text-xs font-bold uppercase tracking-wider mb-3" style="color:var(--primary)">Contact</p><ul class="space-y-2">{contacts.slice(0,4).map(c => <li class="text-sm" style="color:var(--text)">{c.label && <span class="block text-xs" style="color:var(--muted)">{c.label}</span>}{c.value}</li>)}{contacts.length===0 && <li class="text-sm" style="color:var(--muted)">—</li>}</ul></div>
      </div>
      <div class="mt-8 pt-5 border-t flex items-center justify-between" style="border-color:var(--border)"><p class="text-xs" style="color:var(--muted)">© {new Date().getFullYear()} {school.name}</p><a href="/" class="text-xs hover:underline" style="color:var(--primary)">iSchool</a></div>
    </div>
  </footer>
  <SchoolBannerPopup school={school} />
  <button id="radiance-chat-toggle" type="button" class="fixed bottom-6 right-6 z-50 p-4 rounded-full shadow-2xl text-white" style="background:radial-gradient(circle, var(--primary), color-mix(in srgb, var(--primary) 70%, #000));box-shadow:0 8px 32px color-mix(in srgb, var(--primary) 50%, transparent)" aria-label="Open chat" aria-expanded="false" aria-controls="radiance-chat-panel"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg></button>
  <div id="radiance-chat-panel" class="fixed bottom-24 right-6 z-50 w-[min(380px,calc(100vw-3rem))] hidden flex-col rounded-2xl shadow-2xl overflow-hidden" style="background:var(--surface);border:1px solid var(--border);max-height:70vh">
    <div class="px-5 py-4" style="background:radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--primary) 20%, var(--surface)), var(--surface))"><p class="text-sm font-bold" style="color:var(--text)">{school.name}</p><p class="text-[11px]" style="color:var(--muted)">How can we help?</p></div>
    <div id="radiance-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
    <form id="radiance-chat-form" class="p-3 border-t flex items-center gap-2" style="border-color:var(--border)"><input id="radiance-chat-input" type="text" placeholder="Type..." class="flex-1 rounded-full px-4 py-2 text-sm outline-none" style="background:color-mix(in srgb, var(--primary) 6%, var(--bg));color:var(--text)" aria-label="Type your message" /><button type="submit" class="p-3 rounded-full text-white" style="background:var(--primary);box-shadow:0 4px 16px color-mix(in srgb, var(--primary) 30%, transparent)" aria-label="Send"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg></button></form>
  </div>
  <ThemeToggleScript defaultMode="light" selector="#theme-toggle" />
  <script is:inline set:html={`(function(){
    var t=document.getElementById('radiance-menu-toggle'),d=document.getElementById('radiance-mobile-nav');
    if(t&&d){t.addEventListener('click',function(){d.classList.toggle('hidden');t.setAttribute('aria-expanded',String(!d.classList.contains('hidden')));});}
    var ct=document.getElementById('radiance-chat-toggle'),cp=document.getElementById('radiance-chat-panel');
    function o(){cp.classList.remove('hidden');cp.classList.add('flex');ct.setAttribute('aria-expanded','true');}
    function c(){cp.classList.add('hidden');cp.classList.remove('flex');ct.setAttribute('aria-expanded','false');}
    if(ct&&cp){ct.addEventListener('click',function(){cp.classList.contains('hidden')?o():c();});}
    var f=document.getElementById('radiance-chat-form'),i=document.getElementById('radiance-chat-input'),m=document.getElementById('radiance-chat-messages');
    if(f&&i&&m){f.addEventListener('submit',function(e){e.preventDefault();var t=i.value.trim();if(!t)return;
      var b=document.createElement('div');b.className='radiance-bubble-u';b.textContent=t;m.appendChild(b);i.value='';m.scrollTop=m.scrollHeight;
      fetch('/api/'+${JSON.stringify(school.slug)}+'/ai-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:t})}).then(function(r){return r.ok?r.json():{reply:'Unavailable.'};}).then(function(data){var r=document.createElement('div');r.className='radiance-bubble-a';r.textContent=data.reply||data.message||'...';m.appendChild(r);m.scrollTop=m.scrollHeight;}).catch(function(){var r=document.createElement('div');r.className='radiance-bubble-a';r.textContent='Connection error.';m.appendChild(r);m.scrollTop=m.scrollHeight;});});}
  })();`} />
</body>
</html>
